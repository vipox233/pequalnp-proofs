  have hbd : ∀ x ∈ S, x &&& mz Z = x := by
    intro x hx
    rcases hS hx with ⟨w, _, rfl⟩ | h
    · rw [Nat.and_assoc, Nat.and_self]
    · simp at h; rcases h with rfl | rfl <;> simp
  obtain ⟨h0, h1⟩ := hm.proper hT (nb hp0) (nb hp1) hbd
  have hSW : (S : Set ℕ) ⊆ WZ E Z := by
    intro x hx
    rcases hS hx with h | h
    · exact h
    · simp at h; rcases h with rfl | rfl
      · exact absurd hx h0
      · exact absurd hx h1
  have hproj : ∀ e ∈ Q, mz e.1 &&& mz Z = mz e.1 ∧ tz e.1 ≠ 0 ∧ tz e.1 ≠ mz e.1 := by
    intro e he
    obtain ⟨⟨a, b⟩, c⟩ := hp2 e he
    exact ⟨Nat.eq_of_beq_eq_true a, nb b, nb c⟩
  have hno : ∀ e ∈ Q, ∀ q < e.2, ¬ Sol Z0 (mz e.1) (tz Z &&& mz e.1) q (C (mz e.1) (Im (mz e.1) S)) := by
    intro e he q hq hs
    have h3 := (hproj e he).1
    rw [tz_sub h3] at hs
    exact hI e he q hq (hs.mono le_rfl (C_mono (Im_WZ h3 hSW)))
  have htk := hm.size.2
  rcases hb with ⟨e, he, hle⟩ | hb
  · have h3 := hproj e he
    obtain ⟨q', hq', hs'⟩ := hm.const h3.1 (by rw [tz_sub h3.1]; exact h3.2.1) (by rw [tz_sub h3.1]; exact h3.2.2)
    exact hno e he q' (by omega) hs'
  have hpw : pwr E Z = 0 ∨ pwr E Z ∈ S := by
    rcases hE with rfl | ⟨e, he, rfl, hraw⟩
    · exact Or.inl rfl
    · by_contra hc
      push Not at hc
      refine hraw k (by omega) (hl.sol.mono le_rfl ?_)
      intro x hx
      obtain ⟨w, hw, rfl⟩ := hSW hx
      simp only [rawL, List.mem_append, List.map_cons, List.map_nil, List.mem_singleton] at hw
      rcases hw with hw | rfl
      · exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
      · have hx : xw e &&& mz Z ∈ S := by simpa using hx
        exact absurd (show pwr [e] Z ∈ S from hx) hc.2
  obtain ⟨M, hMf, hchk⟩ := hb t (by omega)
  obtain ⟨a1, a2, a3⟩ := avl_spec (PZ Q) (mz Z) (rawL E)
  set v := (avl (PZ Q) (mz Z) (rawL E)).filter (fun w => decide (w.s ∈ S)) with hv
  have hsub : v.Sublist (avl (PZ Q) (mz Z) (rawL E)) := List.filter_sublist
  have hnd : (v.map W.s).Nodup := by
    rw [List.Nodup, List.pairwise_map]
    exact (a1.sublist hsub).imp fun h => Nat.ne_of_gt h
  have hrep : Rep v S := by
    refine ⟨hnd, Finset.ext fun x => ?_⟩
    rw [List.mem_toFinset, List.mem_map]
    constructor
    · rintro ⟨w, hw, rfl⟩
      rw [hv, List.mem_filter] at hw; simpa using hw.2
    · intro hx
      obtain ⟨w, hw, rfl⟩ := hSW hx
      obtain ⟨w', hw', e⟩ := a3 w hw (fun e => h0 (e ▸ hx)) (fun e => h1 (e ▸ hx))
      exact ⟨w', by rw [hv, List.mem_filter]; exact ⟨hw', by simpa [e] using hx⟩, e⟩
  have hwok : ∀ w ∈ v, WOk (PZ Q) w := by
    intro w hw
    obtain ⟨x, _, rfl⟩ := a2 w (hsub.subset hw); exact mkW_ok _ _
  have hcod : ∀ w ∈ v, w.r = RZ E Z w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw)
    have : x &&& mz Z ∈ WZ E Z := ⟨x, hx, rfl⟩
    change 3 = RZ E Z (x &&& mz Z)
    rw [RZ, if_pos this]
  have hgood : ∀ w ∈ v, Good (lz Z) w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw); exact wire_good (rawL_sub hE6 hx) Z
  have hPlen : (PZ Q).length = Q.length := by simp [PZ]
  have hPget : ∀ j < (PZ Q).length, (PZ Q).getD j 0 = mz (Q.getD j (0, L - 1)).1 ∧ Q.getD j (0, L - 1) ∈ Q := by
    intro j hj
    rw [hPlen] at hj
    simp [PZ, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]
  have X : Ctx (PZ Q) (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (tz Z) := by
    refine ⟨fun i hi => lz_lg Z i hi, fun j hj => ?_, ?_⟩
    · obtain ⟨e1, e2⟩ := hPget j hj
      have h3 := hproj _ e2
      rw [e1, tz_sub h3.1]; exact h3
    · rw [pL_pk, List.length_map, hPlen]
      refine pk_congr fun j hj => ?_
      rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]; rfl
  have hcl : Cl (PZ Q) (tz Z) (L - 1) (fun j => L - 1 - (Q.getD j (0, L - 1)).2) S := by
    intro j hj q hq
    obtain ⟨e1, e2⟩ := hPget j hj
    have hq' : q + (L - 1 - (Q.getD j (0, L - 1)).2) < L - 1 := hq
    rw [e1]; exact hno _ e2 q (by omega)
  have hle := cnt_le X hrep hwok hcl hm (by omega)
  have hst : StOk (PZ Q) (tz Z) (lz Z) (L - 1) (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v S := by
    refine ⟨hrep, hwok, hgood, _, fun j _ => by omega, hcl, ?_⟩
    rw [sumc_eq hwok, pk16, pk_sub]
    intro j hj; have := hle j hj; omega
  have hcov : ∀ i, (lz Z).testBit i = true → (0 : ℕ).testBit i = true ∨ (cov (pos t) (lz Z) v).testBit i = true := by
    intro i hli
    right
    rw [cov_bit]
    obtain ⟨⟨m1, m2, t1, t2⟩, _⟩ := lz_lg Z i hli
    obtain ⟨w, hw, hs⟩ := hl.cov m1 m2 t1 t2
    obtain ⟨w', hw', rfl⟩ := hrep.mem.1 hw
    exact ⟨w', hw', by rw [sp_bit, hli, pos_eq, hs]; rfl⟩
  have hsz := hm.size.1
  have hcard := hrep.card
  have hble : Nat.ble v.length (Nat.sub (Nat.succ (L - 1)) t) = true := Nat.ble_eq_true_of_le (by
    change v.length ≤ L - 1 + 1 - t; omega)
  have hhas : hasP (pwr E Z) v = true := hasP_ok (hpw.imp id fun h => hrep.mem.1 h)
  have all : ∀ p ∈ M, topCCut test (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (L - 1) p.1 p.2 (L - 1) t (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v = false := by
    intro p hpM
    have h2 := hchk p hpM
    simp only [chkCut, frc_eq, st_eq] at h2
    have h3 := anySub_false (by simp) h2 v hsub hcov
    simp only [startvCut, bR, hhas, hble, Bool.cond_true] at h3
    exact child_sound X (f := fun z r => topCCut test (lz Z) (mz Z) _ (L - 1) p.1 p.2 (L - 1) t z r) (fun h => rfl) hst hm (by omega) h3
  refine topC_soundCut X hcut (RZ_R E Z) (RZ_R2 E Z) hMf all hst hcod (by omega) hl ?_
  intro q hq hs
  rw [RZ_set] at hs
  refine Nat.find_min hex (show q < Nat.find hex by omega) (hs.mono le_rfl ?_)
  rintro x ((hx | hx) | hx)
  · exact Or.inl hx
  · exact Or.inl (hSW hx)
  · exact Or.inr hx
end gatedUnit
def baseSet (z : ℕ) := C (mz z) (WZ [] z)
def seeds (z : ℕ) := 0 :: mz z :: rawP.map (fun x => x &&& mz z)
lemma seed_ok {x z : ℕ} (hx : x ∈ seeds z) : x ∈ baseSet z := by
  simp only [seeds, List.mem_cons, List.mem_map] at hx
  rcases hx with rfl | rfl | ⟨a, ha, rfl⟩
  · exact Or.inr (by simp)
  · exact Or.inr (by simp)
  · exact Or.inl ⟨a, by simpa [rawL] using ha, rfl⟩
def Pay (n : ℕ) (A : Set ℕ) (a : ℕ) : Prop :=
  ∀ {T q : ℕ} {Q : Set ℕ}, A ⊆ Q → Sol Z0 n T q (insert a Q) → Sol Z0 n T (q + 1) Q
def oneOp (n : ℕ) (B : List ℕ) (p : ℕ) : Bool :=
  B.any fun a => (a ^^^ n == p) || B.any fun b => (a &&& b == p) || (a ||| b == p)
lemma oneOp_ok {z p : ℕ} (h : oneOp (mz z) (seeds z) p = true) : Pay (mz z) (baseSet z) p := by
  simp only [oneOp, List.any_eq_true, Bool.or_eq_true, beq_iff_eq] at h
  intro T q Q hQ hsol
  obtain ⟨a, ha, he | ⟨b, hb, he | he⟩⟩ := h
  · subst p
    exact .un (hQ (seed_ok ha)) hsol
  · subst p
    exact .bi (d := false) (hQ (seed_ok ha)) (hQ (seed_ok hb)) (al0 _ _ _) hsol
  · subst p
    exact .bi (d := true) (hQ (seed_ok ha)) (hQ (seed_ok hb)) (al0 _ _ _) hsol
lemma payList {n T : ℕ} (A : Set ℕ) (xs : List ℕ) (hp : ∀ x ∈ xs, Pay n A x) :
    ∀ {Q : Set ℕ} {q : ℕ}, A ⊆ Q → Sol Z0 n T q (Q ∪ {x | x ∈ xs}) → Sol Z0 n T (q + xs.length) Q := by
  induction xs with
  | nil =>
    intro Q q _ h
    simpa using h
  | cons a xs ih =>
    intro Q q hQ h
    have hx : Sol Z0 n T q (insert a Q ∪ {x | x ∈ xs}) := h.mono le_rfl (by
      rintro x (hx | hx)
      · exact Or.inl (Or.inr hx)
      · change x ∈ a :: xs at hx
        rcases List.mem_cons.1 hx with rfl | hx
        · exact Or.inl (Or.inl rfl)
        · exact Or.inr hx)
    have htail := ih (fun x hx => hp x (List.mem_cons_of_mem _ hx)) (fun x hx => Or.inr (hQ hx)) hx
    exact hp a (by simp) hQ htail
structure Price where
  wire : ℕ
  mask : ℕ
  digits : ℕ
def charge (h : Price) (j : ℕ) : ℕ := (h.digits >>> (6*j)) &&& 3
def cell (z j : ℕ) (h : Price) : Bool :=
  if !h.mask.testBit (6*j+5) then true else
    let p := h.wire &&& mz z
    match charge h j with
    | 0 => (p == 0) || (p == mz z)
    | 1 => (seeds z).contains p
    | 2 => oneOp (mz z) (seeds z) p
    | _ => false
def Fits (tests : List (ℕ × ℕ)) (h : Price) := ∀ j (hj : j < tests.length), cell tests[j].1 j h = true
def paid (rows : List Price) (j : ℕ) := rows.filter fun h => charge h j == 2
def saved (rows : List Price) (j : ℕ) := rows.filter fun h => charge h j == 0
def approves (b k j : ℕ) (rows : List Price) : Bool :=
  (rows.all fun h => h.mask.testBit (6*j+5)) && decide (k + (paid rows j).length < b + (saved rows j).length)
lemma approves_sound {tests : List (ℕ × ℕ)} (hok : pOk 0 tests = true) (bound : ∀ e ∈ tests, Imp [] e.1 e.2)
    {rows : List Price} (hfits : ∀ h ∈ rows, Fits tests h) (j : ℕ) (hj : j < tests.length)
    {k t k' : ℕ} {S : Finset ℕ} {R : ℕ → ℕ} (hnd : (rows.map Price.wire).Nodup)
    (hS : (rows.map Price.wire).toFinset = S) (hk : k' ≤ k) (hm : Min R (mz 0) (tz 0) k' t S) :
    approves tests[j].2 k j rows = false := by
  apply Bool.eq_false_iff.2
  intro bad
  simp only [approves, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at bad
  obtain ⟨hbit, hbudget⟩ := bad
  let z := tests[j].1
  let n := mz z
  have he : tests[j] ∈ tests := List.getElem_mem hj
  simp only [pOk, Bool.and_eq_true, Bool.not_eq_true', List.all_eq_true] at hok
  obtain ⟨⟨ha,hb⟩,hc'⟩ := hok.2 _ he
  have nb : ∀ {x y : ℕ}, Nat.beq x y = false → x ≠ y := fun h e => by rw [e, Nat.beq_refl] at h; simp at h
  have hsub : n &&& mz 0 = n := Nat.eq_of_beq_eq_true ha
  have htgt : tz 0 &&& n = tz z := tz_sub hsub
  obtain ⟨q, hlim, hsol⟩ := hm.const hsub (by rw [htgt]; exact nb hb) (by rw [htgt]; exact nb hc')
  rw [htgt] at hsol
  have hc : ∀ h ∈ rows, cell z j h = true := fun h hh => hfits h hh j hj
  have hzero : ∀ h ∈ saved rows j, Cst n h.wire := by
    intro h hh
    obtain ⟨hmem, hc0⟩ := List.mem_filter.1 hh
    have hh := hc h hmem
    simp [cell, hbit h hmem, beq_iff_eq.1 hc0, Cst, n] at hh ⊢
    exact hh
  have hcount : (saved rows j).length ≤ (S.filter (Cst n)).card := by
    have nd : ((saved rows j).map Price.wire).Nodup := hnd.sublist ((List.filter_sublist : (saved rows j).Sublist rows).map Price.wire)
    rw [← List.length_map Price.wire, ← List.toFinset_card_of_nodup nd]
    apply Finset.card_le_card
    intro x hx
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 (List.mem_toFinset.1 hx)
    exact Finset.mem_filter.2 ⟨by rw [← hS]; exact List.mem_toFinset.2 (List.mem_map_of_mem (List.mem_of_mem_filter hh)), hzero h hh⟩
  let extras := (paid rows j).map fun h => h.wire &&& n
  have hpay : ∀ x ∈ extras, Pay n (baseSet z) x := by
    rintro x hx
    obtain ⟨h,hh,rfl⟩ := List.mem_map.1 hx
    obtain ⟨hmem,hc2⟩ := List.mem_filter.1 hh
    apply oneOp_ok
    simpa [cell, hbit h hmem, beq_iff_eq.1 hc2, n] using hc h hmem
  have hcover : C n (Im n S) ⊆ baseSet z ∪ {x | x ∈ extras} := by
    rintro x (⟨a, ha, rfl⟩ | hx)
    · change a ∈ S at ha
      rw [← hS, List.mem_toFinset, List.mem_map] at ha
      obtain ⟨h,hmem,rfl⟩ := ha
      have hcert := hc h hmem
      simp only [cell, hbit h hmem, Bool.not_true, Bool.false_eq_true, if_false] at hcert
      split at hcert
      · exact Or.inl (Cst_mem (by simpa [Cst, n] using hcert))
      · exact Or.inl (seed_ok (by simpa using hcert))
      · right
        change h.wire &&& n ∈ (paid rows j).map (fun w => w.wire &&& n)
        apply List.mem_map_of_mem (f := fun w : Price => w.wire &&& n)
        apply List.mem_filter.2
        exact ⟨hmem, by simp_all⟩
      · contradiction
    · exact Or.inl (Or.inr hx)
  have out := payList (baseSet z) extras hpay subset_rfl (hsol.mono le_rfl hcover)
  have hxlen : extras.length = (paid rows j).length := List.length_map _
  exact bound _ he _ (by omega) out

structure StateCase where
  ws : List ℕ
  cap : ℕ
  idx : ℕ
  tags : ℕ
def labelRows : List ℕ → ℕ → List Price
  | [], _ => []
  | w::ws, tag => ⟨w, 32, tag &&& 3⟩ :: labelRows ws (tag >>> 2)
lemma label_wires (ws : List ℕ) (tag : ℕ) : (labelRows ws tag).map Price.wire = ws := by
  induction ws generalizing tag with
  | nil => rfl
  | cons w ws ih => simp [labelRows, ih]
def verifiedCase (tests : List (ℕ × ℕ)) (c : StateCase) : Bool :=
  if h : c.idx < tests.length then
    let e := tests[c.idx]
    let rs := labelRows c.ws c.tags
    rs.all (cell e.1 0) && approves e.2 c.cap 0 rs
  else false
lemma case_sound {tests : List (ℕ × ℕ)} (hok : pOk 0 tests = true) (bounds : ∀ e ∈ tests, Imp [] e.1 e.2)
    {c : StateCase} (hcase : verifiedCase tests c = true)
    {v : List W} {k t j : ℕ} {R : ℕ → ℕ} {S : Finset ℕ} (hs : Rep v S) (hk : j ≤ k) (hm : Min R (mz 0) (tz 0) j t S)
    (hcap : k ≤ c.cap) (hw : v.map W.s = c.ws) : False := by
  unfold verifiedCase at hcase
  split at hcase
  · next hi =>
      let e := tests[c.idx]
      have he : e ∈ tests := List.getElem_mem hi
      have hh := hok
      simp only [pOk, Bool.and_eq_true, List.all_eq_true] at hh
      have hsng : pOk 0 [e] = true := by
        simp only [pOk, Bool.and_eq_true, List.all_eq_true, List.mem_singleton]
        exact ⟨hh.1, fun a ha => ha ▸ hh.2 _ he⟩
      have hbound : ∀ r ∈ [e], Imp [] r.1 r.2 := by simpa using bounds _ he
      simp only [Bool.and_eq_true, List.all_eq_true] at hcase
      have fits : ∀ p ∈ labelRows c.ws c.tags, Fits [e] p := by
        intro p hp x hx
        have h0 : x = 0 := by simpa using hx
        subst x
        exact hcase.1 _ hp
      have hw' : (labelRows c.ws c.tags).map Price.wire = v.map W.s := (label_wires _ _).trans hw.symm
      have hn := approves_sound hsng hbound fits 0 (by simp) (hw'.symm ▸ hs.1) (hw'.symm ▸ hs.2) (hk.trans hcap) hm
      exact Bool.noConfusion (hcase.2.symm.trans hn)
  · contradiction
inductive CaseTree where
  | empty
  | leaf (key : ℕ) (rows : List StateCase)
  | split (key : ℕ) (a b : CaseTree)
def bucket (key : ℕ) : CaseTree → List StateCase
  | .empty => []
  | .leaf val xs => bif Nat.beq key val then xs else []
  | .split val a b => bif Nat.ble val key then bucket key b else bucket key a
def casesOk (tests : List (ℕ × ℕ)) : CaseTree → Bool
  | .empty => true
  | .leaf _ xs => xs.all (verifiedCase tests)
  | .split _ a b => casesOk tests a && casesOk tests b
lemma bucket_ok {tests tree} (h : casesOk tests tree = true) (key : ℕ) : ∀ c ∈ bucket key tree, verifiedCase tests c = true := by
  induction tree with
  | empty => simp [bucket]
  | leaf val xs =>
    unfold bucket
    cases Nat.beq key val
    · simp
    · exact List.all_eq_true.1 h
  | split val a b ia ib =>
    simp only [casesOk, Bool.and_eq_true] at h
    unfold bucket
    cases Nat.ble val key
    · exact ia h.1
    · exact ib h.2
def caseKey (v : List W) : ℕ :=
  v.foldl (fun x w => Nat.add x (Nat.mod (Nat.land w.s 0xFFFFFFFFFFFFFFFF) 65521)) 0
def caseTest (tree : CaseTree) (k _t : ℕ) (v : List W) : Bool :=
  bif Nat.ble 9 k then st (caseKey v) (fun key => (bucket key tree).any (fun c => decide (k ≤ c.cap) && (v.map W.s == c.ws))) else false
lemma caseTest_sound {tests tree} (hok : pOk 0 tests = true) (bounds : ∀ e ∈ tests, Imp [] e.1 e.2) (cert : casesOk tests tree = true) :
    CutSound (mz 0) (tz 0) (caseTest tree) := by
  intro R k j t v S hs hk hm
  apply Bool.eq_false_iff.2
  intro h
  simp only [caseTest, st_eq] at h
  cases he : Nat.ble 9 k <;> rw [he] at h
  · contradiction
  · obtain ⟨c,hc,hc'⟩ := List.any_eq_true.1 h
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hc'
    exact case_sound hok bounds (bucket_ok cert _ _ hc) hs hk hm hc'.1 hc'.2

