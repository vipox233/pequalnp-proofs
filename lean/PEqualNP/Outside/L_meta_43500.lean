def target : (Fin 6 → Bool) → Bool := fun x => Nat.testBit (4276808928 * 2 ^ 32 + 4209043616) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)

set_option maxRecDepth 16000 in
set_option maxHeartbeats 0 in
theorem f_target : ∀ x : Fin 6 → Bool, f x = target x := by
  decide +kernel

def witness : Circuit :=
