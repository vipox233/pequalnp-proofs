def CutSound (m T : ℕ) (check : CutTest) : Prop :=
  ∀ {R : ℕ → ℕ} {k j t : ℕ} {v : List W} {S : Finset ℕ},
    Rep v S → j ≤ k → Min R m T j t S → check k t v = false
noncomputable def lookCut (test : CutTest) (l m g : Nat) (fuel : Nat) : Nat → Nat → Nat → List W → Bool :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → List W → Bool) (fun _ _ _ _ => true)
    (fun _ ih k t z v => Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y => bif test k t v then false else mv ih l m g k t z v y)) true (Nat.ble v.length 1)) fuel
