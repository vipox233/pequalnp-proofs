def inputFlip (f : F) : F := fun x => f (fun i => !x i)

def dual (f : F) : F := fun x => !inputFlip f x

theorem av_inputFlip {s t : Set F} (hs : ∀ u ∈ s, Av t (inputFlip u))
    {f} (h : Av s f) : Av t (inputFlip f) := by
  rcases h with ⟨b, rfl⟩ | ⟨u, hu, rfl | rfl⟩
  · exact Or.inl ⟨b, rfl⟩
  · exact hs _ hu
  · exact av_not (hs _ hu)

theorem prog_inputFlip {s : Set F} {f k} (p : Prog s f k) :
    ∀ t : Set F, (∀ u ∈ s, Av t (inputFlip u)) → Prog t (inputFlip f) k := by
  induction p with
  | done h => exact fun _ hs => .done (av_inputFlip hs h)
  | @gate s f a b k tag ha hb tail ih =>
    intro t hs
    have next := ih (insert (comb tag (inputFlip a) (inputFlip b)) t) (by
      intro v hv
      rcases Set.mem_insert_iff.mp hv with rfl | hmem
      · exact av_mem (Set.mem_insert _ _)
      · exact av_ins _ (hs _ hmem))
    exact .gate tag (av_inputFlip hs ha) (av_inputFlip hs hb) next

theorem prog_neg {s : Set F} {f k} (p : Prog s f k) : Prog s (fun x => !f x) k := by
  induction p with
  | done h => exact .done (av_not h)
  | gate tag ha hb tail ih => exact .gate tag ha hb ih

theorem low_of_dual {f : F} {n : ℕ} (h : Low n (dual f)) : Low n f := by
  intro k p
  apply h k
  exact prog_neg (prog_inputFlip p stock (by
    rintro _ ⟨i, rfl⟩
    exact av_not (av_mem ⟨i, rfl⟩)))

