def NN:Nat → Nat
|2=>1
|3=>1
|_=>0
def HT:Nat → Nat → Nat
|2,0=>0xb9ef265f
|3,0=>0xb9ef265f
|_,_=>0
def dictB:Nat → Nat → Nat
|0,0=>0x3300c0c2222
|_,_=>0
def stPool:Nat → Nat
|0=>0x924
|_=>0
def stOffB:Nat → Nat → Nat
|2,0=>3
|3,0=>0x33
