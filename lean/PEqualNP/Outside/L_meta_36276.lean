def pairsG:List (Nat × Nat):=[(1,5),(1,9),(4,5),(4,12),(8,9),(8,12)]
def r1sG:List Nat:=pairsG.map Prod.fst
def r2sG:List Nat:=pairsG.map Prod.snd
def mpG:Nat:=0x3f
def pool6G:List Nat:=[]
def xsM:List Nat:=roots_13.map (· &&& dom_13)
