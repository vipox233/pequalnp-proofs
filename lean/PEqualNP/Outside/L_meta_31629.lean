def wireSAt (i : Nat) : Nat := if i < 10 then (dictB (i / 512) (i / 32 % 16) >>> (92 * (i % 32))) &&& dictMask else 0
def readSt : Nat → Nat → List Nat
|0,_=>[]
  | n + 1, p => wireSAt (fld (stPool (p / 128)) 4 (p % 128)) :: readSt n (p + 1)
def SS (s j : Nat) : List Nat :=
