def vOf (k : Fin 256) : Fin 6 := Fin.ofNat 6 (cellV.getD k.val 0)

def graph : Fin 4 → Fin 6 → Bool := (fun (u : Fin 4) (v : Fin 6) => (816112 : ℕ).testBit (6 * u.val + v.val))

set_option maxRecDepth 32000 in
theorem sample_inputs : ∀ k : Fin 256,
    inputs.map (bit k) = PEqualNP.Represents.oneEach (uOf k) (vOf k) := by
  decide +kernel

set_option maxRecDepth 32000 in
theorem sample_target : ∀ k : Fin 256, graph (uOf k) (vOf k) = bit k target := by
  decide +kernel

theorem no_rep (s : ℕ) (impossible : build basicOps target s inputs.toFinset → False) :
    ¬ PEqualNP.Represents.RepSizeAtMost graph s := by
  rintro ⟨C, hmono, hsize, hrep⟩
  have hg : ∀ g ∈ C.gates, legal g := by
    intro g hgm
    obtain ⟨hop, hlen⟩ := hmono g hgm
    exact ⟨by simpa using hop, hlen⟩
  have he : ∀ k : Fin 256,
      (C.gates.foldl step (inputs.map (bit k))).getD C.output false = bit k target := by
    intro k
    have h := hrep (uOf k) (vOf k)
    rw [← sample_inputs k, sample_target k] at h
    exact h
  have run := compile C.gates C.output hg inputs inputs.toFinset
    (fun u hu => .inr (.inr (List.mem_toFinset.mpr hu))) he
  have lift : ∀ {a b : ℕ}, a ≤ b → build basicOps target a inputs.toFinset →
      build basicOps target b inputs.toFinset := by
    intro a b h hr
    induction h with
    | refl => exact hr
    | step _ ih => exact Or.inl ih
  exact impossible (lift hsize run)

-- No build of 10 steps reaches the target from the vertex words: no vertex word is the target,
-- and the search fails below every state of the first step.
set_option maxRecDepth 32000 in
