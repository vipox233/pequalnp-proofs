theorem PEqualNP.Outside.L_meta_25633 : ¬ (PEqualNP.Represents.RepSizeAtMost (fun (u : Fin 4) (v : Fin 6) => (816112 : ℕ).testBit (6 * u.val + v.val)) 10) :=
  PEqualNP.Outside.L_meta_25633.main
