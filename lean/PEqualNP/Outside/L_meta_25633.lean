set_option maxRecDepth 32000 in
theorem kids_ok : (allKids 9 (inputs.map BitVec.toNat)).all (dead 9) = true :=
  all_first (dead 9) (allKids 9 (inputs.map BitVec.toNat)) 12 part_0 (all_next (dead 9) (allKids 9 (inputs.map BitVec.toNat)) 12 15 27 rfl part_1 (all_next (dead 9) (allKids 9 (inputs.map BitVec.toNat)) 27 15 42 rfl part_2 (all_next (dead 9) (allKids 9 (inputs.map BitVec.toNat)) 42 11 53 rfl part_3 part_4)))

theorem main : ¬ PEqualNP.Represents.RepSizeAtMost graph 10 :=
  no_rep 10 (refute 9 inputs (by decide) roots_ok kids_ok target rfl)

