lemma wLen(gs:List Gate)(inp:List Bool):(Circuit.wires ⟨gs,0⟩ inp).length=inp.length+gs.length:=by unfold Circuit.wires;induction gs generalizing inp with|nil=>simp|cons a l ih=>simp only[List.foldl_cons,List.length_cons];rw[ih,List.length_append,List.length_singleton];omega
lemma wLt(gs:List Gate)(g:Gate)(inp:List Bool)(k:ℕ)(hk:k < inp.length+gs.length):(Circuit.wires ⟨gs++[g],0⟩ inp).getD k false=(Circuit.wires ⟨gs,0⟩ inp).getD k false:=by have h:=wLen gs inp;unfold Circuit.wires at h ⊢;simp only[List.foldl_append,List.foldl_cons,List.foldl_nil];set w:=gs.foldl (λ w g=>w++[g.op.eval (g.inputs.map λ i=>w.getD i false)]) inp;have hk':k<w.length:=h.symm▸hk;rw[List.getD_eq_getElem _ _ (by simp;omega),List.getD_eq_getElem _ _ hk'];exact List.getElem_append_left hk'
