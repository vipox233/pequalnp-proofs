namespace PEqualNP.Outside.L_meta_19462.Helpers

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Library.LRAT
  PEqualNP.Represents

theorem promise_lower_not (n s : ℕ) (g : ℕ → Bool) (rows : List ℕ) (hrows : ∀ r ∈ rows, r < 2 ^ n)
    (hU : ¬ FormulaSat (LinkN.enc2 n s g rows)) (C : Circuit) (hC : FanInTwo C)
    (hev : ∀ r ∈ rows, C.eval (List.ofFn fun i : Fin n => r.testBit i) = g r) :
    s + 1 ≤ C.size := by
  by_contra h
  have hv := LinkN.valid_ofCirc n s g (· ∈ rows) C hC (by simp only [Circuit.size] at h; omega)
    (fun r hr => hev r hr)
  obtain ⟨M, hM, hnf, hlx⟩ := LinkN.exists_nf2 ⟨_, hv⟩
  exact hU ⟨LinkN.val n s M, LinkN.enc2_sat hrows hM hnf hlx⟩

theorem rep_lower_not_mask (n m M s : ℕ)
    (hU : ¬ FormulaSat (LinkN.enc2 (n + m) s (Promise.gMask n m M) (Promise.repRows n m))) :
    ¬ ∃ C : Circuit, FanInTwo C ∧ C.size ≤ s ∧
      Represents (fun (u : Fin n) (v : Fin m) => M.testBit (m * u + v)) C := by
  rintro ⟨C, hC, hs, hr⟩
  have hmem : ∀ r ∈ Promise.repRows n m, ∃ (u : Fin n) (v : Fin m), Promise.repRow n u v = r := by
    intro r hr'
    simpa [Promise.repRows] using hr'
  have hrow : ∀ r ∈ Promise.repRows n m, r < 2 ^ (n + m) := by
    intro r hr'
    obtain ⟨u, v, rfl⟩ := hmem r hr'
    refine Nat.lt_pow_two_of_testBit _ fun i hi => ?_
    rw [Promise.repRow_testBit u.2]
    have := u.2; have := v.2
    simp; omega
  have := promise_lower_not (n + m) s (Promise.gMask n m M) (Promise.repRows n m) hrow hU C hC (by
    intro r hr'
    obtain ⟨u, v, rfl⟩ := hmem r hr'
    rw [Promise.repRow_eq, hr, Promise.gMask_row])
  omega

noncomputable section

abbrev Cont2 := Trie → Nat → Bool → Nat → Nat → Bool

def findBit (R : Nat) : Nat :=
  Nat.rec (motive := fun _ => Nat → Nat) (fun lo => lo)
    (fun i ih lo =>
      ih (Bool.rec lo (Nat.add lo (Nat.shiftLeft 1 i))
        (Nat.ble (Nat.shiftLeft 1 (Nat.add lo (Nat.shiftLeft 1 i))) R)))
    12 0

def stepRead2 (k : Cont2) (db : Trie) (id C F x : Nat) : Bool :=
  Bool.rec
    (Bool.rec (k db id false (setBit C x) F) (k db id true C C) (Nat.beq x (nat_lit 0)))
    (k db (Nat.succ x) false C F)
    (Nat.beq id (nat_lit 0))

def stepR2 (k : Cont2) (db : Trie) (id C F R : Nat) : Bool :=
  Bool.rec
    (Bool.rec false (k db id true C (setBit F (neg (findBit R))))
      (Nat.beq R (Nat.shiftLeft (nat_lit 1) (findBit R))))
    (Bool.rec (k (db.set 64 (Nat.sub id 1) (some C)) 0 false 0 0) true (Nat.beq C (nat_lit 0)))
    (Nat.beq R (nat_lit 0))

def stepHint2 (k : Cont2) (db : Trie) (id C F x : Nat) : Bool :=
  Option.rec false (fun D => stepR2 k db id C F (Nat.xor D (Nat.land D F))) (db.get x)

def tokenStep2 (k : Cont2) (x : Nat) : Cont2 := fun db id mode C F =>
  Bool.rec (stepRead2 k db id C F x) (stepHint2 k db id C F x) mode

def stop2 : Cont2 := fun _ _ _ _ _ => false

def runWord2 (W M fuel w : Nat) (k : Cont2) : Cont2 :=
  Nat.rec (motive := fun _ => Nat → Cont2) (fun _ => k)
    (fun _ ih w =>
      Bool.rec (tokenStep2 (ih (Nat.shiftRight w W)) (Nat.land w M)) k (Nat.beq w (nat_lit 1)))
    fuel w

def runW2 (e : Cont2) (W : Nat) (words : List Nat) : Cont2 :=
  List.rec (motive := fun _ => Cont2) e
    (fun w _ k => runWord2 W (Nat.sub (Nat.shiftLeft (nat_lit 1) W) (nat_lit 1)) fuelW w k) words

def checkW2 (F : List (List Nat)) (fk : List Nat) (W : Nat) (words : List Nat) : Bool :=
  runW2 stop2 W words (loadF F fk .nil) 0 false 0 0

end

section Soundness

variable (a : Nat → Bool)

def HintInv2 (C F : Nat) : Prop :=
  (∀ x, bit C x = true → litVal a x = false) → BitsFalse a F

def Good2 (Q : Prop) (k : Cont2) : Prop :=
  ∀ db id mode C F, db.All (MaskSat a) → (mode = true → HintInv2 a C F) →
    k db id mode C F = true → Q

theorem stop2_good (Q : Prop) : Good2 a Q stop2 := by
  intro _ _ _ _ _ _ _ h
  exact absurd h (by simp [stop2])

theorem tokenStep2_good {Q : Prop} {k : Cont2} (hk : Good2 a Q k) (x : Nat) :
    Good2 a Q (tokenStep2 k x) := by
  intro db id mode C F hdb hinv h
  change Bool.rec (stepRead2 k db id C F x) (stepHint2 k db id C F x) mode = true at h
  cases mode with
  | false =>
    change Bool.rec
      (Bool.rec (k db id false (setBit C x) F) (k db id true C C) (Nat.beq x 0))
      (k db (Nat.succ x) false C F) (Nat.beq id 0) = true at h
    cases hi : Nat.beq id 0
    · rw [hi] at h
      cases hx : Nat.beq x 0
      · rw [hx] at h
        exact hk db id false _ F hdb (by simp) h
      · rw [hx] at h
        exact hk db id true C C hdb (fun _ hC => hC) h
    · rw [hi] at h
      exact hk db _ false C F hdb (by simp) h
  | true =>
    have hinv := hinv rfl
    change Option.rec false (fun D => stepR2 k db id C F (Nat.xor D (Nat.land D F)))
      (db.get x) = true at h
    cases hg : db.get x with
    | none => rw [hg] at h; exact absurd h (by simp)
    | some D =>
      rw [hg] at h
      have hD : MaskSat a D := Trie.All.get hdb hg
      change Bool.rec
        (Bool.rec false (k db id true C (setBit F (neg (findBit (Nat.xor D (Nat.land D F))))))
          (Nat.beq (Nat.xor D (Nat.land D F))
            (Nat.shiftLeft 1 (findBit (Nat.xor D (Nat.land D F))))))
        (Bool.rec (k (db.set 64 (Nat.sub id 1) (some C)) 0 false 0 0) true (Nat.beq C 0))
        (Nat.beq (Nat.xor D (Nat.land D F)) 0) = true at h
      cases hU : Nat.beq (Nat.xor D (Nat.land D F)) 0
      · rw [hU] at h
        cases hu : Nat.beq (Nat.xor D (Nat.land D F))
            (Nat.shiftLeft 1 (findBit (Nat.xor D (Nat.land D F))))
        · rw [hu] at h; exact absurd h (by simp)
        · rw [hu] at h
          refine hk db id true C _ hdb (fun _ hC => ?_) h
          have hF := hinv hC
          obtain ⟨w, hw, hwv⟩ := witness_U a hF hD
          rw [Nat.eq_of_beq_eq_true hu, bit_pow, decide_eq_true_eq] at hw
          intro l hl
          rw [bit_setBit, Bool.or_eq_true, decide_eq_true_eq] at hl
          rcases hl with hl | hl
          · exact hF l hl
          · rw [← hl, hw, litVal_neg, hwv]; rfl
      · rw [hU] at h
        have hCsat : MaskSat a C := by
          apply Classical.byContradiction
          intro hn
          have hC : ∀ y, bit C y = true → litVal a y = false := by
            intro y hy
            cases hv : litVal a y
            · rfl
            · exact absurd ⟨y, hy, hv⟩ hn
          obtain ⟨w, hw, _⟩ := witness_U a (hinv hC) hD
          rw [Nat.eq_of_beq_eq_true hU, bit_zero] at hw
          exact absurd hw (by simp)
        cases hC0 : Nat.beq C 0
        · rw [hC0] at h
          exact hk _ _ false 0 0
            (Trie.All.set 64 _ hdb (fun c hc => by cases hc; exact hCsat)) (by simp) h
        · obtain ⟨w, hw, _⟩ := hCsat
          rw [Nat.eq_of_beq_eq_true hC0, bit_zero] at hw
          exact absurd hw (by simp)

theorem runWord2_good {Q : Prop} (W M : Nat) {k : Cont2} (hk : Good2 a Q k) :
    ∀ fuel w, Good2 a Q (runWord2 W M fuel w k)
  | 0, _ => hk
  | fuel + 1, w => by
    change Good2 a Q (Bool.rec (tokenStep2 (runWord2 W M fuel (Nat.shiftRight w W) k)
      (Nat.land w M)) k (Nat.beq w 1))
    cases Nat.beq w 1
    · exact tokenStep2_good a (runWord2_good W M hk fuel _) _
    · exact hk

theorem runW2_good {Q : Prop} {e : Cont2} (he : Good2 a Q e) (W : Nat) :
    ∀ words : List Nat, Good2 a Q (runW2 e W words)
  | [] => he
  | w :: ws => by
    have h := runWord2_good a W (Nat.sub (Nat.shiftLeft 1 W) 1) (runW2_good he W ws) fuelW w
    exact h

end Soundness

theorem checkW2_sound (F : List (List Nat)) (fk : List Nat) (W : Nat) (words : List Nat)
    (h : checkW2 F fk W words = true) : ¬ FormulaSat F := by
  rintro ⟨a, ha⟩
  exact runW2_good a (stop2_good a False) W words _ _ false 0 0
    (loadF_all a F fk (t := .nil) trivial ha) (by simp) h

def lg5 (x : Nat) : Nat := if x = 2 then 1 else if x = 4 then 2 else if x = 8 then 3 else if x = 16 then 4 else if x = 32 then 5 else if x = 64 then 6 else if x = 128 then 7 else if x = 256 then 8 else if x = 512 then 9 else if x = 1024 then 10 else if x = 2048 then 11 else 0

def cA (a : Nat) : Nat := if a < 13 then a else 13 + 4 * lg5 (a % 16) + lg5 (a / 16)

def tauV (V : Nat) : Nat := (V - 1) / 270 * 29 + cA ((V - 1) % 270) + 1

def iA (c : Nat) : Nat := if c < 13 then c else 2 ^ ((c - 13) / 4) + 2 ^ (4 + (c - 13) % 4)

def sigV (T : Nat) : Nat := (T - 1) / 29 * 270 + iA ((T - 1) % 29) + 1

def rho (l : Nat) : Nat := 2 * tauV (l / 2) + l % 2

theorem sat_rename (F : List (List Nat)) (hinv : ∀ c ∈ F, ∀ l ∈ c, sigV (tauV (l / 2)) = l / 2)
    (h : FormulaSat F) : FormulaSat (F.map (List.map rho)) := by
  obtain ⟨a, ha⟩ := h
  refine ⟨fun x => a (sigV x), ?_⟩
  intro c' hc'
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hc'
  obtain ⟨l, hl, hv⟩ := ha c hc
  refine ⟨rho l, List.mem_map_of_mem hl, ?_⟩
  have h1 : rho l / 2 = tauV (l / 2) := by unfold rho; omega
  have h2 : rho l % 2 = l % 2 := by unfold rho; omega
  unfold litVal at hv ⊢
  rw [h1, h2]
  show (a (sigV (tauV (l / 2))) == (l % 2 == 0)) = true
  rw [hinv c hc l hl]
  exact hv

def F : List (List Nat) := LinkN.enc2 (4 + 4) 4 (Promise.gMask 4 4 495) (Promise.repRows 4 4)

