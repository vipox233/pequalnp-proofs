def Beg (A : ℕ → ℕ → Prop) (R : ℕ → ℕ) (m T k t : ℕ) (S : Finset ℕ) : Prop :=
  Live R m T k t S ∨ ∃ q d a b U, k = q + 1 ∧ R a ≠ 0 ∧ R b ≠ 0 ∧ A a b ∧ Bi Z0 d a b S U ∧ Live Z0 m T q t U
def seen (M : List (ℕ × ℕ)) (a b : ℕ) : Bool := M.any fun p => hb p.1 (a + b)

