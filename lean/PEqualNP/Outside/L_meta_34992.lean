theorem validCuts : certificates.all (fun c => cutWorks c && decide (c.face = 1 ∨ c.face = 4 ∨ c.face = 8)) = true := by decide +kernel
lemma fromCut {d : Bool} {a b : ℕ} {S U : Finset ℕ} (bad : certificates.any (fits d a b) = true)
    (hS : (S : Set ℕ) ⊆ C (mz 0) (WZ [] 0)) (gate : Bi Z0 d a b S U) (tail : Live Z0 (mz 0) (tz 0) 13 1 U) : False := by
  obtain ⟨c,hc,ok⟩ := List.any_eq_true.mp bad
  have v := List.all_eq_true.mp validCuts c hc
  simp only [Bool.and_eq_true,decide_eq_true_eq] at v
  have lo : Imp [] c.face 13 := v.2.elim (fun h => h.symm ▸ low1) (fun h => h.elim (fun e => e.symm ▸ low4) (fun e => e.symm ▸ low8))
  apply forbidCut v.1 lo iroot_prev hS _ tail
  obtain ⟨hd,ab | ba⟩ := of_decide_eq_true ok
  · rw [hd,←ab.1,←ab.2]; exact gate
  · rw [hd,←ba.1,←ba.2]; exact gate.symm

