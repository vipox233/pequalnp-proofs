lemma okAll {T U : List (ℕ × ℕ)} (h : U.all (fun e => okE [] (pr T e.1) e) = true)
    (hT : ∀ e ∈ T, Imp [] e.1 e.2) : ∀ e ∈ U, Imp [] e.1 e.2 := fun e he => imp_okE
  (Or.inl rfl) (List.all_eq_true.1 h e he) (fun e' h' => hT e' (List.mem_of_mem_filter h'))
lemma apI {E A B : List (ℕ × ℕ)} (ha : ∀ e ∈ A, Imp E e.1 e.2) (hb : ∀ e ∈ B, Imp E e.1 e.2) : ∀ e ∈ A ++ B, Imp E e.1 e.2 := fun e he =>
  (List.mem_append.1 he).elim (ha e) (hb e)
lemma imp_ts {E Q : List (ℕ × ℕ)} {L : ℕ} (hE : E = [] ∨ ∃ p ∈ six, E = [p] ∧ Imp [] 0 L) (hp : pOk 0 Q = true) (hL : L ≤ 15) (hI : ∀ e ∈ Q, Imp E e.1 e.2)
    (h : ∀ t < L, chk E Q 0 (L - 1) t FF 1 = false) : Imp E 0 L :=
  imp_of hE hp hL hI (Or.inr fun t ht => ⟨[(FF, 1)], ffull, fun q hq => by simp only [List.mem_singleton] at hq; subst hq; exact h t ht⟩)

def riseOk (z y i : ℕ) : Bool :=
  decide (mz y &&& mz z = mz y ∧ tz y ≠ 0 ∧ tz y ≠ mz y ∧ (mz z).testBit i = true ∧
    (mz z).testBit (NN+i) = true ∧ (tz z).testBit i = true ∧ (tz z).testBit (NN+i) = false) &&
  rawP.all (fun a => !(sepb NN true (a &&& mz z) i) ||
    decide ((a &&& mz z) &&& mz y = 0 ∨ (a &&& mz z) &&& mz y = mz y))

lemma rise {z y i r : ℕ} (ok : riseOk z y i = true) (old : Imp [] y r) : Imp [] z (r+1) := by
  classical
  simp only [riseOk, Bool.and_eq_true, decide_eq_true_eq] at ok
  obtain ⟨⟨mask,n0,n1,m1,m2,t1,t2⟩,cols⟩ := ok
  intro q hq hs
  have poss : ∃ j, Sol Z0 (mz z) (tz z) j (C (mz z) (WZ [] z)) := ⟨q,hs⟩
  have hlt := lt_of_le_of_lt (Nat.find_min' poss hs) hq
  obtain ⟨k,hk,t,S,hS,hl⟩ := (Nat.find_spec poss).live
  have hm : Min Z0 (mz z) (tz z) k t S := ⟨hl, fun u hu sol =>
    Nat.find_min poss (by omega) (sol.mono le_rfl (by rintro x (hx | hx); exact hS hx; exact Or.inr hx))⟩
  have tv := tz_sub mask
  obtain ⟨j,hj,res⟩ := hm.const mask (by rwa [tv]) (by rwa [tv])
  obtain ⟨w,hw,dist⟩ := hl.cov m1 m2 t1 t2
  have hc : Cst (mz y) w := by
    rcases hS hw with ⟨a,ha,rfl⟩ | hc
    · have hv : a ∈ rawP := by simpa [rawL] using ha
      have hx := List.all_eq_true.mp cols a hv
      rw [sepb_weak _ dist] at hx
      simpa [Cst] using hx
    · change w = 0 ∨ w = mz z at hc
      rcases hc with e | e
      · exact Or.inl (by rw [e]; simp)
      · exact Or.inr (by rw [e,Nat.and_comm,mask])
  have positive : 0 < (S.filter (Cst (mz y))).card := Finset.card_pos.mpr ⟨w,Finset.mem_filter.mpr ⟨hw,hc⟩⟩
  apply old j (by omega)
  rw [tv] at res
  apply res.mono le_rfl
  rintro x (⟨w,hw,rfl⟩ | hx)
  · rcases hS hw with ⟨a,ha,rfl⟩ | hc
    · exact Or.inl ⟨a,ha,by change (a &&& mz z) &&& mz y = _; rw [Nat.and_assoc,Nat.and_comm (mz z),mask]⟩
    · change w = 0 ∨ w = mz z at hc
      rcases hc with e | e
      · exact Or.inr (Or.inl (by rw [e]; simp))
      · exact Or.inr (Or.inr (by change w &&& mz y = mz y; rw [e,Nat.and_comm,mask]))
  · exact Or.inr hx

def routeRows (p : List ℕ) (w : ℕ) : ℕ := p.foldr (fun i r => Nat.bit (w.testBit i) r) 0
lemma route_zero (p : List ℕ) : routeRows p 0 = 0 := by
  induction p with
  | nil => rfl
  | cons i p ih => change Nat.bit ((0 : ℕ).testBit i) (routeRows p 0) = 0; simp [ih]
lemma route_and (p : List ℕ) (x y : ℕ) : routeRows p (x &&& y) = routeRows p x &&& routeRows p y := by
  induction p with
  | nil => simp [routeRows]
  | cons i p ih =>
    change Nat.bit ((x &&& y).testBit i) (routeRows p (x &&& y)) = Nat.bit (x.testBit i) (routeRows p x) &&& Nat.bit (y.testBit i) (routeRows p y)
    rw [Nat.testBit_and, ih, Nat.land_bit]
lemma route_or (p : List ℕ) (x y : ℕ) : routeRows p (x ||| y) = routeRows p x ||| routeRows p y := by
  induction p with
  | nil => simp [routeRows]
  | cons i p ih =>
    change Nat.bit ((x ||| y).testBit i) (routeRows p (x ||| y)) = Nat.bit (x.testBit i) (routeRows p x) ||| Nat.bit (y.testBit i) (routeRows p y)
    rw [Nat.testBit_or, ih, Nat.lor_bit]
lemma route_xor (p : List ℕ) (x y : ℕ) : routeRows p (x ^^^ y) = routeRows p x ^^^ routeRows p y := by
  induction p with
  | nil => simp [routeRows]
  | cons i p ih =>
    change Nat.bit ((x ^^^ y).testBit i) (routeRows p (x ^^^ y)) = Nat.bit (x.testBit i) (routeRows p x) ^^^ Nat.bit (y.testBit i) (routeRows p y)
    rw [Nat.testBit_xor, ih, Nat.xor_bit]
lemma route_op (p : List ℕ) (d : Bool) (a b : ℕ) : routeRows p (op d a b) = op d (routeRows p a) (routeRows p b) := by
  cases d <;> simp [op, route_and, route_or]

lemma Sol.route {m T k : ℕ} {S : Set ℕ} (p : List ℕ) (h : Sol Z0 m T k S) :
    ∀ Q : Set ℕ, (∀ x ∈ S, routeRows p x ∈ Q) → Sol Z0 (routeRows p m) (routeRows p T) k Q := by
  induction h with
  | done h => intro Q hQ; exact .done (hQ _ h)
  | @un k S a ha h ih =>
    intro Q hQ
    apply Sol.un (hQ _ ha)
    apply ih
    rintro w (rfl | hw)
    · rw [route_xor]; exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ (hQ _ hw)
  | @bi k S d a b ha hb _ h ih =>
    intro Q hQ
    apply Sol.bi (d := d) (hQ _ ha) (hQ _ hb) (al0 _ _ _)
    apply ih
    rintro w (rfl | hw)
    · rw [route_op]; exact Set.mem_insert _ _
    · exact Set.mem_insert_of_mem _ (hQ _ hw)

def routeOk (p : List ℕ) (source dest : ℕ) : Bool :=
  decide (routeRows p (mz source) = mz dest ∧ routeRows p (tz source) = tz dest) &&
    rawP.all (fun x => rawP.any (fun y => Nat.beq (routeRows p (x &&& mz source)) (y &&& mz dest)))

lemma routeImp {source dest r : ℕ} {p : List ℕ} (ok : routeOk p source dest = true) (h : Imp [] dest r) : Imp [] source r := by
  simp only [routeOk, Bool.and_eq_true, decide_eq_true_eq] at ok
  obtain ⟨⟨hm, hv⟩, columns⟩ := ok
  intro q hq hyp
  apply h q hq
  rw [←hm, ←hv]
  apply hyp.route
  intro x hx
  rcases hx with ⟨v, hmem, rfl⟩ | hc
  · have hmem' : v ∈ rawP := by simpa [rawL] using hmem
    obtain ⟨y, hy, he⟩ := List.any_eq_true.mp (List.all_eq_true.mp columns v hmem')
    exact Or.inl ⟨y, by simpa [rawL] using hy, Nat.eq_of_beq_eq_true he⟩
  · simp at hc
    rcases hc with rfl | rfl
    · exact Or.inr (by simp [route_zero])
    · exact Or.inr (by simp)

def rawSym (p : List ℕ) : Bool := rawP.all (fun w => rawP.any (fun v => Nat.beq (routeRows p w) v))
lemma bySym {p : List ℕ} (raw : rawSym p = true) (target : routeRows p TG = TG)
    {source dest r : ℕ} (hm : routeRows p (mz source) = mz dest) (old : Imp [] dest r) : Imp [] source r := by
  apply routeImp (p := p) _ old
  simp only [routeOk, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.any_eq_true]
  refine ⟨⟨hm, ?_⟩, ?_⟩
  · simpa only [tz, nl, route_and, target, hm]
  · intro w hw
    obtain ⟨v, hv, hh⟩ := List.any_eq_true.mp (List.all_eq_true.mp raw w hw)
    refine ⟨v, hv, ?_⟩
    rw [route_and, hm, Nat.eq_of_beq_eq_true hh, Nat.beq_refl]


