def rt2 : List (ℕ × ℕ) := [(3, 10), (5, 11), (6, 10), (9, 10), (10, 11), (12, 10), (17, 10), (18, 8), (20, 9), (24, 10), (33, 9), (34, 9), (36, 9), (40, 9), (48, 7), (65, 9), (66, 8), (68, 10), (72, 10), (80, 7), (96, 7), (129, 8), (130, 8), (132, 8), (136, 9), (144, 6), (160, 6), (192, 6)]
