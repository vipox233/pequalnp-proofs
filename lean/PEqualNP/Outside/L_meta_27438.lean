-- Ziehchaes (lane O1): the 3 x 3 perfect matching, its inputs renamed so the shared cell 0 is last.
def pm (x : Fin 9 → Bool) : Bool := ((x 0 && x 4 && x 8) || (x 0 && x 5 && x 7) || (x 1 && x 3 && x 8) || (x 1 && x 5 && x 6) || (x 2 && x 3 && x 7) || (x 2 && x 4 && x 6))

def sigma : Fin 9 → Fin 9 := fun i : Fin 9 => if i = 0 then 8 else if i = 8 then 0 else i

def hf : (Fin 8 → Bool) → Bool := (fun y : Fin 8 → Bool => pm ((Fin.snoc y true : Fin 9 → Bool) ∘ sigma))

/-- Gate elimination with the last input fixed: the pass's emitted gates form a circuit for the restriction. -/
theorem cut_size (n : ℕ) (f : (Fin (n + 1) → Bool) → Bool) (gs : List Gate) (o : ℕ)
    (hok : ∀ g ∈ gs, Ok g)
    (hev : ∀ x : Fin (n + 1) → Bool, (wiresFrom gs (List.ofFn x)).getD o false = f x)
    (b : Bool) (hnc : ∃ y y' : Fin n → Bool, f (Fin.snoc y b) ≠ f (Fin.snoc y' b)) :
    HasCircuitSize n (fun y : Fin n → Bool => f (Fin.snoc y b))
      (elim n (gs.map normGate) (initStats n b, [])).2.length := by
  set ns := gs.map normGate with hns
  have hnok : ∀ g ∈ ns, NOk g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok g0 (hok g0 hg0)
  have hevg : ∀ x : Fin (n + 1) → Bool, (wiresFrom ns (List.ofFn x)).getD o false = f x := by
    intro x
    rw [hns, wiresFrom_norm, hev x]
  set acc := elim n ns (initStats n b, []) with hacc
  have hinv : ∀ y : Fin n → Bool,
      Inv n (List.ofFn y) (wiresFrom ns (List.ofFn (Fin.snoc y b : Fin (n + 1) → Bool))) acc := by
    intro y
    rw [ofFn_snoc]
    exact inv_elim n _ (by simp) ns _ _ (fun g hg => (hnok g hg).1) (inv_init n b y)
  have hval : ∀ y : Fin n → Bool,
      (acc.1.getD o (Stat.const false)).val (wiresFrom acc.2 (List.ofFn y)) = f (Fin.snoc y b) := by
    intro y
    rw [((hinv y).2 o).2, hevg]
  cases hst : acc.1.getD o (Stat.const false) with
  | const c =>
    exfalso
    obtain ⟨y, y', hne⟩ := hnc
    apply hne
    rw [← hval y, ← hval y', hst]; rfl
  | wire j =>
    refine ⟨⟨acc.2, j⟩, ?_, le_refl _, ?_⟩
    · intro g hg
      exact elim_ok n ns (initStats n b, []) (by simp) g hg
    · intro y
      have hv := hval y
      rw [hst] at hv
      exact hv

theorem get_one (L : List Gate) (g0 g1 : Gate) (rest : List Gate) (hL : L = g0 :: g1 :: rest)
    (k : Fin L.length) (hk : k.val = 1) : L.get k = g1 := by
  subst hL
  obtain ⟨i, hi⟩ := k
  simp only at hk
  subst hk
  rfl

theorem get_mem_rest (L : List Gate) (g0 g1 : Gate) (rest : List Gate) (hL : L = g0 :: g1 :: rest)
    (k : Fin L.length) (hk : 2 ≤ k.val) : L.get k ∈ rest := by
  subst hL
  obtain ⟨i, hi⟩ := k
  obtain ⟨j, rfl⟩ : ∃ j, i = j + 2 := ⟨i - 2, by simp only at hk; omega⟩
  simp

theorem mem_norm_rel (σ : Fin 9 → Fin 9) (g : Gate) (W : ℕ) (hW : 9 ≤ W) (hin : W ∈ g.inputs)
    (hnot : g.op = GateOp.not → g.inputs.length ≤ 1) : W ∈ (normGate (relGate 9 9 σ g)).inputs := by
  have hw : wmap 9 9 σ W = W := by
    unfold wmap
    rw [dif_neg (by omega)]
    omega
  obtain ⟨op, ins⟩ := g
  have hmem : W ∈ ins.map (wmap 9 9 σ) := by
    have := List.mem_map_of_mem (f := wmap 9 9 σ) hin
    rwa [hw] at this
  cases op with
  | not =>
    have hl : ins.length ≤ 1 := hnot rfl
    rcases ins with _ | ⟨a, _ | ⟨b, l⟩⟩
    · simp at hin
    · simpa [normGate, relGate] using hmem
    · simp at hl
  | _ => simpa [normGate, relGate] using hmem

