              (Nat.add (Nat.shiftRight (cx w) (nat_lit 0)) e :: ih (nx w))
              (Nat.ble (nat_lit 15) (Nat.land w (nat_lit 15))))
            (Nat.ble (nat_lit 9) (Nat.land w (nat_lit 15))))
          (Nat.ble (nat_lit 6) (Nat.land w (nat_lit 15))))
        rest (Nat.beq w (nat_lit 1)))
