  have htk : t < 13 := by have := hm0.size.2; omega
  have hM : ∃ M : List (ℕ × ℕ), mFull M = true ∧ ∀ p ∈ M, chkX CB CB1 [] rt 0 12 t p.1 p.2 = false := by
