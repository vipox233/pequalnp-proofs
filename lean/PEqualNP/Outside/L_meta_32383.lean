open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
section circuit
variable (m : ℕ)
def gv (w : List ℕ) (g : Gate) : ℕ := match g.op, g.inputs with
  | .and, [] => m
  | .and, [i] => w.getD i 0
  | .and, i :: j :: _ => w.getD i 0 &&& w.getD j 0
  | .or, [] => 0
  | .or, [i] => w.getD i 0
  | .or, i :: j :: _ => w.getD i 0 ||| w.getD j 0
  | .not, [] => m
  | .not, i :: _ => w.getD i 0 ^^^ m
  | _, _ => 0
def ex (gs : List Gate) (w : List ℕ) : List ℕ := gs.foldl (fun w g => w ++ [gv m w g]) w
lemma getD_mem {S : Set ℕ} {w : List ℕ} (hw : ∀ x ∈ w, x ∈ S) (h0 : 0 ∈ S) (i : ℕ) : w.getD i 0 ∈ S := by
  rw [List.getD_eq_getElem?_getD]
  by_cases h : i < w.length
  · rw [List.getElem?_eq_getElem h]; exact hw _ (List.getElem_mem h)
  · rw [List.getElem?_eq_none (by omega)]; exact h0
lemma ex_sol {T : ℕ} (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ), (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (∃ i, (ex m gs w).getD i 0 = T) → Sol Z0 m T gs.length S := by
  induction gs with
  | nil =>
    rintro w S hw h0 _ _ ⟨i, rfl⟩
    exact .done (getD_mem hw h0 i)
  | cons g gs ih =>
    intro w S hw h0 hm hg hT
    have hgs := fun x hx => hg x (List.mem_cons_of_mem _ hx)
    have rd := fun i => getD_mem hw h0 i
    have stay : gv m w g ∈ S → Sol Z0 m T (g :: gs).length S := fun h =>
      (ih (w ++ [gv m w g]) S (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact hw x hx
        · exact h) h0 hm hgs hT).mono (by simp) subset_rfl
    have go : Sol Z0 m T gs.length (insert (gv m w g) S) := ih (w ++ [gv m w g]) _ (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact Or.inr (hw x hx)
        · exact Or.inl rfl) (Or.inr h0) (Or.inr hm) hgs hT
    obtain ⟨hop, hlen⟩ := hg g List.mem_cons_self
    obtain ⟨o, l⟩ := g
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
    rcases hop with rfl | rfl | rfl
    · match l with
      | [] => exact stay hm
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact .bi (d := false) (rd i) (rd j) (al0 _ _ _) go
    · match l with
      | [] => exact stay h0
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact .bi (d := true) (rd i) (rd j) (al0 _ _ _) go
    · match l with
      | [] => exact stay hm
      | i :: _ => exact .un (rd i) go
lemma gv_sub {w : List ℕ} (hw : ∀ x ∈ w, x &&& m = x) (g : Gate) : gv m w g &&& m = gv m w g := by
  have rd : ∀ i, w.getD i 0 &&& m = w.getD i 0 := fun i => getD_mem (S := {x | x &&& m = x}) hw (by simp) i
  unfold gv
  split
  · simp
  · exact rd _
  · rw [Nat.and_assoc, rd]
  · simp
  · exact rd _
  · rw [Nat.and_or_distrib_right, rd, rd]
  · simp
  · rw [and_neg (Nat.and_self m), rd]
  · simp
lemma ex_sub {gs : List Gate} : ∀ {w : List ℕ}, (∀ x ∈ w, x &&& m = x) → ∀ x ∈ ex m gs w, x &&& m = x := by
  induction gs with
  | nil => intro w hw; exact hw
  | cons g gs ih =>
    intro w hw
    refine ih (w := w ++ [gv m w g]) fun x hx => ?_
    simp only [List.mem_append, List.mem_singleton] at hx
    rcases hx with hx | rfl
    · exact hw x hx
    · exact gv_sub m hw g
lemma getD_map (w : List ℕ) (b i : ℕ) : (w.map (fun x => x.testBit b)).getD i false = (w.getD i 0).testBit b := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases w[i]? <;> simp
lemma gv_bit {b : ℕ} (hb : m.testBit b = true) (w : List ℕ) (g : Gate)
    (hg : g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) :
    (gv m w g).testBit b = g.op.eval (g.inputs.map fun i => (w.map (fun x => x.testBit b)).getD i false) := by
  have e1 : ∀ l, GateOp.and.eval l = l.all id := fun _ => rfl
  have e2 : ∀ l, GateOp.or.eval l = l.any id := fun _ => rfl
  have e3 : ∀ l, GateOp.not.eval l = !(l.headD false) := fun _ => rfl
  obtain ⟨o, l⟩ := g
  obtain ⟨hop, hlen⟩ := hg
  simp only [getD_map]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
  simp only at hlen
  rcases hop with rfl | rfl | rfl
  · match l, hlen with
    | [], _ => simp [gv, e1, hb]
    | [i], _ => simp [gv, e1]
    | [i, j], _ => simp [gv, e1]
  · match l, hlen with
    | [], _ => simp [gv, e2]
    | [i], _ => simp [gv, e2]
    | [i, j], _ => simp [gv, e2]
  · match l, hlen with
    | [], _ => simp [gv, e3, hb]
    | [i], _ => simp [gv, e3, hb]
    | [i, j], _ => simp [gv, e3, hb]
lemma ex_bit {b : ℕ} (hb : m.testBit b = true) (gs : List Gate) : ∀ (w : List ℕ),
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (ex m gs w).map (fun x => x.testBit b) =
      gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (w.map (fun x => x.testBit b)) := by
  induction gs with
  | nil => intro w _; rfl
  | cons g gs ih =>
    intro w hg
    rw [List.foldl_cons, ← gv_bit m hb w g (hg g List.mem_cons_self)]
    have := ih (w ++ [gv m w g]) (fun x hx => hg x (List.mem_cons_of_mem _ hx))
    rw [List.map_append] at this
    exact this
end circuit
def f (x : Fin 7 → Bool) : Bool := (x 0 && x 3) || (x 1 && x 3) || (x 0 && x 4) || (x 1 && x 4) || (x 2 && x 4) || (x 0 && x 5) || (x 2 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6) || (x 5 && x 6)
def EF : ℕ := ((((((((((((((rawP.getD 0 0 &&& rawP.getD 3 0) ||| (rawP.getD 1 0 &&& rawP.getD 3 0)) ||| (rawP.getD 0 0 &&& rawP.getD 4 0)) ||| (rawP.getD 1 0 &&& rawP.getD 4 0)) ||| (rawP.getD 2 0 &&& rawP.getD 4 0)) ||| (rawP.getD 0 0 &&& rawP.getD 5 0)) ||| (rawP.getD 2 0 &&& rawP.getD 5 0)) ||| (rawP.getD 3 0 &&& rawP.getD 5 0)) ||| (rawP.getD 0 0 &&& rawP.getD 6 0)) ||| (rawP.getD 1 0 &&& rawP.getD 6 0)) ||| (rawP.getD 2 0 &&& rawP.getD 6 0)) ||| (rawP.getD 3 0 &&& rawP.getD 6 0)) ||| (rawP.getD 4 0 &&& rawP.getD 6 0)) ||| (rawP.getD 5 0 &&& rawP.getD 6 0))
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma EF_ok : EF &&& mz 0 = tz 0 := by decide +kernel
lemma rawP_len : rawP.length = 7 := rfl
lemma row_list (b : ℕ) : List.ofFn (fun v : Fin 7 => (rawP.getD v.val 0).testBit b) = rawP.map (fun x => x.testBit b) := by
  apply List.ext_getElem
  · simp [rawP_len]
  · intro i h1 h2
    have : i < rawP.length := by simpa using h2
    rw [List.getElem_ofFn, List.getElem_map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem this]; rfl
lemma f_bit (k : ℕ) : EF.testBit k = f (fun v : Fin 7 => (rawP.getD v.val 0).testBit k) := by
  simp only [f, EF, Nat.testBit_or, Nat.testBit_and]
  rfl
theorem bridge (D : PEqualNP.CircuitLowerBounds.Circuit) (hD : PEqualNP.MetaComplexity.FanInTwo D)
    (hf : ∀ y : Fin 7 → Bool, D.eval (List.ofFn y) = f y) :
    Sol Z0 (mz 0) (tz 0) D.size (C (mz 0) (WZ [] 0)) := by
  obtain ⟨gates, out⟩ := D
  let row : ℕ → Fin 7 → Bool := fun k v => (rawP.getD v.val 0).testBit k
  let init : List ℕ := rawP.map (· &&& mz 0)
  have hinit_sub : ∀ x ∈ init, x &&& mz 0 = x := by
    intro x hx
    simp only [init, List.mem_map] at hx
    obtain ⟨w, _, rfl⟩ := hx
    rw [Nat.and_assoc, Nat.and_self]
  have hinit_mem : ∀ x ∈ init, x ∈ C (mz 0) (WZ [] 0) := by
    intro x hx
    simp only [init, List.mem_map] at hx
    obtain ⟨w, hw, rfl⟩ := hx
    exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
  have hinit_bits : ∀ k, (mz 0).testBit k = true → init.map (fun x => x.testBit k) = List.ofFn (row k) := by
    intro k hk
    simp only [init, List.map_map, Function.comp_def, Nat.testBit_and, hk, Bool.and_true]
    rw [row_list]
  have hout : (ex (mz 0) gates init).getD out 0 = tz 0 := by
    rw [← EF_ok]
    have hsub : ∀ x ∈ ex (mz 0) gates init, x &&& mz 0 = x := ex_sub (mz 0) hinit_sub
    have hsub' := getD_mem (S := {x | x &&& mz 0 = x}) hsub (by simp) out
    apply Nat.eq_of_testBit_eq; intro k
    have e1 := congrArg (fun x => x.testBit k) hsub'
    simp only [Nat.testBit_and] at e1
    rw [← e1, Nat.testBit_and]
    cases hk : (mz 0).testBit k with
    | false => simp
    | true =>
      simp only [Bool.and_true]
      rw [← getD_map, ex_bit (mz 0) hk gates init hD, hinit_bits k hk]
      have h := hf (row k)
      change (gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
        (List.ofFn (row k))).getD out false = f (row k) at h
      rw [h]
      exact (f_bit k).symm
  exact ex_sol (mz 0) gates init (C (mz 0) (WZ [] 0))
    hinit_mem (Or.inr (Set.mem_insert _ _)) (Or.inr (Set.mem_insert_of_mem _ rfl))
    hD ⟨out, hout⟩

lemma ex_live0 {T : ℕ} (m : ℕ) (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ),
    (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2) →
    (∃ i, (ex m gs w).getD i 0 = T) →
    ∃ k ≤ gs.length, ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ S ∧ Live Z0 m T k 0 S0 := by
  induction gs with
  | nil =>
    rintro w S hw h0 _ _ ⟨i, rfl⟩
    exact ⟨0, le_rfl, {w.getD i 0}, by simpa using getD_mem hw h0 i, .stop⟩
  | cons g gs ih =>
    intro w S hw h0 hm hg hT
    have rd := fun i => getD_mem hw h0 i
    obtain ⟨k, hk, S1, hS1, hl⟩ := ih (w ++ [gv m w g]) (insert (gv m w g) S) (fun x hx => by
      simp only [List.mem_append, List.mem_singleton] at hx; rcases hx with hx | rfl; exact Or.inr (hw x hx); exact Or.inl rfl)
      (Or.inr h0) (Or.inr hm) (fun x hx => hg x (List.mem_cons_of_mem _ hx)) hT
    have hlen : k ≤ (g :: gs).length := by simp; omega
    have stay : gv m w g ∈ S → ∃ k ≤ (g :: gs).length, ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ S ∧ Live Z0 m T k 0 S0 :=
      fun h => ⟨k, hlen, S1, fun x hx => (hS1 hx).elim (fun e => e ▸ h) id, hl⟩
    by_cases hz : gv m w g ∈ S1
    swap
    · exact ⟨k, hlen, S1, fun x hx => (hS1 hx).resolve_left (fun e => hz (e ▸ hx)), hl⟩
    have hbi : ∀ (d : Bool) (i j : ℕ), gv m w g = op d (w.getD i 0) (w.getD j 0) →
        ∃ k ≤ (g :: gs).length, ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ S ∧ Live Z0 m T k 0 S0 := by
      intro d i j he
      by_cases hab : w.getD i 0 = w.getD j 0
      · exact stay (by rw [he, hab, op_self]; exact rd j)
      rw [he] at hz hS1
      refine ⟨k + 1, by simp; omega, insert (w.getD i 0) (insert (w.getD j 0) (S1.erase (op d (w.getD i 0) (w.getD j 0)))), ?_,
        Live.bi hab (al0 _ _ _) (by rwa [Finset.insert_erase hz])⟩
      intro x hx; simp at hx; rcases hx with rfl | rfl | ⟨h1, h2⟩; exact rd i; exact rd j; exact (hS1 h1).resolve_left h2
    obtain ⟨hop, -⟩ := hg g List.mem_cons_self
    obtain ⟨o, l⟩ := g
    simp only at hop
    rcases hop with rfl | rfl
    · match l with
      | [] => exact stay hm
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact hbi false i j rfl
    · match l with
      | [] => exact stay h0
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact hbi true i j rfl

lemma ex_sol_one {T : ℕ} (m : ℕ) (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ),
    (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    gs.Pairwise (fun a b => a.op = GateOp.not → b.op ≠ GateOp.not) →
    (∃ g ∈ gs, g.op = GateOp.not) →
    (∃ i, (ex m gs w).getD i 0 = T) →
    Sol Z0 m T (gs.length - 1) S ∨ ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ S ∧ Live Z0 m T gs.length 1 S0 := by
  induction gs with
  | nil => intro _ _ _ _ _ _ _ hnot; simp at hnot
  | cons g gs ih =>
    intro w S hw h0 hm hg hP hnot hT
    have hgs := fun x hx => hg x (List.mem_cons_of_mem _ hx)
    have rd := fun i => getD_mem hw h0 i
    have hwm_stay : gv m w g ∈ S → ∀ x ∈ w ++ [gv m w g], x ∈ S := fun h x hx => by
      simp only [List.mem_append, List.mem_singleton] at hx; rcases hx with hx | rfl; exact hw x hx; exact h
    have hwm_ins : ∀ x ∈ w ++ [gv m w g], x ∈ insert (gv m w g) S := fun x hx => by
      simp only [List.mem_append, List.mem_singleton] at hx; rcases hx with hx | rfl; exact Or.inr (hw x hx); exact Or.inl rfl
    have hnot' : g.op ≠ GateOp.not → ∃ g' ∈ gs, g'.op = GateOp.not := fun hg' => by
      obtain ⟨g', hm', ho⟩ := hnot
      rcases List.mem_cons.1 hm' with rfl | hm'
      · exact absurd ho hg'
      · exact ⟨g', hm', ho⟩
    have hbi : ∀ (d : Bool) (i j : ℕ), g.op ≠ GateOp.not → gv m w g = op d (w.getD i 0) (w.getD j 0) →
        Sol Z0 m T ((g :: gs).length - 1) S ∨ ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ S ∧ Live Z0 m T (g :: gs).length 1 S0 := by
      intro d i j hgn he
      have hn := hnot' hgn
      rcases ih (w ++ [gv m w g]) (insert (gv m w g) S) hwm_ins (Or.inr h0) (Or.inr hm) hgs hP.of_cons hn hT with hs | ⟨S1, hS1, hl1⟩
      · rw [he] at hs
        exact Or.inl ((Sol.bi (d := d) (rd i) (rd j) (al0 _ _ _) hs).mono (by cases gs <;> simp at hn ⊢) subset_rfl)
      rw [he] at hS1
      by_cases hz : op d (w.getD i 0) (w.getD j 0) ∈ S1
      · by_cases hab : w.getD i 0 = w.getD j 0
        · have hsub : (S1 : Set ℕ) ⊆ S := fun x hx => (hS1 hx).elim (fun e => by subst e; rw [hab, op_self]; exact rd j) id
          exact Or.inl (hl1.sol.mono (by cases gs <;> simp at hn ⊢) hsub)
        · refine Or.inr ⟨insert (w.getD i 0) (insert (w.getD j 0) (S1.erase (op d (w.getD i 0) (w.getD j 0)))), ?_, Live.bi hab (al0 _ _ _) (by rwa [Finset.insert_erase hz])⟩
          intro x hx; simp at hx; rcases hx with rfl | rfl | ⟨h1, h2⟩; exact rd i; exact rd j; exact (hS1 h1).resolve_left h2
      · exact Or.inl (hl1.sol.mono (by cases gs <;> simp at hn ⊢) (fun x hx => (hS1 hx).resolve_left (fun e => hz (e ▸ hx))))
    obtain ⟨hop, -⟩ := hg g List.mem_cons_self
    obtain ⟨o, l⟩ := g
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
    rcases hop with rfl | rfl | rfl
    · match l with
      | [] => exact Or.inl (ex_sol m gs (w ++ [gv m w ⟨.and, []⟩]) S (hwm_stay hm) h0 hm hgs hT)
      | [i] => exact Or.inl (ex_sol m gs (w ++ [gv m w ⟨.and, [i]⟩]) S (hwm_stay (rd i)) h0 hm hgs hT)
      | i :: j :: _ => exact hbi false i j (by simp) rfl
    · match l with
      | [] => exact Or.inl (ex_sol m gs (w ++ [gv m w ⟨.or, []⟩]) S (hwm_stay h0) h0 hm hgs hT)
      | [i] => exact Or.inl (ex_sol m gs (w ++ [gv m w ⟨.or, [i]⟩]) S (hwm_stay (rd i)) h0 hm hgs hT)
      | i :: j :: _ => exact hbi true i j (by simp) rfl
    · have hfree : ∀ b ∈ gs, (b.op = GateOp.and ∨ b.op = GateOp.or) ∧ b.inputs.length ≤ 2 := fun b hb => by
        obtain ⟨ho, hl⟩ := hgs b hb
        have hn : b.op ≠ GateOp.not := List.rel_of_pairwise_cons hP hb rfl
        simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ho
        exact ⟨ho.elim Or.inl fun h => h.elim Or.inr fun h => absurd h hn, hl⟩
      match l with
      | [] => exact Or.inl (ex_sol m gs (w ++ [gv m w ⟨.not, []⟩]) S (hwm_stay hm) h0 hm hgs hT)
      | i :: _ =>
        obtain ⟨k, hk, S1, hS1, hl1⟩ := ex_live0 m gs (w ++ [gv m w ⟨.not, i :: _⟩]) (insert (w.getD i 0 ^^^ m) S) hwm_ins (Or.inr h0) (Or.inr hm) hfree hT
        by_cases hz : w.getD i 0 ^^^ m ∈ S1
        · have hsub : ((insert (w.getD i 0) (S1.erase (w.getD i 0 ^^^ m)) : Finset ℕ) : Set ℕ) ⊆ S := by
            intro x hx; simp at hx; rcases hx with rfl | ⟨h1, h2⟩; exact rd i; exact (hS1 h1).resolve_left h2
          have hlu : Live Z0 m T (k + 1) 1 (insert (w.getD i 0) (S1.erase (w.getD i 0 ^^^ m))) := Live.un (by rwa [Finset.insert_erase hz])
          by_cases hkeq : k = gs.length
          · subst hkeq; exact Or.inr ⟨_, hsub, hlu⟩
          · exact Or.inl (hlu.sol.mono (by simp; omega) hsub)
        · exact Or.inl (hl1.sol.mono (by simp; omega) (fun x hx => (hS1 hx).resolve_left (fun e => hz (e ▸ hx))))

theorem bridge_one (gates : List Gate) (o : ℕ) (hD : FanInTwo ⟨gates, o⟩)
    (hP : gates.Pairwise (fun a b => a.op = GateOp.not → b.op ≠ GateOp.not)) (hnot : ∃ g ∈ gates, g.op = GateOp.not)
    (hf : ∀ y : Fin 7 → Bool, Circuit.eval ⟨gates, o⟩ (List.ofFn y) = f y) :
    Sol Z0 (mz 0) (tz 0) (gates.length - 1) (C (mz 0) (WZ [] 0)) ∨
    ∃ S0 : Finset ℕ, (S0 : Set ℕ) ⊆ C (mz 0) (WZ [] 0) ∧ Live Z0 (mz 0) (tz 0) gates.length 1 S0 := by
  let row : ℕ → Fin 7 → Bool := fun k v => (rawP.getD v.val 0).testBit k
  let init : List ℕ := rawP.map (· &&& mz 0)
  have hinit_sub : ∀ x ∈ init, x &&& mz 0 = x := by intro x hx; simp only [init, List.mem_map] at hx; obtain ⟨w, _, rfl⟩ := hx; rw [Nat.and_assoc, Nat.and_self]
  have hinit_mem : ∀ x ∈ init, x ∈ C (mz 0) (WZ [] 0) := by intro x hx; simp only [init, List.mem_map] at hx; obtain ⟨w, hw, rfl⟩ := hx; exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
  have hinit_bits : ∀ k, (mz 0).testBit k = true → init.map (fun x => x.testBit k) = List.ofFn (row k) := by intro k hk; simp only [init, List.map_map, Function.comp_def, Nat.testBit_and, hk, Bool.and_true]; rw [row_list]
  have hout : (ex (mz 0) gates init).getD o 0 = tz 0 := by
    rw [← EF_ok]
    have hsub : ∀ x ∈ ex (mz 0) gates init, x &&& mz 0 = x := ex_sub (mz 0) hinit_sub
    have hsub' := getD_mem (S := {x | x &&& mz 0 = x}) hsub (by simp) o
    apply Nat.eq_of_testBit_eq; intro k
    have e1 := congrArg (fun x => x.testBit k) hsub'
    simp only [Nat.testBit_and] at e1; rw [← e1, Nat.testBit_and]
    cases hk : (mz 0).testBit k with
    | false => simp
    | true =>
      simp only [Bool.and_true]; rw [← getD_map, ex_bit (mz 0) hk gates init hD, hinit_bits k hk]
      have h := hf (row k)
      change (gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (List.ofFn (row k))).getD o false = f (row k) at h
      rw [h]; exact (f_bit k).symm
  exact ex_sol_one (mz 0) gates init (C (mz 0) (WZ [] 0)) hinit_mem (Or.inr (Set.mem_insert _ _)) (Or.inr (Set.mem_insert_of_mem _ rfl)) hD hP hnot ⟨o, hout⟩

def gateIsNot (g : Gate) : Bool :=
  match g.op with
  | .not => true
  | _ => false

theorem notPairwise {gates : List Gate} :
    gates.countP gateIsNot ≤ 1 →
    gates.Pairwise (fun a b => a.op = GateOp.not → b.op ≠ GateOp.not) := by
  induction gates with
  | nil => simp
  | cons g rest ih =>
    intro count
    have tailCount : rest.countP gateIsNot ≤ 1 := by
      have expanded := count
      rw [List.countP_cons] at expanded
      omega
    refine List.pairwise_cons.mpr ⟨?_, ih tailCount⟩
    intro a ha gIsNot aIsNot
    have tailPositive : 0 < rest.countP gateIsNot :=
      List.countP_pos_iff.mpr ⟨a, ha, by simp [gateIsNot, aIsNot]⟩
    have marked : gateIsNot g := by simp [gateIsNot, gIsNot]
    rw [List.countP_cons_of_pos marked] at count
    omega

theorem sevenFloor (base : Imp [] 0 13) (D : Circuit) (legal : FanInTwo D)
    (computes : ∀ x : Fin 7 → Bool, D.eval (List.ofFn x) = f x) :
    13 ≤ D.gates.length := by
  by_contra! short
  exact base D.gates.length short (bridge D legal computes)

theorem sevenWithNotFloor (base : Imp [] 0 13)
    (one : ∀ {S : Finset ℕ}, (S : Set ℕ) ⊆ C (mz 0) (WZ [] 0) →
      Live Z0 (mz 0) (tz 0) 13 1 S → False)
    (D : Circuit) (legal : FanInTwo D)
    (computes : ∀ x : Fin 7 → Bool, D.eval (List.ofFn x) = f x)
    (count : D.gates.countP gateIsNot = 1) :
    14 ≤ D.gates.length := by
  obtain ⟨gates, output⟩ := D
  change gates.countP gateIsNot = 1 at count
  change 14 ≤ gates.length
  have atLeast : 13 ≤ gates.length := sevenFloor base ⟨gates, output⟩ legal computes
  by_contra! short
  have size : gates.length = 13 := by omega
  have unique := notPairwise (gates := gates) (by omega : gates.countP gateIsNot ≤ 1)
  have pos : 0 < gates.countP gateIsNot := by omega
  obtain ⟨g, hg, hnot⟩ := List.countP_pos_iff.mp pos
  have present : ∃ g ∈ gates, g.op = GateOp.not := by
    refine ⟨g, hg, ?_⟩
    cases g with
    | mk op inputs => cases op <;> simp_all [gateIsNot]
  rcases bridge_one gates output legal unique present computes with smaller | ⟨S, subset, live⟩
  · exact base (gates.length - 1) (by omega) smaller
  · rw [size] at live
    exact one subset live

end Core

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

namespace CircuitProof

open PEqualNP.CircuitLowerBounds

def wiresFrom (gs : List Gate) (w : List Bool) : List Bool :=
  gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) w

theorem wiresFrom_append (gs gs' : List Gate) (w : List Bool) :
    wiresFrom (gs ++ gs') w = wiresFrom gs' (wiresFrom gs w) := by
  simp [wiresFrom, List.foldl_append]

theorem wiresFrom_prefix (gs : List Gate) : ∀ w : List Bool,
    ∃ t : List Bool, wiresFrom gs w = w ++ t ∧ t.length = gs.length := by
  induction gs with
  | nil => intro w; exact ⟨[], by simp [wiresFrom], rfl⟩
  | cons g gs ih =>
    intro w
    obtain ⟨t, ht, hl⟩ := ih (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
    refine ⟨g.op.eval (g.inputs.map fun i => w.getD i false) :: t, ?_, by simp [hl]⟩
    have : wiresFrom (g :: gs) w
        = wiresFrom gs (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) := rfl
    rw [this, ht]; simp

theorem length_wiresFrom (gs : List Gate) (w : List Bool) :
    (wiresFrom gs w).length = w.length + gs.length := by
  obtain ⟨t, ht, hl⟩ := wiresFrom_prefix gs w
  rw [ht]; simp [hl]

def Ok (g : Gate) : Prop :=
  g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2

end CircuitProof

namespace CircuitProof

open PEqualNP.CircuitLowerBounds

variable {n : ℕ}

theorem getD_snoc_ne {α : Type} (L : List α) (S d : α) (j : ℕ) (h : j ≠ L.length) :
    (L ++ [S]).getD j d = L.getD j d := by
  by_cases hj : j < L.length
  · exact List.getD_append _ _ _ _ hj
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by omega)]

theorem getD_snoc_eq {α : Type} (L : List α) (S d : α) : (L ++ [S]).getD L.length d = S := by
  simp

end CircuitProof

namespace CircuitProof

open PEqualNP.CircuitLowerBounds

def NOk (g : Gate) : Prop := Ok g ∧ (g.op = GateOp.not → g.inputs.length ≤ 1)

abbrev Stat := Sum Bool ℕ

def Stat.val (w : List Bool) : Stat → Bool
  | Sum.inl c => c
  | Sum.inr j => w.getD j false

def Stat.Valid (m : ℕ) : Stat → Prop
  | Sum.inl _ => True
  | Sum.inr j => j < m

def simpNot (m : ℕ) : List Stat → Option Gate × Stat
  | [] => (none, Sum.inl true)
  | Sum.inl c :: _ => (none, Sum.inl (!c))
  | Sum.inr j :: _ => (some ⟨GateOp.not, [j]⟩, Sum.inr m)

def simpAnd (m : ℕ) : List Stat → Option Gate × Stat
  | [] => (none, Sum.inl true)
  | [Sum.inl c] => (none, Sum.inl c)
  | [Sum.inr j] => (none, Sum.inr j)
  | [Sum.inl c, Sum.inl d] => (none, Sum.inl (c && d))
  | [Sum.inl c, Sum.inr j] => (none, bif c then Sum.inr j else Sum.inl false)
  | [Sum.inr j, Sum.inl c] => (none, bif c then Sum.inr j else Sum.inl false)
  | [Sum.inr j, Sum.inr k] => (some ⟨GateOp.and, [j, k]⟩, Sum.inr m)
  | _ => (none, Sum.inl false)

def simpOr (m : ℕ) : List Stat → Option Gate × Stat
  | [] => (none, Sum.inl false)
  | [Sum.inl c] => (none, Sum.inl c)
  | [Sum.inr j] => (none, Sum.inr j)
  | [Sum.inl c, Sum.inl d] => (none, Sum.inl (c || d))
  | [Sum.inl c, Sum.inr j] => (none, bif c then Sum.inl true else Sum.inr j)
  | [Sum.inr j, Sum.inl c] => (none, bif c then Sum.inl true else Sum.inr j)
  | [Sum.inr j, Sum.inr k] => (some ⟨GateOp.or, [j, k]⟩, Sum.inr m)
  | _ => (none, Sum.inl false)

def simplify (op : GateOp) (m : ℕ) (ins : List Stat) : Option Gate × Stat :=
  match op with
  | GateOp.and => simpAnd m ins
  | GateOp.or => simpOr m ins
  | GateOp.not => simpNot m ins
  | _ => (none, Sum.inl false)

theorem simplify_sound (op : GateOp) (hop : op = GateOp.and ∨ op = GateOp.or ∨ op = GateOp.not)
    (w : List Bool) (ins : List Stat) (hlen : ins.length ≤ 2)
    (hv : ∀ s ∈ ins, Stat.Valid w.length s) :
    Stat.Valid (w.length + (simplify op w.length ins).1.toList.length) (simplify op w.length ins).2 ∧
    Stat.val (wiresFrom (simplify op w.length ins).1.toList w) (simplify op w.length ins).2
      = op.eval (ins.map (Stat.val w)) := by
  rcases hop with rfl | rfl | rfl
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
    · simp [simplify, simpAnd, Stat.Valid, Stat.val, GateOp.eval]
    · cases a <;> simp_all [simplify, simpAnd, Stat.Valid, Stat.val, GateOp.eval, wiresFrom]
    · cases a <;> cases b <;> (try rename_i c e; cases c) <;> (try cases e) <;>
        simp_all [simplify, simpAnd, Stat.Valid, Stat.val, GateOp.eval, wiresFrom]
    · simp at hlen
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
    · simp [simplify, simpOr, Stat.Valid, Stat.val, GateOp.eval]
    · cases a <;> simp_all [simplify, simpOr, Stat.Valid, Stat.val, GateOp.eval, wiresFrom]
    · cases a <;> cases b <;> (try rename_i c e; cases c) <;> (try cases e) <;>
        simp_all [simplify, simpOr, Stat.Valid, Stat.val, GateOp.eval, wiresFrom]
    · simp at hlen
  · rcases ins with _ | ⟨a, l⟩
    · simp [simplify, simpNot, Stat.Valid, Stat.val, GateOp.eval]
    · cases a <;> simp_all [simplify, simpNot, Stat.Valid, Stat.val, GateOp.eval, wiresFrom]

def elimStep (n : ℕ) (acc : List Stat × List Gate) (g : Gate) : List Stat × List Gate :=
  (acc.1 ++ [(simplify g.op (n + acc.2.length)
      (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).2],
    acc.2 ++ (simplify g.op (n + acc.2.length)
      (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1.toList)

def elim (n : ℕ) (gs : List Gate) (acc : List Stat × List Gate) : List Stat × List Gate :=
  gs.foldl (elimStep n) acc

theorem Stat.valid_mono {m m' : ℕ} (h : m ≤ m') : ∀ s : Stat, Stat.Valid m s → Stat.Valid m' s
  | Sum.inl _, _ => trivial
  | Sum.inr _, hj => lt_of_lt_of_le hj h

theorem Stat.val_append (w t : List Bool) : ∀ s : Stat, Stat.Valid w.length s →
    Stat.val (w ++ t) s = Stat.val w s
  | Sum.inl _, _ => rfl
  | Sum.inr _, hj => List.getD_append _ _ _ _ hj

def Inv (n : ℕ) (y : List Bool) (w : List Bool) (acc : List Stat × List Gate) : Prop :=
  acc.1.length = w.length ∧ ∀ i : ℕ,
    Stat.Valid (n + acc.2.length) (acc.1.getD i (Sum.inl false)) ∧
    Stat.val (wiresFrom acc.2 y) (acc.1.getD i (Sum.inl false)) = w.getD i false

theorem inv_elim (n : ℕ) (y : List Bool) (hy : y.length = n) (gs : List Gate) :
    ∀ (w : List Bool) (acc : List Stat × List Gate), (∀ g ∈ gs, Ok g) → Inv n y w acc →
      Inv n y (wiresFrom gs w) (elim n gs acc) := by
  induction gs with
  | nil => intro w acc _ h; exact h
  | cons g gs ih =>
    intro w acc hok h
    apply ih (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (elimStep n acc g)
      (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg'))
    obtain ⟨hl, hi⟩ := h
    set w' := wiresFrom acc.2 y with hw'
    have lw' : w'.length = n + acc.2.length := by rw [hw', length_wiresFrom, hy]
    set ins := g.inputs.map fun i => acc.1.getD i (Sum.inl false) with hins
    have hgok := hok g List.mem_cons_self
    have hs := simplify_sound g.op hgok.1 w' ins (by simpa [hins] using hgok.2)
      (by
        intro s hs
        obtain ⟨a, _, rfl⟩ := List.mem_map.1 hs
        rw [lw']; exact (hi a).1)
    rw [lw'] at hs
    set r := simplify g.op (n + acc.2.length) ins with hr
    have hvals : ins.map (Stat.val w') = g.inputs.map fun i => w.getD i false := by
      rw [hins, List.map_map]
      apply List.map_congr_left
      intro a _
      exact (hi a).2
    have hnew : wiresFrom (acc.2 ++ r.1.toList) y = wiresFrom r.1.toList w' := by
      rw [wiresFrom_append]
    obtain ⟨t, ht, htl⟩ := wiresFrom_prefix r.1.toList w'
    refine ⟨by simp [elimStep, hl], ?_⟩
    intro i
    show Stat.Valid (n + (acc.2 ++ r.1.toList).length) ((acc.1 ++ [r.2]).getD i (Sum.inl false)) ∧
      Stat.val (wiresFrom (acc.2 ++ r.1.toList) y) ((acc.1 ++ [r.2]).getD i (Sum.inl false)) = _
    rw [hnew, List.length_append, ← Nat.add_assoc]
    by_cases hil : i = acc.1.length
    · subst hil
      rw [getD_snoc_eq, hl, getD_snoc_eq]
      exact ⟨hs.1, by rw [hs.2, hvals]⟩
    · rw [getD_snoc_ne _ _ _ _ hil, getD_snoc_ne _ _ _ _ (by omega)]
      refine ⟨Stat.valid_mono (by omega) _ (hi i).1, ?_⟩
      rw [ht, Stat.val_append _ _ _ (by rw [lw']; exact (hi i).1)]
      exact (hi i).2

def isNotGate (op : GateOp) : Bool :=
  match op with
  | .not => true
  | _ => false

def opCount (test : GateOp → Bool) (gs : List Gate) : ℕ :=
  gs.countP (fun g => test g.op)

lemma simplify_same_op (op : GateOp) (m : ℕ) (ins : List Stat) :
    ∀ g ∈ (simplify op m ins).1, g.op = op := by
  intro g hg
  cases op <;> simp only [simplify] at hg
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpAnd] at hg <;> (subst hg; rfl)
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpOr] at hg <;> (subst hg; rfl)
  · rcases ins with _ | ⟨a, l⟩ <;> (try cases a) <;>
      simp [simpNot] at hg <;> (subst hg; rfl)
  · simp at hg
  · simp at hg

lemma opCount_append (test : GateOp → Bool) (gs hs : List Gate) :
    opCount test (gs ++ hs) = opCount test gs + opCount test hs := by
  simp [opCount]

lemma opCount_cons (test : GateOp → Bool) (g : Gate) (gs : List Gate) :
    opCount test (g :: gs) = opCount test gs + (if test g.op then 1 else 0) := by
  by_cases h : test g.op <;> simp [opCount, h]

lemma simplify_opCount_le (test : GateOp → Bool) (op : GateOp) (m : ℕ) (ins : List Stat) :
    opCount test (simplify op m ins).1.toList ≤ (if test op then 1 else 0) := by
  cases h : (simplify op m ins).1 with
  | none => simp [opCount]
  | some g =>
    have hg : g ∈ (simplify op m ins).1 := by simp [h]
    have he := simplify_same_op op m ins g hg
    simp [h, opCount_cons, opCount, he]

lemma elim_opCount_le (test : GateOp → Bool) (n : ℕ) (gs : List Gate) :
    ∀ acc : List Stat × List Gate,
      opCount test (elim n gs acc).2 ≤ opCount test acc.2 + opCount test gs := by
  induction gs with
  | nil => intro acc; simp [elim, opCount]
  | cons g gs ih =>
    intro acc
    change opCount test (elim n gs (elimStep n acc g)).2 ≤ _
    apply (ih (elimStep n acc g)).trans
    simp only [elimStep, opCount_append, opCount_cons]
    have hb := simplify_opCount_le test g.op (n + acc.2.length)
       (g.inputs.map fun i => acc.1.getD i (Sum.inl false))
    omega

def nonNotCount (gs : List Gate) : ℕ :=
  gs.countP (fun g => !(isNotGate g.op))

lemma elim_nonNotCount (n : ℕ) (gs : List Gate) (acc : List Stat × List Gate) :
    nonNotCount (elim n gs acc).2 ≤ nonNotCount acc.2 + nonNotCount gs :=
  elim_opCount_le (fun op => !(isNotGate op)) n gs acc

end CircuitProof

namespace CircuitProof

open PEqualNP.CircuitLowerBounds

def CleanGate (m : ℕ) (g : Gate) : Prop :=
  (g.op = GateOp.not ∧ ∃ j, j < m ∧ g.inputs = [j]) ∨
  ((g.op = GateOp.and ∨ g.op = GateOp.or) ∧ ∃ j k, j < m ∧ k < m ∧ g.inputs = [j, k])

def CleanL (m : ℕ) (gs : List Gate) : Prop :=
  ∀ (p : ℕ) (g : Gate), gs[p]? = some g → CleanGate (m + p) g

theorem CleanGate.nok {m : ℕ} {g : Gate} (h : CleanGate m g) : NOk g := by
  rcases h with ⟨h1, j, _, h2⟩ | ⟨h1 | h1, j, k, _, _, h2⟩
  · refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [h1]; exact Or.inr (Or.inr rfl)
    · rw [h2]; simp
    · intro _; rw [h2]; simp
  · refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [h1]; exact Or.inl rfl
    · rw [h2]; simp
    · intro h; rw [h1] at h; cases h
  · refine ⟨⟨?_, ?_⟩, ?_⟩
    · rw [h1]; exact Or.inr (Or.inl rfl)
    · rw [h2]; simp
    · intro h; rw [h1] at h; cases h

theorem clean_nok (m : ℕ) (gs : List Gate) (h : CleanL m gs) : ∀ g ∈ gs, NOk g := by
  intro g hg
  obtain ⟨p, hp⟩ := List.mem_iff_getElem?.1 hg
  exact (h p g hp).nok

theorem simplify_clean (op : GateOp) (m : ℕ) (ins : List Stat) (hv : ∀ s ∈ ins, Stat.Valid m s) :
    ∀ g ∈ (simplify op m ins).1, CleanGate m g := by
  intro g hg
  cases op <;> simp only [simplify] at hg
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpAnd] at hg
    subst hg
    refine Or.inr ⟨Or.inl rfl, _, _, ?_, ?_, rfl⟩
    · exact hv _ List.mem_cons_self
    · exact hv _ (List.mem_cons_of_mem _ List.mem_cons_self)
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpOr] at hg
    subst hg
    refine Or.inr ⟨Or.inr rfl, _, _, ?_, ?_, rfl⟩
    · exact hv _ List.mem_cons_self
    · exact hv _ (List.mem_cons_of_mem _ List.mem_cons_self)
  · rcases ins with _ | ⟨a, l⟩ <;> (try cases a) <;> simp [simpNot] at hg
    subst hg
    refine Or.inl ⟨rfl, _, ?_, rfl⟩
    exact hv _ List.mem_cons_self
  · simp at hg
  · simp at hg

theorem toList_getElem? {α : Type} (o : Option α) (k : ℕ) (a : α)
    (h : o.toList[k]? = some a) : k = 0 ∧ a ∈ o := by
  cases o with
  | none => simp at h
  | some b =>
    cases k with
    | zero => simp at h; simp [h]
    | succ k => simp at h

theorem clean_elim (n : ℕ) (y : List Bool) (hy : y.length = n) (gs : List Gate) :
    ∀ (w : List Bool) (acc : List Stat × List Gate), (∀ g ∈ gs, Ok g) → Inv n y w acc →
      CleanL n acc.2 → CleanL n (elim n gs acc).2 := by
  induction gs with
  | nil => intro w acc _ _ h; exact h
  | cons g gs ih =>
    intro w acc hok hinv hcl
    have hinv' : Inv n y (wiresFrom [g] w) (elimStep n acc g) :=
      inv_elim n y hy [g] w acc (fun g' hg' => hok g' (by simp at hg'; simp [hg'])) hinv
    refine ih _ (elimStep n acc g) (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg')) hinv' ?_
    intro p g' hp
    have hp' : (acc.2 ++ (simplify g.op (n + acc.2.length)
        (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1.toList)[p]? = some g' := hp
    by_cases hlt : p < acc.2.length
    · rw [List.getElem?_append_left hlt] at hp'
      exact hcl p g' hp'
    · rw [List.getElem?_append_right (by omega)] at hp'
      obtain ⟨h0, hmem⟩ := toList_getElem? _ _ _ hp'
      have hpl : p = acc.2.length := by omega
      rw [hpl]
      exact simplify_clean _ _ _ (fun s hs => by
        obtain ⟨a, _, rfl⟩ := List.mem_map.1 hs
        exact (hinv.2 a).1) g' hmem

theorem getD_ofFn {α : Type} (m : ℕ) (F : Fin m → α) (d : α) (j : Fin m) :
    (List.ofFn F).getD j d = F j := by
  simp

end CircuitProof
namespace Restrict

open CircuitProof

theorem elim_snoc (n : ℕ) (A : List Gate) (g : Gate) (acc : List Stat × List Gate) :
    elim n (A ++ [g]) acc = elimStep n (elim n A acc) g := by
  simp [elim, List.foldl_append]

theorem elim_stats_length (n : ℕ) (gs : List Gate) : ∀ acc : List Stat × List Gate,
    (elim n gs acc).1.length = acc.1.length + gs.length := by
  induction gs with
  | nil => intro acc; simp [elim]
  | cons g gs ih =>
    intro acc
    have h3 : elim n (g :: gs) acc = elim n gs (elimStep n acc g) := rfl
    rw [h3, ih]
    simp [elimStep]
    omega

theorem inv_start {n n' : ℕ} (s0 : Fin n → Stat) (hv : ∀ i, Stat.Valid n' (s0 i))
    (y : Fin n' → Bool) :
    Inv n' (List.ofFn y) (List.ofFn fun i => Stat.val (List.ofFn y) (s0 i)) (List.ofFn s0, []) := by
  refine ⟨by simp, ?_⟩
  intro i
  by_cases hlt : i < n
  · have h1 : (List.ofFn s0).getD i (Sum.inl false) = s0 ⟨i, hlt⟩ :=
      getD_ofFn n s0 _ ⟨i, hlt⟩
    have h2 : (List.ofFn fun i => Stat.val (List.ofFn y) (s0 i)).getD i false
        = Stat.val (List.ofFn y) (s0 ⟨i, hlt⟩) :=
      getD_ofFn n (fun i => Stat.val (List.ofFn y) (s0 i)) _ ⟨i, hlt⟩
    show Stat.Valid (n' + ([] : List Gate).length) ((List.ofFn s0).getD i (Sum.inl false)) ∧
      Stat.val (wiresFrom [] (List.ofFn y)) ((List.ofFn s0).getD i (Sum.inl false)) = _
    rw [h1, h2]
    exact ⟨by simpa using hv ⟨i, hlt⟩, rfl⟩
  · show Stat.Valid (n' + ([] : List Gate).length) ((List.ofFn s0).getD i (Sum.inl false)) ∧
      Stat.val (wiresFrom [] (List.ofFn y)) ((List.ofFn s0).getD i (Sum.inl false)) = _
    rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega)]
    exact ⟨trivial, rfl⟩

theorem restrict_sem {n n' : ℕ} (gs : List Gate) (hok : ∀ g ∈ gs, Ok g) (s0 : Fin n → Stat)
    (hv : ∀ i, Stat.Valid n' (s0 i)) :
    CleanL n' (elim n' gs (List.ofFn s0, [])).2 ∧
    ∀ (y : Fin n' → Bool) (o : ℕ),
      Stat.val (wiresFrom (elim n' gs (List.ofFn s0, [])).2 (List.ofFn y))
        ((elim n' gs (List.ofFn s0, [])).1.getD o (Sum.inl false)) =
      (wiresFrom gs (List.ofFn fun i => Stat.val (List.ofFn y) (s0 i))).getD o false := by
  constructor
  · exact clean_elim n' (List.ofFn fun _ : Fin n' => false) (by simp) gs _ _ hok
      (inv_start s0 hv _) (by intro p g hp; simp at hp)
  · intro y o
    exact ((inv_elim n' (List.ofFn y) (by simp) gs _ _ hok (inv_start s0 hv y)).2 o).2

theorem clean_fan (n : ℕ) (gs : List Gate) (o : ℕ) (h : CleanL n gs) : FanInTwo ⟨gs, o⟩ := by
  intro g hg
  exact (clean_nok n gs h g hg).1

theorem restrict_core {n n' : ℕ} (C : Circuit) (hfan : FanInTwo C) (s0 : Fin n → Stat)
    (hv : ∀ i, Stat.Valid n' (s0 i)) (f' : (Fin n' → Bool) → Bool)
    (he : ∀ y : Fin n' → Bool,
      C.eval (List.ofFn fun i => Stat.val (List.ofFn y) (s0 i)) = f' y)
    (hnc : ∃ y y', f' y ≠ f' y') :
    ∃ C' : Circuit, FanInTwo C' ∧ opCount isNotGate C'.gates ≤ opCount isNotGate C.gates ∧
      nonNotCount C'.gates ≤ nonNotCount C.gates ∧
      ∀ y : Fin n' → Bool, C'.eval (List.ofFn y) = f' y := by
  have hok : ∀ g ∈ C.gates, Ok g := hfan
  obtain ⟨hclean, hsem⟩ := restrict_sem C.gates hok s0 hv
  have hval : ∀ y : Fin n' → Bool,
      Stat.val (wiresFrom (elim n' C.gates (List.ofFn s0, [])).2 (List.ofFn y))
        ((elim n' C.gates (List.ofFn s0, [])).1.getD C.output (Sum.inl false)) = f' y := by
    intro y
    rw [hsem y C.output, ← he y]
    rfl
  cases hst : (elim n' C.gates (List.ofFn s0, [])).1.getD C.output (Sum.inl false) with
  | inl c =>
    exfalso
    obtain ⟨y, y', hne⟩ := hnc
    apply hne
    rw [← hval y, ← hval y', hst]
    rfl
  | inr j =>
    refine ⟨⟨(elim n' C.gates (List.ofFn s0, [])).2, j⟩, clean_fan n' _ j hclean, ?_, ?_, ?_⟩
    · simpa [opCount] using elim_opCount_le isNotGate n' C.gates (List.ofFn s0, [])
    · simpa [nonNotCount] using elim_nonNotCount n' C.gates (List.ofFn s0, [])
    · intro y
      have h := hval y
      rw [hst] at h
      exact h

theorem elim_count_marked (n : ℕ) (A B : List Gate) (g : Gate) (acc : List Stat × List Gate)
    (hg : isNotGate g.op = false)
    (hnone : (simplify g.op (n + (elim n A acc).2.length)
      (g.inputs.map fun i => (elim n A acc).1.getD i (Sum.inl false))).1 = none) :
    nonNotCount (elim n (A ++ g :: B) acc).2 + 1 ≤ nonNotCount acc.2 + nonNotCount (A ++ g :: B) := by
  have h1 : elim n (A ++ g :: B) acc = elim n B (elimStep n (elim n A acc) g) := by
    simp [elim, List.foldl_append]
  have h2 := elim_nonNotCount n B (elimStep n (elim n A acc) g)
  have h3 := elim_nonNotCount n A acc
  have h4 : nonNotCount (elimStep n (elim n A acc) g).2 = nonNotCount (elim n A acc).2 := by
    show nonNotCount ((elim n A acc).2 ++ (simplify g.op (n + (elim n A acc).2.length)
      (g.inputs.map fun i => (elim n A acc).1.getD i (Sum.inl false))).1.toList) = _
    rw [hnone]
    simp
  have h5 : nonNotCount (A ++ g :: B) = nonNotCount A + nonNotCount B + 1 := by
    simp [nonNotCount, List.countP_append, List.countP_cons, hg]
    omega
  rw [h1, h5]
  omega

theorem simplify_binary_some (op : GateOp) (hop : op = GateOp.and ∨ op = GateOp.or) (m : ℕ)
    (ins : List Stat) (h : (simplify op m ins).1 ≠ none) :
    ∃ a b, ins = [Sum.inr a, Sum.inr b] := by
  rcases hop with rfl | rfl
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simplify, simpAnd] at h ⊢
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simplify, simpOr] at h ⊢

theorem simplify_not_inr (m : ℕ) (ins : List Stat) (k : ℕ)
    (h : (simplify GateOp.not m ins).2 = Sum.inr k) : ∃ a rest, ins = Sum.inr a :: rest := by
  rcases ins with _ | ⟨a, l⟩
  · simp [simplify, simpNot] at h
  · cases a with
    | inl c => simp [simplify, simpNot] at h
    | inr a => exact ⟨a, l, rfl⟩

theorem restrict_drop {n : ℕ} (C : Circuit) (hfan : FanInTwo C) (p : Fin n)
    (f : (Fin n → Bool) → Bool) (he : ∀ x : Fin n → Bool, C.eval (List.ofFn x) = f x)
    (hdep : ∃ x : Fin n → Bool, f (Function.update x p true) ≠ f (Function.update x p false))
    (hnc : ∃ x y : Fin n → Bool,
      f (Function.update x p false) ≠ f (Function.update y p false)) :
    ∃ C' : Circuit, FanInTwo C' ∧ opCount isNotGate C'.gates ≤ opCount isNotGate C.gates ∧
      nonNotCount C'.gates + 1 ≤ nonNotCount C.gates ∧
      ∀ x : Fin n → Bool, C'.eval (List.ofFn x) = f (Function.update x p false) := by
  classical
  have hok : ∀ g ∈ C.gates, Ok g := hfan
  let s0 : Fin n → Stat := fun i => if i = p then Sum.inl false else Sum.inr i.val
  have s0p : ∀ i : Fin n, i = p → s0 i = Sum.inl false := fun i h => if_pos h
  have s0n : ∀ i : Fin n, i ≠ p → s0 i = Sum.inr i.val := fun i h => if_neg h
  have hv : ∀ i, Stat.Valid n (s0 i) := by
    intro i
    by_cases h : i = p
    · rw [s0p i h]; trivial
    · rw [s0n i h]; exact i.isLt
  have hold : ∀ y : Fin n → Bool,
      (fun i => Stat.val (List.ofFn y) (s0 i)) = Function.update y p false := by
    intro y
    funext i
    by_cases h : i = p
    · rw [s0p i h, h, Function.update_self]; rfl
    · rw [s0n i h, Function.update_of_ne h]
      exact getD_ofFn n y false i
  obtain ⟨hclean, hsem⟩ := restrict_sem C.gates hok s0 hv
  have hval : ∀ y : Fin n → Bool,
      Stat.val (wiresFrom (elim n C.gates (List.ofFn s0, [])).2 (List.ofFn y))
        ((elim n C.gates (List.ofFn s0, [])).1.getD C.output (Sum.inl false))
        = f (Function.update y p false) := by
    intro y
    rw [hsem y C.output, hold y, ← he]
    rfl
  cases hst : (elim n C.gates (List.ofFn s0, [])).1.getD C.output (Sum.inl false) with
  | inl c =>
    exfalso
    obtain ⟨y, y', hne⟩ := hnc
    apply hne
    rw [← hval y, ← hval y', hst]
    rfl
  | inr jo =>
    refine ⟨⟨(elim n C.gates (List.ofFn s0, [])).2, jo⟩, clean_fan n _ jo hclean, ?_, ?_, ?_⟩
    · simpa [opCount] using elim_opCount_le isNotGate n C.gates (List.ofFn s0, [])
    swap
    · intro y
      have h := hval y
      rw [hst] at h
      exact h
    · by_cases hstrict : ∃ A g B, C.gates = A ++ g :: B ∧ isNotGate g.op = false ∧
          (simplify g.op (n + (elim n A (List.ofFn s0, [])).2.length)
            (g.inputs.map fun i => (elim n A (List.ofFn s0, [])).1.getD i (Sum.inl false))).1
              = none
      · obtain ⟨A, g, B, hsplit, hg, hnone⟩ := hstrict
        have hc := elim_count_marked n A B g (List.ofFn s0, []) hg hnone
        rw [← hsplit] at hc
        have hz : nonNotCount (([] : List Gate)) = 0 := rfl
        show nonNotCount (elim n C.gates (List.ofFn s0, [])).2 + 1 ≤ nonNotCount C.gates
        have hc' : nonNotCount (elim n C.gates (List.ofFn s0, [])).2 + 1
            ≤ nonNotCount ([] : List Gate) + nonNotCount C.gates := hc
        omega
      · exfalso
        push_neg at hstrict
        obtain ⟨x, hx⟩ := hdep
        apply hx
        have key : ∀ A B, C.gates = A ++ B → ∀ i k,
            (elim n A (List.ofFn s0, [])).1.getD i (Sum.inl false) = Sum.inr k →
            (wiresFrom A (List.ofFn (Function.update x p true))).getD i false
              = (wiresFrom A (List.ofFn (Function.update x p false))).getD i false := by
          intro A
          induction A using List.reverseRecOn with
          | nil =>
            intro B _ i k hik
            have hik0 : (List.ofFn s0).getD i (Sum.inl false) = Sum.inr k := hik
            show (List.ofFn (Function.update x p true)).getD i false
              = (List.ofFn (Function.update x p false)).getD i false
            by_cases hlt : i < n
            · have h1 : (List.ofFn s0).getD i (Sum.inl false) = s0 ⟨i, hlt⟩ :=
                getD_ofFn n s0 _ ⟨i, hlt⟩
              have hne : (⟨i, hlt⟩ : Fin n) ≠ p := by
                intro h
                rw [h1, s0p _ h] at hik0
                cases hik0
              have e1 : (List.ofFn (Function.update x p true)).getD i false
                  = Function.update x p true ⟨i, hlt⟩ := getD_ofFn n _ false ⟨i, hlt⟩
              have e2 : (List.ofFn (Function.update x p false)).getD i false
                  = Function.update x p false ⟨i, hlt⟩ := getD_ofFn n _ false ⟨i, hlt⟩
              rw [e1, e2, Function.update_of_ne hne, Function.update_of_ne hne]
            · exfalso
              rw [List.getD_eq_default _ _ (by simp; omega)] at hik0
              cases hik0
          | append_singleton A g ih =>
            intro B hsplit i k hik
            have hsplit' : C.gates = A ++ g :: B := by rw [hsplit]; simp
            have ihA := ih (g :: B) hsplit'
            have hgok : Ok g := hok g (by rw [hsplit']; simp)
            have hlen : (elim n A (List.ofFn s0, [])).1.length = n + A.length := by
              rw [elim_stats_length]; simp
            have hw : ∀ X : List Bool, wiresFrom (A ++ [g]) X = wiresFrom A X ++
                [g.op.eval (g.inputs.map fun i => (wiresFrom A X).getD i false)] := by
              intro X; rw [wiresFrom_append]; rfl
            have hwl : ∀ X : List Bool, X.length = n →
                (wiresFrom A X).length = n + A.length := by
              intro X hX; rw [length_wiresFrom, hX]
            rw [elim_snoc] at hik
            have hik1 : ((elim n A (List.ofFn s0, [])).1 ++
                [(simplify g.op (n + (elim n A (List.ofFn s0, [])).2.length)
                  (g.inputs.map fun i =>
                    (elim n A (List.ofFn s0, [])).1.getD i (Sum.inl false))).2]).getD i
                  (Sum.inl false) = Sum.inr k := hik
            rw [hw, hw]
            by_cases hi : i = n + A.length
            · have hik2 : (simplify g.op (n + (elim n A (List.ofFn s0, [])).2.length)
                  (g.inputs.map fun i =>
                    (elim n A (List.ofFn s0, [])).1.getD i (Sum.inl false))).2 = Sum.inr k := by
                rw [hi, ← hlen, getD_snoc_eq] at hik1
                exact hik1
              have e1 : ∀ X : List Bool, X.length = n →
                  (wiresFrom A X ++ [g.op.eval (g.inputs.map fun i =>
                    (wiresFrom A X).getD i false)]).getD i false
                  = g.op.eval (g.inputs.map fun i => (wiresFrom A X).getD i false) := by
                intro X hX
                rw [hi, ← hwl X hX, getD_snoc_eq]
              rw [e1 _ (by simp), e1 _ (by simp)]
              have hop : g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not := hgok.1
              have binary : (g.op = GateOp.and ∨ g.op = GateOp.or) →
                  g.op.eval (g.inputs.map fun i =>
                    (wiresFrom A (List.ofFn (Function.update x p true))).getD i false)
                  = g.op.eval (g.inputs.map fun i =>
                    (wiresFrom A (List.ofFn (Function.update x p false))).getD i false) := by
                intro hb
                have hnn : isNotGate g.op = false := by
                  rcases hb with h | h <;> rw [h] <;> rfl
                have hemit := hstrict A g B hsplit' hnn
                obtain ⟨a, b, hins⟩ := simplify_binary_some g.op hb _ _ hemit
                rcases hgi : g.inputs with _ | ⟨u, _ | ⟨v, _ | ⟨c, l⟩⟩⟩
                · rw [hgi] at hins; simp at hins
                · rw [hgi] at hins; simp at hins
                · rw [hgi] at hins
                  simp only [List.map_cons, List.map_nil, List.cons.injEq, and_true] at hins
                  have hu := ihA u a hins.1
                  have hv' := ihA v b hins.2
                  simp only [List.map_cons, List.map_nil, hu, hv']
                · rw [hgi] at hins; simp at hins
              rcases hop with hop | hop | hop
              · exact binary (Or.inl hop)
              · exact binary (Or.inr hop)
              · rw [hop] at hik2
                obtain ⟨a, rest, hins⟩ := simplify_not_inr _ _ _ hik2
                rcases hgi : g.inputs with _ | ⟨u, l⟩
                · rw [hgi] at hins; simp at hins
                · rw [hgi] at hins
                  simp only [List.map_cons, List.cons.injEq] at hins
                  have hu := ihA u a hins.1
                  rw [hop]
                  simp only [GateOp.eval, List.map_cons, List.headD_cons, hu]
            · rw [getD_snoc_ne _ _ _ _ (by rw [hlen]; exact hi)] at hik1
              rw [getD_snoc_ne _ _ _ _ (by rw [hwl _ (by simp)]; exact hi),
                getD_snoc_ne _ _ _ _ (by rw [hwl _ (by simp)]; exact hi)]
              exact ihA i k hik1
        have hfin := key C.gates [] (by simp) C.output jo hst
        rw [← he, ← he]
        exact hfin

end Restrict

def isNotOp (g : Gate) : Bool := match g.op with | .not => true | _ => false
lemma isNotOp_eq_true (g : Gate) : isNotOp g = true ↔ g.op = GateOp.not := by
  cases g with | mk op ins => cases op <;> simp [isNotOp]
lemma countP_not_le_one (gs : List Gate)
    (huniq : ∀ i j : Fin gs.length, (gs.get i).op = GateOp.not → (gs.get j).op = GateOp.not → i = j) :
    gs.countP isNotOp ≤ 1 := by
  induction gs with
  | nil => simp
  | cons g gs ih =>
    simp only [List.countP_cons]
    by_cases hgn : g.op = GateOp.not
    · have hrest : gs.countP isNotOp = 0 := by
        rw [List.countP_eq_zero]
        intro x hx
        obtain ⟨idx, rfl⟩ := List.mem_iff_get.1 hx
        intro hxn
        have heq := huniq ⟨0, by simp⟩ ⟨idx.val + 1, by simp [idx.isLt]⟩ hgn ((isNotOp_eq_true _).1 hxn)
        simp at heq
      simp [(isNotOp_eq_true g).2 hgn, hrest]
    · have hle := ih (fun i j hi hj => by
        have heq := huniq ⟨i.val + 1, by simp [i.isLt]⟩ ⟨j.val + 1, by simp [j.isLt]⟩ hi hj
        exact Fin.ext (by simpa using congrArg Fin.val heq))
      have hgnf : isNotOp g = false := Bool.eq_false_iff.2 fun h => hgn ((isNotOp_eq_true g).1 h)
      simp [hgnf, hle]

open CircuitProof Restrict

def graphValue (x : Fin 8 → Bool) : Bool :=
  decide (∃ i < ([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).length / 2, (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i + 1) 0) false = true)

def restrictedGraphValue (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 3) || (x 1 && x 3) || (x 0 && x 4) || (x 1 && x 4) || (x 2 && x 4) || (x 0 && x 5) || (x 2 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6) || (x 5 && x 6)

def monotoneWitness : Circuit :=
  ⟨[⟨.or, [4, 5]⟩,
    ⟨.or, [8, 7]⟩,
    ⟨.or, [3, 9]⟩,
    ⟨.and, [10, 0]⟩,
    ⟨.or, [1, 2]⟩,
    ⟨.or, [12, 7]⟩,
    ⟨.or, [5, 6]⟩,
    ⟨.and, [13, 14]⟩,
    ⟨.or, [11, 15]⟩,
    ⟨.or, [6, 7]⟩,
    ⟨.or, [12, 4]⟩,
    ⟨.and, [17, 18]⟩,
    ⟨.or, [16, 19]⟩,
    ⟨.and, [9, 1]⟩,
    ⟨.or, [20, 21]⟩], 22⟩

set_option maxRecDepth 32768 in
theorem witnessCorrect : ∀ x : Fin 8 → Bool,
    monotoneWitness.eval (List.ofFn x) = graphValue x := by
  decide +kernel

def pinLeaf : Fin 8 → Stat :=
  ![Sum.inr 1, Sum.inr 0, Sum.inr 2, Sum.inl false, Sum.inr 3, Sum.inr 4, Sum.inr 5, Sum.inr 6]

def SevenFloor : Prop := ∀ C : Circuit, FanInTwo C →
  (∀ x : Fin 7 → Bool, C.eval (List.ofFn x) = restrictedGraphValue x) →
  13 ≤ C.gates.length

def SevenWithNotFloor : Prop := ∀ C : Circuit, FanInTwo C →
  (∀ x : Fin 7 → Bool, C.eval (List.ofFn x) = restrictedGraphValue x) →
  opCount isNotGate C.gates = 1 → 14 ≤ C.gates.length

set_option maxRecDepth 32768 in
theorem leafRestrictionMatches : ∀ y : Fin 7 → Bool,
    graphValue (Function.update (fun i => Stat.val (List.ofFn y) (pinLeaf i)) 3 false)
      = restrictedGraphValue y := by
  decide +kernel

theorem restrictLeaf (C : Circuit) (fan : FanInTwo C)
    (computes : ∀ x : Fin 8 → Bool, C.eval (List.ofFn x) = graphValue x) :
    ∃ E : Circuit, FanInTwo E ∧ opCount isNotGate E.gates ≤ opCount isNotGate C.gates ∧
      nonNotCount E.gates + 1 ≤ nonNotCount C.gates ∧
      ∀ y : Fin 7 → Bool, E.eval (List.ofFn y) = restrictedGraphValue y := by
  have dependsOnLeaf : ∃ x : Fin 8 → Bool,
      graphValue (Function.update x 3 true) ≠ graphValue (Function.update x 3 false) :=
    ⟨fun i => decide (i = 0), by decide +kernel⟩
  have cofactorNonconstant : ∃ x y : Fin 8 → Bool,
      graphValue (Function.update x 3 false) ≠ graphValue (Function.update y 3 false) :=
    ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  obtain ⟨D, fanD, notBound, dropOne, computesD⟩ :=
    restrict_drop C fan 3 graphValue computes dependsOnLeaf cofactorNonconstant
  have validPin : ∀ i : Fin 8, Stat.Valid 7 (pinLeaf i) := by
    intro i
    fin_cases i <;> norm_num [pinLeaf, Stat.Valid]
  have cofactorEval : ∀ y : Fin 7 → Bool,
      D.eval (List.ofFn fun i => Stat.val (List.ofFn y) (pinLeaf i)) = restrictedGraphValue y :=
    fun y => (computesD _).trans (leafRestrictionMatches y)
  obtain ⟨E, fanE, notBoundE, binaryBound, computesE⟩ :=
    restrict_core D fanD pinLeaf validPin restrictedGraphValue cofactorEval
      ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  exact ⟨E, fanE, notBoundE.trans notBound, by omega, computesE⟩

theorem gateCountPartition (gates : List Gate) :
    nonNotCount gates + opCount isNotGate gates = gates.length := by
  unfold nonNotCount opCount
  induction gates with
  | nil => rfl
  | cons g gs ih =>
    cases state : isNotGate g.op <;> simp [List.countP_cons, state] <;> omega

theorem witnessBound (floor : SevenFloor) (withNot : SevenWithNotFloor)
    (gates : List Gate) (o : ℕ) (fan : FanInTwo ⟨gates, o⟩)
    (computes : ∀ x : Fin 8 → Bool, Circuit.eval ⟨gates, o⟩ (List.ofFn x) = graphValue x)
    (notCount : opCount isNotGate gates ≤ 1) (hasNot : 0 < opCount isNotGate gates) :
    15 ≤ gates.length := by
  obtain ⟨E, fanE, notBound, dropOne, computesE⟩ := restrictLeaf ⟨gates, o⟩ fan computes
  change opCount isNotGate E.gates ≤ opCount isNotGate gates at notBound
  change nonNotCount E.gates + 1 ≤ nonNotCount gates at dropOne
  have totalE := gateCountPartition E.gates
  have total := gateCountPartition gates
  by_cases lostNot : opCount isNotGate E.gates = 0
  · have floorE := floor E fanE computesE
    omega
  · have retained : opCount isNotGate E.gates = 1 := by omega
    have floorE := withNot E fanE computesE retained
    omega

theorem fromSevenFloors (floor : SevenFloor) (withNot : SevenWithNotFloor) : (∀ (gates : List PEqualNP.CircuitLowerBounds.Gate) (o : ℕ), (∀ g ∈ gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) → (∀ i j : Fin gates.length, (gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → (gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not → i = j) → (∀ x : Fin 8 → Bool, PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, o⟩ (List.ofFn x) = decide (∃ i < ([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).length / 2, (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i + 1) 0) false = true)) → ∃ (gates' : List PEqualNP.CircuitLowerBounds.Gate) (o' : ℕ), (∀ g ∈ gates', (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) ∧ gates'.length ≤ gates.length ∧ ∀ x : Fin 8 → Bool, PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates', o'⟩ (List.ofFn x) = decide (∃ i < ([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).length / 2, (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 3, 0, 4, 1, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 4, 6, 0, 7, 1, 7, 2, 7, 4, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i + 1) 0) false = true)) := by
  intro gates o legal oneNot computes
  by_cases hasNot : ∃ g ∈ gates, g.op = GateOp.not
  · obtain ⟨g, hg, notGate⟩ := hasNot
    have fan : FanInTwo ⟨gates, o⟩ := fun t ht => ⟨(legal t ht).1, (legal t ht).2⟩
    have positive : 0 < opCount isNotGate gates :=
      List.countP_pos_iff.mpr ⟨g, hg, by simp [notGate, isNotGate]⟩
    have atMostOne : opCount isNotGate gates ≤ 1 := by
      have predEq : (fun g : Gate => isNotGate g.op) = isNotOp := by
        funext g
        cases g with | mk op inputs => cases op <;> rfl
      unfold opCount
      rw [predEq]
      exact countP_not_le_one gates oneNot
    have lower := witnessBound floor withNot gates o fan computes atMostOne positive
    exact ⟨monotoneWitness.gates, monotoneWitness.output, by simp [monotoneWitness],
      by change 15 ≤ gates.length; omega, witnessCorrect⟩
  · refine ⟨gates, o, ?_, le_rfl, computes⟩
    intro g hg
    obtain ⟨ops, hlen⟩ := legal g hg
    exact ⟨ops.imp_right (fun h => h.resolve_right (fun eq => hasNot ⟨g, hg, eq⟩)), hlen⟩

