private theorem orbitHits {Z : ℕ} (region : Z = 0 ∨ Z = 1) :
    (inputs Z).all (fun a => (inputs Z).all fun b => a == b ||
      hb (orbitMask Z) (a+b) || (rename a + rename b < a+b)) = true := by
  rcases region with rfl | rfl <;> decide +kernel

private lemma rename_mem {Z w : Nat} (region : Z = 0 ∨ Z = 1) (hw : w ∈ WZ [] Z) : rename w ∈ WZ [] Z := by
  apply inputSet.mp
  simpa using List.all_eq_true.mp (inputsClosed region) w (inputSet.mpr hw)

private lemma selectedPair {Z a b : Nat} (region : Z = 0 ∨ Z = 1)
    (ha : a ∈ WZ [] Z) (hb' : b ∈ WZ [] Z) (hne : a ≠ b) :
    hb (orbitMask Z) (a+b) = true ∨ rename a + rename b < a+b := by
  have h := List.all_eq_true.mp (List.all_eq_true.mp (orbitHits region) a (inputSet.mpr ha)) b (inputSet.mpr hb')
  simpa [hne] using h

private lemma orbitLeast {Z k t : Nat} (region : Z = 0 ∨ Z = 1) {S : Finset Nat} (hS : (S : Set Nat) ⊆ C (mz Z) (WZ [] Z))
    (hl : Live Z0 (mz Z) (tz Z) k t S)
    (hmin : ∀ q < k, ¬Sol Z0 (mz Z) (tz Z) q (C (mz Z) (WZ [] Z))) :
    ∃ U : Finset Nat, (U : Set Nat) ⊆ C (mz Z) (WZ [] Z) ∧ Live Z0 (mz Z) (tz Z) k t U ∧
      RankedChoice (RZ [] Z) (mz Z) (tz Z) k t U (fun a b => hb (orbitMask Z) (a+b) = true) := by
  classical
  have raw {w : Nat} : RZ [] Z w ≠ 0 ↔ w ∈ WZ [] Z := by
    change w ∈ {x | RZ [] Z x ≠ 0} ↔ _
    rw [RZ_set]
  have minimal {U : Finset Nat} (hU : (U : Set Nat) ⊆ C (mz Z) (WZ [] Z)) :
      ∀ q < k, ¬Sol Z0 (mz Z) (tz Z) q (C (mz Z) ({x | RZ [] Z x ≠ 0} ∪ (U : Set Nat))) := by
    intro q hq hs
    apply hmin q hq (hs.mono le_rfl ?_)
    rintro x ((hx|hx)|hx)
    · exact Or.inl (raw.mp hx)
    · exact hU hx
    · exact Or.inr hx
  rcases front (RZ_R2 [] Z) hl (minimal hS) with done | ⟨j,d,a,b,V,hk,ha,hb',g,rest⟩
  · exact ⟨S,hS,hl,Or.inl done⟩
  let P (r : Nat) := ∃ U : Finset Nat, (U : Set Nat) ⊆ C (mz Z) (WZ [] Z) ∧ RawFirst (RZ [] Z) (mz Z) (tz Z) k t U r
  have ex : ∃ r, P r := ⟨rawPairKey a b, S,hS,j,d,a,b,V,hk,ha,hb',g,rest,rfl⟩
  clear hk ha hb' g rest j d a b V
  obtain ⟨U,hU,j,d,a,b,V,rfl,ha,hb',gate,tail,eq⟩ := Nat.find_spec ex
  have next {A B : Finset Nat} {x y : Nat} (hA : (A : Set Nat) ⊆ C (mz Z) (WZ [] Z))
      (hx : RZ [] Z x ≠ 0) (hy : RZ [] Z y ≠ 0) (g : Bi Z0 d x y A B) :
      ∀ r, RawFirst (RZ [] Z) (mz Z) (tz Z) j t B r → Nat.find ex ≤ r := by
    intro r later
    exact Nat.find_min' ex ⟨A,hA,liftRawFirst hx hy g (minimal hA) later⟩
  rcases selectedPair region (raw.mp ha) (raw.mp hb') gate.1 with ok | smaller
  · exact ⟨U,hU,gate.live tail,Or.inr ⟨j,d,a,b,V,rfl,ha,hb',gate,tail,eq ▸ next hU ha hb' gate,ok⟩⟩
  · obtain ⟨r0,rm,rt⟩ := renameFacts region
    have imageOK : (U.image rename : Set Nat) ⊆ C (mz Z) (WZ [] Z) := by
      intro x hx
      obtain ⟨y,hy,rfl⟩ := Finset.mem_image.mp hx
      rcases hU hy with hy | hy
      · exact Or.inl (rename_mem region hy)
      · rcases hy with h0 | hM
        · exact Or.inr (Or.inl (by simpa [h0] using r0))
        · exact Or.inr (Or.inr (by simpa [Set.mem_singleton_iff.mp hM] using rm))
    have hx := raw.mpr (rename_mem region (raw.mp ha))
    have hy := raw.mpr (rename_mem region (raw.mp hb'))
    have gr := permute_first swaps gate
    have tr := permute_live swaps rm rt tail
    have imageRank : P (rawPairKey (rename a) (rename b)) :=
      ⟨U.image rename,imageOK,j,d,rename a,rename b,V.image rename,rfl,hx,hy,gr,tr,rfl⟩
    have minimum := Nat.find_min' ex imageRank
    have lower : rawPairKey (rename a) (rename b) < Nat.find ex := by
      simpa only [rawPairKey, ← eq] using smaller
    exact (Nat.not_lt_of_ge minimum lower).elim

private lemma orderedRootByOrbit {Q : List (Nat × Nat)} {Z L k t : Nat} {S : Finset Nat}
    (region : Z = 0 ∨ Z = 1)
    (hp : pOk Z Q = true) (hL : L ≤ 15) (bounds : ∀ e ∈ Q, ImpB [] e.1 e.2 t)
    (hk : k < L) (hS : (S : Set Nat) ⊆ C (mz Z) (WZ [] Z))
    (hl : Live Z0 (mz Z) (tz Z) k t S)
    (hmin : ∀ q < k, ¬Sol Z0 (mz Z) (tz Z) q (C (mz Z) (WZ [] Z)))
    (run : ∀ r ∈ startingRanks (avl (PZ Q) (mz Z) (rawL [])), rankedCheck [] Q Z (L-1) t (orbitMask Z) r = false) : False := by
  obtain ⟨U,hU,live,chosen⟩ := orbitLeast region hS hl hmin
  exact imp_of_ranked_live (Or.inl rfl) hp hL bounds hk hU live hmin chosen run

structure Snapshot where
  blue : Bool
  fuel : Nat
  gates : Nat
  negs : Nat
  budget : Nat
  wires : List W
  deriving DecidableEq

noncomputable def evalSnap (l m g K rank : Nat) (s : Snapshot) : Bool :=
  if s.blue then rankedLook rank l m g K s.fuel s.gates s.negs s.budget s.wires
  else look l m g s.fuel s.gates s.negs s.budget s.wires

private lemma evalSnap_rank_irrelevant (l m g K left right : ℕ) (state : Snapshot)
    (unranked : state.blue = false) : evalSnap l m g K left state = evalSnap l m g K right state := by
  simp only [evalSnap, unranked, Bool.false_eq_true, if_false]

noncomputable def saved (l m g K rank : Nat) (cache : List Snapshot) (blue : Bool)
    (fuel k t z : Nat) (v : List W) : Bool :=
  let s := Snapshot.mk blue fuel k t z v
  if s ∈ cache then false else evalSnap l m g K rank s

lemma saved_ok (l m g K rank : Nat) (cache : List Snapshot)
    (h : ∀ s ∈ cache, evalSnap l m g K rank s = false) :
    saved l m g K rank cache = fun blue fuel k t z v => evalSnap l m g K rank ⟨blue,fuel,k,t,z,v⟩ := by
  funext blue fuel k t z v
  unfold saved
  dsimp only
  split
  · exact (h _ (by assumption)).symm
  · rfl

noncomputable def checkChildren (l m g K rank : Nat) (cache : List Snapshot) (s : Snapshot) : Bool :=
  let recurse := saved l m g K rank cache
  match s.fuel with
  | 0 => true
  | j+1 =>
    let k := s.gates
    let t := s.negs
    let z := s.budget
    let v := s.wires
    Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y =>
      if s.blue then
        Bool.rec (motive := fun _ => Bool) (mv (recurse false K) l m g k t z v y) true
          (node (recurse true j (Nat.sub k 1) t) (pos t) l m g (Nat.sub (Nat.sub k t) y) v.length z v (rankedPairs rank))
      else mv (recurse false j) l m g k t z v y)) true (Nat.ble v.length 1)

lemma children_ok (l m g K rank : Nat) (cache : List Snapshot) (s : Snapshot)
    (h : ∀ e ∈ cache, evalSnap l m g K rank e = false) :
    evalSnap l m g K rank s = checkChildren l m g K rank cache s := by
  unfold checkChildren
  rw [saved_ok _ _ _ _ _ _ h]
  rcases s with ⟨b,j,k,t,z,v⟩
  cases b <;> cases j <;> rfl

noncomputable def checkFront (Q : List (ℕ × ℕ)) (Z K t H rank : Nat) (cache : List Snapshot) : Bool :=
  let l := lz Z
  let m := mz Z
  let P := PZ Q
  let g := pL (Q.map fun _ => 16)
  let B := pL (Q.map fun e => 16 + (K - e.2))
  let p := pwr [] Z
  let recurse := saved l m g K rank cache
  let top (z : Nat) (v : List W) := Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ K) t) v (fun y =>
    Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) false (mv (recurse false K) l m g K t z v y) (Nat.beq rank 0)) true
      (node (recurse true K (Nat.sub K 1) t) (pos t) l m g (Nat.sub (Nat.sub K t) y) v.length z v (matchingPairs H rank)))) true (Nat.ble v.length 1)
  anySub (pos t) l (avl P m (rawL [])) 0 (fun v =>
    Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false
      (child top g (fun h => h v) (Nat.sub B (sumc v))) (Nat.ble v.length (Nat.sub (Nat.succ K) t))) (hasP p v))

lemma front_eq (Q : List (ℕ × ℕ)) (Z K t H rank : Nat) (cache : List Snapshot)
    (h : ∀ s ∈ cache, evalSnap (lz Z) (mz Z) (pL (Q.map fun _ => 16)) K rank s = false) :
    rankedCheck [] Q Z K t H rank = checkFront Q Z K t H rank cache := by
  simp only [rankedCheck, frc_eq, st_eq, checkFront, rankedStart, rankedTop]
  rw [saved_ok _ _ _ _ _ _ h]
  rfl
