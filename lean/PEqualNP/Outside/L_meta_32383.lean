  | succ fuel ih =>
    intro k t z v S h hs hcod k' hk hl hmW lower
    change (Bool.rec (motive := fun _ => Bool) (tst (pos t) l (k + 1 - t) v (fun y => Bool.rec (motive := fun _ => Bool) (mv (look l m g K) l m g k t z v y) true
        (node (rankedLook floor l m g K fuel (k - 1) t) (pos t) l m g (k - t - y) v.length z v (rankedPairs floor)))) true (Nat.ble v.length 1) : Bool) = false at h
    rw [bR, pos_eq] at h
    cases h0 : Nat.ble v.length 1 with
    | true => rw [h0] at h; simp at h
    | false =>
      rw [h0, Bool.cond_false] at h
      have hlen : 2 ≤ v.length := by
        by_contra hc
        rw [Nat.ble_eq_true_of_le (by omega)] at h0; simp at h0
      have hmin : Min Z0 m T k' t S := ⟨hl, fun q hq hs => hmW q hq (hs.mono le_rfl (C_mono Set.subset_union_right))⟩
      obtain ⟨y, hFy, hyk⟩ := tst_sound X hs hmin hk
      have hy := (hFy _).symm.trans h
      beta_reduce at hy
      obtain ⟨hy1, hy2⟩ := or_false' X hy
      refine orderedStep_sound X hR hR2 (f := fun _ => rankedLook floor l m g K fuel)
        (fun rank bound k t z v S hf hst hcode j hle hli hmi hlow => ih _ _ _ _ _ hf hst hcode j hle hli hmi (fun r hr => bound.trans (hlow r hr)))
        hs hcod hlen hk hl hmW lower (rankedChoiceOfLive hR2 hl hmW) hyk hy2 fun a ha c hc hne har hcr hbound _ => ⟨rankedPairs floor, hy1, fun h hp => ?_⟩
      have result := pairs_any (h := fun a b => Nat.ble floor (rawPairKey a.s b.s) && h a b) hp (fs_mem (List.mem_map_of_mem ha) har) (fs_mem (List.mem_map_of_mem hc) hcr) (fun e => hne (congrArg PEqualNP.Outside.L_meta_32383.Core.X.s e))
      have le : Nat.ble floor (rawPairKey a.s c.s) = true := Nat.ble_eq_true_of_le hbound
      have rev : Nat.ble floor (rawPairKey c.s a.s) = true := by simpa only [rawPairKey, Nat.add_comm c.s a.s] using le
      simpa only [mkx, le, rev, Bool.true_and] using result
end

noncomputable def matchingPairs (H key : ℕ) (h : X → X → Bool) (xs : List X) :=
  pairs (fun a b => (Nat.beq key (rawPairKey a.s b.s) && hb H (a.s+b.s)) && h a b) (fs xs)
noncomputable def rankedTop (l m g K H key k t z : ℕ) (v : List W) : Bool :=
  Bool.rec (motive := fun _ => Bool) (tst (pos t) l (Nat.sub (Nat.succ k) t) v (fun y =>
    Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) false (mv (look l m g K) l m g k t z v y) (Nat.beq key 0)) true
      (node (rankedLook key l m g K K (Nat.sub k 1) t) (pos t) l m g (Nat.sub (Nat.sub k t) y) v.length z v (matchingPairs H key)))) true (Nat.ble v.length 1)
section
variable {P : List ℕ} {l m g T : ℕ} (X : Ctx P l m g T)
include X
lemma rankedTop_sound (hR : RR R) (hR2 : ∀ d a b, (R a = 0 ∨ R b = 0) → Al R d a b) {H K k t z : ℕ} {v : List W} {S : Finset ℕ} {keys : List ℕ}
    (zero : 0 ∈ keys) (cover : ∀ a ∈ v, ∀ b ∈ v, rawPairKey a.s b.s ∈ keys)
    (h : ∀ key ∈ keys, rankedTop l m g K H key k t z v = false) (hs : StOk P T l k t z v S) (hcod : ∀ w ∈ v, w.r = R w.s)
    {k' : ℕ} (hk : k' ≤ k) (hl : Live Z0 m T k' t S) (hmW : ∀ q < k', ¬ Sol Z0 m T q (C m ({x | R x ≠ 0} ∪ (S : Set ℕ)))) (sel : RankedChoice R m T k' t S (fun a b => hb H (a+b) = true)) : False := by
  have un : ∀ key ∈ keys, 2 ≤ v.length ∧ tst (pos' t) l (k + 1 - t) v (fun y =>
      Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) false (mv (look l m g K) l m g k t z v y) (Nat.beq key 0)) true
      (node (rankedLook key l m g K K (k - 1) t) (pos' t) l m g (k - t - y) v.length z v (matchingPairs H key))) = false := by
    intro key hp
    have h := h key hp
    change (Bool.rec (motive := fun _ => Bool) (tst (pos t) l (k + 1 - t) v (fun y =>
      Bool.rec (motive := fun _ => Bool) (Bool.rec (motive := fun _ => Bool) false (mv (look l m g K) l m g k t z v y) (Nat.beq key 0)) true
      (node (rankedLook key l m g K K (k - 1) t) (pos t) l m g (k - t - y) v.length z v (matchingPairs H key)))) true (Nat.ble v.length 1) : Bool) = false at h
    rw [bR, pos_eq] at h
    cases h0 : Nat.ble v.length 1 with
    | true => rw [h0] at h; simp at h
    | false =>
      rw [h0, Bool.cond_false] at h
      refine ⟨?_, h⟩
      by_contra hc
      rw [Nat.ble_eq_true_of_le (by omega)] at h0; simp at h0
  have hmin : Min Z0 m T k' t S := ⟨hl, fun q hq hs => hmW q hq (hs.mono le_rfl (C_mono Set.subset_union_right))⟩
  obtain ⟨y, hFy, hyk⟩ := tst_sound X hs hmin hk
  have un2 := fun p hp => (hFy _).symm.trans (un p hp).2
  refine orderedStep_sound X hR hR2 (floor := 0) (K := K) (f := fun key => rankedLook key l m g K K)
    (fun key _ => rankedLook_sound X key hR hR2 K) hs hcod (un 0 zero).1 hk hl hmW (fun _ _ => Nat.zero_le _) sel hyk ?_ ?_
  · have result := (or_false' X (un2 0 zero)).2
    simpa only [Nat.beq_refl, bR, Bool.cond_true] using result
  · intro a ha c hc hne har hcr _ permitted
    let key := rawPairKey a.s c.s
    refine ⟨matchingPairs H key, (or_false' X (un2 key (cover a ha c hc))).1, fun h hp => ?_⟩
    have result := pairs_any (h := fun a b => (Nat.beq key (rawPairKey a.s b.s) && hb H (a.s+b.s)) && h a b) hp
      (fs_mem (List.mem_map_of_mem ha) har) (fs_mem (List.mem_map_of_mem hc) hcr) (fun e => hne (congrArg PEqualNP.Outside.L_meta_32383.Core.X.s e))
    have eq : Nat.beq key (rawPairKey a.s c.s) = true := Nat.beq_refl _
    have rev : Nat.beq key (rawPairKey c.s a.s) = true := by simpa only [rawPairKey, Nat.add_comm c.s a.s] using eq
    have pr : hb H (c.s+a.s) = true := by simpa only [Nat.add_comm c.s a.s] using permitted
    simpa only [mkx, eq, rev, permitted, pr, Bool.true_and] using result
end

noncomputable def rankedStart (l m g B K t p H key : ℕ) (v : List W) : Bool :=
  Bool.rec (motive := fun _ => Bool) false (Bool.rec (motive := fun _ => Bool) false
    (child (fun z r => rankedTop l m g K H key K t z r) g (fun h => h v) (Nat.sub B (sumc v)))
    (Nat.ble v.length (Nat.sub (Nat.succ K) t))) (hasP p v)
noncomputable def rankedCheck (E Q : List (ℕ × ℕ)) (Z K t H key : ℕ) : Bool :=
  (fun l => (fun m => (fun P => (fun g => (fun B => (fun p =>
    frc (avl P m (rawL E)) (fun v => st l fun l => st m fun m => st g fun g => st B fun B => st p fun p =>
      anySub (pos t) l v 0 (fun r => rankedStart l m g B K t p H key r)))
    (pwr E Z)) (pL (Q.map fun e => 16 + (K - e.2)))) (pL (Q.map fun _ => 16))) (PZ Q)) (mz Z)) (lz Z)
def startingRanks (v : List W) : List Nat :=
  0 :: (v.flatMap fun a => v.map fun b => rawPairKey a.s b.s).eraseDups

lemma startingRank_mem {v : List W} {a b : W} (ha : a ∈ v) (hb : b ∈ v) : rawPairKey a.s b.s ∈ startingRanks v := by
  simp only [startingRanks, List.mem_cons, List.mem_eraseDups, List.mem_flatMap, List.mem_map]
  exact Or.inr ⟨a,ha,b,hb,rfl⟩
theorem imp_of_ranked_live {E Q : List (ℕ × ℕ)} {Z L k t H : ℕ} {S : Finset ℕ}
    (hE : E = [] ∨ ∃ e ∈ six, E = [e] ∧ Imp [] Z L) (hp : pOk Z Q = true) (hL : L ≤ 15)
    (hI : ∀ e ∈ Q, ImpB E e.1 e.2 t)
    (hk : k < L) (hS : (S : Set ℕ) ⊆ C (mz Z) (WZ E Z)) (hl : Live Z0 (mz Z) (tz Z) k t S)
    (hmin : ∀ q < k, ¬ Sol Z0 (mz Z) (tz Z) q (C (mz Z) (WZ E Z)))
    (sel : RankedChoice (RZ E Z) (mz Z) (tz Z) k t S (fun a b => hb H (a+b) = true))
    (hchk : ∀ key ∈ startingRanks (avl (PZ Q) (mz Z) (rawL E)), rankedCheck E Q Z (L - 1) t H key = false) : False := by
  simp only [pOk, Bool.and_eq_true, Bool.not_eq_true', List.all_eq_true] at hp
  obtain ⟨⟨hp0, hp1⟩, hp2⟩ := hp
  have nb : ∀ {x y : ℕ}, Nat.beq x y = false → x ≠ y := fun h e => by rw [e, Nat.beq_refl] at h; simp at h
  have hT : tz Z &&& mz Z = tz Z := by simp only [tz, nl, Nat.and_assoc, Nat.and_self]
  have hE6 : ∀ e ∈ E, e ∈ six := by
    rcases hE with rfl | ⟨e, he, rfl, _⟩
    · simp
    · intro e' he'; simp only [List.mem_singleton] at he'; rw [he']; exact he
  classical
  have hCS : C (mz Z) (S : Set ℕ) ⊆ C (mz Z) (WZ E Z) := by
    rintro x (hx | hx)
    · exact hS hx
    · exact Or.inr hx
  have hm : Min Z0 (mz Z) (tz Z) k t S := ⟨hl, fun q' hq' hs => hmin q' hq' (hs.mono le_rfl hCS)⟩
  have hbd : ∀ x ∈ S, x &&& mz Z = x := by
    intro x hx
    rcases hS hx with ⟨w, _, rfl⟩ | h
    · rw [Nat.and_assoc, Nat.and_self]
    · simp at h; rcases h with rfl | rfl <;> simp
  obtain ⟨h0, h1⟩ := hm.proper hT (nb hp0) (nb hp1) hbd
  have hSW : (S : Set ℕ) ⊆ WZ E Z := by
    intro x hx
    rcases hS hx with h | h
    · exact h
    · simp at h; rcases h with rfl | rfl
      · exact absurd hx h0
      · exact absurd hx h1
  have hproj : ∀ e ∈ Q, mz e.1 &&& mz Z = mz e.1 ∧ tz e.1 ≠ 0 ∧ tz e.1 ≠ mz e.1 := by
    intro e he
    obtain ⟨⟨a, b⟩, c⟩ := hp2 e he
    exact ⟨Nat.eq_of_beq_eq_true a, nb b, nb c⟩
  have hno : ∀ e ∈ Q, ∀ q, q + t < e.2 → ¬ SolB (mz e.1) (tz Z &&& mz e.1) q t (C (mz e.1) (Im (mz e.1) S)) := by
    intro e he q hq hs
    have h3 := (hproj e he).1
    rw [tz_sub h3] at hs
    exact hI e he q hq (hs.mono le_rfl le_rfl (C_mono (Im_WZ h3 hSW)))
  have htk := hm.size.2
  have hpw : pwr E Z = 0 ∨ pwr E Z ∈ S := by
    rcases hE with rfl | ⟨e, he, rfl, hraw⟩
    · exact Or.inl rfl
    · by_contra hc
      push Not at hc
      refine hraw k (by omega) (hl.sol.mono le_rfl ?_)
      intro x hx
      obtain ⟨w, hw, rfl⟩ := hSW hx
      simp only [rawL, List.mem_append, List.map_cons, List.map_nil, List.mem_singleton] at hw
      rcases hw with hw | rfl
      · exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
      · have hx : xw e &&& mz Z ∈ S := by simpa using hx
        exact absurd (show pwr [e] Z ∈ S from hx) hc.2
  obtain ⟨a1, a2, a3⟩ := avl_spec (PZ Q) (mz Z) (rawL E)
  set v := (avl (PZ Q) (mz Z) (rawL E)).filter (fun w => decide (w.s ∈ S)) with hv
  have hsub : v.Sublist (avl (PZ Q) (mz Z) (rawL E)) := List.filter_sublist
  have hnd : (v.map W.s).Nodup := by
    rw [List.Nodup, List.pairwise_map]
    exact (a1.sublist hsub).imp fun h => Nat.ne_of_gt h
  have hrep : Rep v S := by
    refine ⟨hnd, Finset.ext fun x => ?_⟩
    rw [List.mem_toFinset, List.mem_map]
    constructor
    · rintro ⟨w, hw, rfl⟩
      rw [hv, List.mem_filter] at hw; simpa using hw.2
    · intro hx
      obtain ⟨w, hw, rfl⟩ := hSW hx
      obtain ⟨w', hw', e⟩ := a3 w hw (fun e => h0 (e ▸ hx)) (fun e => h1 (e ▸ hx))
      exact ⟨w', by rw [hv, List.mem_filter]; exact ⟨hw', by simpa [e] using hx⟩, e⟩
  have hwok : ∀ w ∈ v, WOk (PZ Q) w := by
    intro w hw
    obtain ⟨x, _, rfl⟩ := a2 w (hsub.subset hw); exact mkW_ok _ _
  have hcod : ∀ w ∈ v, w.r = RZ E Z w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw)
    have : x &&& mz Z ∈ WZ E Z := ⟨x, hx, rfl⟩
    change 3 = RZ E Z (x &&& mz Z)
    rw [RZ, ite_eq_left this]
  have hgood : ∀ w ∈ v, Good (lz Z) w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw); exact wire_good (rawL_sub hE6 hx) Z
  have hPlen : (PZ Q).length = Q.length := by simp [PZ]
  have hPget : ∀ j < (PZ Q).length, (PZ Q).getD j 0 = mz (Q.getD j (0, L - 1)).1 ∧ Q.getD j (0, L - 1) ∈ Q := by
    intro j hj
    rw [hPlen] at hj
    simp [PZ, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]
  have X : Ctx (PZ Q) (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (tz Z) := by
    refine ⟨fun i hi => lz_lg Z i hi, fun j hj => ?_, ?_⟩
    · obtain ⟨e1, e2⟩ := hPget j hj
      have h3 := hproj _ e2
      rw [e1, tz_sub h3.1]; exact h3
    · rw [pL_pk, List.length_map, hPlen]
      refine pk_congr fun j hj => ?_
      rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]; rfl
  have hcl : Cl (PZ Q) (tz Z) (L - 1) t (fun j => L - 1 - (Q.getD j (0, L - 1)).2) S := by
    intro j hj q hq
    obtain ⟨e1, e2⟩ := hPget j hj
    have hq' : q + t + (L - 1 - (Q.getD j (0, L - 1)).2) < L - 1 := hq
    rw [e1]; exact hno _ e2 q (by omega)
  have hle := cnt_le X hrep hwok hcl hm (by omega)
  have hst : StOk (PZ Q) (tz Z) (lz Z) (L - 1) t (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v S := by
    refine ⟨hrep, hwok, hgood, _, fun j _ => by omega, hcl, ?_⟩
    rw [sumc_eq hwok, pk16, pk_sub]
    intro j hj; have := hle j hj; omega
  have hcov : ∀ i, (lz Z).testBit i = true → (0 : ℕ).testBit i = true ∨ (cov (pos t) (lz Z) v).testBit i = true := by
    intro i hli
    right
    rw [cov_bit]
    obtain ⟨⟨m1, m2, t1, t2⟩, _⟩ := lz_lg Z i hli
    obtain ⟨w, hw, hs⟩ := hl.cov m1 m2 t1 t2
    obtain ⟨w', hw', rfl⟩ := hrep.mem.1 hw
    exact ⟨w', hw', by rw [sp_bit, hli, pos_eq, hs]; rfl⟩
  have hsz := hm.size.1
  have hcard := hrep.card
  have hble : Nat.ble v.length (Nat.sub (Nat.succ (L - 1)) t) = true := Nat.ble_eq_true_of_le (by
    change v.length ≤ L - 1 + 1 - t; omega)
  have hhas : hasP (pwr E Z) v = true := hasP_ok (hpw.imp id fun h => hrep.mem.1 h)
  have all : ∀ key ∈ startingRanks (avl (PZ Q) (mz Z) (rawL E)), rankedTop (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (L - 1) H key (L - 1) t (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v = false := by
    intro key hpM
    have h2 := hchk key hpM
    simp only [rankedCheck, frc_eq, st_eq] at h2
    have h3 := anySub_false (by simp) h2 v hsub hcov
    simp only [rankedStart, bR, hhas, hble, Bool.cond_true] at h3
    exact child_sound X (f := fun z r => rankedTop (lz Z) (mz Z) _ (L - 1) H key (L - 1) t z r) (fun h => rfl) hst hm (by omega) h3
  refine rankedTop_sound X (RZ_R E Z) (RZ_R2 E Z) (List.mem_cons_self) (fun a ha b hb => startingRank_mem (hsub.subset ha) (hsub.subset hb)) all hst hcod (by omega) hl ?_ sel
  intro q hq hs
  rw [RZ_set] at hs
  refine hmin q hq (hs.mono le_rfl ?_)
  rintro x ((hx | hx) | hx)
  · exact Or.inl hx
  · exact Or.inl (hSW hx)
  · exact Or.inr hx

def exchangeBits (p : Nat × Nat) (x : Nat) : Nat :=
  if x.testBit p.1 = x.testBit p.2 then x else x ^^^ (2^p.1 ||| 2^p.2)

lemma exchangeBit (a b x i : Nat) :
    (exchangeBits (a,b) x).testBit i = x.testBit (if i = a then b else if i = b then a else i) := by
  by_cases e : x.testBit a = x.testBit b
  · simp only [exchangeBits, if_pos e]
    split_ifs <;> simp_all
  · simp only [exchangeBits, if_neg e, Nat.testBit_xor, Nat.testBit_or, Nat.testBit_two_pow]
    by_cases ia : i = a
    · subst i
      cases h₁ : x.testBit a <;> cases h₂ : x.testBit b <;> simp_all
    · by_cases ib : i = b
      · subst i
        cases h₁ : x.testBit a <;> cases h₂ : x.testBit b <;> simp_all
      · simp [ia,ib,Ne.symm ia,Ne.symm ib]

lemma exchange_inj (a b : Nat) : Function.Injective (exchangeBits (a,b)) := by
  intro x y h
  apply Nat.eq_of_testBit_eq
  intro j
  have bits := fun i => congrArg (fun w : Nat => w.testBit i) h
  by_cases ja : j = a
  · subst j
    have z := bits b
    simp only [exchangeBit] at z
    split_ifs at z <;> simp_all
  · by_cases jb : j = b
    · subst j
      have z := bits a
      simp only [exchangeBit, if_pos rfl] at z
      exact z
    · simpa only [exchangeBit, if_neg ja, if_neg jb] using bits j

def permuteBits (ps : List (Nat × Nat)) (x : Nat) := ps.foldr exchangeBits x

lemma permute_inj (ps : List (Nat × Nat)) : Function.Injective (permuteBits ps) := by
  induction ps with
  | nil => exact fun _ _ h => h
  | cons p ps ih => exact (exchange_inj p.1 p.2).comp ih

lemma permute_xor (ps : List (Nat × Nat)) (x y : Nat) :
    permuteBits ps (x ^^^ y) = permuteBits ps x ^^^ permuteBits ps y := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    change exchangeBits p (permuteBits ps (x ^^^ y)) = _
    rw [ih]
    apply Nat.eq_of_testBit_eq
    intro i
    cases p
    simp only [permuteBits,List.foldr_cons,Nat.testBit_xor,exchangeBit]

lemma permute_op (ps : List (Nat × Nat)) (d : Bool) (x y : Nat) :
    permuteBits ps (op d x y) = op d (permuteBits ps x) (permuteBits ps y) := by
  induction ps with
  | nil => rfl
  | cons p ps ih =>
    change exchangeBits p (permuteBits ps (op d x y)) = _
    rw [ih]
    apply Nat.eq_of_testBit_eq
    intro i
    cases p
    cases d <;> simp only [op,cond_true,cond_false,permuteBits,List.foldr_cons,Nat.testBit_and,Nat.testBit_or,exchangeBit]

lemma permute_live {m T k t : Nat} {S : Finset Nat} (ps : List (Nat × Nat))
    (hm : permuteBits ps m = m) (ht : permuteBits ps T = T) (h : Live Z0 m T k t S) :
    Live Z0 m T k t (S.image (permuteBits ps)) := by
  induction h with
  | stop => simpa [ht] using (Live.stop (R:=Z0) (m:=m) (T:=T))
  | @un k t a U h ih =>
    rw [Finset.image_insert] at ih ⊢
    rw [permute_xor, hm] at ih
    exact .un ih
  | @bi k t d a b U hn _ h ih =>
    rw [Finset.image_insert, permute_op] at ih
    rw [Finset.image_insert, Finset.image_insert]
    exact .bi (fun h => hn (permute_inj ps h)) (al0 _ _ _) ih

lemma permute_first {d : Bool} {a b : Nat} {S V : Finset Nat} (ps : List (Nat × Nat))
    (h : Bi Z0 d a b S V) :
    Bi Z0 d (permuteBits ps a) (permuteBits ps b) (S.image (permuteBits ps)) (V.image (permuteBits ps)) := by
  obtain ⟨hne,U,rfl,rfl,_⟩ := h
  refine ⟨fun e => hne (permute_inj ps e),U.image (permuteBits ps),?_,?_,al0 _ _ _⟩
