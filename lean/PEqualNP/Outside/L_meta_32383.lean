  obtain ⟨⟨⟨⟨x, hx, hx1, hx2⟩, hp⟩, hL⟩, hc⟩ := h
  obtain rfl : x = e := Prod.ext (Nat.eq_of_beq_eq_true hx1) (Nat.eq_of_beq_eq_true hx2)
