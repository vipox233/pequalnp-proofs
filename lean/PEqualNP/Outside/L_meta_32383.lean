private theorem inputsBefore {d : Bool} {a b : ℕ} {S S' : Finset ℕ}
    (gate : Bi Z0 d a b S S') (fresh : op d a b ∉ S) :
    S = insert a (insert b (S'.erase (op d a b))) := by
  obtain ⟨_, U, rfl, rfl, _⟩ := gate
  have hu : op d a b ∉ U := fun h => fresh (by simp [h])
  simp [hu]

theorem swapRawGates {d f : Bool} {a b c e : ℕ} {S S₁ S₂ : Finset ℕ}
    (first : Bi Z0 d a b S S₁) (second : Bi Z0 f c e S₁ S₂)
    (fresh₁ : op d a b ∉ S) (fresh₂ : op f c e ∉ S₁)
    (ac : op d a b ≠ c) (ae : op d a b ≠ e)
    (ca : op f c e ≠ a) (cb : op f c e ≠ b) :
    ∃ U, Bi Z0 f c e S U ∧ Bi Z0 d a b U S₂ := by
  classical
  have out₁ : op d a b ∈ S₁ := by obtain ⟨_, U, _, rfl, _⟩ := first; simp
  have out₂ : op f c e ∈ S₂ := by obtain ⟨_, U, _, rfl, _⟩ := second; simp
  have different : op f c e ≠ op d a b := fun h => fresh₂ (by simpa [h] using out₁)
  have retained : op d a b ∈ S₂ := by
    obtain ⟨_, U, hs, rfl, _⟩ := second
    rw [hs] at out₁
    simp only [Finset.mem_insert] at out₁ ⊢
    exact Or.inr ((out₁.resolve_left ac).resolve_left ae)
  let U := insert a (insert b (S₂.erase (op d a b)))
  have hy : op f c e ∈ U := by simp [U, different, out₂]
  refine ⟨U, ⟨second.1, U.erase (op f c e), ?_, (Finset.insert_erase hy).symm, al0 _ _ _⟩,
    ⟨first.1, S₂.erase (op d a b), rfl, (Finset.insert_erase retained).symm, al0 _ _ _⟩⟩
  rw [inputsBefore first fresh₁, inputsBefore second fresh₂]
  ext x
  simp only [U, Finset.mem_insert, Finset.mem_erase]
  grind

def rawPairKey (a b : ℕ) := a + b

def RawFirst (R : ℕ → ℕ) (m T k t : ℕ) (S : Finset ℕ) (rank : ℕ) : Prop :=
  ∃ n d a b S₁, k = n + 1 ∧ R a ≠ 0 ∧ R b ≠ 0 ∧
    Bi Z0 d a b S S₁ ∧ Live Z0 m T n t S₁ ∧ rawPairKey a b = rank

private theorem nextMinimal {R : ℕ → ℕ} {m T n : ℕ} {S S₁ : Finset ℕ} {d a b}
    (gate : Bi Z0 d a b S S₁)
    (minimal : ∀ j < n + 1, ¬ Sol Z0 m T j (C m ({w | R w ≠ 0} ∪ (S : Set ℕ)))) :
    ∀ j < n, ¬ Sol Z0 m T j (C m ({w | R w ≠ 0} ∪ (S₁ : Set ℕ))) := by
  intro j hj sol
  refine minimal (j + 1) (by omega) (.bi (d := d) (a := a) (b := b)
    (Or.inl (Or.inr gate.sub.1)) (Or.inl (Or.inr gate.sub.2.1)) (al0 _ _ _) (sol.mono le_rfl ?_))
  rintro w ((hw | hw) | hw)
  · exact Or.inr (Or.inl (Or.inl hw))
  · rcases Finset.mem_insert.1 (gate.sub.2.2 hw) with rfl | hw
    · exact Or.inl rfl
    · exact Or.inr (Or.inl (Or.inr hw))
  · exact Or.inr (Or.inr hw)

private theorem rawOutputFresh {R : ℕ → ℕ} {m T k t a b : ℕ} {d} {S S₁ : Finset ℕ}
    (gate : Bi Z0 d a b S S₁) (tail : Live Z0 m T k t S₁)
    (minimal : ∀ n < k + 1, ¬ Sol Z0 m T n (C m ({w | R w ≠ 0} ∪ (S : Set ℕ)))) :
    op d a b ∉ S ∧ R (op d a b) = 0 := by
  have unavailable : op d a b ∉ C m ({w | R w ≠ 0} ∪ (S : Set ℕ)) := by
    intro available
    apply minimal k (by omega)
    refine tail.sol.mono le_rfl ?_
    intro w hw
    rcases Finset.mem_insert.1 (gate.sub.2.2 hw) with rfl | h
    · exact available
    · exact Or.inl (Or.inr h)
  refine ⟨fun h => unavailable (Or.inl (Or.inr h)), ?_⟩
  by_contra h
  exact unavailable (Or.inl (Or.inl h))

theorem liftRawFirst {R : ℕ → ℕ} {m T k t r a b : ℕ} {d} {S S₁ : Finset ℕ}
    (ha : R a ≠ 0) (hb : R b ≠ 0) (gate : Bi Z0 d a b S S₁)
    (minimal : ∀ n < k + 1, ¬ Sol Z0 m T n (C m ({w | R w ≠ 0} ∪ (S : Set ℕ))))
    (next : RawFirst R m T k t S₁ r) : RawFirst R m T (k + 1) t S r := by
  obtain ⟨j, f, c, e, S₂, rfl, hc, he, step, tail, rank⟩ := next
  have fresh₁ := rawOutputFresh gate (step.live tail) minimal
  have fresh₂ := rawOutputFresh step tail (nextMinimal gate minimal)
  obtain ⟨U, left, right⟩ := swapRawGates gate step fresh₁.1 fresh₂.1
    (fun h => hc (h ▸ fresh₁.2)) (fun h => he (h ▸ fresh₁.2))
    (fun h => ha (h ▸ fresh₂.2)) (fun h => hb (h ▸ fresh₂.2))
  exact ⟨j + 1, f, c, e, U, rfl, hc, he, left, right.live tail, rank⟩

theorem leastRawFront {R : ℕ → ℕ} {m T k t : ℕ} {S : Finset ℕ}
    (allowed : ∀ d a b, (R a = 0 ∨ R b = 0) → Al R d a b)
    (live : Live Z0 m T k t S)
    (minimal : ∀ n < k, ¬ Sol Z0 m T n (C m ({w | R w ≠ 0} ∪ (S : Set ℕ)))) :
    Live R m T k t S ∨ ∃ n d a b S₁, k = n + 1 ∧ R a ≠ 0 ∧ R b ≠ 0 ∧
      Bi Z0 d a b S S₁ ∧ Live Z0 m T n t S₁ ∧
      ∀ r, RawFirst R m T n t S₁ r → rawPairKey a b ≤ r := by
  classical
  rcases front allowed live minimal with done | ⟨n, d, a, b, S₁, hk, ha, hb, step, tail⟩
  · exact Or.inl done
  have existsRank : ∃ r, RawFirst R m T k t S r :=
    ⟨rawPairKey a b, n, d, a, b, S₁, hk, ha, hb, step, tail, rfl⟩
  clear hk ha hb step tail
  obtain ⟨j, f, c, e, S₂, hk, hc, he, chosen, rest, key⟩ := Nat.find_spec existsRank
  refine Or.inr ⟨j, f, c, e, S₂, hk, hc, he, chosen, rest, fun r later => ?_⟩
  rw [key]
  apply Nat.find_min' existsRank
  subst k
  exact liftRawFirst hc he chosen minimal later

def RankedChoice (R : Nat → Nat) (m T k t : Nat) (S : Finset Nat) (permit : Nat → Nat → Prop) : Prop :=
  Live R m T k t S ∨ ∃ n d a b U, k = n + 1 ∧ R a ≠ 0 ∧ R b ≠ 0 ∧
    Bi Z0 d a b S U ∧ Live Z0 m T n t U ∧
    (∀ r, RawFirst R m T n t U r → rawPairKey a b ≤ r) ∧ permit a b

lemma rankedChoiceOfLive {m T k t : ℕ} {S : Finset ℕ}
    (allowed : ∀ d a b, (R a = 0 ∨ R b = 0) → Al R d a b)
    (live : Live Z0 m T k t S)
    (minimal : ∀ n < k, ¬ Sol Z0 m T n (C m ({w | R w ≠ 0} ∪ (S : Set ℕ)))) :
    RankedChoice R m T k t S (fun _ _ => True) := by
  rcases leastRawFront allowed live minimal with h | ⟨n,d,a,b,U,hk,ha,hb,g,tail,lower⟩
  · exact Or.inl h
  · exact Or.inr ⟨n,d,a,b,U,hk,ha,hb,g,tail,lower,trivial⟩

noncomputable def rankedPairs (floor : ℕ) (h : X → X → Bool) (xs : List X) :=
  pairs (fun a b => Nat.ble floor (rawPairKey a.s b.s) && h a b) (fs xs)
