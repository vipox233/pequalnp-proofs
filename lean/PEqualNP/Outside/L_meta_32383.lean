  by_cases zero : t = 0
  · subst t
    exact orderedRootByOrbit (L := 13) (Or.inl rfl) root_p (by norm_num) (fun e he => (ir e he).toB 0)
      (by omega) subset live minimal monotone
  have tSmall : t < 13 := by
    have contained : C (mz 0) (S : Set ℕ) ⊆ C (mz 0) (WZ [] 0) := by
      rintro x (xS | constant)
      · exact subset xS
