theorem raw_parts {n m : ℕ} (S : Finset ℕ) (sub : S⊆Finset.range (n+m)) :
    ∃ (R : Finset (Fin n)) (B : Finset (Fin m)),
      R.image (fun a => a.val) ∪ B.image (fun c => n+c.val)=S ∧ S.card=R.card+B.card := by
  classical
  let R := Finset.univ.filter (fun a : Fin n => a.val∈S)
  let B := Finset.univ.filter (fun c : Fin m => n+c.val∈S)
  have joined : R.image (fun a => a.val) ∪ B.image (fun c => n+c.val)=S := by
    ext i
    constructor
    · intro hi
      rcases Finset.mem_union.mp hi with h|h
      · obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp h
        exact (Finset.mem_filter.mp ha).2
      · obtain ⟨c,hc,rfl⟩ := Finset.mem_image.mp h
        exact (Finset.mem_filter.mp hc).2
    · intro hi
      have bound := Finset.mem_range.mp (sub hi)
      by_cases low : i<n
      · exact Finset.mem_union_left _ (Finset.mem_image.mpr
          ⟨⟨i,low⟩,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hi⟩,rfl⟩)
      · have eq : n+(i-n)=i := by omega
        let c : Fin m := ⟨i-n,by omega⟩
        have cv : n+c.val=i := eq
        exact Finset.mem_union_right _ (Finset.mem_image.mpr
          ⟨c,Finset.mem_filter.mpr ⟨Finset.mem_univ _,cv ▸ hi⟩,cv⟩)
  have separate : Disjoint (R.image (fun a => a.val)) (B.image (fun c => n+c.val)) := by
    apply Finset.disjoint_left.mpr
    rintro i hi hj
    obtain ⟨a,_,ha⟩ := Finset.mem_image.mp hi
    obtain ⟨c,_,hc⟩ := Finset.mem_image.mp hj
    have small := a.isLt
    change n+c.val=i at hc
    change a.val=i at ha
    omega
  refine ⟨R,B,joined,?_⟩
  rw [←joined,Finset.card_union_of_disjoint separate,Finset.card_image_of_injective _ Fin.val_injective,
    Finset.card_image_of_injective _ (show Function.Injective (fun c : Fin m => n+c.val) from
      fun _ _ eq => Fin.ext (Nat.add_left_cancel eq))]

def FarRows {n m : ℕ} (G : Fin n → Fin m → Bool) := ∀ a b : Fin n, a≠b →
  6≤(Finset.univ.filter (fun c => G a c≠G b c)).card
def FarCols {n m : ℕ} (G : Fin n → Fin m → Bool) := ∀ c d : Fin m, c≠d →
  6≤(Finset.univ.filter (fun a => G a c≠G a d)).card

theorem pure_limit {n m : ℕ} (G : Fin n → Fin m → Bool) (D : Circuit)
    (hr : FarRows G) (hc : FarCols G) (back : ReadsBack (n+m) D) (rep : Represents G D)
    (S : Finset ℕ) (sub : S⊆Finset.range (n+m)) (tree : Partition.tree69 (n+m) D S ∅) : S.card≤4 := by
  classical
  obtain ⟨R,B,join,card⟩ := raw_parts S sub
  obtain ⟨region,root,h⟩ := tree
  dsimp only at h
  obtain ⟨inside,rootIn,last,_,gates,uses⟩ := h
  have fourApp := four n m G D R B region root
  dsimp only at fourApp
  rw [join] at fourApp
  rw [card]
  apply fourApp (fun a b h => le_trans (by decide : 5≤6) (hr a b h))
    (fun a b h => le_trans (by decide : 5≤6) (hc a b h)) back rep
    (fun _ hj => Finset.mem_range.mpr (Partition.ordinary_index69 (inside hj))) rootIn _ last uses
  intro k hk
  simpa using gates k hk

theorem entry_limit {n m : ℕ} (G : Fin n → Fin m → Bool) (D : Circuit)
    (hr : FarRows G) (hc : FarCols G) (back : ReadsBack (n+m) D) (rep : Represents G D)
    (S : Finset ℕ) (b : ℕ) (sub : S⊆Finset.range (n+m)) (tree : Partition.tree69 (n+m) D S {b}) : S.card≤6 := by
  classical
  obtain ⟨R,B,join,card⟩ := raw_parts S sub
  obtain ⟨region,root,h⟩ := tree
  dsimp only at h
  obtain ⟨inside,rootIn,last,entry,gates,uses⟩ := h
  obtain ⟨outside,low,count⟩ := entry b (Finset.mem_singleton_self b)
  have sixApp := six n m G D R B region root b
  dsimp only at sixApp
  rw [join] at sixApp
  rw [card]
  apply sixApp hr hc back rep (fun _ hj => Finset.mem_range.mpr (Partition.ordinary_index69 (inside hj)))
    rootIn outside low count _ last uses
  intro k hk
  simpa using gates k hk

theorem distance_data {n m : ℕ} (G : Fin n → Fin m → Bool) (large : 3<n+m)
    (hr : FarRows G) (hc : FarCols G) :
    DifferentRows G ∧ DifferentCols G ∧ (∃ a c d, G a c≠G a d) ∧ (∃ a b c, G a c≠G b c) := by
  classical
  have dims {i j : ℕ} (H : Fin i → Fin j → Bool) (dist : FarRows H) (two : 2 ≤ i) : 6≤j := by
    let a : Fin i := ⟨0,by omega⟩
    let b : Fin i := ⟨1,by omega⟩
    have neq : a≠b := fun eq => by have he := congrArg Fin.val eq; change 0=1 at he; omega
    have h := dist a b neq
    have k := (Finset.univ.filter (fun c => H a c≠H b c)).card_le_univ
    simp only [Fintype.card_fin] at k
    omega
  have nr : 2≤n := by
    by_contra! small
    have h := dims (fun c a => G a c) hc (by omega)
    omega
  have nc : 2 ≤ m := by
    have h := dims G hr nr; omega
  have different {i j : ℕ} (H : Fin i → Fin j → Bool) (dist : FarRows H) : DifferentRows H := by
    intro a b neq
    have h := dist a b neq
    obtain ⟨c,mem⟩ := Finset.card_pos.mp (lt_of_lt_of_le (by decide : 0<6) h)
    exact ⟨c,(Finset.mem_filter.mp mem).2⟩
  have dr := different G hr
  have dc := different (fun c a => G a c) hc
  have one {i : ℕ} (h : 2 ≤ i) : ∃ a b : Fin i, a≠b := by
    refine ⟨⟨0,by omega⟩,⟨1,by omega⟩,?_⟩
    intro eq
    have he := congrArg Fin.val eq; change 0=1 at he; omega
  obtain ⟨a,b,rne⟩ := one nr
  obtain ⟨c,d,cne⟩ := one nc
  obtain ⟨row,ha⟩ := dc c d cne
  obtain ⟨col,hh⟩ := dr a b rne
  exact ⟨dr,dc,⟨row,c,d,ha⟩,⟨a,b,col,hh⟩⟩

end PEqualNP.Outside.L_meta_25565_aux

open PEqualNP.Outside.L_meta_25565_aux in
theorem PEqualNP.Outside.L_meta_25565 : ∀ (n m : ℕ) (G : Fin n → Fin m → Bool) (C : PEqualNP.CircuitLowerBounds.Circuit),
  (∀ firstRow secondRow : Fin n, firstRow ≠ secondRow → 6 ≤ (Finset.univ.filter (fun col => G firstRow col ≠ G secondRow col)).card) →
  (∀ firstCol secondCol : Fin m, firstCol ≠ secondCol → 6 ≤ (Finset.univ.filter (fun row => G row firstCol ≠ G row secondCol)).card) →
  PEqualNP.MetaComplexity.FanInTwo C → PEqualNP.Represents.Represents G C →
  34 * (n + m) ≤ 33 * C.size + 105 := by
  intro n m G C rows cols fan rep
  by_cases small : n+m≤3
  · omega
  obtain ⟨dr,dc,across,down⟩ := distance_data G (by omega) rows cols
  obtain ⟨D,smaller,repD,back,shape,pos,last,live⟩ := normalized C fan rep across down
  have out := output_not_raw repD across down
  have missing := few_missing G D back repD out dr dc
  change n+m≤used (n+m) D+2 at missing
  have balance := budget_eq D shape back pos live
  have cap := account (n+m) D 4 6 shape back pos last live
    (pure_limit G D rows cols back repD) (entry_limit G D rows cols back repD)
  norm_num at cap
  omega
