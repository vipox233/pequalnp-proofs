def onWit : List Gate := [⟨.or, [7, 1]⟩, ⟨.or, [7, 6]⟩, ⟨.or, [6, 5]⟩, ⟨.or, [4, 3]⟩, ⟨.or, [3, 2]⟩, ⟨.or, [9, 11]⟩, ⟨.and, [8, 12]⟩, ⟨.or, [8, 12]⟩, ⟨.and, [15, 10]⟩, ⟨.or, [9, 2]⟩, ⟨.and, [17, 4]⟩, ⟨.or, [14, 18]⟩, ⟨.or, [19, 0]⟩, ⟨.and, [13, 20]⟩, ⟨.or, [16, 21]⟩]

theorem onWitBasis : ∀ g ∈ onWit,
    (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2 := by
  intro g hg
  simp only [onWit, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

set_option maxRecDepth 12000 in
