lemma fcChk_eq {L : List (List (List (ℕ × ℕ × ℕ × ℕ × ℕ × List W)))} {E Q : List (ℕ × ℕ)} {Z K : ℕ}
    (hT : fcTV (lz Z) (mz Z) (pL (Q.map fun _ => 16)) K L) (t H ph : ℕ) :
