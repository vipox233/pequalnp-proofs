theorem rowTrace {n : Nat} (e : Model.Row → Fin n → Bool)
    (f : BF n) (roots : List (Model.Wire Model.Row)) :
    ∀ k L, R f k L → ∀ p bank, Model.Reach true roots p bank →
      (∀ w ∈ L, Model.Available true bank (fun r => w (e r))) →
      ∃ q out, q ≤ p+k ∧ Model.Reach true roots q out ∧ Model.Available true out (fun r => f (e r)) := by
  intro k
  induction k with
  | zero =>
    intro L hr p bank h sup
    exact ⟨p,bank,by omega,h,sup f hr⟩
  | succ k ih =>
    intro L hr p bank h sup
    rcases hr with hf | ⟨t,⟨x,hx,y,hy,hop⟩,tail⟩
    · exact ⟨p,bank,by omega,h,sup f hf⟩
    have step (op : Bool) (a b : Model.Wire Model.Row)
        (ha : Model.Available true bank a) (hb : Model.Available true bank b)
        (eqt : (fun r => t (e r)) = Model.combine op a b) :
        ∃ q out, q ≤ p+(k+1) ∧ Model.Reach true roots q out ∧ Model.Available true out (fun r => f (e r)) := by
      have hn := Model.Reach.two op h ha hb
      obtain ⟨q,out,hq,hout,hf⟩ := ih (t::L) tail (p+1) _ hn (by
        intro w hw
        rcases List.mem_cons.mp hw with rfl | hw
        · rw [eqt]
          exact Or.inl List.mem_cons_self
        · exact Model.available_cons _ (sup w hw))
      exact ⟨q,out,by omega,hout,hf⟩
    rcases hop with rfl | rfl | rfl
    · exact step false _ _ (sup x hx) (sup y hy) rfl
    · exact step true _ _ (sup x hx) (sup y hy) rfl
    · exact step false _ _ (sup x hx) (Model.avail_inv rfl (sup y hy)) rfl

theorem atlasLowerToR {n : Nat} (e : Model.Row → Fin n → Bool)
    (f : BF n) (L : List (BF n)) (roots : List Model.Sig) (target : Model.Sig) (bound : Nat)
    (lower : Model.Lower true roots target bound)
    (hit : (fun r => f (e r)) = Model.observe target)
    (supply : ∀ w ∈ L, Model.Available true (roots.map Model.observe) (fun r => w (e r))) :
    ∀ k, R f k L → bound ≤ k := by
  intro k hr
  obtain ⟨q,out,hq,chain,hf⟩ := rowTrace e f (roots.map Model.observe) k L hr 0 _ Model.Reach.start supply
  rw [hit] at hf
  have := lower q out chain hf
  omega
