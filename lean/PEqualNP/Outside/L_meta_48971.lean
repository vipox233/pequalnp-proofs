def point (indices : Fin 6 → Nat) (dual : Bool) (r : Row) (i : Fin 6) : Bool :=
  if indices i < 4 then Bool.xor (r.val.testBit (indices i)) dual else false

theorem point_available (indices : Fin 6 → Nat) (dual : Bool) (i : Fin 6) :
    Available true ([(inputs.getD 0 zero), (inputs.getD 1 zero), (inputs.getD 2 zero), (inputs.getD 3 zero)].map observe)
      (fun r => point indices dual r i) := by
  by_cases small : indices i < 4
  · let j : Fin 4 := ⟨indices i, small⟩
    have memAll : ∀ k : Fin 4, inputs.getD k.val zero ∈ [inputs.getD 0 zero, inputs.getD 1 zero,
        inputs.getD 2 zero, inputs.getD 3 zero] := by decide +kernel
    have colAll : ∀ (k : Fin 4) (r : Row), bit r (inputs.getD k.val zero) = r.val.testBit k.val := by decide +kernel
    have avail : Available true ([inputs.getD 0 zero, inputs.getD 1 zero, inputs.getD 2 zero, inputs.getD 3 zero].map observe)
        (observe (inputs.getD j.val zero)) := Or.inl (List.mem_map_of_mem (memAll j))
    have eq : (fun r => point indices dual r i) =
        if dual then inv (observe (inputs.getD j.val zero)) else observe (inputs.getD j.val zero) := by
      cases dual
      · funext r
        change point indices false r i = bit r (inputs.getD j.val zero)
        simp only [point, if_pos small, Bool.xor_false]
        exact (colAll j r).symm
      · funext r
        change point indices true r i = !(bit r (inputs.getD j.val zero))
        simp only [point, if_pos small, Bool.xor_true]
        exact congrArg Bool.not (colAll j r).symm
    rw [eq]
    cases dual
    · exact avail
    · exact avail_inv rfl avail
  · exact Or.inr (Or.inl ⟨false, funext (fun r => by simp [point, small])⟩)

theorem atlasOrbitLeaf (f : BF 6) (indices : Fin 6 → Nat) (dual : Bool)
    (h : (fun r => f (point indices dual r)) =
      (if dual then inv (observe (target gbAtlas)) else observe (target gbAtlas))) :
    ∀ k, R f k (L0 6) → 7 ≤ k := by
  intro k hr
  have supply : ∀ w ∈ L0 6, Available true ((roots gbAtlas).map observe)
      (fun r => w (point indices dual r)) := by
    intro w hw
    change w ∈ fF 6 :: List.ofFn (fun i : Fin 6 => fV i) at hw
    rcases List.mem_cons.mp hw with rfl | hw
    · exact Or.inr (Or.inl ⟨false,rfl⟩)
    · obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hw
      exact point_available indices dual i
  obtain ⟨q,out,hq,chain,hf⟩ :=
    rowTrace (point indices dual) f ((roots gbAtlas).map observe) k (L0 6) hr 0 _ Model.Reach.start supply
  rw [h] at hf
  have avail : Available true out (observe (target gbAtlas)) := by
