theorem PEqualNP.Outside.R_meta_9059_2
    (hTopAndExtract : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) (x5 : PEqualNP.CircuitLowerBounds.Circuit),
