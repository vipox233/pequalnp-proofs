theorem input_index : ∀ w ∈ inputs, ∃ i : Fin 5, vinput i = w := by
  intro w hw
  simp only [inputs, List.mem_cons, List.not_mem_nil, or_false] at hw
  rcases hw with rfl|rfl|rfl|rfl|rfl
  all_goals first | exact ⟨0,rfl⟩ | exact ⟨1,rfl⟩ | exact ⟨2,rfl⟩ | exact ⟨3,rfl⟩ | exact ⟨4,rfl⟩

theorem restricted_available : ∀ i j : Fin 5, holds (remaining i).toFinset (restriction i (vinput j)) := by
  intro i j
  by_cases h : i = j
  · subst j
    exact Or.inl (projected_input i)
  · right; right
    exact ⟨_, List.mem_toFinset.mpr (List.mem_map.mpr ⟨j, by simp [Ne.symm h],rfl⟩), Or.inl rfl⟩

def changes (w : W) (r : Fin 60) : Bool :=
  w.getLsbD (60+r.val) != w.getLsbD r.val

def rowIndex (i j : Fin 5) (op : Fin 4) : Fin 60 :=
  Fin.ofNat 60 ((#[0, 0, 0, 0, 9, 2, 2, 9, 2, 9, 9, 2, 2, 16, 16, 2, 2, 23, 23, 2, 27, 1, 1, 27, 0, 0, 0, 0, 1, 27, 27, 1, 1, 34, 34, 1, 1, 41, 41, 1, 26, 7, 7, 26, 7, 26, 26, 7, 0, 0, 0, 0, 7, 46, 46, 7, 7, 53, 53, 7, 32, 13, 13, 32, 13, 32, 32, 13, 13, 45, 45, 13, 0, 0, 0, 0, 13, 59, 59, 13, 38, 19, 19, 38, 19, 38, 38, 19, 19, 51, 51, 19, 19, 58, 58, 19, 0, 0, 0, 0])[20 * i.val + 4 * j.val + op.val]!)

