theorem k4Rename_words : ∀ i j : Fin 4, i ≠ j →
    k4Rename i j (k4Word i) = k4Word 0 ∧
    k4Rename i j (k4Word j) = k4Word 1 ∧
    ∀ q : Fin 4, k4Rename i j (k4Word q) ∈ k4inputs := by decide +kernel

theorem k4Goal_bit : ∀ r : Fin 120, goal[r.val]'r.isLt = decide (60 ≤ r.val) := by
  decide +kernel

theorem k4Rename_goal (i j : Fin 4) : k4Rename i j goal = goal := by
  apply BitVec.eq_of_getElem_eq
  intro n hn
  let k : Fin 120 := ⟨n, hn⟩
  change (selectRows (k4Rows i j) goal)[k.val] = goal[k.val]
  rw [selectRows_bit]
  change goal[(k4Rows i j k).val] = goal[k.val]
  simp only [k4Goal_bit]
  have half : 60 ≤ (k4Rows i j k).val ↔ 60 ≤ k.val := by
    simp only [k4Rows, Fin.val_ofNat]
    let index := (#[0x0, 0x3bcdeb38bdab49ca307b9ac5a928398a418820, 0x316bd69ddf3599c6507b98d5a882184093a0c5, 0x2519c1fcdf759bdb15a20e9314622040d6396a, 0x3bcd6f2e6ad8a4a0c72e2f5b5272845e418440, 0x0, 0x1cb6b15dd7379499072e2b7b50811881384a2f, 0x10649cbcd77796adcc54a138bc6120817ae2d4, 0x316ade8e62daa208230777ae6671849e939905, 0x1cb63558adaf4204430775be65263a0b38464f, 0x0, 0x4120c16ae2f462dcd5461393ce64a0bbd7799, 0x25184de839925188240737aee6f6ae28d62dca, 0x1063a4b28466f184440735bee5ab63957adb14, 0x411901184a6f399092dab7c518b6b95bd73b9, 0x0] : Array Nat)[4 * i.val + j.val]!
    change 60 ≤ (k.val / 60 * 60 + ((index >>> (5 * (k.val % 30))) &&& 31)) % 120 ↔ _
    have hmask : (index >>> (5 * (k.val % 30))) &&& 31 < 32 := by
      rw [show (31 : Nat) = 2 ^ 5 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]
      exact Nat.mod_lt _ (by decide)
    have hk := k.isLt
    omega
  simp only [half]

theorem k4Word_cover {w : W} (hw : w ∈ k4inputs.toFinset) : ∃ i : Fin 4, k4Word i = w := by
  rw [List.mem_toFinset] at hw
  simp only [k4inputs, List.mem_cons, List.not_mem_nil, or_false] at hw
  rcases hw with rfl | rfl | rfl | rfl
  all_goals first | exact ⟨0, rfl⟩ | exact ⟨1, rfl⟩ | exact ⟨2, rfl⟩ | exact ⟨3, rfl⟩

set_option maxRecDepth 32000 in
set_option maxHeartbeats 0 in
theorem k4Search : ∀ v : Fin 4,
    search 5 (((ops (k4Word 0) (k4Word 1)).getD v.val 0) :: k4inputs) = false := by
  decide +kernel

theorem signed_reject {k : ℕ} {ws : List W} (hn : ws.Nodup) (hf : search k ws = false)
    {t : W} (ht : t = goal ∨ t = ~~~goal) (h : SignedBuild k ws.toFinset t) : False := by
  have nt : goal ≠ 0 ∧ goal ≠ ~~~0 ∧ ~~~goal ≠ 0 ∧ ~~~goal ≠ ~~~0 := by decide
  rcases ht with rfl | rfl
  all_goals
    rcases h with h | h | h | h
    · first | exact nt.1 h | exact nt.2.2.1 h
    · first | exact nt.2.1 h | exact nt.2.2.2 h
    · exact Bool.noConfusion (hf.symm.trans (search_complete (by simp) k ws hn h))
    · exact Bool.noConfusion (hf.symm.trans (search_complete (by simp) k ws hn h))

theorem no_six_k4 (t : W) (ht : t = goal ∨ t = ~~~goal)
    (run : build basicOps t 6 k4inputs.toFinset) : False := by
  obtain ⟨s, hs, hl⟩ := compress run
  rcases first_live (k := 5) hl with endcase | ⟨a,ha,b,hb,hab,z,hz,_,rest,he,tail⟩
  · have mt := hs (show t ∈ s by simp [endcase])
    obtain ⟨i, hi⟩ := k4Word_cover mt
    have impossible : ∀ i : Fin 4, k4Word i ≠ goal ∧ k4Word i ≠ ~~~goal := by decide
    rcases ht with rfl | rfl
    · exact (impossible i).1 hi
    · exact (impossible i).2 hi
  · obtain ⟨i, rfl⟩ := k4Word_cover (hs ha)
    obtain ⟨j, rfl⟩ := k4Word_cover (hs hb)
    have hij : i ≠ j := fun e => hab (congrArg k4Word e)
    have ha := k4Rename_words i j hij
    let f := k4Rename i j
    have mapOp : ∀ a b z, z ∈ basicOps a b → f z ∈ basicOps (f a) (f b) :=
      ops_map_of (selectRows_land _) (selectRows_lor _) (selectRows_neg _)
    have hZ := mapOp _ _ _ hz
    change f z ∈ basicOps (k4Rename i j (k4Word i)) (k4Rename i j (k4Word j)) at hZ
    rw [ha.1, ha.2.1] at hZ
    obtain ⟨v, hv⟩ := index_of_op _ _ _ hZ
    have ht' : f t = goal ∨ f t = ~~~goal := by
      rcases ht with rfl | rfl
      · exact .inl (k4Rename_goal i j)
      · right
        change selectRows (k4Rows i j) (~~~goal) = ~~~goal
        rw [selectRows_neg]
        exact congrArg (fun w : W => ~~~w) (k4Rename_goal i j)
    have nd : ∀ v : Fin 4, (((ops (k4Word 0) (k4Word 1)).getD v.val 0) :: k4inputs).Nodup := by decide
    apply signed_reject (nd v) (k4Search v) ht'
    apply live_transport mapOp tail
    intro w hw
    rcases Finset.mem_insert.mp hw with hwz | hr
    · subst w
      refine .inr (.inr ⟨f z, ?_, .inl rfl⟩)
      exact List.mem_toFinset.mpr (List.mem_cons.mpr (Or.inl hv.symm))
    · have hraw := hs (he ▸ Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hr))
      obtain ⟨q, rfl⟩ := k4Word_cover hraw
      exact .inr (.inr ⟨_, List.mem_toFinset.mpr (List.mem_cons_of_mem _ (ha.2.2 q)), .inl rfl⟩)

theorem projected_impossible (i : Fin 5) (t : W) (ht : t = goal ∨ t = ~~~goal)
    (h : SignedBuild 6 (remaining i).toFinset (restriction i t)) : False := by
  rw [remaining_same] at h
  have signs : restriction i t = goal ∨ restriction i t = ~~~goal := by
    rcases ht with rfl|rfl
    · exact .inl (projected_goal i)
    · right
      change selectRows (sourceRow i) (~~~goal) = ~~~goal
      rw [selectRows_neg]
      exact congrArg (fun w : W => ~~~w) (projected_goal i)
  have nt : goal ≠ 0 ∧ goal ≠ ~~~0 ∧ ~~~goal ≠ 0 ∧ ~~~goal ≠ ~~~0 := by decide
  rcases signs with ht' | ht' <;> rw [ht'] at h
  all_goals
    rcases h with h | h | h | h
    · first | exact nt.1 h | exact nt.2.2.1 h
    · first | exact nt.2.1 h | exact nt.2.2.2 h
    · exact no_six_k4 _ (by simp) h
    · exact no_six_k4 _ (by simp) h

theorem no_eight_binary (t : W) (ht : t = goal ∨ t = ~~~goal)
    (run : build basicOps t 8 inputs.toFinset) : False := by
  obtain ⟨s, hs, hl⟩ := compress run
  rcases first_live (k := 7) hl with endcase | ⟨a,ha,b,hb,hab,z,hz,_,rest,he,tail⟩
  · have tx : t ∈ s := by simp [endcase]
    obtain ⟨i, hi⟩ := input_index _ (List.mem_toFinset.mp (hs tx))
    rcases ht with rfl|rfl
    · exact (input_not_goal i).1 hi
    · exact (input_not_goal i).2 hi
  · obtain ⟨i, rfl⟩ := input_index _ (List.mem_toFinset.mp (hs ha))
    obtain ⟨j, rfl⟩ := input_index _ (List.mem_toFinset.mp (hs hb))
    have hij : i ≠ j := fun eq => hab (congrArg vinput eq)
    have sub : rest ⊆ inputs.toFinset := by
      intro u hu
      exact hs (he ▸ Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hu))
    have keep := raw_present ht i j hij hz rest sub tail
    have pg : vinput i ≠ t := by rcases ht with rfl|rfl; exact (input_not_goal i).1; exact (input_not_goal i).2
    apply projected_impossible i t ht
    apply live_transport_save (ops_map_of (selectRows_land _) (selectRows_lor _) (selectRows_neg _))
      tail (Finset.mem_insert_of_mem keep) pg (projected_input i)
    intro w hw
    rcases Finset.mem_insert.mp hw with rfl|hw
    · exact restricted_new i j w hz
    · obtain ⟨k,rfl⟩ := input_index _ (List.mem_toFinset.mp (sub hw))
      exact restricted_available i k

def witness : Circuit :=
  ⟨[⟨.or, [0, 1]⟩, ⟨.and, [0, 1]⟩,
    ⟨.or, [2, 3]⟩, ⟨.and, [2, 3]⟩, ⟨.or, [4, 8]⟩, ⟨.and, [7, 9]⟩,
    ⟨.and, [4, 8]⟩, ⟨.or, [6, 11]⟩, ⟨.and, [5, 10]⟩, ⟨.and, [12, 13]⟩], 14⟩

theorem witness_mono : Monotone2 witness := by
  simp [Monotone2, witness]

theorem witness_eval : ∀ x : Fin 5 → Bool, witness.eval (List.ofFn x) = targetFun x := by
  decide

end Cofactor

theorem Cofactor :
    ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 5 (fun x : Fin 5 → Bool => Nat.testBit 0xe8808000 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = Nat.testBit 0xe8808000 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0) := by
  intro s hs
  obtain ⟨C, fits, size, computes⟩ := hs
  by_cases hasNot : ∃ g ∈ C.gates, g.op = PEqualNP.CircuitLowerBounds.GateOp.not
  · obtain ⟨g, mem, op⟩ := hasNot
    have short : Cofactor.binaryCost C.gates < C.size :=
      (List.length_filter_lt_length_iff_exists
        (p := Cofactor.isBinary)).mpr
        ⟨g, mem, by simp [Cofactor.isBinary, op]⟩
    have bound := Cofactor.bound_from_impossible
      8 Cofactor.no_eight_binary C.gates C.output fits computes
    refine ⟨Cofactor.witness, Cofactor.witness_mono,
      ?_, Cofactor.witness_eval⟩
    change 10 ≤ s
    omega
  · refine ⟨C, ?_, size, computes⟩
    intro g mem
    obtain ⟨op, cap⟩ := fits g mem
    change g.op = .and ∨ g.op = .or ∨ g.op = .not at op
    exact ⟨op.elim Or.inl (fun h => h.elim Or.inr (fun eq => (hasNot ⟨g,mem,eq⟩).elim)), cap⟩

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
def target (x : Fin 6 → Bool) := Nat.testBit (4276808362 * 2 ^ 32 + 3937053354) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)
def base (x : Fin 5 → Bool) := Nat.testBit 3900735488 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0)
def rotation : Fin 6 → Fin 6 := ![5,0,1,2,3,4]
def rotated (x : Fin 6 → Bool) := target (x ∘ rotation)
def plusGate (C : Circuit) : Gate := ⟨.or,[0,C.output]⟩
def plus (C : Circuit) : Circuit := ⟨C.gates ++ [plusGate C],6+C.gates.length⟩
theorem plusMono (C : Circuit) (hc : Monotone2 C) : Monotone2 (plus C) := by
  intro g hg
  rcases List.mem_append.mp hg with old | newGate
  · exact hc g old
  · obtain rfl := List.mem_singleton.mp newGate
    simp [plusGate]
theorem plusEval (C : Circuit) (x : Fin 6 → Bool) :
    (plus C).eval (List.ofFn x) = (x 0 || C.eval (List.ofFn x)) := by
  change (Lift.wiresFrom (C.gates ++ [plusGate C]) (List.ofFn x)).getD (6+C.gates.length) false = _
  rw [Lift.wiresFrom_append]
  let w := Lift.wiresFrom C.gates (List.ofFn x)
  change (w ++ [GateOp.or.eval ([0,C.output].map (fun i => w.getD i false))]).getD (6+C.gates.length) false = _
  rw [Lift.getD_snoc_len _ _ _ _ (by simp [w,Lift.length_wiresFrom])]
  have first : w.getD 0 false = x 0 := by
    rw [show w = Lift.wiresFrom C.gates (List.ofFn x) from rfl,Lift.getD_wiresFrom _ _ _ (by simp)]
    simp [List.getD_eq_getElem?_getD]
  change _ = (x 0 || w.getD C.output false)
  simp only [List.map_cons,List.map_nil,first]
  simp [GateOp.eval]
theorem lifted
    (small : ∀ s : ℕ, HasCircuitSize 5 base s → ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧
      ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = base x)
    (s : ℕ) (hs : HasCircuitSize 6 target s) :
    ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = target x := by
  have signed := Lift.relabel_size (n := 6) (m := 6) rotation target s hs
  change HasCircuitSize 6 rotated s at signed
  have dep : ∃ x : Fin 6 → Bool, rotated (Function.update x (Fin.last 5) (!x (Fin.last 5))) ≠ rotated x := by
    exact ⟨fun _ => false, by decide +kernel⟩
  have nc : ∃ y z : Fin 5 → Bool, rotated (Fin.snoc y false) ≠ rotated (Fin.snoc z false) := by
    exact ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  obtain ⟨k,hk,sm⟩ := Lift.gate_elim_one 5 rotated false s dep nc signed
  have fixed : (fun y : Fin 5 → Bool => rotated (Fin.snoc y false)) = base := by
    funext y
    exact (by decide +kernel : ∀ a : Fin 5 → Bool, rotated (Fin.snoc a false) = base a) y
  rw [fixed] at sm
  obtain ⟨C,hm,hsize,eval⟩ := small k sm
  let D := Lift.relabel 5 6 Fin.succ C
  have mono : Monotone2 D := by
    intro q hq
    obtain ⟨o,ho,rfl⟩ := List.mem_map.mp hq
    exact ⟨(hm o ho).1, by simpa [Lift.relGate] using (hm o ho).2⟩
  have sz : D.gates.length=C.gates.length := by simp [D,Lift.relabel]
  refine ⟨plus D, plusMono D mono, ?_, fun x => ?_⟩
  · change (D.gates ++ [plusGate D]).length ≤ s
    simp only [List.length_append,List.length_singleton,sz]
    change C.gates.length ≤ k at hsize
    omega
  · have agrees : D.eval (List.ofFn x) = C.eval (List.ofFn (x ∘ Fin.succ)) :=
      (Lift.rel_fold 5 6 Fin.succ C.gates _ _ (Lift.rel_init 5 6 Fin.succ x)).2.2 C.output
    rw [plusEval,agrees,eval]
    exact (by decide +kernel : ∀ y : Fin 6 → Bool, (y 0 || base (y ∘ Fin.succ))=target y) x

end PEqualNP.Outside.L_meta_40011

theorem PEqualNP.Outside.L_meta_40011 : (∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4276808362 * 2 ^ 32 + 3937053354) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4276808362 * 2 ^ 32 + 3937053354) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) :=
  PEqualNP.Outside.L_meta_40011.lifted PEqualNP.Outside.L_meta_40011.Cofactor
