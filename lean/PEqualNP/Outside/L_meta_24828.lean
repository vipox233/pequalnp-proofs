  refine ⟨⟨[⟨.or, [0, 1]⟩, ⟨.and, [1, 2]⟩, ⟨.or, [4, 5]⟩, ⟨.and, [3, 6]⟩, ⟨.or, [7, 8]⟩, ⟨.and, [6, 8]⟩, ⟨.or, [9, 10]⟩, ⟨.not, [12]⟩, ⟨.or, [11, 13]⟩], 14⟩, ?_, by decide, by decide +kernel⟩
  simp [PEqualNP.MetaComplexity.FanInTwo]
