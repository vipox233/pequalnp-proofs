theorem PEqualNP.Outside.L_meta_22003 : ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 10 ∧ ∀ i j : Fin 6, C.eval (List.ofFn fun k : Fin 6 => decide (k = i ∨ k = j)) = (17200 : ℕ).testBit (6 * min i.val j.val + max i.val j.val) := by
