theorem rows_related : List.Forall₂ related restricted flipped := by
  unfold restricted flipped
  refine List.Forall₂.cons (.inl rfl) ?_
  refine List.Forall₂.cons (.inr (.inr rfl)) ?_
  refine List.Forall₂.cons (.inl rfl) ?_
  refine List.Forall₂.cons (.inl rfl) ?_
  refine List.Forall₂.cons (.inl rfl) ?_
  refine List.Forall₂.cons (.inl rfl) ?_
