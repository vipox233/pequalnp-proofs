    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    let r : Row := ⟨j,hj⟩
    exact (eval8 C legal C.output r).trans ((computes (sample8 r)).trans (table8 r).symm)
  have out := get_rep (u := true) (execute C.gates raw) C.output
  rw [goalEq] at out
  unfold Repr at out
  have pg : bit 0 fullSig = false := by decide +kernel
  rw [nrm_id pg] at out
  obtain ⟨k,S,hk,run,sub⟩ := extract (u := true) C.gates raw legal (by simp) fullProper
    (out.resolve_right (fun h => h fullProper))
  have ns : raw.all plainWord = true := by decide +kernel
  rw [nrm_map ns] at sub
  have steps := list_run run S.toList (Finset.nodup_toList _) (by simp)
  have supply0 : supply true (raw.map observe) (S.toList.map observe) := by
    intro f hf
    obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hf
    exact Or.inl (List.mem_map_of_mem (sub a (Finset.mem_toList.mp ha)))
  obtain ⟨q,bank,built,hit,limit⟩ := contraction (observe_proper fullProper)
    steps (raw.map observe) Reach.start supply0
  have hq := fullLower q bank built hit
  omega

lemma replace (gates : List Gate) (o : Nat)
    (fit : ∀ g ∈ gates, (g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧ g.inputs.length ≤ 2)
    (correct : ∀ x : Fin 8 → Bool, (Circuit.mk gates o).eval (List.ofFn x) = target8 x) :
    ∃ (gs : List Gate) (out : Nat), (∀ g ∈ gs, (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2) ∧
      gs.length ≤ gates.length ∧ ∀ x : Fin 8 → Bool, (Circuit.mk gs out).eval (List.ofFn x) = target8 x := by
  classical
  by_cases mono : ∀ g ∈ gates, g.op ≠ GateOp.not
  · exact ⟨gates,o,noNotReuse fit mono,Nat.le_refl _,correct⟩
  push Not at mono
  obtain ⟨g,hg,hop⟩ := mono
  have lt : gates.countP (fun q => !isNot q) < gates.length := by
    rcases Nat.lt_or_ge (gates.countP (fun q => !isNot q)) gates.length with h | h
    · exact h
    · have eq := List.countP_eq_length.mp (Nat.le_antisymm List.countP_le_length h) g hg
      simp [isNot,hop] at eq
  have legal : PEqualNP.MetaComplexity.FanInTwo (Circuit.mk gates o) := by
    intro g hg
    simpa only [Set.mem_insert_iff,Set.mem_singleton_iff] using fit g hg
  have lower := binaryLower (Circuit.mk gates o) legal correct
  change 13 ≤ gates.countP (fun g => !isNot g) at lower
  exact ⟨witness14.gates,witness14.output,basis14,(by simpa only [size14] using (show 14 ≤ gates.length by omega)),correct14⟩

