lemma binaryLower (C : Circuit) (legal : PEqualNP.MetaComplexity.FanInTwo C)
    (computes : ∀ x : Fin 8 → Bool, C.eval (List.ofFn x) = target8 x) :
    13 ≤ C.gates.countP (fun g => !isNot g) := by
