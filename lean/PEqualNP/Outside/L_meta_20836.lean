open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents in
theorem PEqualNP.Outside.L_meta_20836 : PEqualNP.Represents.RepSizeAtMost (fun u v : Fin 5 => (31388771 : ℕ).testBit (5 * u.val + v.val)) 9 ∧ ¬ PEqualNP.Represents.RepSizeAtMost (fun u v : Fin 5 => (31388771 : ℕ).testBit (5 * u.val + v.val)) 8 := by
  refine ⟨?_, ?_⟩
  · let C : Circuit := ⟨[⟨.or, [0, 8]⟩, ⟨.or, [2, 4]⟩, ⟨.or, [7, 10]⟩, ⟨.or, [6, 11]⟩, ⟨.or, [9, 12]⟩, ⟨.or, [3, 13]⟩, ⟨.or, [1, 14]⟩, ⟨.and, [15, 16]⟩, ⟨.or, [5, 17]⟩], 18⟩
    refine ⟨C, ?_, by decide, by decide⟩
    intro g hg
    simp only [C, List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp
  · intro h
    have k := PEqualNP.Outside.L_meta_20836.RepReads.reads_le (fun u v : Fin 5 => (31388771 : ℕ).testBit (5 * u.val + v.val)) h
    have e : (PEqualNP.Outside.L_meta_20836.RepReads.forcedL (fun u v : Fin 5 => (31388771 : ℕ).testBit (5 * u.val + v.val))).card + (PEqualNP.Outside.L_meta_20836.RepReads.forcedR (fun u v : Fin 5 => (31388771 : ℕ).testBit (5 * u.val + v.val))).card = 10 := by decide
    omega
