lemma sL(a b:Nat):a+b-a=b:=Nat.add_sub_cancel_left a b
lemma d1{a b m:Nat}(h:b<m:=by omega):(a*m+b)/m=a:=by rw[Nat.mul_comm,Nat.mul_add_div (by omega),Nat.div_eq_of_lt h,Nat.add_zero]
