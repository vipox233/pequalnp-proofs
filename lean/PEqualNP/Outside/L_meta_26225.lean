def F7 (x : Fin 6 → Bool) : Bool := (x 0 && x 2) || (x 0 && x 4) || (x 0 && x 5) || (x 1 && x 3) || (x 1 && x 5) || (x 2 && x 4) || (x 3 && x 5) || (x 4 && x 5)
def D7 : Finset (Fin 6) := {1, 3}
set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem deep7 : Maj.EdgeFn.DeepHyp F7 D7 := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro y hy b
    simp [D7] at hy
    rcases hy with rfl | rfl <;> cases b
    · exact ⟨![false, false, false, false, false, false], ![true, false, true, false, false, false], by decide +kernel⟩
    · exact ⟨![false, false, false, false, false, false], ![true, false, true, false, false, false], by decide +kernel⟩
    · exact ⟨![false, false, false, false, false, false], ![true, false, true, false, false, false], by decide +kernel⟩
    · exact ⟨![false, false, false, false, false, false], ![false, true, false, false, false, false], by decide +kernel⟩
  · intro y hy z hz hne
    simp [D7] at hy hz
    rcases hy with rfl | rfl <;> rcases hz with rfl | rfl
    · exact (hne rfl).elim
    · rintro ⟨a, b, h⟩
      cases a <;> cases b
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, true]) (by decide +kernel)
    · rintro ⟨a, b, h⟩
      cases a <;> cases b
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, false]) (by decide +kernel)
      · exact absurd (h ![false, false, false, false, false, true]) (by decide +kernel)
    · exact (hne rfl).elim
  · intro y hy x hx
    simp [D7] at hy
    rcases hy with rfl | rfl
    · have key : ∀ x : Fin 6 → Bool, F7 (Maj.EdgeFn.zeroOn D7 x) = false →
          (F7 (Function.update (Function.update x 3 true) 1 false) = false ∧ F7 (Function.update (Function.update (Function.update x 3 true) 1 false) 1 true) = true) ∨
          (F7 (Function.update (Function.update x 3 false) 1 false) = false ∧ F7 (Function.update (Function.update (Function.update x 3 false) 1 false) 1 true) = true) := by
        decide +kernel
      rcases key x hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · refine ⟨Function.update (Function.update x 3 true) 1 false, ?_, ?_, h1, h2⟩
        · intro i hi
          simp [D7] at hi
          simp [Function.update_of_ne hi.1, Function.update_of_ne hi.2]
        · simp
      · refine ⟨Function.update (Function.update x 3 false) 1 false, ?_, ?_, h1, h2⟩
        · intro i hi
          simp [D7] at hi
          simp [Function.update_of_ne hi.1, Function.update_of_ne hi.2]
        · simp
    · have key : ∀ x : Fin 6 → Bool, F7 (Maj.EdgeFn.zeroOn D7 x) = false →
          (F7 (Function.update (Function.update x 1 true) 3 false) = false ∧ F7 (Function.update (Function.update (Function.update x 1 true) 3 false) 3 true) = true) ∨
          (F7 (Function.update (Function.update x 1 false) 3 false) = false ∧ F7 (Function.update (Function.update (Function.update x 1 false) 3 false) 3 true) = true) := by
        decide +kernel
      rcases key x hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
      · refine ⟨Function.update (Function.update x 1 true) 3 false, ?_, ?_, h1, h2⟩
        · intro i hi
          simp [D7] at hi
          simp [Function.update_of_ne hi.1, Function.update_of_ne hi.2]
        · simp
      · refine ⟨Function.update (Function.update x 1 false) 3 false, ?_, ?_, h1, h2⟩
        · intro i hi
          simp [D7] at hi
          simp [Function.update_of_ne hi.1, Function.update_of_ne hi.2]
        · simp
  · decide +kernel
  · decide
set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem bnd7 (s : ℕ) (h : HasCircuitSize 6 F7 s) : 10 ≤ s := by
  obtain ⟨y, hy, hcase⟩ := Maj.stmtML_final 5 F7 D7 s deep7 (by simp [D7]) h
  have hy' : y = 1 ∨ y = 3 := by simpa [D7] using hy
  rcases hy' with rfl | rfl
  · rcases hcase with ⟨s1, hs1, hc1⟩ | ⟨s1, hs1, hc1⟩
