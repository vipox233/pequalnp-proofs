                Finset.card_singleton]
          obtain ⟨s', hs', hg'⟩ := PEqualNP.Outside.L_meta_26225.Path.simplify_gives_circuit n g
            ⟨x₁, hx₁⟩ hg_false C hF cb (hCeval_false cb) {ja, jb, hb} (by
              intro j hj
              simp only [Finset.mem_insert, Finset.mem_singleton] at hj
              rcases hj with rfl | rfl | rfl
              · exact ⟨hjalt, hja_el⟩
              · exact ⟨hjblt, hjb_el⟩
              · exact ⟨hhblt, hhb_el⟩)
          exact ⟨s', by omega, hg'⟩
        · push Not at hhb_ne
          subst hb
          have hja_const : ∃ da : Bool,
              PEqualNP.Outside.L_meta_26225.Path.lookupEnv
                (PEqualNP.Outside.L_meta_26225.Path.simpPrefix n cb C.gates C.gates.length).2
                (n + 2 + ja) = Sum.inl da := by
            apply PEqualNP.Outside.L_meta_26225.Path.const_of_all_const_inputs n cb C.gates ja hjalt
              (hF _ (List.getElem_mem hjalt))
            intro w hw
            rcases eff_two_subset ja hjalt n (n + 2 + jb) (by omega) hja_mem hhb_mem w hw with hwn | hwn
            · rw [hwn]; exact ⟨false, PEqualNP.Outside.L_meta_26225.Path.initEnv_a n cb C.gates⟩
            · rw [hwn]; exact ⟨db, hdb⟩
          obtain ⟨da, hda⟩ := hja_const
          have hout_ne_ja : C.output ≠ n + 2 + ja := by
            intro heq
            exact PEqualNP.Outside.L_meta_26225.Path.wire_not_const_output n g ⟨x₁, hx₁⟩ hg_false C hF
              cb (hCeval_false cb) da (heq ▸ hda)
          obtain ⟨ha, hhbha, hhalt, hha_mem⟩ := (hlive ja hjalt).resolve_left hout_ne_ja
          have hha_el := PEqualNP.Outside.L_meta_26225.Path.elim_of_const_input n cb C.gates ha hhalt
            (hF _ (List.getElem_mem hhalt)) (n + 2 + ja) hha_mem da hda
          have hcard3 : ({jb, ja, ha} : Finset ℕ).card = 3 := by
            rw [Finset.card_insert_of_notMem (by simp; omega),
