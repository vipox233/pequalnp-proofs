      exact Finset.card_pos.mpr ⟨j, Finset.mem_union_left _ hj⟩
    by_cases hS1 : S.card = 1
    · exfalso
      obtain ⟨j₀, hj₀eq⟩ := Finset.card_eq_one.mp hS1
      have hj₀a : j₀ ∈ Sa := by
