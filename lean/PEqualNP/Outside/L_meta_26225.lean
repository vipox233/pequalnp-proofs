    · have hS2 : S.card = 2 := by omega
      obtain ⟨j₁, j₂, hjne, hSeq⟩ := Finset.card_eq_two.mp hS2
      by_cases hboth : j₁ ∈ Sa ∧ j₁ ∈ Sb ∨ j₂ ∈ Sa ∧ j₂ ∈ Sb
      · have h2bi : ∀ p q : ℕ, p ≠ q → S = {p, q} → p ∈ Sa → p ∈ Sb →
