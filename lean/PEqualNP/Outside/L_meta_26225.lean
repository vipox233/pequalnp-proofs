def F0 (x : Fin 3 → Bool) : Bool := (x 0 && x 1) || (x 0 && x 2) || (x 1 && x 2)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem bnd0 (s : ℕ) (h : HasCircuitSize 3 F0 s) : 4 ≤ s := by
  let pi : Fin 3 → Fin 3 := ![0, 1, 2]
  have hr := Bow.relabel_size pi F0 s h
  have heq : (fun x : Fin 3 → Bool => F0 (x ∘ pi)) = Bow.f_K3 := by
    funext x; revert x; decide +kernel
  rw [heq] at hr
  exact Bow.base_K3 s hr

def F1 (x : Fin 4 → Bool) : Bool := (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 1 && x 2) || (x 2 && x 3)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 4000000 in
theorem bnd1 (s : ℕ) (h : HasCircuitSize 4 F1 s) : 5 ≤ s := by
  have hd : ∃ x : Fin 4 → Bool, F1 (Function.update x 1 (!x 1)) ≠ F1 x := ⟨![true, false, false, false], by decide +kernel⟩
  have hn : ∃ x y : Fin 4 → Bool, F1 (Function.update x 1 false) ≠ F1 (Function.update y 1 false) :=
    ⟨![false, false, false, false], ![true, false, true, false], by decide +kernel⟩
  obtain ⟨s1, hs1, hc1⟩ := Bow.one_gate_at 3 F1 1 false s hd hn h
  let pi : Fin 4 → Fin 3 := ![0, 0, 1, 2]
  have hr := Bow.relabel_size pi (fun x => F1 (Function.update x 1 false)) s1 hc1
  have heq : (fun x : Fin 3 → Bool => F1 (Function.update (x ∘ pi) 1 false)) = F0 := by
    funext x; revert x; decide +kernel
  rw [heq] at hr
  have hb := bnd0 s1 hr
  omega

