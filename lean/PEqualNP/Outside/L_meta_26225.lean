            hgb_legal (n + 1) hjb_mem
          rcases hgb_legal.1 with hop | hop | hop
          · left; exact ⟨hop, by simpa [cb, hop] using PEqualNP.Outside.L_meta_26225.Path.initEnv_b n cb C.gates⟩
          · right; left; exact ⟨hop, by simpa [cb, hop] using PEqualNP.Outside.L_meta_26225.Path.initEnv_b n cb C.gates⟩
          · right; right; exact ⟨hop, cb, PEqualNP.Outside.L_meta_26225.Path.initEnv_b n cb C.gates⟩
        obtain ⟨db, hdb⟩ := hjb_const
        have hout_ne_jb : C.output ≠ n + 2 + jb := by
          intro heq
          exact PEqualNP.Outside.L_meta_26225.Path.wire_not_const_output n g ⟨x₁, hx₁⟩ hg_false C hF
            cb (hCeval_false cb) db (heq ▸ hdb)
        obtain ⟨hb, hjbhb, hhblt, hhb_mem⟩ := (hlive jb hjblt).resolve_left hout_ne_jb
        have hja_el := PEqualNP.Outside.L_meta_26225.Path.elim_of_const_input n cb C.gates ja hjalt
          (hF _ (List.getElem_mem hjalt)) n hja_mem false
          (PEqualNP.Outside.L_meta_26225.Path.initEnv_a n cb C.gates)
        have hjb_el := PEqualNP.Outside.L_meta_26225.Path.elim_of_const_input n cb C.gates jb hjblt
          hgb_legal (n + 1) hjb_mem cb
          (PEqualNP.Outside.L_meta_26225.Path.initEnv_b n cb C.gates)
        by_cases hhb_ne : hb ≠ ja
        · have hhb_el := PEqualNP.Outside.L_meta_26225.Path.elim_of_const_input n cb C.gates hb hhblt
            (hF _ (List.getElem_mem hhblt)) (n + 2 + jb) hhb_mem db hdb
          have hcard3 : ({ja, jb, hb} : Finset ℕ).card = 3 := by
            rw [Finset.card_insert_of_notMem (by simp [hjab, Ne.symm hhb_ne]),
