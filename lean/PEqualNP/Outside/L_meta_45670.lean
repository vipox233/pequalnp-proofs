def thirdChildren (i : ℕ) : List ℕ := thirdLinks.getD i []

noncomputable def firstFrontier : List SearchState := (List.range firstCount).map firstFront

noncomputable def childReady (k len : ℕ) (x : SearchState) (ids : List ℕ) (next : ℕ → SearchState) : Bool :=
  (!freezeFront (ids.map next) (fun states => frontPure k x (frontierMissing states))) &&
  ((ids.all fun j => decide (j < len)) &&
    (decide (1 < x.2.length) && decide (x.2.length+1 < k)))

lemma childReady_sound {k len : ℕ} {x : SearchState} {ids : List ℕ}
    {next : ℕ → SearchState} (h : childReady k len x ids next = true)
    (mixed : frontMixed k x = false) (tails : ∀ j < len, frontTail (k-1) (next j) = false) :
    frontTail k x = false := by
  simp only [childReady, freezeFront_eq, Bool.and_eq_true, decide_eq_true_eq] at h
