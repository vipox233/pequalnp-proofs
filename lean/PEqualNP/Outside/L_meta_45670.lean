def picked {X : Type} (F : X → Bool) (G : Fin 8 → X → Bool) : Prop :=
  ∀ x, F x = true → ∃ b, G b x = true
lemma scan_picked (f : X → Bool) (q : Fin 8 → X → Bool) (v : List X)
    (hp : picked f q) :
    scan f v = true → ∃ b, scan (q b) v = true := by
  induction v with
  | nil => simp [scan]
  | cons a v ih =>
    have hu (F : X → Bool) :
        scan F (a :: v) = (bif F a then true else scan F v) := by
      change Bool.rec (motive := fun _ => Bool) (scan F v) true (F a) = _
      rw [bR]
    simp only [hu]
    cases h : f a
    · simp only [h, Bool.cond_false]
      intro hr
      obtain ⟨b,hb⟩ := ih hr
      exact ⟨b,by rw [hb]; cases q b a <;> rfl⟩
    · intro _
      obtain ⟨b,hb⟩ := hp a h
      exact ⟨b,by rw [hb]; rfl⟩
lemma ins_distribute (o : W) (v : List W) {f : List W → Bool} {g : Fin 8 → List W → Bool}
    (h : picked f g) : ins o v f = true → ∃ b, ins o v (g b) = true := by
  induction v generalizing f g with
  | nil => exact h [o]
  | cons a r ih =>
    have step (u : List W → Bool) : ins o (a :: r) u =
        (bif Nat.ble a.s o.s then (bif Nat.beq o.s a.s then false else u (o :: a :: r))
          else ins o r (fun ws => u (a :: ws))) := by
      change Bool.rec (motive := fun _ => Bool) (ins o r (fun ws => u (a :: ws)))
        (Bool.rec (motive := fun _ => Bool) (u (o :: a :: r)) false (Nat.beq o.s a.s))
        (Nat.ble a.s o.s) = _
      rw [bR,bR]
    simp only [step]
    cases hle : Nat.ble a.s o.s
    · simp only [hle,Bool.cond_false]
      exact ih (f := fun ws => f (a :: ws)) (g := fun b ws => g b (a :: ws)) (fun ws => h (a :: ws))
    · cases he : Nat.beq o.s a.s
      · simpa only [he,hle,Bool.cond_true,Bool.cond_false] using h (o :: a :: r)
      · simp [he,hle]


lemma put_distribute (m s x y : ℕ) (v : List W) {f : List W → Bool} {g : Fin 8 → List W → Bool}
    (h : picked f g) : put m s x y v f = true → ∃ b, put m s x y v (g b) = true := by
  simp only [put,st_eq,bR]
  cases h0 : Nat.beq s 0 <;> cases h1 : Nat.beq s m <;> simp only [h0,h1,Bool.cond_true,Bool.cond_false,Bool.false_eq_true,false_implies]
  exact ins_distribute _ _ h

lemma child_distribute {f : ℕ → List W → Bool} {g : Fin 8 → ℕ → List W → Bool}
    (free z : ℕ) (mk : (List W → Bool) → Bool) (mk_distribute : ∀ p q, picked p q → mk p = true → ∃ b, mk (q b) = true)
    (h : ∀ j, picked (f j) (fun b => g b j)) :
    child f free mk z = true → ∃ b, child (g b) free mk z = true := by
  simp only [child,st_eq,bR]
  cases hb : Nat.beq (z &&& free) free
  · simp [hb]
  · simpa only [hb,Bool.cond_true] using mk_distribute (f z) (fun b => g b z) (h z)

lemma kids_unfold (ch : ((List W → Bool) → Bool) → ℕ → Bool) (e n z x y a c : ℕ)
    (oa oc : Bool) (mk : (List W → Bool) → Bool) :
    kids ch e n z x y a c oa oc mk =
      ((oa && oc && ch (fun f => mk (fun r => rm a c r f)) z) ||
      ((oc && Nat.ble (n+1) e && ch (fun f => mk (fun r => rm c c r f)) (z-x)) ||
      ((oa && Nat.ble (n+1) e && ch (fun f => mk (fun r => rm a a r f)) (z-y)) ||
       (Nat.ble (n+2) e && ch mk (z-x-y))))) := by
  simp only [kids,bR]
  cases oa <;> cases oc <;> cases Nat.ble (n+1) e <;> cases Nat.ble (n+2) e <;> simp <;>
    (try rw [Bool.eq_iff_iff]) <;> (try simp) <;> (try simp only [← Bool.not_eq_true]) <;> tauto

lemma kids_distribute {f : ℕ → List W → Bool} {g : Fin 8 → ℕ → List W → Bool}
    (free e n z x y a c : ℕ) (oa oc : Bool) (mk : (List W → Bool) → Bool)
    (hm : ∀ p q, picked p q → mk p = true → ∃ b, mk (q b) = true)
    (h : ∀ j, picked (f j) (fun b => g b j)) :
    kids (child f free) e n z x y a c oa oc mk = true →
    ∃ b, kids (child (g b) free) e n z x y a c oa oc mk = true := by
  have cm (p q k : ℕ) : child f free (fun f => mk fun r => rm p q r f) k = true →
      ∃ b, child (g b) free (fun f => mk fun r => rm p q r f) k = true := by
    refine child_distribute free k _ ?_ h
    intro u v huv
    simp only [rm_eq]
    exact hm (fun r => u (r.filter _)) (fun b r => v b (r.filter _)) (fun r => huv (r.filter _))
  rw [kids_unfold]
  simp only [Bool.or_eq_true,Bool.and_eq_true]
  rintro (⟨h1,h2⟩ | ⟨h1,h2⟩ | ⟨h1,h2⟩ | ⟨h1,h2⟩)
  · obtain ⟨b,hb⟩ := cm a c z h2
    refine ⟨b, ?_⟩
    simp only [kids_unfold,Bool.or_eq_true,Bool.and_eq_true]
    exact Or.inl ⟨h1,hb⟩
  · obtain ⟨b,hb⟩ := cm c c (z-x) h2
    refine ⟨b, ?_⟩
    simp only [kids_unfold,Bool.or_eq_true,Bool.and_eq_true]
    exact Or.inr (Or.inl ⟨h1,hb⟩)
  · obtain ⟨b,hb⟩ := cm a a (z-y) h2
    refine ⟨b, ?_⟩
    simp only [kids_unfold,Bool.or_eq_true,Bool.and_eq_true]
    exact Or.inr (Or.inr (Or.inl ⟨h1,hb⟩))
  · obtain ⟨b,hb⟩ := child_distribute free (z-x-y) mk hm h h2
    refine ⟨b, ?_⟩
    simp only [kids_unfold,Bool.or_eq_true,Bool.and_eq_true]
    exact Or.inr (Or.inr (Or.inr ⟨h1,hb⟩))

lemma mid_distribute {f : ℕ → List W → Bool} {g : Fin 8 → ℕ → List W → Bool}
    (m free e n z : ℕ) (v : List W) (a c : W) (da dc s x y : ℕ)
    (h : ∀ j, picked (f j) (fun b => g b j)) :
    mid f m free e n z v a c da dc s x y = true →
      ∃ b, mid (g b) m free e n z v a c da dc s x y = true := by
  simp only [mid,st_eq,bR]
  cases hb : Nat.beq (Nat.land (Nat.sub (Nat.add z (Nat.land a.c c.c)) (Nat.lor x y)) free) free
  · simp [hb]
  · simpa only [hb,Bool.cond_true] using
      kids_distribute free e n (Nat.sub (Nat.add z (Nat.land a.c c.c)) (Nat.lor x y)) a.c c.c a.s c.s
        (Nat.beq da 0) (Nat.beq dc 0) (put m s x y v)
        (fun _ _ => put_distribute m s x y v) h

lemma pairs_distribute (f : X → X → Bool) (g : Fin 8 → X → X → Bool)
    (h : ∀ x, picked (f x) (fun b => g b x)) (v : List X) :
    pairs f v = true → ∃ b, pairs (g b) v = true := by
  induction v with
  | nil => simp [pairs]
  | cons a r ih =>
    have he (u : X → X → Bool) : pairs u (a::r) = bif scan (u a) r then true else pairs u r := by
      change Bool.rec (motive := fun _ => Bool) (pairs u r) true (scan (u a) r) = _
      rw [bR]
    simp only [he]
    cases hb : scan (f a) r
    · simp only [hb,Bool.cond_false]
      intro ht
      obtain ⟨b,hb⟩ := ih ht
      exact ⟨b, by rw [hb]; cases scan (g b a) r <;> rfl⟩
    · simp only [hb,Bool.cond_true]
      intro _
      obtain ⟨b,hb⟩ := scan_picked _ _ r (h a) hb
      exact ⟨b,by rw [hb]; rfl⟩
lemma mode_distribute {f : ℕ → List W → Bool} {g : Fin 8 → ℕ → List W → Bool}
    (m free e n z : ℕ) (v : List W) (a c : W) (da dc s x y : ℕ)
    (h : ∀ j, picked (f j) (fun b => g b j)) :
    modeF n e (mid f m free e n.pred z v) a c da dc s x y = true →
      ∃ b, modeF n e (mid (g b) m free e n.pred z v) a c da dc s x y = true := by
  have mid' := mid_distribute m free e n.pred z v a c da dc s x y h
  unfold modeF
  cases hn : Nat.ble n e
  · simp only [hn,Bool.cond_false,f0,bR]
    cases ha : Nat.beq (Nat.lor da dc) 0
    · simp [ha]
    · simpa only [ha,Bool.cond_true] using mid'
  · simp only [hn,Bool.cond_true]
    cases hs : Nat.ble n.succ e
    · simp only [hs,Bool.cond_false,f1,bR]
      cases ha : (bif Nat.beq da 0 then true else Nat.beq dc 0)
      · simp [ha]
      · simpa only [ha,Bool.cond_true] using mid'
    · simpa only [hs,Bool.cond_true,f2] using mid'

lemma pair_distribute {f : W → W → ℕ → ℕ → ℕ → ℕ → ℕ → Bool}
    {g : Fin 8 → W → W → ℕ → ℕ → ℕ → ℕ → ℕ → Bool}
    (h : ∀ a c da dc s x y, f a c da dc s x y = true → ∃ b, g b a c da dc s x y = true)
    (a c : X) : pair f a c = true → ∃ b, pair (g b) a c = true := by
  obtain ⟨w,s,q,u⟩ := a
  obtain ⟨w',s',q',u'⟩ := c
  simp only [pair,bR]
  cases hb : f w w' (Nat.xor (Nat.land u s') u) (Nat.xor (Nat.land u' s) u')
      (Nat.land s s') (Nat.lor w.a w'.a) (Nat.land w.b w'.b)
  · simp only [hb,Bool.cond_false]
    intro hor
    obtain ⟨b,hb⟩ := h _ _ _ _ _ _ _ hor
    refine ⟨b, ?_⟩
    rw [hb]
    simp
  · intro _
    obtain ⟨b,hb⟩ := h _ _ _ _ _ _ _ hb
    exact ⟨b,by rw [hb]; rfl⟩

-- Deduplicate the states reached by the first three binary steps on input wires.
abbrev SearchState := ℕ × List W

def wordEquals (a b : W) : Bool :=
  (a.s == b.s) && (a.a == b.a) && (a.b == b.b) && (a.c == b.c) && (a.r == b.r)

noncomputable def freezeFront (xs : List SearchState) : (List SearchState → Bool) → Bool :=
  List.rec (motive := fun _ => (List SearchState → Bool) → Bool) (fun f => f [])
    (fun row _ ih f => st row.1 fun z => frc row.2 fun v => ih fun rest => f ((z,v) :: rest)) xs

lemma freezeFront_eq (xs : List SearchState) (f : List SearchState → Bool) :
    freezeFront xs f = f xs := by
  induction xs generalizing f with
  | nil => rfl
  | cons row rest ih =>
    change st row.1 (fun z => frc row.2 fun v => freezeFront rest fun r => f ((z,v)::r)) = _
    simp only [st_eq, frc_eq, ih]

lemma wordEquals_spec {a b : W} (h : wordEquals a b = true) : a = b := by
  cases a
  cases b
  simp [wordEquals, Bool.and_eq_true] at h ⊢
  rcases h with ⟨⟨⟨⟨hs, ha⟩, hb⟩, hc⟩, hr⟩
  exact ⟨hs, ha, hb, hc, hr⟩

def frontierMissing (states : List SearchState) (z : ℕ) (v : List W) : Bool :=
  !(states.any fun state => (z == state.1) && List.isEqv v state.2 wordEquals)

lemma frontierMissing_false {states : List SearchState} {z : ℕ} {v : List W}
    (h : frontierMissing states z v = false) : (z, v) ∈ states := by
  simp only [frontierMissing, Bool.not_eq_false', List.any_eq_true, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨j, w⟩, membership, rfl, he⟩ := h
  have hw : v = w := by
    clear membership
    induction v generalizing w with
    | nil => cases w <;> simp_all [List.isEqv]
    | cons a v ih =>
      cases w with
      | nil => simp [List.isEqv] at he
      | cons b w =>
        simp only [List.isEqv, Bool.and_eq_true] at he
        rw [wordEquals_spec he.1, ih w he.2]
  rwa [hw]

lemma frontier_of_hit {f : ℕ → List W → Bool} {states : List SearchState}
    (checked : ∀ s ∈ states, f s.1 s.2 = false) (z : ℕ) :
    picked (f z) (fun _ => frontierMissing states z) := by
  intro v hit
  refine ⟨0, ?_⟩
  cases h : frontierMissing states z v
  · exact Bool.noConfusion ((checked (z,v) (frontierMissing_false h)).symm.trans hit)
  · exact h

lemma pairsC_as_pairs (H : ℕ) (f : X → X → Bool) (v : List X) :
    pairsC H f v = pairs (fun a c => bif hb H (a.s+c.s) then f a c else false) v := by
  induction v with
  | nil => rfl
  | cons a v ih =>
    change Bool.rec (motive := fun _ => Bool) (pairsC H f v) true _ =
      Bool.rec (motive := fun _ => Bool)
        (pairs (fun a c => bif hb H (a.s+c.s) then f a c else false) v) true _
    rw [ih]
    congr 1
    congr 1
    funext c
    exact bR _ _ _

lemma rawNode_distribute {f : ℕ → List W → Bool} {branches : Fin 8 → ℕ → List W → Bool}
    (d : Bool) (l m g e n z : ℕ) (v : List W) (H : ℕ)
    (h : ∀ j, picked (f j) (fun b => branches b j)) :
    node f d l m g e n z v (fun h xs => pairsC H h (fs xs)) = true →
      ∃ b, node (branches b) d l m g e n z v (fun h xs => pairsC H h (fs xs)) = true := by
  simp only [node_eq, pairsC_as_pairs]
  apply pairs_distribute
  intro a c
  cases hH : hb H (a.s+c.s)
  · simp [hH]
  · simp only [hH, Bool.cond_true]
    exact pair_distribute (fun _ _ _ _ _ _ _ => mode_distribute m g e n z v _ _ _ _ _ _ _ h) a c

lemma pureNode_distribute {f : ℕ → List W → Bool} {branches : Fin 8 → ℕ → List W → Bool}
    (d : Bool) (l m g e n z : ℕ) (v : List W)
    (h : ∀ j, picked (f j) (fun b => branches b j)) :
    node f d l m g e n z v pairsS = true →
      ∃ b, node (branches b) d l m g e n z v pairsS = true := by
  simp only [node_eq,pairsS]
  exact pairs_distribute _ _ (fun a c =>
    pair_distribute (fun _ _ _ _ _ _ _ => mode_distribute m g e n z v _ _ _ _ _ _ _ h) a c) _

def allInputsNeeded (d : Bool) (l : ℕ) (v : List W) : ℕ → Bool :=
  List.rec (motive := fun _ => ℕ → Bool) (fun _ => true)
    (fun w ws rest bits =>
      !Nat.beq (Nat.lor bits (cov d l ws)) l &&
        rest (Nat.lor bits (sp d l w.s))) v

lemma anySub_allInputs {d : Bool} {l : ℕ} {v : List W} {bits : ℕ}
    (needed : allInputsNeeded d l v bits = true) (test : List W → Bool) :
    anySub d l v bits test = test v := by
  induction v generalizing bits test with
  | nil => rfl
  | cons w ws ih =>
    let included := Nat.lor bits (sp d l w.s)
    let skip := Nat.beq (Nat.lor bits (cov d l ws)) l
    change (!skip && allInputsNeeded d l ws included) = true at needed
    simp only [Bool.and_eq_true] at needed
    have mustKeep : skip = false := Bool.eq_false_iff.mpr (fun h => by rw [h] at needed; simp at needed)
    change Bool.rec (motive := fun _ => Bool)
      (Bool.rec (motive := fun _ => Bool) false (anySub d l ws bits test) skip)
      true (st included (fun c => anySub d l ws c (fun r => test (w :: r)))) = _
    rw [st_eq, ih needed.2, mustKeep]
    cases test (w :: ws) <;> rfl

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma frontNeeded : allInputsNeeded true AA frontWords 0 = true := by decide +kernel

lemma tst_slack (k : ℕ) (v : List W) (small : v.length + 1 < k) (F : ℕ → Bool) :
    tst true AA k v F = F 0 := by
  have h0 : Nat.beq v.length k = false := beq_f (by omega)
  have h1 : Nat.beq v.length.succ k = false := beq_f (by omega)
  simp only [tst, bR, h0, h1, Bool.cond_false]

noncomputable def frontTail (k : ℕ) (state : SearchState) : Bool :=
  frc state.2 (fun v => st state.1 (fun z =>
    look1 AA frontMask frontSlots 12 (k+1) k 1 z v))

noncomputable def frontPure (k : ℕ) (state : SearchState) (f : ℕ → List W → Bool) : Bool :=
  frc state.2 (fun v => st state.1 (fun z =>
    cv true AA v (node f true AA frontMask frontSlots (k-1) v.length z v pairsS)))

noncomputable def frontMixed (k : ℕ) (state : SearchState) : Bool :=
  frc state.2 (fun v => st state.1 (fun z =>
    cv true AA v (mv (look AA frontMask frontSlots 12)
      AA frontMask frontSlots k 1 z v 0)))

lemma frontPure_sound (k : ℕ) (state : SearchState) (next : List SearchState)
    (f : ℕ → List W → Bool)
    (links : frontPure k state (frontierMissing next) = false)
    (checked : ∀ x ∈ next, f x.1 x.2 = false) : frontPure k state f = false := by
  simp only [frontPure, frc_eq, st_eq, cv, bR] at links ⊢
  cases hc : Nat.beq (cov true AA state.2) AA
  · simp [hc]
  · simp only [hc, Bool.cond_true] at links ⊢
    refine Bool.eq_false_iff.mpr fun hit => ?_
    obtain ⟨_, got⟩ := pureNode_distribute true AA frontMask frontSlots (k-1)
      state.2.length state.1 state.2 (frontier_of_hit checked) hit
    exact Bool.noConfusion (links.symm.trans got)

lemma frontierJoin {d : Bool} {l : ℕ} {v : List W} {x y : Bool}
    (pure : cv d l v x = false) (mixed : cv d l v y = false) :
    cv d l v (Bool.rec (motive := fun _ => Bool) y true x) = false := by
  unfold cv at *
  cases hc : Nat.beq (cov d l v) l
  · rfl
  · simp only [hc] at pure mixed ⊢
    rw [pure, mixed]

lemma frontTail_before (k : ℕ) (state : SearchState)
    (two : 1 < state.2.length) (small : state.2.length + 1 < k)
    (mixed : frontMixed k state = false)
    (pure : frontPure k state (fun z v => frontTail (k-1) (z,v)) = false) :
    frontTail k state = false := by
  have hn : Nat.ble state.2.length 1 = false := by
    cases h : Nat.ble state.2.length 1
    · rfl
    · exact absurd (Nat.le_of_ble_eq_true h) (Nat.not_le_of_gt two)
  simp only [frontPure, frontMixed, frontTail, frc_eq, st_eq] at pure mixed ⊢
  rw [Nat.sub_add_cancel (by omega : 1 ≤ k)] at pure
  change cv true AA state.2
    (Bool.rec (motive := fun _ => Bool) (tst true AA k state.2 _) true
      (Nat.ble state.2.length 1)) = false
  rw [hn]
  change cv true AA state.2 (tst true AA k state.2 _) = false
  rw [tst_slack k state.2 small]
  exact frontierJoin pure mixed

noncomputable def rawTest (l m g e n z H : ℕ) (d : Bool) (v : List W)
    (f : ℕ → List W → Bool) : Bool :=
  Bool.rec (motive := fun _ => Bool) false true
    (node f d l m g e n z v (fun h xs => pairsC H h (fs xs)))

noncomputable abbrev frontRaw (f : ℕ → List W → Bool) : Bool :=
  rawTest AA frontMask frontSlots (Nat.sub (Nat.sub 12 1) 0) frontWords.length frontStart FF (pos 1) frontWords f

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma prepare_atFront (run : ℕ → ℕ → ℕ → ℕ → ℕ → List W → Bool) :
    prepareCheck [] rtTop 0 12 1 run = run AA frontMask frontSlots frontBudget 0 frontWords := by
  simp only [prepareCheck, frc_eq, st_eq, frontWords_eq, frontMask_eq, frontSlots_eq, frontBudget_eq, frontL_eq]
  change anySub true AA frontWords 0 _ = _
  rw [anySub_allInputs frontNeeded]
  rfl

lemma startFront_unfold (l m g B K t p H ph : ℕ) (v : List W)
    (hv : hasP p v = true) (hl : Nat.ble v.length (Nat.sub (Nat.succ K) t) = true)
    (hb : Nat.beq (Nat.land (Nat.sub B (sumc v)) g) g = true) :
    startv l m g B K t p H ph v = topC l m g K H ph K t (Nat.sub B (sumc v)) v := by
  simp only [startv, child, st_eq, hv, hl, hb]

lemma noUnaryTop (l m g K H k t z : ℕ) (v : List W)
    (short : Nat.ble v.length 1 = false)
    (easy : ∀ f : ℕ → Bool, tst (pos t) l (Nat.sub (Nat.succ k) t) v f = f 0) :
    topC l m g K H 0 k t z v =
      rawTest l m g (Nat.sub (Nat.sub k t) 0) v.length z H (pos t) v
        (look1 l m g K K (Nat.sub k 1) t) := by
  unfold topC
  rewrite [short]
  change tst (pos t) l (Nat.sub (Nat.succ k) t) v _ = _
  rewrite [easy]
  rfl

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma frontRoot_hit (found : chk [] rtTop 0 12 1 FF 0 = true) :
    frontRaw (look1 AA frontMask frontSlots 12 12 (Nat.sub 12 1) 1) = true := by
  have shape := prepare_atFront (fun l m g B p => startv l m g B 12 1 p FF 0)
  have prepared : startv AA frontMask frontSlots frontBudget 12 1 0 FF 0 frontWords = true :=
    shape.symm.trans found
  have budget : Nat.beq (Nat.land frontStart frontSlots) frontSlots = true := by decide +kernel
  have hp : hasP 0 frontWords = true := by decide +kernel
  have hl : Nat.ble frontWords.length (Nat.sub (Nat.succ 12) 1) = true := by decide +kernel
  have hv : Nat.ble frontWords.length 1 = false := by decide +kernel
  have hbudget : Nat.beq (Nat.land (Nat.sub frontBudget (sumc frontWords)) frontSlots) frontSlots = true :=
    (congrArg (fun z => Nat.beq (Nat.land z frontSlots) frontSlots) frontStart_eq).trans budget
  have easy : ∀ f : ℕ → Bool, tst (pos 1) AA (Nat.sub (Nat.succ 12) 1) frontWords f = f 0 :=
    tst_slack 12 frontWords (by decide)
  have started : topC AA frontMask frontSlots 12 FF 0 12 1 (Nat.sub frontBudget (sumc frontWords)) frontWords = true :=
    (startFront_unfold AA frontMask frontSlots frontBudget 12 1 0 FF 0 frontWords hp hl hbudget).symm.trans prepared
  have settled : topC AA frontMask frontSlots 12 FF 0 12 1 frontStart frontWords = true :=
    (congrArg (fun z => topC AA frontMask frontSlots 12 FF 0 12 1 z frontWords) frontStart_eq).symm.trans started
  exact (noUnaryTop AA frontMask frontSlots 12 FF 12 1 frontStart frontWords hv easy).symm.trans settled


lemma frontRaw_sound (next : List SearchState) (f : ℕ → List W → Bool)
    (links : frontRaw (frontierMissing next) = false)
    (checked : ∀ x ∈ next, f x.1 x.2 = false) : frontRaw f = false := by
  refine Bool.eq_false_iff.mpr fun hit => ?_
  have h (q : Bool) : Bool.rec (motive := fun _ => Bool) false true q = q := by cases q <;> rfl
  simp only [frontRaw, rawTest, h] at links hit
  obtain ⟨_, got⟩ := rawNode_distribute (pos 1) AA frontMask frontSlots (Nat.sub (Nat.sub 12 1) 0)
    frontWords.length frontStart frontWords FF (frontier_of_hit checked) hit
  exact Bool.noConfusion (links.symm.trans got)


def rangeCheck (test : ℕ → Bool) (start count : ℕ) : Bool :=
  (List.range' start count).all test

lemma rangeCheck_append (test : ℕ → Bool) {s a b : ℕ}
    (left : rangeCheck test s a = true) (right : rangeCheck test (s+a) b = true) :
    rangeCheck test s (a+b) = true := by
  unfold rangeCheck at *
  rw [← List.range'_append_1, List.all_append, left, right]
  rfl

lemma rangeCheck_at {test : ℕ → Bool} {n i : ℕ} (checked : rangeCheck test 0 n = true) (hi : i < n) :
    test i = true :=
  List.all_eq_true.mp checked _ (List.mem_range'_1.mpr ⟨Nat.zero_le _, by simpa using hi⟩)

lemma boolOfNeg {b : Bool} (h : (!b) = true) : b = false := by cases b <;> simp_all

