def Together(D:qD)(x c:V):Prop:=∃w,x∈fM 10 D w/\c∈fM 10 D w
def ineligNbrs(I:Nat)(x:V):List V:=(lR 10).filter (λ y=>(neigh x).testBit y.1&&I.testBit y.1)
