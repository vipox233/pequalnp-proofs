def fF(D:qD)(x:V):Nat:=(fD 10 D x).card
def cap(k I:Nat)(x:V):Nat:=if I.testBit x.1 then 1 else 2+k
def gQ(D:qD)(x:V)(j:Nat):Prop:=j<fF D x
