def pinTarget(a:EI->qO)(x y:V):qO:=let p:=fW x y;sflip p.2 (a p.1)
def pinSlots(I:Nat)(a:EI->qO)(x:V):List qO:=let c:=ineligNbrs I x;let d:=eligNbrs I x;c.map (pinTarget a x)++match d with|[]=>[]|y::_=>[pinTarget a x y]
