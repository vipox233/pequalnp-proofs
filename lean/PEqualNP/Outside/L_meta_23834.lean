  refine ⟨⟨[⟨.or, [3, 4]⟩, ⟨.or, [0, 5]⟩, ⟨.or, [2, 5]⟩, ⟨.and, [0, 7]⟩, ⟨.not, [6]⟩, ⟨.and, [1, 9]⟩, ⟨.or, [8, 10]⟩], 11⟩, ?_, by decide, ?_⟩
  · simp [PEqualNP.MetaComplexity.FanInTwo]
  · decide +kernel
