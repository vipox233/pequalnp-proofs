theorem PEqualNP.Outside.L_meta_21665 : (∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 9 ∧ ∀ i j : Fin 5, C.eval (List.ofFn fun k : Fin 5 => decide (k = i ∨ k = j)) = (266451 : ℕ).testBit (5 * min i.val j.val + max i.val j.val))  := by
  exact ⟨PEqualNP.Outside.L_meta_21665_aux.circ, PEqualNP.Outside.L_meta_21665_aux.h_ok, PEqualNP.Outside.L_meta_21665_aux.h_sz, by decide +kernel⟩
