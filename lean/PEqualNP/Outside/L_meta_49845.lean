section Prog
variable {ι κ : Type}

def K (S : (ι → Bool) → Prop) (w : ι → Bool) : Prop :=
  (∃ c : Bool, w = fun _ => c) ∨ S w ∨ S (fun x => !w x)

def ins (z : ι → Bool) (S : (ι → Bool) → Prop) : (ι → Bool) → Prop := fun w => w = z ∨ S w

def Run : ℕ → ((ι → Bool) → Prop) → (ι → Bool) → Prop
  | 0, S, f => K S f
  | t + 1, S, f => Run t S f ∨
      ∃ a b : ι → Bool, K S a ∧ K S b ∧ Run t (ins (fun x => a x && b x) S) f

theorem K_not {S : (ι → Bool) → Prop} {w : ι → Bool} (h : K S w) : K S (fun x => !w x) := by
  rcases h with ⟨c, rfl⟩ | h | h
  · exact Or.inl ⟨!c, rfl⟩
  · exact Or.inr (Or.inr (by simpa using h))
  · exact Or.inr (Or.inl h)

theorem K_ins {S : (ι → Bool) → Prop} {z w : ι → Bool} (h : K S w) : K (ins z S) w := by
  rcases h with h | h | h
  · exact Or.inl h
  · exact Or.inr (Or.inl (Or.inr h))
  · exact Or.inr (Or.inr (Or.inr h))

theorem K_new {S : (ι → Bool) → Prop} (z : ι → Bool) : K (ins z S) z := Or.inr (Or.inl (Or.inl rfl))

theorem K_and {S : (ι → Bool) → Prop} {a b : ι → Bool} (ha : ∃ c, ∀ y, a y = c) (hb : K S b) :
    K S (fun y => a y && b y) := by
  obtain ⟨c, hc⟩ := ha
  cases c
  · exact Or.inl ⟨false, funext fun y => by simp [hc y]⟩
  · have : (fun y => a y && b y) = b := funext fun y => by simp [hc y]
    rw [this]; exact hb

theorem K_bind {S : (ι → Bool) → Prop} {S' : (κ → Bool) → Prop} (σ : κ → ι)
    (h : ∀ w, S w → K S' (fun y => w (σ y))) {w : ι → Bool} (hw : K S w) :
    K S' (fun y => w (σ y)) := by
  rcases hw with ⟨c, rfl⟩ | hw | hw
  · exact Or.inl ⟨c, rfl⟩
  · exact h w hw
  · have h2 := K_not (h _ hw)
    simpa using h2

theorem Run_map (σ : κ → ι) : ∀ (t : ℕ) (S : (ι → Bool) → Prop) (S' : (κ → Bool) → Prop)
    (f : ι → Bool), (∀ w, S w → K S' (fun y => w (σ y))) → Run t S f → Run t S' (fun y => f (σ y))
  | 0, _, _, _, h, hf => K_bind σ h hf
  | t + 1, S, S', f, h, hf => by
    rcases hf with hf | ⟨a, b, ha, hb, hf⟩
    · exact Or.inl (Run_map σ t S S' f h hf)
    · refine Or.inr ⟨_, _, K_bind σ h ha, K_bind σ h hb, Run_map σ t _ _ f ?_ hf⟩
      rintro w (rfl | hw)
      · exact K_new _
      · exact K_ins (h w hw)

theorem Run_le {t t' : ℕ} {S : (ι → Bool) → Prop} {f : ι → Bool} (h : t ≤ t') (hf : Run t S f) :
    Run t' S f := by
  induction h with
  | refl => exact hf
  | step _ ih => exact Or.inl ih

def Cl (σ : κ → ι) (p q r : ι) (S : (ι → Bool) → Prop) : Prop :=
  ∀ w, S w → w p ≠ w q → ∀ y, w (σ y) = w r

theorem Cl_K {σ : κ → ι} {p q r : ι} {S : (ι → Bool) → Prop} (h : Cl σ p q r S) {w : ι → Bool}
    (hw : K S w) (hd : w p ≠ w q) (y : κ) : w (σ y) = w r := by
  rcases hw with ⟨c, rfl⟩ | hw | hw
  · exact absurd rfl hd
  · exact h w hw hd y
  · have h2 := h _ hw (by simpa using hd) y
    simpa using h2

theorem and_dep {a b : ι → Bool} {p q : ι} (h : (a p && b p) ≠ (a q && b q)) :
    a p ≠ a q ∨ b p ≠ b q := by
  by_contra hc
  simp only [not_or, not_not] at hc
  exact h (by rw [hc.1, hc.2])

theorem kill1 (σ : κ → ι) (p q r : ι) : ∀ (t : ℕ) (S : (ι → Bool) → Prop) (S' : (κ → Bool) → Prop)
    (f : ι → Bool), Cl σ p q r S → (∀ w, S w → K S' (fun y => w (σ y))) → f p ≠ f q →
    (∃ y y', f (σ y) ≠ f (σ y')) → Run t S f → ∃ t', t' + 1 ≤ t ∧ Run t' S' (fun y => f (σ y))
  | 0, _, _, f, hc, _, hd, ⟨y, y', hn⟩, hf =>
    absurd ((Cl_K hc hf hd y).trans (Cl_K hc hf hd y').symm) hn
  | t + 1, S, S', f, hc, hm, hd, hn, hf => by
    rcases hf with hf | ⟨a, b, ha, hb, hf⟩
    · obtain ⟨t', ht, hr⟩ := kill1 σ p q r t S S' f hc hm hd hn hf
      exact ⟨t', by omega, hr⟩
    · by_cases hz : (a p && b p) ≠ (a q && b q)
      · have hk : K S' (fun y => a (σ y) && b (σ y)) := by
          rcases and_dep hz with h | h
          · exact K_and ⟨a r, Cl_K hc ha h⟩ (K_bind σ hm hb)
          · have e : (fun y => a (σ y) && b (σ y)) = fun y => b (σ y) && a (σ y) :=
              funext fun y => Bool.and_comm _ _
            rw [e]
            exact K_and ⟨b r, Cl_K hc hb h⟩ (K_bind σ hm ha)
        refine ⟨t, le_rfl, Run_map σ t _ S' f ?_ hf⟩
        rintro w (rfl | hw)
        · exact hk
        · exact hm w hw
      · obtain ⟨t', ht, hr⟩ := kill1 σ p q r t (ins (fun x => a x && b x) S)
          (ins (fun y => a (σ y) && b (σ y)) S') f
          (by
            rintro w (rfl | hw) hd2
            · exact absurd hd2 hz
            · exact hc w hw hd2)
          (by
            rintro w (rfl | hw)
            · exact K_new _
            · exact K_ins (hm w hw)) hd hn hf
        exact ⟨t' + 1, by omega, Or.inr ⟨_, _, K_bind σ hm ha, K_bind σ hm hb, hr⟩⟩

theorem kill2_dep (σ0 σ1 : κ → ι) (p q : ι) {t : ℕ} {S : (ι → Bool) → Prop}
    {S0 S1 : (κ → Bool) → Prop} {f a b : ι → Bool} (hc0 : Cl σ0 p q p S) (hc1 : Cl σ1 p q q S)
    (hm0 : ∀ w, S w → K S0 (fun y => w (σ0 y))) (hm1 : ∀ w, S w → K S1 (fun y => w (σ1 y)))
    (hd : f p ≠ f q) (hn0 : ∃ y y', f (σ0 y) ≠ f (σ0 y')) (hn1 : ∃ y y', f (σ1 y) ≠ f (σ1 y'))
    (ha : K S a) (hb : K S b) (hda : a p ≠ a q) (hf : Run t (ins (fun x => a x && b x) S) f) :
    ∃ t0 t1, Run t0 S0 (fun y => f (σ0 y)) ∧ Run t1 S1 (fun y => f (σ1 y)) ∧
      ((t0 + 2 ≤ t + 1 ∧ t1 + 1 ≤ t + 1) ∨ (t0 + 1 ≤ t + 1 ∧ t1 + 2 ≤ t + 1)) := by
  have k0 := Cl_K hc0 ha hda
  have k1 := Cl_K hc1 ha hda
  have hz0 : ∀ w, ins (fun x => a x && b x) S w → K S0 (fun y => w (σ0 y)) := by
    rintro w (rfl | hw)
    · exact K_and ⟨_, k0⟩ (K_bind σ0 hm0 hb)
    · exact hm0 w hw
  have hz1 : ∀ w, ins (fun x => a x && b x) S w → K S1 (fun y => w (σ1 y)) := by
    rintro w (rfl | hw)
    · exact K_and ⟨_, k1⟩ (K_bind σ1 hm1 hb)
    · exact hm1 w hw
  cases hap : a p
  · obtain ⟨t', ht, hr⟩ := kill1 σ0 p q p t _ S0 f (by
        rintro w (rfl | hw) hd2
        · intro y; simp [k0 y, hap]
        · exact hc0 w hw hd2) hz0 hd hn0 hf
    exact ⟨t', t, hr, Run_map σ1 t _ S1 f hz1 hf, Or.inl ⟨by omega, le_rfl⟩⟩
  · have haq : a q = false := by
      cases h : a q
      · rfl
      · exact absurd (hap.trans h.symm) hda
    obtain ⟨t', ht, hr⟩ := kill1 σ1 p q q t _ S1 f (by
        rintro w (rfl | hw) hd2
        · intro y; simp [k1 y, haq]
        · exact hc1 w hw hd2) hz1 hd hn1 hf
    exact ⟨t, t', Run_map σ0 t _ S0 f hz0 hf, hr, Or.inr ⟨le_rfl, by omega⟩⟩

theorem kill2 (σ0 σ1 : κ → ι) (p q : ι) : ∀ (t : ℕ) (S : (ι → Bool) → Prop)
    (S0 S1 : (κ → Bool) → Prop) (f : ι → Bool), Cl σ0 p q p S → Cl σ1 p q q S →
    (∀ w, S w → K S0 (fun y => w (σ0 y))) → (∀ w, S w → K S1 (fun y => w (σ1 y))) → f p ≠ f q →
    (∃ y y', f (σ0 y) ≠ f (σ0 y')) → (∃ y y', f (σ1 y) ≠ f (σ1 y')) → Run t S f →
    ∃ t0 t1, Run t0 S0 (fun y => f (σ0 y)) ∧ Run t1 S1 (fun y => f (σ1 y)) ∧
      ((t0 + 2 ≤ t ∧ t1 + 1 ≤ t) ∨ (t0 + 1 ≤ t ∧ t1 + 2 ≤ t))
  | 0, _, _, _, f, hc, _, _, _, hd, ⟨y, y', hn⟩, _, hf =>
    absurd ((Cl_K hc hf hd y).trans (Cl_K hc hf hd y').symm) hn
  | t + 1, S, S0, S1, f, hc0, hc1, hm0, hm1, hd, hn0, hn1, hf => by
    rcases hf with hf | ⟨a, b, ha, hb, hf⟩
    · obtain ⟨t0, t1, r0, r1, h⟩ := kill2 σ0 σ1 p q t S S0 S1 f hc0 hc1 hm0 hm1 hd hn0 hn1 hf
      exact ⟨t0, t1, r0, r1, by omega⟩
    · by_cases hz : (a p && b p) ≠ (a q && b q)
      · rcases and_dep hz with h | h
        · exact kill2_dep σ0 σ1 p q hc0 hc1 hm0 hm1 hd hn0 hn1 ha hb h hf
        · have e : (fun x => a x && b x) = fun x => b x && a x :=
            funext fun x => Bool.and_comm _ _
          rw [e] at hf
          exact kill2_dep σ0 σ1 p q hc0 hc1 hm0 hm1 hd hn0 hn1 hb ha h hf
      · obtain ⟨t0, t1, r0, r1, h⟩ := kill2 σ0 σ1 p q t (ins (fun x => a x && b x) S)
          (ins (fun y => a (σ0 y) && b (σ0 y)) S0) (ins (fun y => a (σ1 y) && b (σ1 y)) S1) f
          (by
            rintro w (rfl | hw) hd2
            · exact absurd hd2 hz
            · exact hc0 w hw hd2)
          (by
            rintro w (rfl | hw) hd2
            · exact absurd hd2 hz
            · exact hc1 w hw hd2)
          (by
            rintro w (rfl | hw)
            · exact K_new _
            · exact K_ins (hm0 w hw))
          (by
            rintro w (rfl | hw)
            · exact K_new _
            · exact K_ins (hm1 w hw)) hd hn0 hn1 hf
        exact ⟨t0 + 1, t1 + 1, Or.inr ⟨_, _, K_bind σ0 hm0 ha, K_bind σ0 hm0 hb, r0⟩,
          Or.inr ⟨_, _, K_bind σ1 hm1 ha, K_bind σ1 hm1 hb, r1⟩, by omega⟩

end Prog

section Rules
variable {n : ℕ}

abbrev BF (n : ℕ) := (Fin n → Bool) → Bool

def Vars (n : ℕ) : BF n → Prop := fun w => ∃ i : Fin n, w = fun x => x i

def LB (f : BF n) (b : ℕ) : Prop := ∀ t, Run t (Vars n) f → b ≤ t

def pt (n : ℕ) (c : ℕ) : Fin n → Bool := fun i => c.testBit i.val

def rs (f : BF n) (i : Fin n) (c : Bool) : BF n := fun x => f (Function.update x i c)

theorem vars_rs (i : Fin n) (c : Bool) (w : BF n) (hw : Vars n w) :
    K (Vars n) (fun x => w (Function.update x i c)) := by
  obtain ⟨j, rfl⟩ := hw
  by_cases h : j = i
  · subst h; exact Or.inl ⟨c, by simp⟩
  · exact Or.inr (Or.inl ⟨j, by simp [Function.update_of_ne h]⟩)

theorem vars_cl (i : Fin n) (c : Bool) (x : Fin n → Bool) :
    Cl (fun y => Function.update y i c) (Function.update x i false) (Function.update x i true)
      (Function.update x i c) (Vars n) := by
  rintro w ⟨j, rfl⟩ hd y
  by_cases h : j = i
  · subst h; simp
  · exact absurd (by simp [Function.update_of_ne h]) hd

theorem rule1 (f : BF n) (i : Fin n) (c : Bool) (b p y y' : ℕ)
    (hd : f (Function.update (pt n p) i false) ≠ f (Function.update (pt n p) i true))
    (hn : rs f i c (pt n y) ≠ rs f i c (pt n y')) (h : LB (rs f i c) b) : LB f (b + 1) := by
  intro t ht
  obtain ⟨t', h1, h2⟩ := kill1 _ _ _ _ t _ (Vars n) f (vars_cl i c (pt n p)) (vars_rs i c) hd
    ⟨_, _, hn⟩ ht
  have := h t' h2
  omega

theorem rule2 (f : BF n) (i : Fin n) (b p y y' u u' : ℕ)
    (hd : f (Function.update (pt n p) i false) ≠ f (Function.update (pt n p) i true))
    (hn0 : rs f i false (pt n y) ≠ rs f i false (pt n y'))
    (hn1 : rs f i true (pt n u) ≠ rs f i true (pt n u'))
    (h0 : LB (rs f i false) b) (h1 : LB (rs f i true) b) : LB f (b + 2) := by
  intro t ht
  obtain ⟨t0, t1, r0, r1, h⟩ := kill2 _ _ _ _ t _ (Vars n) (Vars n) f (vars_cl i false (pt n p))
    (vars_cl i true (pt n p)) (vars_rs i false) (vars_rs i true) hd ⟨_, _, hn0⟩ ⟨_, _, hn1⟩ ht
  have g0 := h0 t0 r0
  have g1 := h1 t1 r1
  omega

theorem LB_mono {f : BF n} {b b' : ℕ} (h : LB f b) (hb : b' ≤ b) : LB f b' :=
  fun t ht => hb.trans (h t ht)

theorem LB_perm (π : Fin n → Fin n) (f g : BF n) (hg : ∀ x, g x = f (fun i => x (π i))) {b : ℕ}
    (h : LB g b) : LB f b := by
  intro t ht
  apply h t
  have e : g = fun x => f (fun i => x (π i)) := funext hg
  rw [e]
  refine Run_map (fun (x : Fin n → Bool) (i : Fin n) => x (π i)) t _ _ f ?_ ht
  rintro w ⟨j, rfl⟩
  exact Or.inr (Or.inl ⟨π j, rfl⟩)

end Rules

section Live

variable {α : Type} [DecidableEq α]

def build (ops : α → α → Finset α) (goal : α) : ℕ → Finset α → Prop
  | 0, available => goal ∈ available
  | k + 1, available => build ops goal k available ∨
    ∃ a ∈ available, ∃ b ∈ available, a ≠ b ∧
      ∃ z ∈ ops a b, build ops goal k (insert z available)

def live (ops : α → α → Finset α) (goal : α) : ℕ → Finset α → Prop
  | 0, s => s = {goal}
  | k + 1, s => live ops goal k s ∨
    ∃ a ∈ s, ∃ b ∈ s, a ≠ b ∧ ∃ z ∈ ops a b, z ∉ s ∧
      ∃ rest : Finset α, s = insert a (insert b rest) ∧ live ops goal k (insert z rest)

theorem compress {ops : α → α → Finset α} {goal : α} {k : ℕ} {available : Finset α}
    (h : build ops goal k available) : ∃ s ⊆ available, live ops goal k s := by
  induction k generalizing available with
  | zero =>
    exact ⟨{goal}, Finset.singleton_subset_iff.mpr h, rfl⟩
  | succ k ih =>
    rcases h with skip | ⟨a, ha, b, hb, hab, z, hz, tail⟩
    · obtain ⟨s, hs, hrun⟩ := ih skip
      exact ⟨s, hs, Or.inl hrun⟩
    · obtain ⟨t, ht, hrun⟩ := ih tail
      by_cases sub : t ⊆ available
      · exact ⟨t, sub, Or.inl hrun⟩
      · have hzmem : z ∈ t := by
          by_contra hn
          apply sub
          intro u hu
          rcases Finset.mem_insert.mp (ht hu) with rfl | ok
          · exact False.elim (hn hu)
          · exact ok
        have hzout : z ∉ available := by
          intro hh
          exact sub ((Finset.insert_eq_of_mem hh) ▸ ht)
        let rest := t.erase z
        have hrest : rest ⊆ available := by
          intro u hu
          have hu' := Finset.mem_erase.mp hu
          exact (Finset.mem_insert.mp (ht hu'.2)).resolve_left hu'.1
        let s := insert a (insert b rest)
        have hs : s ⊆ available := Finset.insert_subset ha (Finset.insert_subset hb hrest)
        refine ⟨s, hs, Or.inr ⟨a, by simp [s], b, by simp [s], hab, z, hz,
          fun h => hzout (hs h), rest, rfl, ?_⟩⟩
        simpa [rest, Finset.insert_erase hzmem] using hrun

theorem live_card {ops : α → α → Finset α} {goal : α} {k : ℕ} {s : Finset α}
    (h : live ops goal k s) : s.card ≤ k + 1 := by
  induction k generalizing s with
  | zero => change s = {goal} at h; simp [h]
  | succ k ih =>
    rcases h with skip | ⟨a, ha, b, hb, hab, z, hz, hout, rest, rfl, tail⟩
    · exact (ih skip).trans (by omega)
    · have hzrest : z ∉ rest := fun hm => hout (by simp [hm])
      have htail := ih tail
      rw [Finset.card_insert_of_notMem hzrest] at htail
      have h₁ := Finset.card_insert_le a (insert b rest)
      have h₂ := Finset.card_insert_le b rest
      omega

theorem live_separates {ops : α → α → Finset α} {goal : α} (D : α → Prop)
    (hd : D goal) (hops : ∀ a b, ∀ z ∈ ops a b, D z → D a ∨ D b)
    {k : ℕ} {s : Finset α} (h : live ops goal k s) : ∃ w ∈ s, D w := by
  induction k generalizing s with
  | zero => change s = {goal} at h; exact ⟨goal, by simp [h], hd⟩
  | succ k ih =>
    rcases h with skip | ⟨a, ha, b, hb, hab, z, hz, hout, rest, rfl, tail⟩
    · exact ih skip
    · obtain ⟨w, hw, hD⟩ := ih tail
      rcases Finset.mem_insert.mp hw with rfl | hw
      · rcases hops a b w hz hD with h | h
        · exact ⟨a, ha, h⟩
        · exact ⟨b, hb, h⟩
      · exact ⟨w, by simp [hw], hD⟩

theorem first_live {ops : α → α → Finset α} {goal : α} {k : ℕ} {s : Finset α}
    (h : live ops goal (k + 1) s) :
    s = {goal} ∨
    ∃ a ∈ s, ∃ b ∈ s, a ≠ b ∧ ∃ z ∈ ops a b, z ∉ s ∧
      ∃ rest : Finset α, s = insert a (insert b rest) ∧ live ops goal k (insert z rest) := by
  induction k with
  | zero => exact h
  | succ k ih =>
    rcases h with skip | step
    · rcases ih skip with done | ⟨a, ha, b, hb, hab, z, hz, hn, r, hs, tail⟩
      · exact .inl done
      · exact .inr ⟨a, ha, b, hb, hab, z, hz, hn, r, hs, Or.inl tail⟩
    · exact .inr step

end Live

def ops (a b : ℕ) : List ℕ := [a &&& b, a ||| b, a ^^^ (a &&& b), b ^^^ (a &&& b)]

abbrev bops (a b : ℕ) : Finset ℕ := (ops a b).toFinset

def sep (P m x : ℕ) : ℕ := Nat.land (Nat.xor (Nat.shiftRight x P) x) m

def cuts (P m : ℕ) (ws : List ℕ) : ℕ := ws.foldr (fun w v => Nat.lor (sep P m w) v) 0

def differs (P i w : ℕ) : Prop := w.testBit (P + i) ≠ w.testBit i

theorem ops_differs (P i a b z : ℕ) (hz : z ∈ bops a b) (hd : differs P i z) :
    differs P i a ∨ differs P i b := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  by_contra! fail
  obtain ⟨ha, hb⟩ := fail
  apply hd
  unfold differs at ha hb
  simp only [not_not] at ha hb
  rcases hz with rfl | rfl | rfl | rfl <;>
    simp only [Nat.testBit_and, Nat.testBit_or, Nat.testBit_xor, ha, hb]

theorem mask_bit (P i : ℕ) : (2 ^ P - 1).testBit i = decide (i < P) := Nat.testBit_two_pow_sub_one P i

theorem cuts_spec (P : ℕ) (ws : List ℕ) (i : ℕ) :
    (cuts P (2 ^ P - 1) ws).testBit i = true ↔ i < P ∧ ∃ w ∈ ws, differs P i w := by
  induction ws with
  | nil => simp [cuts]
  | cons a rest ih =>
    change ((((a >>> P) ^^^ a) &&& (2 ^ P - 1)) ||| cuts P (2 ^ P - 1) rest).testBit i = true ↔ _
    rw [Nat.testBit_or, Bool.or_eq_true, ih]
    have bx (p q : Bool) : Bool.xor p q = true ↔ p ≠ q := by cases p <;> cases q <;> decide
    simp only [Nat.testBit_and, Nat.testBit_xor, Nat.testBit_shiftRight, mask_bit,
      Bool.and_eq_true, bx, decide_eq_true_eq, differs, List.mem_cons, exists_eq_or_imp]
    tauto

theorem cuts_full {P g : ℕ} (hg : ∀ i, i < P → differs P i g) {k : ℕ} {ws : List ℕ}
    (h : live bops g k ws.toFinset) : cuts P (2 ^ P - 1) ws = 2 ^ P - 1 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [mask_bit]
  by_cases hi : i < P
  · have hw := live_separates (differs P i) (hg i hi) (ops_differs P i) h
    simpa [hi] using (cuts_spec P ws i).mpr ⟨hi, by simpa using hw⟩
  · cases hb : (cuts P (2 ^ P - 1) ws).testBit i
    · simp [hi]
    · exact absurd ((cuts_spec P ws i).mp hb).1 hi

theorem ops_swap (a b : ℕ) : bops a b = bops b a := by
  ext z
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false]
  rw [Nat.and_comm a b, Nat.or_comm a b]
  tauto

def singles {α : Type} : List α → List (α × List α)
  | [] => []
  | a :: rest => (a, rest) :: (singles rest).map (fun (b, bs) => (b, a :: bs))

def pairs {α : Type} : List α → List (α × α × List α)
  | [] => []
  | a :: rest => (singles rest).map (fun (b, bs) => (a, b, bs)) ++
      (pairs rest).map (fun (b, c, bs) => (b, c, a :: bs))

theorem pick_one {α : Type} {a : α} {ws : List α} (h : a ∈ ws) :
    ∃ rest, (a, rest) ∈ singles ws ∧ ws.Perm (a :: rest) := by
  induction ws with
  | nil => simp at h
  | cons x xs ih =>
    rcases List.mem_cons.mp h with e | h
    · subst x; exact ⟨xs, by simp [singles], .refl _⟩
    · obtain ⟨rest, hm, hp⟩ := ih h
      refine ⟨x :: rest, List.mem_cons_of_mem _ (List.mem_map.mpr ⟨(a, rest), hm, rfl⟩), ?_⟩
      exact (hp.cons x).trans (.swap _ _ _)

theorem pick_two {α : Type} {a b : α} {ws : List α} (ha : a ∈ ws) (hb : b ∈ ws) (hne : a ≠ b) :
    ∃ rest, ((a, b, rest) ∈ pairs ws ∨ (b, a, rest) ∈ pairs ws) ∧
      ws.Perm (a :: b :: rest) := by
  induction ws with
  | nil => simp at ha
  | cons x xs ih =>
    rcases List.mem_cons.mp ha with h | ha
    · subst x
      obtain ⟨r, hm, hp⟩ := pick_one ((List.mem_cons.mp hb).resolve_left (Ne.symm hne))
      exact ⟨r, .inl (List.mem_append_left _ (List.mem_map.mpr ⟨(b, r), hm, rfl⟩)), hp.cons a⟩
    · rcases List.mem_cons.mp hb with h | hb
      · subst x
        obtain ⟨r, hm, hp⟩ := pick_one (ws := xs) (a := a) (by assumption)
        exact ⟨r, .inr (List.mem_append_left _ (List.mem_map.mpr ⟨(a, r), hm, rfl⟩)),
          (hp.cons b).trans (.swap _ _ _)⟩
      · obtain ⟨r, hm, hp⟩ := ih ha hb
        refine ⟨x :: r, ?_,
          (hp.cons x).trans ((List.Perm.swap _ _ _).trans ((List.Perm.swap _ _ _).cons a))⟩
        rcases hm with hm | hm
        · exact .inl (List.mem_append_right _ (List.mem_map.mpr ⟨(a, b, r), hm, rfl⟩))
        · exact .inr (List.mem_append_right _ (List.mem_map.mpr ⟨(b, a, r), hm, rfl⟩))

def keepChoices (a b : ℕ) (r : List ℕ) : List (List ℕ) := [r, a :: r, b :: r, a :: b :: r]

theorem recover_kept {ws r : List ℕ} {a b : ℕ} {needed : Finset ℕ}
    (hp : ws.Perm (a :: b :: r)) (hn : ws.Nodup)
    (hs : ws.toFinset = insert a (insert b needed)) :
    ∃ kept ∈ keepChoices a b r, kept.Nodup ∧ kept.toFinset = needed := by
  have habr := hp.nodup_iff.mp hn
  have hbase : ws.toFinset = insert a (insert b r.toFinset) := by
    ext v
    simp [hp.mem_iff]
  have henne : ∀ v, v ∈ r ↔ v ∈ needed ∧ v ≠ a ∧ v ≠ b := by
    intro v
    have he : (v ∈ insert a (insert b r.toFinset)) ↔ v ∈ insert a (insert b needed) := by
      rw [← hbase, ← hs]
    simp only [Finset.mem_insert, List.mem_toFinset] at he
    simp only [List.nodup_cons, List.mem_cons, not_or] at habr
    grind
  by_cases ha : a ∈ needed <;> by_cases hb : b ∈ needed
  · refine ⟨a :: b :: r, by simp [keepChoices], habr, ?_⟩
    ext v; simp [henne]; grind
  · refine ⟨a :: r, by simp [keepChoices], ?_, ?_⟩
    · simp_all [List.nodup_cons]
    · ext v; simp [henne]; grind
  · refine ⟨b :: r, by simp [keepChoices], (List.nodup_cons.mp habr).2, ?_⟩
    ext v; simp [henne]; grind
  · refine ⟨r, by simp [keepChoices], (List.nodup_cons.mp (List.nodup_cons.mp habr).2).2, ?_⟩
    ext v; simp [henne]; grind

theorem singleton_list {goal : ℕ} {ws : List ℕ} (hn : ws.Nodup) (hs : ws.toFinset = {goal}) :
    ws = [goal] := by
  have hc := List.toFinset_card_of_nodup hn
  rw [hs] at hc
  cases ws with
  | nil => simp at hc
  | cons w ws =>
    cases ws with
    | nil => simpa using hs
    | cons => simp at hc

def fz {β : Type} (n : ℕ) (f : ℕ → β) : β := Nat.casesOn n (f 0) (fun k => f (Nat.succ k))

theorem fz_eq {β : Type} (n : ℕ) (f : ℕ → β) : fz n f = f n := by cases n <;> rfl

def fzl {β : Type} : List ℕ → (List ℕ → β) → β
  | [], f => f []
  | a :: t, f => fz a fun a' => fzl t fun t' => f (a' :: t')

theorem fzl_eq {β : Type} : ∀ (l : List ℕ) (f : List ℕ → β), fzl l f = f l
  | [], f => rfl
  | a :: t, f => by simp [fzl, fz_eq, fzl_eq t]

def enc {ρ : Type} (w : ρ → Bool) : List ρ → ℕ
  | [] => 0
  | p :: t => Nat.bit (w p) (enc w t)

theorem enc_testBit {ρ : Type} (w : ρ → Bool) : ∀ (l : List ρ) (j : ℕ),
    (enc w l).testBit j = (l.map w).getD j false
  | [], j => by simp [enc]
  | p :: t, 0 => by simp [enc]
  | p :: t, j + 1 => by simp [enc, Nat.testBit_bit_succ, enc_testBit w t j]

theorem enc_lt {ρ : Type} (w : ρ → Bool) (l : List ρ) : enc w l < 2 ^ l.length := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  rw [enc_testBit, List.getD_eq_default _ _ (by simp; omega)]

theorem enc_congr {ρ : Type} {w w' : ρ → Bool} (h : ∀ x, w x = w' x) (l : List ρ) :
    enc w l = enc w' l := by
  have : w = w' := funext h
  rw [this]

theorem enc_false {ρ : Type} (l : List ρ) : enc (fun _ : ρ => false) l = 0 := by
  induction l with
  | nil => rfl
  | cons a t ih => simp [enc, ih]

theorem enc_op {ρ : Type} (o : Bool → Bool → Bool) (o' : ℕ → ℕ → ℕ) (h0 : o false false = false)
    (ho : ∀ a b i, (o' a b).testBit i = o (a.testBit i) (b.testBit i)) (a b : ρ → Bool)
    (l : List ρ) : enc (fun r => o (a r) (b r)) l = o' (enc a l) (enc b l) := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [ho, enc_testBit, enc_testBit, enc_testBit]
  by_cases h : j < l.length
  · simp [h]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      List.getD_eq_default _ _ (by simp; omega), h0]

section Code
variable {ρ : Type} (x0 : ρ) (pts : List ρ)

def code (w : ρ → Bool) : ℕ := enc (fun x => Bool.xor (w x) (w x0)) pts

theorem code_const (c : Bool) : code x0 pts (fun _ => c) = 0 := by
  unfold code
  rw [← enc_false pts]
  exact enc_congr (fun x => by simp) pts

theorem code_not (w : ρ → Bool) : code x0 pts (fun x => !w x) = code x0 pts w :=
  enc_congr (fun x => by
    show Bool.xor (!w x) (!w x0) = Bool.xor (w x) (w x0)
    cases w x <;> cases w x0 <;> rfl) pts

theorem code_and (a b : ρ → Bool) :
    code x0 pts (fun x => a x && b x) ∈ bops (code x0 pts a) (code x0 pts b) := by
  have e1 := enc_op (ρ := ρ) (fun p q => p && q) (· &&& ·) rfl (fun a b i => Nat.testBit_and a b i)
    (fun x => Bool.xor (a x) (a x0)) (fun x => Bool.xor (b x) (b x0)) pts
  have e2 := enc_op (ρ := ρ) (fun p q => p || q) (· ||| ·) rfl (fun a b i => Nat.testBit_or a b i)
    (fun x => Bool.xor (a x) (a x0)) (fun x => Bool.xor (b x) (b x0)) pts
  have e3 := enc_op (ρ := ρ) (fun p q => Bool.xor p (p && q)) (fun a b => a ^^^ (a &&& b)) rfl
    (fun a b i => by simp [Nat.testBit_and, Nat.testBit_xor])
    (fun x => Bool.xor (a x) (a x0)) (fun x => Bool.xor (b x) (b x0)) pts
  have e4 := enc_op (ρ := ρ) (fun p q => Bool.xor q (p && q)) (fun a b => b ^^^ (a &&& b)) rfl
    (fun a b i => by simp [Nat.testBit_and, Nat.testBit_xor])
    (fun x => Bool.xor (a x) (a x0)) (fun x => Bool.xor (b x) (b x0)) pts
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false]
  unfold code
  cases ha : a x0 <;> cases hb : b x0
  · left
    rw [ha, hb] at e1
    rw [← e1]
    exact enc_congr (fun x => by simp only [ha, hb]; cases a x <;> cases b x <;> rfl) pts
  · right; right; left
    rw [ha, hb] at e3
    rw [← e3]
    exact enc_congr (fun x => by simp only [ha, hb]; cases a x <;> cases b x <;> rfl) pts
  · right; right; right
    rw [ha, hb] at e4
    rw [← e4]
    exact enc_congr (fun x => by simp only [ha, hb]; cases a x <;> cases b x <;> rfl) pts
  · right; left
    rw [ha, hb] at e2
    rw [← e2]
    exact enc_congr (fun x => by simp only [ha, hb]; cases a x <;> cases b x <;> rfl) pts

theorem bops_zero {b z : ℕ} (hz : z ∈ bops 0 b) : z = 0 ∨ z = b := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl <;> simp

theorem bops_self {b z : ℕ} (hz : z ∈ bops b b) : z = 0 ∨ z = b := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl <;> simp

theorem sim (f : ρ → Bool) (hf : code x0 pts f ≠ 0) : ∀ (t : ℕ) (S : (ρ → Bool) → Prop)
    (A : Finset ℕ), (∀ w, S w → code x0 pts w = 0 ∨ code x0 pts w ∈ A) → Run t S f →
    build bops (code x0 pts f) t A
  | 0, S, A, h, hr => by
    rcases hr with ⟨c, rfl⟩ | hr | hr
    · exact absurd (code_const x0 pts c) hf
    · exact (h f hr).resolve_left hf
    · have := h _ hr
      rw [code_not] at this
      exact this.resolve_left hf
  | t + 1, S, A, h, hr => by
    rcases hr with hr | ⟨a, b, ha, hb, hr⟩
    · exact Or.inl (sim f hf t S A h hr)
    · have hK : ∀ w, K S w → code x0 pts w = 0 ∨ code x0 pts w ∈ A := by
        intro w hw
        rcases hw with ⟨c, rfl⟩ | hw | hw
        · exact Or.inl (code_const x0 pts c)
        · exact h w hw
        · have := h _ hw
          rwa [code_not] at this
      have hmem := code_and x0 pts a b
      by_cases hz : code x0 pts (fun x => a x && b x) = 0 ∨ code x0 pts (fun x => a x && b x) ∈ A
      · refine Or.inl (sim f hf t _ A ?_ hr)
        rintro w (rfl | hw)
        · exact hz
        · exact h w hw
      · have ha' := hK a ha
        have hb' := hK b hb
        have haA : code x0 pts a ∈ A := by
          rcases ha' with h0 | h1
          · rw [h0] at hmem
            rcases bops_zero hmem with e | e
            · exact absurd (Or.inl e) hz
            · exact absurd (e ▸ hb') hz
          · exact h1
        have hbA : code x0 pts b ∈ A := by
          rcases hb' with h0 | h1
          · rw [h0, ops_swap] at hmem
            rcases bops_zero hmem with e | e
            · exact absurd (Or.inl e) hz
            · exact absurd (e ▸ ha') hz
          · exact h1
        have hne : code x0 pts a ≠ code x0 pts b := by
          intro e
          rw [e] at hmem
          rcases bops_self hmem with e2 | e2
          · exact hz (Or.inl e2)
          · exact hz (Or.inr (e2 ▸ hbA))
        refine Or.inr ⟨_, haA, _, hbA, hne, _, hmem, sim f hf t _ _ ?_ hr⟩
        rintro w (rfl | hw)
        · exact Or.inr (Finset.mem_insert_self _ _)
        · exact (h w hw).imp id (fun h => Finset.mem_insert_of_mem h)

end Code

def isBinary (g : Gate) : Bool := match g.op with
  | .not => false
  | _ => true

def bc (gs : List Gate) : ℕ := (gs.filter isBinary).length

def legal (g : Gate) : Prop := (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

section Compile
variable {n : ℕ}

def rd (ws : List (BF n)) (i : ℕ) : BF n := fun x => (ws.map fun w => w x).getD i false

theorem rd_K {S : BF n → Prop} {ws : List (BF n)} (hw : ∀ w ∈ ws, K S w) (i : ℕ) :
    K S (rd ws i) := by
  by_cases h : i < ws.length
  · have : rd ws i = ws[i] := by
      funext x
      simp [rd, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
    rw [this]
    exact hw _ (List.getElem_mem h)
  · refine Or.inl ⟨false, ?_⟩
    funext x
    simp [rd, List.getD_eq_getElem?_getD, List.getElem?_eq_none (Nat.le_of_not_gt h)]

theorem gate_run {S : BF n → Prop} {ws : List (BF n)} (hw : ∀ w ∈ ws, K S w) (g : Gate)
    (hg : legal g) (z : BF n)
    (hz : z = fun x => g.op.eval (g.inputs.map fun i => rd ws i x)) :
    K S z ∨ (isBinary g = true ∧ ∃ a b : BF n, K S a ∧ K S b ∧ K (ins (fun x => a x && b x) S) z) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  subst hz
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩
  · left
    rcases hop with rfl | rfl | rfl
    · exact Or.inl ⟨true, rfl⟩
    · exact Or.inl ⟨false, rfl⟩
    · exact Or.inl ⟨true, rfl⟩
  · left
    rcases hop with rfl | rfl | rfl
    · have e : (fun x => GateOp.eval .and ([i].map fun i => rd ws i x)) = rd ws i :=
        funext fun x => by simp [GateOp.eval]
      simp only [e]; exact rd_K hw i
    · have e : (fun x => GateOp.eval .or ([i].map fun i => rd ws i x)) = rd ws i :=
        funext fun x => by simp [GateOp.eval]
      simp only [e]; exact rd_K hw i
    · exact K_not (rd_K hw i)
  · rcases hop with rfl | rfl | rfl
    · right
      refine ⟨rfl, rd ws i, rd ws j, rd_K hw i, rd_K hw j, ?_⟩
      have e : (fun x => GateOp.eval .and ([i, j].map fun i => rd ws i x)) =
          fun x => rd ws i x && rd ws j x := funext fun x => by simp [GateOp.eval]
      simp only [e]; exact K_new _
    · right
      refine ⟨rfl, _, _, K_not (rd_K hw i), K_not (rd_K hw j), ?_⟩
      have e : (fun x => GateOp.eval .or ([i, j].map fun i => rd ws i x)) =
          fun x => !(!rd ws i x && !rd ws j x) := funext fun x => by simp [GateOp.eval]
      simp only [e]; exact K_not (K_new _)
    · left
      exact K_not (rd_K hw i)
  · simp at cap

theorem compile (out : ℕ) : ∀ (gs : List Gate) (ws : List (BF n)) (S : BF n → Prop),
    (∀ g ∈ gs, legal g) → (∀ w ∈ ws, K S w) →
    Run (bc gs) S (fun x => (gs.foldl step (ws.map fun w => w x)).getD out false)
  | [], ws, S, _, hw => rd_K hw out
  | g :: gs, ws, S, hg, hw => by
    set z : BF n := fun x => g.op.eval (g.inputs.map fun i => rd ws i x) with hz
    have hst : ∀ x, step (ws.map fun w => w x) g = (ws ++ [z]).map fun w => w x := by
      intro x
      simp [step, hz, rd]
    have hfold : (fun x => ((g :: gs).foldl step (ws.map fun w => w x)).getD out false) =
        fun x => (gs.foldl step ((ws ++ [z]).map fun w => w x)).getD out false := by
      funext x
      rw [List.foldl_cons, hst x]
    rw [hfold]
    have tail := fun S' h => compile out gs (ws ++ [z]) S' (fun g' h' => hg g' (by simp [h'])) h
    have ext : ∀ S' : BF n → Prop, (∀ w ∈ ws, K S' w) → K S' z → ∀ w ∈ ws ++ [z], K S' w := by
      intro S' h1 h2 w hm
      rcases List.mem_append.mp hm with hm | hm
      · exact h1 w hm
      · exact (List.mem_singleton.mp hm) ▸ h2
    have hle : bc gs ≤ bc (g :: gs) := by
      unfold bc
      rw [List.filter_cons]
      split <;> simp
    rcases gate_run hw g (hg g (by simp)) z hz with h | ⟨hb, a, b, ha, hb2, h⟩
    · exact Run_le hle (tail S (ext S hw h))
    · have hbc : bc (g :: gs) = bc gs + 1 := by simp [bc, hb]
      rw [hbc]
      exact Or.inr ⟨a, b, ha, hb2, tail _ (ext _ (fun w hm => K_ins (hw w hm)) h)⟩

theorem bound_of_LB (F : BF n) (b : ℕ) (h : LB F b) (gs : List Gate) (o : ℕ)
    (hg : ∀ g ∈ gs, legal g)
    (he : ∀ x : Fin n → Bool, Circuit.eval ⟨gs, o⟩ (List.ofFn x) = F x) : b ≤ bc gs := by
  apply h
  have hr := compile o gs (List.ofFn fun i : Fin n => fun x : Fin n → Bool => x i) (Vars n) hg (by
    intro w hw
    obtain ⟨i, rfl⟩ := (List.mem_ofFn' _ _).mp hw
    exact Or.inr (Or.inl ⟨i, rfl⟩))
  have e : (fun x : Fin n → Bool => (gs.foldl step ((List.ofFn fun i : Fin n =>
      fun x : Fin n → Bool => x i).map fun w => w x)).getD o false) = F := by
    funext x
    rw [← he x, List.map_ofFn]
    rfl
  rw [e] at hr
  exact hr

end Compile

section LiveProjection

variable {α ι : Type} [DecidableEq α]
variable {ops : α → α → Finset α} {goal : α} {k : ℕ} {s : Finset α}

private theorem lp_count_insert_le (C : α → Prop) [DecidablePred C] (w : α) (r : Finset α) :
    ((insert w r).filter C).card ≤ (r.filter C).card + (if C w then 1 else 0) := by
  by_cases h : C w
  · simpa [Finset.filter_insert, h] using Finset.card_insert_le w (r.filter C)
  · simp [Finset.filter_insert, h]

theorem live_project_steps (ev : α → ι → Bool) (C : α → Prop) [DecidablePred C]
    (h0 : ∀ w, C w → ∀ S, K S (ev w))
    (hboth : ∀ a b, ∀ z ∈ ops a b, C a → C b → C z)
    (hfree : ∀ a b, ∀ z ∈ ops a b, C a ∨ C b → ∀ S, K S (ev a) → K S (ev b) → K S (ev z))
    (hgate : ∀ a b, ∀ z ∈ ops a b, ∀ S, K S (ev a) → K S (ev b) →
      K S (ev z) ∨ ∃ u v, K S u ∧ K S v ∧ K (ins (fun i => u i && v i) S) (ev z))
    (hg : ¬ C goal) (h : live ops goal k s) (S : (ι → Bool) → Prop)
    (hs : ∀ w ∈ s, ¬ C w → K S (ev w)) :
    ∃ t, Run t S (ev goal) ∧ t + (s.filter C).card ≤ k := by
  induction k generalizing s S with
  | zero =>
    change s = {goal} at h
    subst s
    exact ⟨0, hs goal (by simp) hg, by simp [hg]⟩
  | succ k ih =>
    rcases h with h | ⟨a, ha, b, hb, _, z, hz, hout, r, hsr, tail⟩
    · obtain ⟨t, ht, hn⟩ := ih h S hs
      exact ⟨t, ht, by omega⟩
    · have knew : ∀ w ∈ s, K S (ev w) := by
        intro w hw
        by_cases hc : C w
        · exact h0 w hc S
        · exact hs w hw hc
      have ka := knew a ha
      have kb := knew b hb
      subst s
      have kr : ∀ w ∈ r, K S (ev w) := fun w hw => knew w (by simp [hw])
      have hzr : z ∉ r := fun hw => hout (by simp [hw])
      have cnt₁ := lp_count_insert_le C a (insert b r)
      have cnt₂ := lp_count_insert_le C b r
      have cnt₃ : ((insert z r).filter C).card =
          (r.filter C).card + (if C z then 1 else 0) := by
        by_cases hc : C z
        · simp [Finset.filter_insert, hc, Finset.card_insert_of_notMem, hzr]
        · simp [Finset.filter_insert, hc]
      have skip : K S (ev z) → ∃ t, Run t S (ev goal) ∧
          t + ((insert z r).filter C).card ≤ k := by
        intro kz
        apply ih tail S
        intro w hw _
        rcases Finset.mem_insert.mp hw with rfl | hw
        · exact kz
        · exact kr w hw
      by_cases cheap : C a ∨ C b
      · obtain ⟨t, ht, hcount⟩ := skip (hfree a b z hz cheap S ka kb)
        refine ⟨t, ht, ?_⟩
        have both := hboth a b z hz
        by_cases ca : C a <;> by_cases cb : C b <;> by_cases cz : C z <;>
          simp_all only [↓reduceIte, or_self, or_false, or_true] <;> omega
      · obtain ⟨ca, cb⟩ := not_or.mp cheap
        simp only [ca, cb, ite_false, Nat.add_zero] at cnt₁ cnt₂
        rcases hgate a b z hz S ka kb with kz | ⟨u, v, ku, kv, kz⟩
        · obtain ⟨t, ht, hn⟩ := skip kz
          exact ⟨t, ht, by omega⟩
        · obtain ⟨t, ht, hn⟩ := ih tail (ins (fun i => u i && v i) S) (by
            intro w hw _
            rcases Finset.mem_insert.mp hw with rfl | hw
            · exact kz
            · exact K_ins (kr w hw))
          exact ⟨t+1, Or.inr ⟨u, v, ku, kv, ht⟩, by omega⟩

private theorem lp_xor {S : (ι → Bool) → Prop} {w : ι → Bool}
    (p : Bool) (h : K S w) : K S (fun i => Bool.xor p (w i)) := by
  cases p
  · simpa using h
  · simpa using K_not h

theorem live_project_loss (ev : α → ι → Bool) (C : α → Prop) [DecidablePred C]
    (hc : ∀ w, C w ↔ ∃ c : Bool, ev w = fun _ => c)
    (hop : ∀ a b, ∀ z ∈ ops a b, ∃ pa pb pz : Bool, ∀ i,
      ev z i = Bool.xor pz (Bool.xor pa (ev a i) && Bool.xor pb (ev b i)))
    (hg : ¬ C goal) (h : live ops goal k s) (S : (ι → Bool) → Prop)
    (hs : ∀ w ∈ s, ¬ C w → K S (ev w)) :
    ∃ t, Run t S (ev goal) ∧ t + (s.filter C).card ≤ k := by
  apply live_project_steps ev C _ _ _ _ hg h S hs
  · intro w hw _
    exact Or.inl ((hc w).mp hw)
  · intro a b z hz ca cb
    obtain ⟨u, hu⟩ := (hc a).mp ca
    obtain ⟨v, hv⟩ := (hc b).mp cb
    obtain ⟨pa, pb, pz, hh⟩ := hop a b z hz
    exact (hc z).mpr ⟨_, funext fun i => by rw [hh, hu, hv]⟩
  · intro a b z hz cheap S ka kb
    obtain ⟨pa, pb, pz, hh⟩ := hop a b z hz
    rw [funext hh]
    apply lp_xor pz
    rcases cheap with ca | cb
    · obtain ⟨c, hc'⟩ := (hc a).mp ca
      exact K_and ⟨_, fun i => by rw [hc']⟩ (lp_xor pb kb)
    · obtain ⟨c, hc'⟩ := (hc b).mp cb
      simp_rw [Bool.and_comm (Bool.xor pa _) (Bool.xor pb _)]
      exact K_and ⟨_, fun i => by rw [hc']⟩ (lp_xor pa ka)
  · intro a b z hz S ka kb
    obtain ⟨pa, pb, pz, hh⟩ := hop a b z hz
    refine Or.inr ⟨_, _, lp_xor pa ka, lp_xor pb kb, ?_⟩
    rw [funext hh]
    exact lp_xor pz (K_new _)

end LiveProjection
section PoolPrune

abbrev R (d : ℕ) := {i : ℕ // d.testBit i = true}

def v (d w : ℕ) (i : R d) : Bool := w.testBit i.val

def PoolLB (d : ℕ) (roots : List ℕ) (g b : ℕ) : Prop :=
  ∀ k, Run k (fun w => ∃ a ∈ roots, w = v d a) (v d g) → b ≤ k

inductive HistOK (roots : List ℕ) : List ℕ → Prop
  | root : HistOK roots roots
  | cons {hist : List ℕ} {a b z : ℕ} : HistOK roots hist →
      a ∈ hist → b ∈ hist → z ∈ bops a b → HistOK roots (z :: hist)

def pconst (d w : ℕ) : Bool :=
  fz (Nat.land w d) fun t => t == 0 || t == d

def pcheap (d z : ℕ) (hist : List ℕ) : Bool :=
  fz (Nat.land z d) fun t => t == 0 || t == d ||
    fz (Nat.xor t d) fun n =>
      hist.any fun a => fz (Nat.land a d) fun u => u == t || u == n

def pcost (d : ℕ) : ℕ → List ℕ → ℕ
  | n + 1, z :: hist => if pcheap d z hist then pcost d n hist else (pcost d n hist).succ
  | _, _ => 0

def cost (d : ℕ) (roots hist : List ℕ) : ℕ :=
  pcost d (hist.length - roots.length) hist

def pprune (roots : List ℕ) (bounds : List (ℕ × ℕ)) (k : ℕ) (hist ws : List ℕ) : Bool :=
  bounds.any fun (d, b) => decide (k + cost d roots hist < b + ws.countP (pconst d))

private theorem pmask_bit (d w : ℕ) (i : R d) :
    (Nat.land w d).testBit i.val = v d w i := by
  simp [Nat.testBit_and, i.property, v]

theorem pconst_spec (d w : ℕ) : pconst d w = true ↔ ∃ c : Bool, v d w = fun _ => c := by
  simp only [pconst, fz_eq, Bool.or_eq_true, beq_iff_eq]
  constructor
  · rintro (h | h)
    · exact ⟨false, funext fun i => by rw [← pmask_bit, h]; simp⟩
    · exact ⟨true, funext fun i => by rw [← pmask_bit, h]; exact i.property⟩
  · rintro ⟨c, h⟩
    have hi (i : ℕ) (hd : d.testBit i = true) : w.testBit i = c :=
      congrFun h ⟨i, hd⟩
    cases c
    · left
      apply Nat.eq_of_testBit_eq
      intro i
      cases hd : d.testBit i <;> simp [Nat.testBit_and, hd, hi]
    · right
      apply Nat.eq_of_testBit_eq
      intro i
      cases hd : d.testBit i <;> simp [Nat.testBit_and, hd, hi]

theorem bops_signed (d a b z : ℕ) (hz : z ∈ bops a b) :
    ∃ pa pb pz : Bool, ∀ i, v d z i =
      Bool.xor pz (Bool.xor pa (v d a i) && Bool.xor pb (v d b i)) := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl
  · exact ⟨false, false, false, fun i => by simp [v, Nat.testBit_and]⟩
  · refine ⟨true, true, true, fun i => ?_⟩
    simp only [v, Nat.testBit_or]
    cases a.testBit i.val <;> cases b.testBit i.val <;> rfl
  · refine ⟨false, true, false, fun i => ?_⟩
    simp only [v, Nat.testBit_xor, Nat.testBit_and]
    cases a.testBit i.val <;> cases b.testBit i.val <;> rfl
  · refine ⟨true, false, false, fun i => ?_⟩
    simp only [v, Nat.testBit_xor, Nat.testBit_and]
    cases a.testBit i.val <;> cases b.testBit i.val <;> rfl

private abbrev ppool (d : ℕ) (ws : List ℕ) : (R d → Bool) → Prop :=
  fun w => ∃ a ∈ ws, w = v d a

private theorem ppool_mem {d a : ℕ} {l : List ℕ} (ha : a ∈ l) : K (ppool d l) (v d a) :=
  Or.inr (Or.inl ⟨a, ha, rfl⟩)

private theorem pcheap_K {d z : ℕ} {hist : List ℕ} (h : pcheap d z hist = true) :
    K (ppool d hist) (v d z) := by
  simp only [pcheap, fz_eq, Bool.or_eq_true, beq_iff_eq, List.any_eq_true] at h
  rcases h with hc | ⟨a, ha, e | e⟩
  · apply Or.inl
    exact (pconst_spec d z).mp (by simpa [pconst, fz_eq] using hc)
  · have E : v d z = v d a := funext fun i => by rw [← pmask_bit, ← e, pmask_bit]
    exact E ▸ ppool_mem ha
  · have E : v d z = fun i => !v d a i := by
      funext i
      have he := congrArg (fun n : ℕ => n.testBit i.val) e
      change (Nat.land a d).testBit i.val = ((Nat.land z d) ^^^ d).testBit i.val at he
      simp only [Nat.testBit_xor, pmask_bit, i.property, Bool.xor_true] at he
      simp [he]
    rw [E]; exact K_not (ppool_mem ha)

private theorem ppool_remap {d z : ℕ} {l : List ℕ} {S : (R d → Bool) → Prop}
    (hz : K S (v d z)) (hl : ∀ a ∈ l, K S (v d a))
    {k : ℕ} {f : R d → Bool} (h : Run k (ppool d (z :: l)) f) : Run k S f := by
  apply Run_map id k (ppool d (z :: l)) S f _ h
  rintro _ ⟨a, ha, rfl⟩
  rcases List.mem_cons.mp ha with rfl | ha
  · exact hz
  · exact hl _ ha

private theorem HistOK.plen {roots hist} (hh : HistOK roots hist) :
    roots.length ≤ hist.length := by
  induction hh with
  | root => rfl
  | cons _ _ _ _ ih => exact Nat.le.step ih

private theorem pcost_cons {d z : ℕ} {roots hist : List ℕ} (hh : HistOK roots hist) :
    cost d roots (z :: hist) =
      if pcheap d z hist then cost d roots hist else (cost d roots hist).succ := by
  have hlen := hh.plen
  have e : (z :: hist).length - roots.length = (hist.length - roots.length).succ := by
    simp only [List.length_cons]; omega
  simp only [cost, e, pcost]

theorem HistOK.cost_run {d : ℕ} {roots hist : List ℕ} (hh : HistOK roots hist)
    {f : R d → Bool} {k : ℕ} (h : Run k (ppool d hist) f) :
    Run (cost d roots hist + k) (ppool d roots) f := by
  induction hh generalizing k with
  | root => simpa [cost, pcost] using h
  | @cons hist a b z hh ha hb hz ih =>
    rw [pcost_cons hh]
    by_cases cheap : pcheap d z hist = true
    · simp only [cheap, ↓reduceIte]
      exact ih (ppool_remap (pcheap_K cheap) (fun _ ha => ppool_mem ha) h)
    · rw [ite_eq_right cheap, Nat.succ_add, ← Nat.add_succ]
      apply ih
      obtain ⟨pa, pb, pz, hbit⟩ := bops_signed d a b z hz
      refine Or.inr ⟨_, _, lp_xor pa (ppool_mem ha), lp_xor pb (ppool_mem hb), ?_⟩
      apply ppool_remap _ (fun _ hc => K_ins (ppool_mem hc)) h
      rw [funext hbit]
      exact lp_xor pz (K_new _)

theorem prune_ineq {d g b k : ℕ} {roots hist ws : List ℕ}
    (hg : pconst d g = false) (hb : PoolLB d roots g b) (hh : HistOK roots hist)
    (hn : ws.Nodup) (hw : ∀ w ∈ ws, w ∈ hist) (hl : live bops g k ws.toFinset) :
    b + ws.countP (pconst d) ≤ k + cost d roots hist := by
  obtain ⟨t, hr, hle⟩ := live_project_loss (v d) (fun w => pconst d w = true)
    (pconst_spec d) (bops_signed d) (by simp [hg]) hl (ppool d hist)
    (fun w hw' _ => ppool_mem (hw w (List.mem_toFinset.mp hw')))
  have lb := hb _ (hh.cost_run hr)
  rw [hn.card_eq_countP] at hle
  simpa using (show b + ws.countP (fun w => decide (pconst d w = true)) ≤ k + cost d roots hist by
    omega)

theorem pprune_sound {roots hist ws : List ℕ} {bounds : List (ℕ × ℕ)} {g k : ℕ}
    (hv : ∀ q ∈ bounds, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hh : HistOK roots hist) (hn : ws.Nodup) (hw : ∀ w ∈ ws, w ∈ hist)
    (hl : live bops g k ws.toFinset) : pprune roots bounds k hist ws = false := by
  apply Bool.eq_false_iff.mpr
  intro h
  unfold pprune at h
  obtain ⟨⟨d,b⟩, hq, hc⟩ := List.any_eq_true.mp h
  obtain ⟨hg, hb⟩ := hv _ hq
  exact (Nat.not_lt_of_ge (prune_ineq hg hb hh hn hw hl)) (of_decide_eq_true hc)

end PoolPrune
namespace PSearchAux

def isOne (g : ℕ) : List ℕ → Bool
  | [w] => Nat.beq w g
  | _ => false

theorem isOne_self (g : ℕ) : isOne g [g] = true := Nat.beq_refl g

def memb (z : ℕ) : List ℕ → Bool
  | [] => false
  | w :: t => or (Nat.beq z w) (memb z t)

theorem memb_false {z : ℕ} : ∀ {ws : List ℕ}, z ∉ ws → memb z ws = false
  | [], _ => rfl
  | w :: t, h => by
    have h1 : z ≠ w := fun e => h (e ▸ List.mem_cons_self ..)
    have h2 : z ∉ t := fun e => h (List.mem_cons_of_mem _ e)
    show or (Nat.beq z w) (memb z t) = false
    rw [memb_false h2]
    cases hb : Nat.beq z w
    · rfl
    · exact absurd (Nat.eq_of_beq_eq_true hb) h1

def opsK (a b : ℕ) : List ℕ :=
  [Nat.land a b, Nat.lor a b, Nat.xor a (Nat.land a b), Nat.xor b (Nat.land a b)]

theorem opsK_eq (a b : ℕ) : opsK a b = ops a b := rfl

theorem all_false_of {α : Type} {l : List α} {p : α → Bool} {x : α} (hx : x ∈ l) (hp : p x = false) :
    l.all p = false := by
  cases h : l.all p
  · rfl
  · rw [List.all_eq_true] at h
    rw [h x hx] at hp
    exact absurd hp (by decide)

def kp (P m k : ℕ) (nx : List ℕ → Bool) (z : ℕ) (r : List ℕ) : Bool :=
  fzl r fun r => or (Nat.blt k r.length) (or (not (Nat.beq (cuts P m (z :: r)) m)) (nx (z :: r)))

def cand (P m k : ℕ) (nx : List ℕ → Bool) (ws : List ℕ) (cw : ℕ) (q : ℕ × ℕ × List ℕ) (z : ℕ) : Bool :=
  or (Nat.beq z 0) (or (memb z ws) (or (not (Nat.beq (Nat.lor (sep P m z) cw) m))
    ((keepChoices q.1 q.2.1 q.2.2).all fun r => kp P m k nx z r)))

theorem live_zero {g : ℕ} (hg : g ≠ 0) : ∀ {k : ℕ} {s : Finset ℕ}, live bops g k s → 0 ∉ s := by
  intro k
  induction k with
  | zero =>
    intro s h h0
    change s = {g} at h
    subst h
    exact hg (Finset.mem_singleton.mp h0).symm
  | succ k ih =>
    intro s h h0
    rcases h with h | ⟨a, ha, b, hb, hab, z, hz, hout, rest, rfl, tail⟩
    · exact ih h h0
    · have h1 := ih tail
      have hz0 : z ≠ 0 := fun e => h1 (e ▸ Finset.mem_insert_self _ _)
      have hr0 : 0 ∉ rest := fun e => h1 (Finset.mem_insert_of_mem e)
      rcases Finset.mem_insert.mp h0 with e | e
      · rw [← e] at hz
        rcases bops_zero hz with e2 | e2
        · exact hz0 e2
        · exact hout (by rw [e2]; exact Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
      · rcases Finset.mem_insert.mp e with e | e
        · rw [← e, ops_swap] at hz
          rcases bops_zero hz with e2 | e2
          · exact hz0 e2
          · exact hout (by rw [e2]; exact Finset.mem_insert_self _ _)
        · exact hr0 e

theorem cuts_sup {P : ℕ} {ws ws' : List ℕ} (hsub : ∀ w ∈ ws, w ∈ ws')
    (h : cuts P (2 ^ P - 1) ws = 2 ^ P - 1) : cuts P (2 ^ P - 1) ws' = 2 ^ P - 1 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [mask_bit]
  by_cases hi : i < P
  · have h1 : (cuts P (2 ^ P - 1) ws).testBit i = true := by rw [h, mask_bit]; simp [hi]
    obtain ⟨_, w, hw, hd⟩ := (cuts_spec P ws i).mp h1
    have := (cuts_spec P ws' i).mpr ⟨hi, w, hsub w hw, hd⟩
    simpa [hi] using this
  · cases hb : (cuts P (2 ^ P - 1) ws').testBit i
    · simp [hi]
    · exact absurd ((cuts_spec P ws' i).mp hb).1 hi

def stepP (P m g k : ℕ) (prune : ℕ → List ℕ → List ℕ → Bool)
    (nx : List ℕ → List ℕ → Bool) (hist ws : List ℕ) : Bool :=
  and (not (isOne g ws)) (or (prune k.succ hist ws) (fz (cuts P m ws) fun cw =>
    (pairs ws).all fun q => (opsK q.1 q.2.1).all fun z0 => fz z0 fun z =>
      cand P m k (nx (z :: hist)) ws cw q z))

end PSearchAux

open PSearchAux in
def psrch (P m g : ℕ) (prune : ℕ → List ℕ → List ℕ → Bool)
    (k : ℕ) (hist ws : List ℕ) : Bool :=
  Nat.rec (motive := fun _ => List ℕ → List ℕ → Bool) (fun _ ws => not (isOne g ws))
    (fun k ih hist ws => stepP P m g k prune ih hist ws) k hist ws

section PSearchSound
open PSearchAux

variable {P g : ℕ} {prune : ℕ → List ℕ → List ℕ → Bool} {ValidHist : List ℕ → Prop}
  (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
  (hcons : ∀ hist z, ValidHist hist → (∃ a ∈ hist, ∃ b ∈ hist, z ∈ bops a b) → ValidHist (z :: hist))
  (hp : ∀ k hist ws, ValidHist hist → ws.Nodup → ws.toFinset ⊆ hist.toFinset →
    live bops g k ws.toFinset → prune k hist ws = false)

include hg0 hg hcons hp

theorem psrch_sound : ∀ k hist (ws : List ℕ), ValidHist hist → ws.Nodup → ws.toFinset ⊆ hist.toFinset →
    live bops g k ws.toFinset → psrch P (2 ^ P - 1) g prune k hist ws = false := by
  intro k
  induction k with
  | zero =>
    intro hist ws hv hn hsub h
    rw [singleton_list hn h]
    show (not (isOne g [g])) = false
    rw [isOne_self]; rfl
  | succ k ih =>
    intro hist ws hv hn hsub h
    show stepP P (2 ^ P - 1) g k prune (psrch P (2 ^ P - 1) g prune k) hist ws = false
    rcases first_live h with done | ⟨a, ha, b, hb, hab, z, hz, hout, rest, hs, tail⟩
    · rw [singleton_list hn done]
      show and (not (isOne g [g])) _ = false
      rw [isOne_self]; rfl
    · have ha' : a ∈ ws := List.mem_toFinset.mp ha
      have hb' : b ∈ ws := List.mem_toFinset.mp hb
      obtain ⟨r, hm, hpr⟩ := pick_two ha' hb' hab
      have hz0 : z ≠ 0 := fun e => live_zero hg0 tail (e ▸ Finset.mem_insert_self _ _)
      have hzw : z ∉ ws := fun e => hout (List.mem_toFinset.mpr e)
      have hvalid : ValidHist (z :: hist) := hcons _ _ hv
        ⟨a, List.mem_toFinset.mp (hsub ha), b, List.mem_toFinset.mp (hsub hb), hz⟩
      have key : ∀ a b : ℕ, (a, b, r) ∈ pairs ws → ws.Perm (a :: b :: r) → z ∈ bops a b →
          ws.toFinset = insert a (insert b rest) →
          stepP P (2 ^ P - 1) g k prune (psrch P (2 ^ P - 1) g prune k) hist ws = false := by
        intro a b hmem hperm hzab hset
        obtain ⟨kept, hk, hnk, hfin⟩ := recover_kept hperm hn hset
        have hkw : ∀ w ∈ kept, w ∈ ws := by
          intro w hw
          have h1 : w ∈ rest := hfin ▸ List.mem_toFinset.mpr hw
          have h2 : w ∈ ws.toFinset := by
            rw [hset]; exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem h1)
          exact List.mem_toFinset.mp h2
        have hzk : z ∉ kept := fun e => hzw (hkw z e)
        have hnd : (z :: kept).Nodup := List.nodup_cons.mpr ⟨hzk, hnk⟩
        have hl : live bops g k (z :: kept).toFinset := by
          rw [List.toFinset_cons, hfin]; exact tail
        have hsub' : (z :: kept).toFinset ⊆ (z :: hist).toFinset := by
          simp only [List.toFinset_cons]
          exact Finset.insert_subset_insert _ (fun w hw => hsub (List.mem_toFinset.mpr
            (hkw w (List.mem_toFinset.mp hw))))
        have hc := live_card hl
        rw [List.toFinset_card_of_nodup hnd, List.length_cons] at hc
        have hcut := cuts_full hg hl
        have hcut2 : cuts P (2 ^ P - 1) (z :: ws) = 2 ^ P - 1 := by
          refine cuts_sup ?_ hcut
          intro w hw
          rcases List.mem_cons.mp hw with e | e
          · rw [e]; exact List.mem_cons_self ..
          · exact List.mem_cons_of_mem _ (hkw w e)
        have hblt : Nat.blt k kept.length = false := by
          cases hq : Nat.blt k kept.length
          · rfl
          · have := Nat.blt_eq.mp hq; omega
        have hkp : kp P (2 ^ P - 1) k (psrch P (2 ^ P - 1) g prune k (z :: hist)) z kept = false := by
          unfold kp
          rw [fzl_eq, hblt, hcut, Nat.beq_refl, ih _ _ hvalid hnd hsub' hl]; rfl
        have hz0' : Nat.beq z 0 = false := by
          cases hq : Nat.beq z 0
          · rfl
          · exact absurd (Nat.eq_of_beq_eq_true hq) hz0
        have hlor : Nat.lor (sep P (2 ^ P - 1) z) (cuts P (2 ^ P - 1) ws) = 2 ^ P - 1 := hcut2
        have hcand : cand P (2 ^ P - 1) k (psrch P (2 ^ P - 1) g prune k (z :: hist)) ws (cuts P (2 ^ P - 1) ws)
            (a, b, r) z = false := by
          unfold cand
          rw [hz0', memb_false hzw, hlor, Nat.beq_refl, all_false_of hk hkp]; rfl
        unfold stepP
        rw [hp _ _ _ hv hn hsub h, fz_eq]
        have hall : ((pairs ws).all fun q => (opsK q.1 q.2.1).all fun z0 => fz z0 fun z =>
            cand P (2 ^ P - 1) k (psrch P (2 ^ P - 1) g prune k (z :: hist)) ws (cuts P (2 ^ P - 1) ws) q z) = false := by
          refine all_false_of hmem ?_
          refine all_false_of (x := z) ?_ ?_
          · rw [opsK_eq]; exact List.mem_toFinset.mp hzab
          · rw [fz_eq]; exact hcand
        rw [hall]
        cases (not (isOne g ws)) <;> rfl
      rcases hm with hm | hm
      · exact key a b hm hpr hz hs
      · exact key b a hm (hpr.trans (List.Perm.swap b a r)) (ops_swap a b ▸ hz)
          (by rw [hs, Finset.insert_comm])

def ptop (P m g : ℕ) (prune : ℕ → List ℕ → List ℕ → Bool) (k : ℕ) (inp : List ℕ) : Bool :=
  inp.sublists.all fun ws =>
    or (Nat.blt k.succ ws.length)
      (or (not (Nat.beq (cuts P m ws) m)) (psrch P m g prune k inp ws))

theorem ptop_sound (k : ℕ) (inp : List ℕ) (hv : ValidHist inp) (hn : inp.Nodup)
    {s : Finset ℕ} (hs : s ⊆ inp.toFinset) (hl : live bops g k s) :
    ptop P (2 ^ P - 1) g prune k inp = false := by
  classical
  let ws := inp.filter (· ∈ s)
  have e : ws.toFinset = s := by
    ext w
    simp only [ws, List.mem_toFinset, List.mem_filter, decide_eq_true_eq, and_iff_right_iff_imp]
    exact fun hw => List.mem_toFinset.mp (hs hw)
  have hn' : ws.Nodup := hn.filter _
  have hl' : live bops g k ws.toFinset := e.symm ▸ hl
  have h := psrch_sound hg0 hg hcons hp k inp ws hv hn' (e.symm ▸ hs) hl'
  have hc := live_card hl'
  rw [List.toFinset_card_of_nodup hn'] at hc
  have hb : Nat.blt k.succ ws.length = false := by
    cases hq : Nat.blt k.succ ws.length
    · rfl
    · have := Nat.blt_eq.mp hq; omega
  unfold ptop
  apply all_false_of (x := ws) (List.mem_sublists.mpr (List.filter_sublist ..))
  rw [hb, cuts_full hg hl', Nat.beq_refl, h]; rfl

end PSearchSound
section PoolEntry


theorem pbase_build {n k t g : ℕ} (f : BF n) (roots : List ℕ)
    (x0 : Fin n → Bool) (pts : List (Fin n → Bool))
    (hroot : ∀ i : Fin n, code x0 pts (fun x => x i) ∈ roots)
    (hgcode : code x0 pts f = g) (hg0 : g ≠ 0)
    (htk : t ≤ k) (hr : Run t (Vars n) f) :
    build bops g k roots.toFinset := by
  rw [← hgcode]
  apply sim x0 pts f (hgcode.symm ▸ hg0) k (Vars n) roots.toFinset _ (Run_le htk hr)
  rintro w ⟨i, rfl⟩
  exact Or.inr (List.mem_toFinset.mpr (hroot i))



theorem pbase_of_check {n : ℕ} (f : BF n) (roots : List ℕ) (g k : ℕ)
    (x0 : Fin n → Bool) (pts : List (Fin n → Bool))
    (hroot : ∀ i : Fin n, code x0 pts (fun x => x i) ∈ roots)
    (hgcode : code x0 pts f = g) (hg0 : g ≠ 0)
    {check : Bool} (hsound : ∀ s ⊆ roots.toFinset, live bops g k s → check = false)
    (hcheck : check = true) : LB f (k + 1) := by
  intro t hr
  by_contra hlt
  have hbuild := pbase_build f roots x0 pts hroot hgcode hg0 (show t ≤ k by omega) hr
  obtain ⟨s, hs, hl⟩ := compress hbuild
  exact Bool.noConfusion (hcheck.symm.trans (hsound s hs hl))

end PoolEntry
theorem pbase {n : ℕ} (f : BF n) (roots : List ℕ) (g P k : ℕ)
    (x0 : Fin n → Bool) (pts : List (Fin n → Bool))
    (hroot : ∀ i : Fin n, code x0 pts (fun x => x i) ∈ roots)
    (hgcode : code x0 pts f = g) (hg0 : g ≠ 0)
    (hg : ∀ i < P, differs P i g)
    (prune : ℕ → List ℕ → List ℕ → Bool) (ValidHist : List ℕ → Prop)
    (hcons : ∀ hist z, ValidHist hist →
      (∃ a ∈ hist, ∃ b ∈ hist, z ∈ bops a b) → ValidHist (z :: hist))
    (hp : ∀ j hist ws, ValidHist hist → ws.Nodup → ws.toFinset ⊆ hist.toFinset →
      live bops g j ws.toFinset → prune j hist ws = false)
    (hv : ValidHist roots) (hn : roots.Nodup)
    (htop : ptop P (2 ^ P - 1) g prune k roots = true) : LB f (k + 1) := by
  refine pbase_of_check f roots g k x0 pts hroot hgcode hg0 ?_ htop
  intro s hs hl
  exact ptop_sound hg0 hg hcons hp k roots hv hn hs hl

theorem pbase' {n : ℕ} (f : BF n) (roots : List ℕ) (g P k : ℕ)
    (x0 : Fin n → Bool) (pts : List (Fin n → Bool))
    (hroot : ∀ i : Fin n, code x0 pts (fun x => x i) ∈ roots)
    (hgcode : code x0 pts f = g) (hg0 : g ≠ 0)
    (hg : ∀ i < P, differs P i g)
    (bounds : List (ℕ × ℕ))
    (hsoundProof : ∀ q ∈ bounds, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hn : roots.Nodup)
    (htop : ptop P (2 ^ P - 1) g (pprune roots bounds) k roots = true) : LB f (k + 1) := by
  refine pbase f roots g P k x0 pts hroot hgcode hg0 hg
    (pprune roots bounds) (HistOK roots) ?_ ?_ HistOK.root hn htop
  · rintro hist z hh ⟨a, ha, b, hb, hz⟩
    exact hh.cons ha hb hz
  · intro j hist ws hh hws hsub hl
    exact pprune_sound hsoundProof hh hws (fun w hw =>
      List.mem_toFinset.mp (hsub (List.mem_toFinset.mpr hw))) hl
def sampleIdx {n : ℕ} (x : Fin n → Bool) : ℕ :=
  (List.ofFn x).foldr (fun b z => b.toNat + 2*z) 0

def tbl (n t : ℕ) : BF n := fun x => t.testBit (sampleIdx x)

def sLit (n j : ℕ) : BF n := fun x => if h : j<n then x ⟨j,h⟩ else decide (n<j)

theorem sLitK (n j : ℕ) : K (Vars n) (sLit n j) := by
  by_cases h : j<n
  · exact Or.inr (Or.inl ⟨⟨j,h⟩, funext fun x => by simp [sLit,h]⟩)
  · exact Or.inl ⟨decide (n<j), funext fun x => by simp [sLit,h]⟩

theorem poolFrom {n : ℕ} (f : BF n) {b : ℕ} (hf : LB f b) (d g : ℕ) (roots ls : List ℕ)
    (idx : (Fin n → Bool) → ℕ)
    (hd : ∀ x, d.testBit (idx x) = true)
    (hg : ∀ x, g.testBit (idx x) = f x)
    (hR : ∀ i : Fin roots.length, ∀ x, (roots.get i).testBit (idx x) = sLit n (ls.getD i.val n) x) :
    PoolLB d roots g b := by
  intro k h
  let pick : (Fin n → Bool) → R d := fun x => ⟨idx x, hd x⟩
  have hmap := Run_map pick k _ (Vars n) _ (by
    rintro w ⟨a, ha, rfl⟩
    obtain ⟨i, rfl⟩ := List.mem_iff_get.mp ha
    exact (funext (hR i)).symm ▸ sLitK n (ls.getD i.val n)) h
  exact hf k ((funext hg) ▸ hmap)

def packedSample (n p neg pos : ℕ) : List (Fin n → Bool) :=
  (((List.range p).map (fun i => (neg >>> (n*i)) % 2^n)) ++
    ((List.range p).map (fun i => (pos >>> (n*i)) % 2^n)) ++ List.range (2^n)).map (pt n)

theorem pbits (g P i : ℕ) (hi : i < P) (h : g % 2^P = 0 ∧ (g >>> P) % 2^P = 2^P-1) :
    differs P i g := by
  have h0 := congrArg (fun w : ℕ => w.testBit i) h.1
  have h1 := congrArg (fun w : ℕ => w.testBit i) h.2
  simp [Nat.testBit_mod_two_pow, hi, Nat.testBit_two_pow_sub_one] at h0 h1
  simp [differs,h0,h1]

theorem finishPool {n : ℕ} (f : BF n) (roots : List ℕ) (g P k : ℕ)
    (pts : List (Fin n → Bool)) (bounds : List (ℕ × ℕ))
    (hroot : ∀ i : Fin n, code (pt n 0) pts (fun x => x i) ∈ roots)
    (hcode : code (pt n 0) pts f = g) (hg0 : g ≠ 0)
    (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bounds, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hn : roots.Nodup)
    (h : ptop P (2^P-1) g (pprune roots bounds) k roots = true) : LB f (k+1) :=
  pbase f roots g P k (pt n 0) pts hroot hcode hg0 hg _ (HistOK roots)
    (by rintro hist z hH ⟨a,ha,b,hb,hz⟩; exact HistOK.cons hH ha hb hz)
    (by intro j hist ws hh hw hs hl
        exact pprune_sound hv hh hw (fun w h => List.mem_toFinset.mp (hs (List.mem_toFinset.mpr h))) hl)
    HistOK.root hn h

section SearchRows

open PSearchAux


private def withRowKeepCuts {β : Type} (P m a b : ℕ) (r : List ℕ)
    (f : List (List ℕ × ℕ × ℕ) → β) : β :=
  fz r.length fun n =>
  fz (cuts P m r) fun cr =>
  fz (sep P m a) fun ca =>
  fz (sep P m b) fun cb =>
  fz (Nat.lor ca cr) fun car =>
  fz (Nat.lor cb cr) fun cbr =>
  fz (Nat.lor ca cbr) fun cabr =>
  let br := b :: r
  f [(r, n, cr), (a :: r, n+1, car), (br, n+1, cbr), (a :: br, n+2, cabr)]

private theorem withRowKeepCuts_eq {β : Type} (P m a b : ℕ) (r : List ℕ)
    (f : List (List ℕ × ℕ × ℕ) → β) :
    withRowKeepCuts P m a b r f = f ((keepChoices a b r).map (fun l => (l, l.length, cuts P m l))) := by
  simp only [withRowKeepCuts, fz_eq]
  rfl

def rowKids (P m k : ℕ) (ws : List ℕ) (q : ℕ × ℕ × List ℕ) : List (List ℕ) :=
  let (a, b, r) := q
  withRowKeepCuts P m a b r fun ks =>
  (opsK a b).flatMap fun z =>
    fz z fun z =>
    if Nat.beq z 0 || memb z ws then [] else
      fz (sep P m z) fun cz =>
      ks.filterMap fun (kept, n, ck) =>
        if Nat.blt k n || !(Nat.beq (Nat.lor cz ck) m) then none else some (z :: kept)


theorem rowKids_spec (P m k : ℕ) (ws : List ℕ) (q : ℕ × ℕ × List ℕ) :
    rowKids P m k ws q =
      (opsK q.1 q.2.1).flatMap fun z =>
        if Nat.beq z 0 || memb z ws then [] else
          (keepChoices q.1 q.2.1 q.2.2).filterMap fun kept =>
            if Nat.blt k kept.length || !(Nat.beq (cuts P m (z :: kept)) m)
            then none else some (z :: kept) := by
  obtain ⟨a, b, r⟩ := q
  simp only [rowKids, fz_eq, withRowKeepCuts_eq, List.filterMap_map, Function.comp_apply]
  rfl

def nextKids (P m k : ℕ) (ws : List ℕ) :=
  (pairs ws).flatMap (rowKids P m k ws)

theorem psrch_of_next {P m g k : ℕ} {prune : ℕ → List ℕ → List ℕ → Bool}
    {hist ws : List ℕ} (ho : PSearchAux.isOne g ws = false)
    (hn : ∀ w ∈ nextKids P m k ws, psrch P m g prune k (w.headD 0 :: hist) w = true) :
    psrch P m g prune (k+1) hist ws = true := by
  change stepP P m g k prune (psrch P m g prune k) hist ws = true
  simp only [stepP, ho, Bool.not_false, Bool.true_and, fz_eq]
  apply Bool.or_eq_true_iff.mpr
  right
  apply List.all_eq_true.mpr
  intro q hq
  apply List.all_eq_true.mpr
  intro z hz
  simp only [cand, Bool.or_eq_true]
  by_cases hz0 : Nat.beq z 0 = true
  · exact Or.inl hz0
  right
  by_cases hzw : memb z ws = true
  · exact Or.inl hzw
  right
  right
  apply List.all_eq_true.mpr
  intro kept hk
  simp only [kp, fzl_eq, Bool.or_eq_true]
  by_cases hlen : Nat.blt k kept.length = true
  · exact Or.inl hlen
  right
  by_cases hcut : Nat.beq (cuts P m (z :: kept)) m = false
  · exact Or.inl (by rw [hcut]; rfl)
  right
  change psrch P m g prune k ((z :: kept).headD 0 :: hist) (z :: kept) = true
  apply hn
  apply List.mem_flatMap.mpr
  refine ⟨q, hq, ?_⟩
  rw [rowKids_spec]
  refine List.mem_flatMap.mpr ⟨z, hz, ?_⟩
  have hz0' : Nat.beq z 0 = false := Bool.eq_false_iff.mpr hz0
  have hzw' : memb z ws = false := Bool.eq_false_iff.mpr hzw
  simp only [hz0', hzw', Bool.false_or, Bool.false_eq_true, ite_false]
  refine List.mem_filterMap.mpr ⟨kept, hk, ?_⟩
  have hlen' : Nat.blt k kept.length = false := Bool.eq_false_iff.mpr hlen
  have hcut' : Nat.beq (cuts P m (z :: kept)) m = true := Bool.eq_true_of_ne_false hcut
  simp [hlen', hcut']

end SearchRows
section CertifiedHints

inductive PCert where
  | node (hints : ℕ) (children : List PCert)



def useBound (roots : List ℕ) (bounds : List (ℕ × ℕ)) (g k : ℕ)
    (hist ws : List ℕ) (idx : ℕ) : Bool :=
  match bounds[idx]? with
  | none => false
  | some (d,b) =>
    !(PSearchAux.isOne g ws) &&
      Nat.blt (k + cost d roots hist) (b + ws.countP (pconst d))

theorem useBound_sound {roots bounds g k hist ws idx}
    (h : useBound roots bounds g k hist ws idx = true) (P m : ℕ) :
    psrch P m g (pprune roots bounds) k hist ws = true := by
  unfold useBound at h
  split at h
  · contradiction
  next d b he =>
    obtain ⟨hn, hf⟩ := Bool.and_eq_true_iff.mp h
    have hp : pprune roots bounds k hist ws = true := by
      apply List.any_eq_true.mpr
      exact ⟨(d,b), List.mem_of_getElem? he, decide_eq_true (Nat.blt_eq.mp hf)⟩
    cases k with
    | zero => exact hn
    | succ k =>
      change (!PSearchAux.isOne g ws && (pprune roots bounds (k+1) hist ws || _)) = true
      rw [hn, hp]; rfl

def hintSeq {α : Type} (p : ℕ → List ℕ → Bool) (e : α → List ℕ → Bool)
    (h : ℕ) (cs : List α) (ws : List (List ℕ)) : Bool :=
  match ws with
  | [] => true
  | w :: ws => fz (h % 256) fun i =>
    if i = 0 then
      match cs with
      | [] => false
      | c :: rest => e c w && hintSeq p e (h >>> 8) rest ws
    else p (i-1) w && hintSeq p e (h >>> 8) cs ws

theorem hintSeq_sound {α : Type} {p} {e : α → List ℕ → Bool} {Q : List ℕ → Prop}
    (hp : ∀ i w, p i w = true → Q w) (he : ∀ c w, e c w = true → Q w) :
    ∀ {h cs ws}, hintSeq p e h cs ws = true → ∀ w ∈ ws, Q w := by
  intro h cs ws
  induction ws generalizing h cs with
  | nil => simp
  | cons w ws ih =>
    intro hc a ha
    rw [hintSeq.eq_def] at hc
    dsimp only at hc
    rw [fz_eq] at hc
    split at hc
    · cases cs with
      | nil => contradiction
      | cons c cs =>
        obtain ⟨ht, hs⟩ := Bool.and_eq_true_iff.mp hc
        rcases List.mem_cons.mp ha with rfl | ha
        · exact he _ _ ht
        · exact ih hs _ ha
    · obtain ⟨ht, hs⟩ := Bool.and_eq_true_iff.mp hc
      rcases List.mem_cons.mp ha with rfl | ha
      · exact hp _ _ ht
      · exact ih hs _ ha

def certCheck (P m g : ℕ) (roots : List ℕ) (bounds : List (ℕ × ℕ)) :
    ℕ → List ℕ → List ℕ → PCert → Bool
  | 0, _, ws, _ => !(PSearchAux.isOne g ws)
  | k+1, hist, ws, .node h cs =>
    !(PSearchAux.isOne g ws) &&
      hintSeq (fun i w => useBound roots bounds g k (w.headD 0 :: hist) w i)
        (fun c w => certCheck P m g roots bounds k (w.headD 0 :: hist) w c)
        h cs (nextKids P m k ws)

theorem certCheck_sound (P m g : ℕ) (roots : List ℕ) (bounds : List (ℕ × ℕ)) :
    ∀ k hist ws c, certCheck P m g roots bounds k hist ws c = true →
      psrch P m g (pprune roots bounds) k hist ws = true := by
  intro k
  induction k with
  | zero => intro hist ws c h; exact h
  | succ k ih =>
    rintro hist ws ⟨h,cs⟩ hc
    obtain ⟨hn, hs⟩ := Bool.and_eq_true_iff.mp hc
    apply psrch_of_next (by simpa using hn)
    refine hintSeq_sound (Q := fun w => psrch P m g (pprune roots bounds) k (w.headD 0 :: hist) w = true)
      (p := fun i w => useBound roots bounds g k (w.headD 0 :: hist) w i)
      (e := fun c w => certCheck P m g roots bounds k (w.headD 0 :: hist) w c) ?_ ?_ hs
    · exact fun _ _ h => useBound_sound h P m
    · exact fun c w h => ih _ _ c h

def certRow (P m g : ℕ) (roots : List ℕ) (bounds : List (ℕ × ℕ))
    (k : ℕ) (hist ws : List ℕ) (q : ℕ × ℕ × List ℕ) : PCert → Bool
  | .node h cs =>
    hintSeq (fun i w => useBound roots bounds g k (w.headD 0 :: hist) w i)
      (fun c w => certCheck P m g roots bounds k (w.headD 0 :: hist) w c)
      h cs (rowKids P m k ws q)

theorem certRow_sound {P m g roots bounds k hist ws q c}
    (h : certRow P m g roots bounds k hist ws q c = true) :
    ∀ w ∈ rowKids P m k ws q,
      psrch P m g (pprune roots bounds) k (w.headD 0 :: hist) w = true := by
  cases c
  refine hintSeq_sound (Q := fun w => psrch P m g (pprune roots bounds) k (w.headD 0 :: hist) w = true)
    (p := fun i w => useBound roots bounds g k (w.headD 0 :: hist) w i)
    (e := fun c w => certCheck P m g roots bounds k (w.headD 0 :: hist) w c) ?_ ?_ h
  · exact fun _ _ hc => useBound_sound hc P m
  · exact fun c _ hc => certCheck_sound P m g roots bounds _ _ _ c hc

theorem psrch_of_rows {P m g roots bounds k hist ws}
    (hn : PSearchAux.isOne g ws = false)
    (h : ∀ q ∈ pairs ws, ∃ c, certRow P m g roots bounds k hist ws q c = true) :
    psrch P m g (pprune roots bounds) (k+1) hist ws = true := by
  apply psrch_of_next hn
  intro w hw
  obtain ⟨q,hq,hm⟩ := List.mem_flatMap.mp hw
  obtain ⟨c,hc⟩ := h q hq
  exact certRow_sound hc w hm

theorem ptop_at_root {P m g k prune roots}
    (hs : roots.sublists.all (fun ws : List ℕ =>
      ws == roots || Nat.blt k.succ ws.length || !(Nat.beq (cuts P m ws) m)) = true)
    (h : psrch P m g prune k roots roots = true) : ptop P m g prune k roots = true := by
  apply List.all_eq_true.mpr
  intro ws hm
  have h' := List.all_eq_true.mp hs ws hm
  simp only [Bool.or_eq_true, beq_iff_eq] at h'
  rcases h' with (rfl | h') | h'
  · simp [h]
  · simp [h']
  · simp [h']

end CertifiedHints


def embLit {m n : ℕ} (ls : List ℕ) (x : Fin m → Bool) (i : Fin n) :=
  sLit m (ls.getD i.val m) x

theorem pullLB {m n b : ℕ} (f : BF n) (g : BF m) (ls : List ℕ)
    (h : ∀ x, f (embLit ls x) = g x) (hg : LB g b) : LB f b := by
  intro t ht
  have hmap := Run_map (embLit ls) t (Vars n) (Vars m) f (by
    rintro w ⟨i, rfl⟩
    exact sLitK m _) ht
  exact hg t ((funext h) ▸ hmap)
section Symm

open PSearchAux

def bmap (src : List ℕ) (c : ℕ) : ℕ := enc (fun s => c.testBit s) src

theorem bmap_bit (src : List ℕ) (c j : ℕ) :
    (bmap src c).testBit j = (match src[j]? with | some s => c.testBit s | none => false) := by
  rw [bmap, enc_testBit, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases src[j]? <;> rfl

theorem bmap_op (src : List ℕ) (o : Bool → Bool → Bool) (o' : ℕ → ℕ → ℕ)
    (ho : ∀ a b i, (o' a b).testBit i = o (a.testBit i) (b.testBit i)) (h0 : o false false = false)
    (a b : ℕ) : bmap src (o' a b) = o' (bmap src a) (bmap src b) := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [ho, bmap_bit, bmap_bit, bmap_bit]
  cases src[j]? with
  | none => exact h0.symm
  | some s => exact ho a b s

theorem bmap_and (src : List ℕ) (a b : ℕ) : bmap src (a &&& b) = bmap src a &&& bmap src b :=
  bmap_op src (· && ·) (· &&& ·) (fun a b i => Nat.testBit_and a b i) rfl a b

theorem bmap_or (src : List ℕ) (a b : ℕ) : bmap src (a ||| b) = bmap src a ||| bmap src b :=
  bmap_op src (· || ·) (· ||| ·) (fun a b i => Nat.testBit_or a b i) rfl a b

theorem bmap_xor (src : List ℕ) (a b : ℕ) : bmap src (a ^^^ b) = bmap src a ^^^ bmap src b :=
  bmap_op src (fun x y => x ^^ y) (· ^^^ ·) (fun a b i => Nat.testBit_xor a b i) rfl a b

theorem bops_bmap (src : List ℕ) (a b : ℕ) :
    bops (bmap src a) (bmap src b) = (bops a b).image (bmap src) := by
  ext w
  simp only [bops, ops, Finset.mem_image, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false]
  constructor
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨a &&& b, Or.inl rfl, bmap_and src a b⟩
    · exact ⟨a ||| b, Or.inr (Or.inl rfl), bmap_or src a b⟩
    · exact ⟨a ^^^ (a &&& b), Or.inr (Or.inr (Or.inl rfl)), by rw [bmap_xor, bmap_and]⟩
    · exact ⟨b ^^^ (a &&& b), Or.inr (Or.inr (Or.inr rfl)), by rw [bmap_xor, bmap_and]⟩
  · rintro ⟨x, (rfl | rfl | rfl | rfl), rfl⟩
    · exact Or.inl (bmap_and src a b)
    · exact Or.inr (Or.inl (bmap_or src a b))
    · exact Or.inr (Or.inr (Or.inl (by rw [bmap_xor, bmap_and])))
    · exact Or.inr (Or.inr (Or.inr (by rw [bmap_xor, bmap_and])))

theorem bops_closed (F : ℕ → ℕ) (hand : ∀ a b, F (a &&& b) = F a &&& F b)
    (hor : ∀ a b, F (a ||| b) = F a ||| F b) (hxor : ∀ a b, F (a ^^^ b) = F a ^^^ F b)
    {a b z : ℕ} (ha : F a = a) (hb : F b = b) (hz : z ∈ bops a b) : F z = z := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl <;> simp [hand, hor, hxor, ha, hb]

theorem live_map {g : ℕ} (Φ : ℕ → ℕ) (V : ℕ → Prop)
    (hV : ∀ a b z, V a → V b → z ∈ bops a b → V z)
    (hinj : ∀ a b, V a → V b → Φ a = Φ b → a = b)
    (hops : ∀ a b, bops (Φ a) (Φ b) = (bops a b).image Φ) (hg : Φ g = g) :
    ∀ k (s : Finset ℕ), (∀ x ∈ s, V x) → live bops g k s → live bops g k (s.image Φ) := by
  intro k
  induction k with
  | zero =>
    intro s _ h
    change s = {g} at h
    subst h
    change ({g} : Finset ℕ).image Φ = {g}
    simp [hg]
  | succ k ih =>
    intro s hs h
    rcases h with h | ⟨a, ha, b, hb, hab, z, hz, hout, rest, rfl, tail⟩
    · exact Or.inl (ih s hs h)
    · have hVa := hs a ha
      have hVb := hs b hb
      have hVz : V z := hV a b z hVa hVb hz
      have hVi : ∀ x ∈ insert z rest, V x := by
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx
        · exact hVz
        · exact hs x (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hx))
      refine Or.inr ⟨Φ a, Finset.mem_image_of_mem _ ha, Φ b, Finset.mem_image_of_mem _ hb,
        fun e => hab (hinj a b hVa hVb e), Φ z, ?_, ?_, rest.image Φ, ?_, ?_⟩
      · rw [hops]; exact Finset.mem_image_of_mem _ hz
      · intro hm
        obtain ⟨x, hx, hxz⟩ := Finset.mem_image.mp hm
        exact hout (hinj x z (hs x hx) hVz hxz ▸ hx)
      · simp only [Finset.image_insert]
      · have := ih (insert z rest) hVi tail
        simpa only [Finset.image_insert] using this

theorem bmap_inv_closed (src : List ℕ) {a b z : ℕ} (ha : bmap src (bmap src a) = a)
    (hb : bmap src (bmap src b) = b) (hz : z ∈ bops a b) : bmap src (bmap src z) = z :=
  bops_closed (fun x => bmap src (bmap src x)) (fun a b => by simp only [bmap_and])
    (fun a b => by simp only [bmap_or]) (fun a b => by simp only [bmap_xor]) ha hb hz

theorem live_bmap {g : ℕ} (src : List ℕ) (hg : bmap src g = g) {k : ℕ} {s : Finset ℕ}
    (hs : ∀ x ∈ s, bmap src (bmap src x) = x) (h : live bops g k s) :
    live bops g k (s.image (bmap src)) :=
  live_map (bmap src) (fun x => bmap src (bmap src x) = x) (fun _ _ _ ha hb hz => bmap_inv_closed src ha hb hz)
    (fun a b ha hb e => by rw [← ha, ← hb, e]) (bops_bmap src) hg k s hs h

theorem noLive_bmap {g : ℕ} (src : List ℕ) (hg : bmap src g = g) {k : ℕ} {s : Finset ℕ}
    (hs : ∀ x ∈ s, bmap src (bmap src x) = x) (h : ¬ live bops g k (s.image (bmap src))) :
    ¬ live bops g k s := fun hl => h (live_bmap src hg hs hl)

theorem mem_singles_perm {α : Type} : ∀ {ws : List α} {b : α} {bs : List α},
    (b, bs) ∈ singles ws → ws.Perm (b :: bs)
  | [], _, _, h => by simp [singles] at h
  | a :: rest, b, bs, h => by
    simp only [singles, List.mem_cons, List.mem_map, Prod.mk.injEq] at h
    rcases h with ⟨rfl, rfl⟩ | ⟨⟨c, cs⟩, hm, rfl, rfl⟩
    · exact .refl _
    · exact ((mem_singles_perm hm).cons a).trans (.swap _ _ _)

theorem mem_pairs_perm {α : Type} : ∀ {ws : List α} {q : α × α × List α},
    q ∈ pairs ws → ws.Perm (q.1 :: q.2.1 :: q.2.2)
  | [], _, h => by simp [pairs] at h
  | a :: rest, q, h => by
    simp only [pairs, List.mem_append, List.mem_map] at h
    rcases h with ⟨⟨b, bs⟩, hm, rfl⟩ | ⟨⟨b, c, bs⟩, hm, rfl⟩
    · exact (mem_singles_perm hm).cons a
    · have hp := (mem_pairs_perm hm).cons a
      exact hp.trans ((List.Perm.swap _ _ _).trans ((List.Perm.swap _ _ _).cons _))

theorem row_refute {P g k : ℕ} {roots : List ℕ} {bounds : List (ℕ × ℕ)}
    (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bounds, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hn : roots.Nodup) {q : ℕ × ℕ × List ℕ} (hq : q ∈ pairs roots)
    (hrow : ∀ w ∈ rowKids P (2 ^ P - 1) k roots q,
      psrch P (2 ^ P - 1) g (pprune roots bounds) k (w.headD 0 :: roots) w = true)
    {z : ℕ} {rest : Finset ℕ} (hz : z ∈ bops q.1 q.2.1) (hout : z ∉ roots.toFinset)
    (hset : roots.toFinset = insert q.1 (insert q.2.1 rest))
    (tail : live bops g k (insert z rest)) : False := by
  obtain ⟨a, b, r⟩ := q
  have hperm := mem_pairs_perm hq
  obtain ⟨kept, hk, hnk, hfin⟩ := recover_kept hperm hn hset
  have hkw : ∀ w ∈ kept, w ∈ roots := by
    intro w hw
    have h1 : w ∈ rest := hfin ▸ List.mem_toFinset.mpr hw
    have h2 : w ∈ roots.toFinset := by
      rw [hset]; exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem h1)
    exact List.mem_toFinset.mp h2
  have hzw : z ∉ roots := fun e => hout (List.mem_toFinset.mpr e)
  have hzk : z ∉ kept := fun e => hzw (hkw z e)
  have hnd : (z :: kept).Nodup := List.nodup_cons.mpr ⟨hzk, hnk⟩
  have hl : live bops g k (z :: kept).toFinset := by
    rw [List.toFinset_cons, hfin]; exact tail
  have hcard := live_card hl
  rw [List.toFinset_card_of_nodup hnd, List.length_cons] at hcard
  have hcut := cuts_full hg hl
  have hz0 : z ≠ 0 := fun e => live_zero hg0 tail (e ▸ Finset.mem_insert_self _ _)
  have ha : a ∈ roots := List.mem_toFinset.mp (by rw [hset]; exact Finset.mem_insert_self _ _)
  have hb : b ∈ roots := List.mem_toFinset.mp (by
    rw [hset]; exact Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
  have hmem : (z :: kept) ∈ rowKids P (2 ^ P - 1) k roots (a, b, r) := by
    rw [rowKids_spec]
    refine List.mem_flatMap.mpr ⟨z, ?_, ?_⟩
    · rw [opsK_eq]; exact List.mem_toFinset.mp hz
    · have hz0' : Nat.beq z 0 = false := by
        cases hq : Nat.beq z 0
        · rfl
        · exact absurd (Nat.eq_of_beq_eq_true hq) hz0
      have hblt : Nat.blt k kept.length = false := by
        cases hq : Nat.blt k kept.length
        · rfl
        · have := Nat.blt_eq.mp hq; omega
      simp only [hz0', memb_false hzw, Bool.false_or, Bool.false_eq_true, ite_false]
      refine List.mem_filterMap.mpr ⟨kept, hk, ?_⟩
      simp [hblt, hcut]
  have htrue := hrow (z :: kept) hmem
  have hvalid : HistOK roots (z :: roots) := HistOK.cons HistOK.root ha hb hz
  have hsub' : (z :: kept).toFinset ⊆ (z :: roots).toFinset := by
    simp only [List.toFinset_cons]
    exact Finset.insert_subset_insert _ (fun w hw => List.mem_toFinset.mpr
      (hkw w (List.mem_toFinset.mp hw)))
  have hfalse := psrch_sound (prune := pprune roots bounds) (ValidHist := HistOK roots) hg0 hg
    (by rintro hist z' hH ⟨a', ha', b', hb', hz'⟩; exact HistOK.cons hH ha' hb' hz')
    (by intro j hist ws hh hw hs hl
        exact pprune_sound hv hh hw (fun w h => List.mem_toFinset.mp (hs (List.mem_toFinset.mpr h))) hl)
    k (z :: roots) (z :: kept) hvalid hnd hsub' hl
  simp only [List.headD_cons] at htrue
  rw [htrue] at hfalse
  exact Bool.noConfusion hfalse

def symOk (g : ℕ) (roots : List ℕ) (src : List ℕ) : Bool :=
  roots.all (fun x => Nat.beq (bmap src (bmap src x)) x && roots.contains (bmap src x)) &&
    Nat.beq (bmap src g) g

def symHit (maps : List (List ℕ)) (reps : List (ℕ × ℕ × List ℕ)) (q : ℕ × ℕ × List ℕ) (h : ℕ × ℕ) : Bool :=
  match maps[h.1]?, reps[h.2]? with
  | some src, some rp => fz (bmap src q.1) fun x => fz (bmap src q.2.1) fun y =>
      (Nat.beq x rp.1 && Nat.beq y rp.2.1) || (Nat.beq x rp.2.1 && Nat.beq y rp.1)
  | _, _ => false

def coverAll (maps : List (List ℕ)) (reps : List (ℕ × ℕ × List ℕ)) :
    List (ℕ × ℕ × List ℕ) → List (ℕ × ℕ) → Bool
  | [], _ => true
  | _ :: _, [] => false
  | q :: qs, h :: hs => symHit maps reps q h && coverAll maps reps qs hs

theorem symHit_sound {maps : List (List ℕ)} {reps : List (ℕ × ℕ × List ℕ)} {q : ℕ × ℕ × List ℕ}
    {h : ℕ × ℕ} (hh : symHit maps reps q h = true) : ∃ src ∈ maps, ∃ rp ∈ reps,
      (bmap src q.1 = rp.1 ∧ bmap src q.2.1 = rp.2.1) ∨ (bmap src q.1 = rp.2.1 ∧ bmap src q.2.1 = rp.1) := by
  unfold symHit at hh
  split at hh
  · rename_i src rp e1 e2
    refine ⟨src, List.mem_of_getElem? e1, rp, List.mem_of_getElem? e2, ?_⟩
    simp only [fz_eq, Bool.or_eq_true, Bool.and_eq_true] at hh
    rcases hh with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact Or.inl ⟨Nat.eq_of_beq_eq_true h1, Nat.eq_of_beq_eq_true h2⟩
    · exact Or.inr ⟨Nat.eq_of_beq_eq_true h1, Nat.eq_of_beq_eq_true h2⟩
  · exact absurd hh (by simp)

theorem coverAll_sound {maps : List (List ℕ)} {reps : List (ℕ × ℕ × List ℕ)} :
    ∀ {qs : List (ℕ × ℕ × List ℕ)} {hs : List (ℕ × ℕ)}, coverAll maps reps qs hs = true →
      ∀ q ∈ qs, ∃ src ∈ maps, ∃ rp ∈ reps,
        (bmap src q.1 = rp.1 ∧ bmap src q.2.1 = rp.2.1) ∨ (bmap src q.1 = rp.2.1 ∧ bmap src q.2.1 = rp.1)
  | [], _, _, q, hq => absurd hq (by simp)
  | _ :: _, [], h, _, _ => absurd h (by simp [coverAll])
  | q' :: qs, h :: hs, hc, q, hq => by
    simp only [coverAll, Bool.and_eq_true] at hc
    rcases List.mem_cons.mp hq with rfl | hq
    · exact symHit_sound hc.1
    · exact coverAll_sound hc.2 q hq

theorem noLiveSym {P g k : ℕ} {roots : List ℕ} {bounds : List (ℕ × ℕ)}
    (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bounds, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hn : roots.Nodup)
    (hs : roots.sublists.all (fun ws : List ℕ =>
      ws == roots || Nat.blt k.succ.succ ws.length || !(Nat.beq (cuts P (2 ^ P - 1) ws) (2 ^ P - 1))) = true)
    (hone : PSearchAux.isOne g roots = false)
    (maps : List (List ℕ)) (hmaps : maps.all (symOk g roots) = true)
    (reps : List (ℕ × ℕ × List ℕ)) (hints : List (ℕ × ℕ))
    (hcover : coverAll maps reps (pairs roots) hints = true)
    (hreps : ∀ rp ∈ reps, rp ∈ pairs roots ∧ ∀ w ∈ rowKids P (2 ^ P - 1) k roots rp,
      psrch P (2 ^ P - 1) g (pprune roots bounds) k (w.headD 0 :: roots) w = true) :
    ∀ s ⊆ roots.toFinset, ¬ live bops g (k + 1) s := by
  classical
  intro s hsub hl0
  let ws := roots.filter (· ∈ s)
  have e : ws.toFinset = s := by
    ext w
    simp only [ws, List.mem_toFinset, List.mem_filter, decide_eq_true_eq, and_iff_right_iff_imp]
    exact fun hw => List.mem_toFinset.mp (hsub hw)
  have hn' : ws.Nodup := hn.filter _
  have hl' : live bops g (k + 1) ws.toFinset := e.symm ▸ hl0
  have hc := live_card hl'
  rw [List.toFinset_card_of_nodup hn'] at hc
  have hcut := cuts_full hg hl'
  have hws : ws = roots := by
    have h' := List.all_eq_true.mp hs ws (List.mem_sublists.mpr (List.filter_sublist ..))
    have hb : Nat.blt k.succ.succ ws.length = false := by
      cases hq : Nat.blt k.succ.succ ws.length
      · rfl
      · have := Nat.blt_eq.mp hq; omega
    rw [hb, hcut, Nat.beq_refl] at h'
    simpa using h'
  rw [hws] at hl'
  rcases first_live hl' with done | ⟨a, ha, b, hb, hab, z, hz, hout, rest, hset, tail⟩
  · have := singleton_list hn done
    rw [this, isOne_self] at hone
    exact Bool.noConfusion hone
  · have step : ∀ a b : ℕ, a ∈ roots → b ∈ roots → (∃ r, (a, b, r) ∈ pairs roots) → z ∈ bops a b →
        roots.toFinset = insert a (insert b rest) → False := by
      intro a b ha hb ⟨r, hm⟩ hz hset
      obtain ⟨src, hsrc, rp, hrp, hor⟩ := coverAll_sound hcover (a, b, r) hm
      have hok := List.all_eq_true.mp hmaps src hsrc
      simp only [symOk, Bool.and_eq_true, List.all_eq_true, List.contains_iff_mem] at hok
      obtain ⟨hroot, hgs⟩ := hok
      have hgs' : bmap src g = g := Nat.eq_of_beq_eq_true hgs
      have hinv : ∀ x ∈ roots, bmap src (bmap src x) = x := fun x hx =>
        Nat.eq_of_beq_eq_true (hroot x hx).1
      have hin : ∀ x ∈ roots, bmap src x ∈ roots := fun x hx => (hroot x hx).2
      let Φ := bmap src
      let V : ℕ → Prop := fun x => Φ (Φ x) = x
      have hV : ∀ a b z, V a → V b → z ∈ bops a b → V z := fun a b z ha hb hz =>
        bops_closed (fun x => Φ (Φ x)) (fun a b => by simp only [Φ, bmap_and])
          (fun a b => by simp only [Φ, bmap_or]) (fun a b => by simp only [Φ, bmap_xor]) ha hb hz
      have hinj : ∀ a b, V a → V b → Φ a = Φ b → a = b := fun a b ha hb e => by
        rw [← ha, ← hb, e]
      have hrestV : ∀ x ∈ rest, x ∈ roots := fun x hx => List.mem_toFinset.mp (by
        rw [hset]; exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hx))
      have hVz : V z := hV a b z (hinv a ha) (hinv b hb) hz
      have hVi : ∀ x ∈ insert z rest, V x := by
        intro x hx
        rcases Finset.mem_insert.mp hx with rfl | hx
        · exact hVz
        · exact hinv x (hrestV x hx)
      have tail' := live_map Φ V hV hinj (bops_bmap src) hgs' k (insert z rest) hVi tail
      rw [Finset.image_insert] at tail'
      have img : roots.toFinset.image Φ = roots.toFinset := by
        ext y
        simp only [Finset.mem_image, List.mem_toFinset]
        constructor
        · rintro ⟨x, hx, rfl⟩; exact hin x hx
        · intro hy; exact ⟨Φ y, hin y hy, hinv y hy⟩
      have hset' : roots.toFinset = insert (Φ a) (insert (Φ b) (rest.image Φ)) := by
        rw [← img, hset, Finset.image_insert, Finset.image_insert]
      have hz' : Φ z ∈ bops (Φ a) (Φ b) := by
        rw [bops_bmap]; exact Finset.mem_image_of_mem _ hz
      have hout' : Φ z ∉ roots.toFinset := by
        rw [← img]
        intro hm
        obtain ⟨x, hx, e⟩ := Finset.mem_image.mp hm
        have hx' := List.mem_toFinset.mp hx
        have := hinj x z (hinv x hx') hVz e
        exact hout (this ▸ hx)
      obtain ⟨hrpm, hrow⟩ := hreps rp hrp
      rcases hor with ⟨e1, e2⟩ | ⟨e1, e2⟩
      · exact row_refute hg0 hg hv hn hrpm hrow (z := Φ z) (rest := rest.image Φ)
          (by rw [← e1, ← e2]; exact hz') hout' (by rw [hset', ← e1, ← e2]) tail'
      · exact row_refute hg0 hg hv hn hrpm hrow (z := Φ z) (rest := rest.image Φ)
          (by rw [← e1, ← e2, ops_swap]; exact hz') hout' (by rw [hset', ← e1, ← e2, Finset.insert_comm]) tail'
    have ha' := List.mem_toFinset.mp ha
    have hb' := List.mem_toFinset.mp hb
    obtain ⟨r, hm, _⟩ := pick_two ha' hb' hab
    rcases hm with hm | hm
    · exact step a b ha' hb' ⟨r, hm⟩ hz hset
    · exact step b a hb' ha' ⟨r, hm⟩ (ops_swap a b ▸ hz) (by rw [hset, Finset.insert_comm])

theorem histOK_inv (src : List ℕ) {roots : List ℕ} (hr : ∀ x ∈ roots, bmap src (bmap src x) = x)
    {hist : List ℕ} (h : HistOK roots hist) : ∀ x ∈ hist, bmap src (bmap src x) = x := by
  induction h with
  | root => exact hr
  | cons _ ha hb hz ih =>
    intro x hx
    rcases List.mem_cons.mp hx with rfl | hx
    · exact bmap_inv_closed src (ih _ ha) (ih _ hb) hz
    · exact ih x hx

theorem symOk_inv {g : ℕ} {roots src : List ℕ} (h : symOk g roots src = true) :
    bmap src g = g ∧ ∀ x ∈ roots, bmap src (bmap src x) = x := by
  simp only [symOk, Bool.and_eq_true, List.all_eq_true] at h
  exact ⟨Nat.eq_of_beq_eq_true h.2, fun x hx => Nat.eq_of_beq_eq_true (h.1 x hx).1⟩

theorem noLiveFull {P g k : ℕ} {roots : List ℕ}
    (hg : ∀ i < P, differs P i g) (hn : roots.Nodup)
    (hs : roots.sublists.all (fun ws : List ℕ =>
      ws == roots || Nat.blt k.succ.succ ws.length || !(Nat.beq (cuts P (2 ^ P - 1) ws) (2 ^ P - 1))) = true)
    (hclean : ¬ live bops g (k + 1) roots.toFinset) :
    ∀ s ⊆ roots.toFinset, ¬ live bops g (k + 1) s := by
  classical
  intro s hsub hl0
  let ws := roots.filter (· ∈ s)
  have e : ws.toFinset = s := by
    ext w
    simp only [ws, List.mem_toFinset, List.mem_filter, decide_eq_true_eq, and_iff_right_iff_imp]
    exact fun hw => List.mem_toFinset.mp (hsub hw)
  have hn' : ws.Nodup := hn.filter _
  have hl' : live bops g (k + 1) ws.toFinset := e.symm ▸ hl0
  have hc := live_card hl'
  rw [List.toFinset_card_of_nodup hn'] at hc
  have hcut := cuts_full hg hl'
  have hws : ws = roots := by
    have h' := List.all_eq_true.mp hs ws (List.mem_sublists.mpr (List.filter_sublist ..))
    have hb : Nat.blt k.succ.succ ws.length = false := by
      cases hq : Nat.blt k.succ.succ ws.length
      · rfl
      · have := Nat.blt_eq.mp hq; omega
    rw [hb, hcut, Nat.beq_refl] at h'
    simpa using h'
  rw [hws] at hl'
  exact hclean hl'

theorem finishSym {n : ℕ} (f : BF n) (roots : List ℕ) (g k : ℕ)
    (pts : List (Fin n → Bool))
    (hroot : ∀ i : Fin n, code (pt n 0) pts (fun x => x i) ∈ roots)
    (hcode : code (pt n 0) pts f = g) (hg0 : g ≠ 0)
    (hno : ∀ s ⊆ roots.toFinset, ¬ live bops g k s) : LB f (k + 1) :=
  pbase_of_check f roots g k (pt n 0) pts hroot hcode hg0 (check := true)
    (fun s hs hl => absurd hl (hno s hs)) rfl

def pidx : List ℕ → ℕ → ℕ
  | [], _ => 0
  | p :: t, q => (if q.testBit p then 1 else 0) + 2 * pidx t q

def symSrc (n P neg pos : ℕ) (π : List ℕ) : List ℕ :=
  (((List.range P).map (fun i => (neg >>> (n * i)) % 2 ^ n)) ++
    ((List.range P).map (fun i => (pos >>> (n * i)) % 2 ^ n)) ++ List.range (2 ^ n)).map
    (fun q => 2 * P + pidx π q)

end Symm
def msame (xs ys : List ℕ) : Bool :=
  xs.all (fun x => ys.contains x) && ys.all (fun y => xs.contains y)

theorem msame_eq {xs ys : List ℕ} (h : msame xs ys = true) : xs.toFinset = ys.toFinset := by
  obtain ⟨h1,h2⟩ := Bool.and_eq_true_iff.mp h
  ext x
  simp only [List.mem_toFinset]
  exact ⟨fun hx => List.contains_iff_mem.mp (List.all_eq_true.mp h1 x hx),
    fun hx => List.contains_iff_mem.mp (List.all_eq_true.mp h2 x hx)⟩

def memPr (roots : List ℕ) (bs : List (ℕ × ℕ)) (t : ℕ) (refs : List (List ℕ))
    (k : ℕ) (hist ws : List ℕ) : Bool :=
  pprune roots bs k hist ws || ((k == t) && refs.any (msame ws))

def memHit (g : ℕ) (refs : List (List ℕ)) (i : ℕ) (ws : List ℕ) : Bool :=
  !(PSearchAux.isOne g ws) && (refs[i]?).any (msame ws)

theorem memPr_valid {roots bs t refs g}
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hr : ∀ r ∈ refs, ¬live bops g t r.toFinset) :
    ∀ k hist ws, HistOK roots hist → ws.Nodup → ws.toFinset ⊆ hist.toFinset →
      live bops g k ws.toFinset → memPr roots bs t refs k hist ws = false := by
  intro k hist ws hh hn hs hl
  have hp := pprune_sound hv hh hn (fun w hw => List.mem_toFinset.mp (hs (List.mem_toFinset.mpr hw))) hl
  apply Bool.eq_false_iff.mpr
  intro h
  simp only [memPr,hp,Bool.false_or,Bool.and_eq_true,beq_iff_eq,List.any_eq_true] at h
  obtain ⟨rfl,r,hm,he⟩ := h
  exact hr r hm (msame_eq he ▸ hl)

theorem memPr_close {P m g k hist ws pr}
    (hn : (!PSearchAux.isOne g ws) = true) (h : pr k hist ws = true) :
    psrch P m g pr k hist ws = true := by
  cases k with
  | zero => exact hn
  | succ k =>
    change (!PSearchAux.isOne g ws && (pr (k+1) hist ws || _)) = true
    rw [hn,h]
    rfl

theorem memUse {P m g k hist ws roots bs t refs i}
    (h : useBound roots bs g k hist ws i = true) :
    psrch P m g (memPr roots bs t refs) k hist ws = true := by
  unfold useBound at h
  split at h
  · contradiction
  next d b he =>
    obtain ⟨hn,hb⟩ := Bool.and_eq_true_iff.mp h
    apply memPr_close hn
    apply Bool.or_eq_true_iff.mpr
    left
    exact List.any_eq_true.mpr ⟨(d,b),List.mem_of_getElem? he,decide_eq_true (Nat.blt_eq.mp hb)⟩

theorem memUseHit {P m g k hist ws roots bs refs i}
    (h : memHit g refs i ws = true) :
    psrch P m g (memPr roots bs k refs) k hist ws = true := by
  obtain ⟨hn,h⟩ := Bool.and_eq_true_iff.mp h
  apply memPr_close hn
  apply Bool.or_eq_true_iff.mpr
  right
  simp only [beq_self_eq_true,Bool.true_and]
  cases hh : refs[i]? with
  | none => simp [hh] at h
  | some r => exact List.any_eq_true.mpr ⟨r,List.mem_of_getElem? hh,by simpa [hh] using h⟩

def memSeq (g k : ℕ) (roots : List ℕ) (bs : List (ℕ × ℕ)) (hist : List ℕ)
    (refs : List (List ℕ)) (h : ℕ) (r : List ℕ) (ws : List (List ℕ)) : Bool :=
  hintSeq (fun i w => useBound roots bs g k (w.headD 0 :: hist) w i)
    (fun i w => memHit g refs i w) h r ws

theorem memSeq_sound {P m g k roots bs hist refs h r L}
    (hc : memSeq g k roots bs hist refs h r L = true) :
    ∀ w ∈ L, psrch P m g (memPr roots bs k refs) k (w.headD 0 :: hist) w = true := by
  exact hintSeq_sound (p := fun i w => useBound roots bs g k (w.headD 0 :: hist) w i)
    (e := fun i w => memHit g refs i w)
    (fun _ _ h => memUse h) (fun _ _ h => memUseHit h) hc

theorem mem_state {P g k roots bs hist ws refs h r}
    (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hh : HistOK roots hist) (hn : ws.Nodup) (hs : ws.toFinset ⊆ hist.toFinset)
    (ho : PSearchAux.isOne g ws = false)
    (hr : ∀ a ∈ refs, ¬live bops g k a.toFinset)
    (hc : memSeq g k roots bs hist refs h r (nextKids P (2^P-1) k ws) = true) :
    ¬live bops g (k+1) ws.toFinset := by
  intro hl
  have key := psrch_of_next ho (memSeq_sound hc)
  have neg := psrch_sound hg0 hg
    (fun hist z hH ⟨a,ha,b,hb,hz⟩ => HistOK.cons hH ha hb hz) (memPr_valid hv hr)
    (k+1) hist ws hh hn hs hl
  exact Bool.noConfusion (neg.symm.trans key)
theorem mtransport {src : List ℕ} {g k : ℕ} {A M B : List ℕ}
    (hg : bmap src g = g)
    (hf : A.map (bmap src) = M) (hb : M.map (bmap src) = A)
    (hs : msame M B = true) (hc : ¬live bops g k B.toFinset) :
    ¬live bops g k A.toFinset := by
  intro h
  have hinv : A.map (fun x => bmap src (bmap src x)) = A := by
    change A.map ((bmap src) ∘ (bmap src)) = A
    rw [← List.map_map, hf, hb]
  have ip : ∀ x ∈ A.toFinset, bmap src (bmap src x) = x := by
    intro x hx
    have hx' := List.mem_toFinset.mp hx
    obtain ⟨i,hi⟩ := List.mem_iff_get.mp hx'
    subst x
    have hget := congrArg (fun l : List ℕ => l.getD i.val 0) hinv
    simpa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem, i.isLt] using hget
  have hh := live_bmap src hg ip h
  apply hc
  have he : A.toFinset.image (bmap src) = B.toFinset := by
    rw [← msame_eq hs, ← hf]
    ext w
    simp
  exact he ▸ hh
def cv (B : List ℕ) (i : ℕ) := B.getD (i % (B.length+1)) 0
def ci (B p : List ℕ) (i : ℕ) := p.getD (i % (B.length+1)) B.length
def cl (B xs : List ℕ) := xs.map (cv B)
def cg (B : List ℕ) (g : ℕ) (p : List ℕ) : Prop :=
  ∀ k xs, ¬live bops g k (cl B xs).toFinset → ¬live bops g k (cl B (xs.map (ci B p))).toFinset

theorem cgood (B p src : List ℕ) (g : ℕ) (hg : bmap src g = g)
    (ht : ∀ i : Fin (B.length+1),
      bmap src (cv B i.val) = cv B (ci B p i.val) ∧
      bmap src (cv B (ci B p i.val)) = cv B i.val) : cg B g p := by
  have hu (i : ℕ) : bmap src (cv B i) = cv B (ci B p i) ∧
      bmap src (cv B (ci B p i)) = cv B i := by
    have v := ht ⟨i % (B.length+1),Nat.mod_lt _ (Nat.succ_pos _)⟩
    simpa only [cv,ci,Nat.mod_mod] using v
  intro k xs hc
  apply mtransport (A:=cl B (xs.map (ci B p))) (M:=cl B xs) (B:=cl B xs) hg
  · simp only [cl,List.map_map]
    exact List.map_congr_left fun i _ => (hu i).2
  · simp only [cl,List.map_map]
    exact List.map_congr_left fun i _ => (hu i).1
  · unfold msame
    simp
  · exact hc

def cacts (B : List ℕ) (maps : List (List ℕ)) : List ℕ → List ℕ → List ℕ
  | [], w => w
  | i::t,w =>
    let a := (maps[i]?).elim w (fun p => w.map (ci B p))
    cacts B maps t a

theorem cacts_ok {B g maps} (hm : ∀ m ∈ maps, cg B g m) (k : ℕ) :
    ∀ t w, ¬live bops g k (cl B w).toFinset →
      ¬live bops g k (cl B (cacts B maps t w)).toFinset := by
  intro t
  induction t with
  | nil => exact fun _ h => h
  | cons i t ih =>
    intro w hw
    apply ih
    cases hh : maps[i]? with
    | none => exact hw
    | some p => exact hm p (List.mem_of_getElem? hh) k _ hw

def cgate (op a b : ℕ) :=
  match op with
  | 0 => a &&& b
  | 1 => a ||| b
  | 2 => a ^^^ (a &&& b)
  | _ => b ^^^ (a &&& b)

theorem cgate_mem (op a b : ℕ) : cgate op a b ∈ bops a b := by
  cases op with
  | zero => simp [cgate,bops,ops]
  | succ op =>
    cases op with
    | zero => simp [cgate,bops,ops]
    | succ op =>
      cases op <;> simp [cgate,bops,ops]

def chist : List ℕ → List ℕ → List ℕ
  | [], h => h
  | op::t,h =>
    match h[(op/4)%16]?, h[op/64]? with
    | some a,some b => chist t (cgate (op % 4) a b :: h)
    | _,_ => chist t h

theorem chist_ok {roots : List ℕ} : ∀ prog h, HistOK roots h → HistOK roots (chist prog h) := by
  intro prog
  induction prog with
  | nil => exact fun _ hh => hh
  | cons d prog ih =>
    intro h hh
    simp only [chist]
    split
    next a b ha hb => exact ih _ (HistOK.cons hh (List.mem_of_getElem? ha) (List.mem_of_getElem? hb) (cgate_mem _ _ _))
    next => exact ih _ hh

structure CCell where
  w : List ℕ
  hist : List ℕ
  hints : ℕ
  links : List (ℕ × List ℕ)

def crefs (B : List ℕ) (maps prev : List (List ℕ)) (l : List (ℕ × List ℕ)) :=
  l.filterMap fun p => (prev[p.1]?).map (fun w => cl B (cacts B maps p.2 w))

theorem crefs_ok {B maps g prev k} (hm : ∀ p ∈ maps, cg B g p)
    (hp : ∀ w ∈ prev, ¬live bops g k (cl B w).toFinset) (l : List (ℕ × List ℕ)) :
    ∀ a ∈ crefs B maps prev l, ¬live bops g k a.toFinset := by
  intro a ha
  obtain ⟨⟨j,t⟩,_,hh⟩ := List.mem_filterMap.mp ha
  cases he : prev[j]? with
  | none => simp [he] at hh
  | some w =>
    simp [he] at hh
    subst a
    exact cacts_ok hm k t w (hp _ (List.mem_of_getElem? he))

def ccheck (P g : ℕ) (roots B : List ℕ) (bs : List (ℕ × ℕ))
    (maps prev : List (List ℕ)) (k : ℕ) (c : CCell) : Bool :=
  let w := cl B c.w
  let h := chist c.hist roots
  let rs := crefs B maps prev c.links
  decide w.Nodup && w.all (fun x => h.contains x) && !(PSearchAux.isOne g w) &&
    memSeq g k roots bs h rs c.hints (List.range rs.length) (nextKids P (2^P-1) k w)

theorem ccell_ok {P g roots B bs maps prev k} (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hm : ∀ p ∈ maps, cg B g p) (hp : ∀ w ∈ prev, ¬live bops g k (cl B w).toFinset)
    (c : CCell) (hh : ccheck P g roots B bs maps prev k c = true) :
    ¬live bops g (k+1) (cl B c.w).toFinset := by
  simp only [ccheck,Bool.and_eq_true,decide_eq_true_eq,Bool.not_eq_true',List.all_eq_true] at hh
  obtain ⟨⟨⟨hn,hs⟩,ho⟩,hc⟩ := hh
  apply mem_state hg0 hg hv (chist_ok c.hist roots HistOK.root) hn _ ho (crefs_ok hm hp c.links) hc
  intro x hx
  exact List.mem_toFinset.mpr (List.contains_iff_mem.mp (hs x (List.mem_toFinset.mp hx)))

theorem clayer {P g roots B bs maps prev k} (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hm : ∀ p ∈ maps, cg B g p) (hp : ∀ w ∈ prev, ¬live bops g k (cl B w).toFinset)
    (cells : List CCell) (hc : cells.all (ccheck P g roots B bs maps prev k) = true) :
    ∀ w ∈ cells.map CCell.w, ¬live bops g (k+1) (cl B w).toFinset := by
  intro w hw
  obtain ⟨c,hm',rfl⟩ := List.mem_map.mp hw
  exact ccell_ok hg0 hg hv hm hp c (List.all_eq_true.mp hc _ hm')
def cext (h : List ℕ) (a : ℕ) : List ℕ :=
  cgate (a % 4) (h.getD ((a/4)%2048) 0) (h.getD (a/8192) 0) :: h

def cnet (ops : List ℕ) (roots : List ℕ) := ops.foldl cext roots

theorem gate_map (s : List ℕ) (op a b : ℕ) :
    bmap s (cgate op a b) = cgate op (bmap s a) (bmap s b) := by
  cases op with
  | zero => exact bmap_and s a b
  | succ op =>
    cases op with
    | zero => exact bmap_or s a b
    | succ op => cases op <;> simp only [cgate,bmap_xor,bmap_and]

theorem map_zero (s : List ℕ) : bmap s 0 = 0 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [bmap_bit]
  cases s[i]? <;> simp

theorem bmap_get (s a : List ℕ) (i : ℕ) :
    (a.map (bmap s)).getD i 0 = bmap s (a.getD i 0) := by
  induction a generalizing i with
  | nil => simp [map_zero]
  | cons x xs ih =>
    cases i with
    | zero => rfl
    | succ i => exact ih i

theorem cnet_map (s p roots : List ℕ) :
    (cnet p roots).map (bmap s) = cnet p (roots.map (bmap s)) := by
  induction p generalizing roots with
  | nil => rfl
  | cons a p ih =>
    change (cnet p (cext roots a)).map (bmap s) = cnet p (cext (roots.map (bmap s)) a)
    rw [ih]
    simp only [cext,List.map_cons,gate_map,bmap_get]

theorem cnet_good (p r rr m s : List ℕ) (g : ℕ) (hg : bmap s g = g)
    (h0 : r.map (bmap s) = rr)
    (h : let B := cnet p r; let C := cnet p rr
      ∀ i : Fin (B.length+1), cv C i.val = cv B (ci B m i.val) ∧
        cv C (ci B m i.val) = cv B i.val) : cg (cnet p r) g m := by
  apply cgood _ _ s _ hg
  have he := cnet_map s p r
  rw [h0] at he
  have hv (i : ℕ) : cv (cnet p rr) i = bmap s (cv (cnet p r) i) := by
    rw [← he]
    simp only [cv,List.length_map,bmap_get]
  simpa only [hv] using h
abbrev PPage := List (List ℕ)
structure PBank where
  cap : ℕ
  table : PPage
def pread (p : PPage) (i : ℕ) := (p.getD (i/32) []).getD (i % 32) 0
def pcv (B : PBank) (i : ℕ) := pread B.table (i % (B.cap+1))
def pci (B : PBank) (p : PPage) (i : ℕ) := pread p (i % (B.cap+1))
def pcl (B : PBank) (xs : List ℕ) := xs.map (pcv B)
def pcg (B : PBank) (g : ℕ) (p : PPage) : Prop :=
  ∀ k xs, ¬live bops g k (pcl B xs).toFinset → ¬live bops g k (pcl B (xs.map (pci B p))).toFinset

theorem pcgood (B : PBank) (p : PPage) (src : List ℕ) (g : ℕ) (hg : bmap src g = g)
    (ht : ∀ i : Fin (B.cap+1),
      bmap src (pcv B i.val) = pcv B (pci B p i.val) ∧
      bmap src (pcv B (pci B p i.val)) = pcv B i.val) : pcg B g p := by
  have hu (i : ℕ) : bmap src (pcv B i) = pcv B (pci B p i) ∧
      bmap src (pcv B (pci B p i)) = pcv B i := by
    have v := ht ⟨i % (B.cap+1),Nat.mod_lt _ (Nat.succ_pos _)⟩
    simpa only [pcv,pci,Nat.mod_mod] using v
  intro k xs hc
  apply mtransport (A:=pcl B (xs.map (pci B p))) (M:=pcl B xs) (B:=pcl B xs) hg
  · simp only [pcl,List.map_map]
    exact List.map_congr_left fun i _ => (hu i).2
  · simp only [pcl,List.map_map]
    exact List.map_congr_left fun i _ => (hu i).1
  · unfold msame
    simp
  · exact hc

def pcacts (B : PBank) (maps : List PPage) : List ℕ → List ℕ → List ℕ
  | [], w => w
  | i::t,w =>
    let a := (maps[i]?).elim w (fun p => w.map (pci B p))
    pcacts B maps t a

theorem pcacts_ok {B g maps} (hm : ∀ m ∈ maps, pcg B g m) (k : ℕ) :
    ∀ t w, ¬live bops g k (pcl B w).toFinset →
      ¬live bops g k (pcl B (pcacts B maps t w)).toFinset := by
  intro t
  induction t with
  | nil => exact fun _ h => h
  | cons i t ih =>
    intro w hw
    apply ih
    cases hh : maps[i]? with
    | none => exact hw
    | some p => exact hm p (List.mem_of_getElem? hh) k _ hw

def pcrefs (B : PBank) (maps : List PPage) (prev : List (List ℕ)) (l : List (ℕ × List ℕ)) :=
  l.filterMap fun p => (prev[p.1]?).map (fun w => pcl B (pcacts B maps p.2 w))

theorem pcrefs_ok {B maps g prev k} (hm : ∀ p ∈ maps, pcg B g p)
    (hp : ∀ w ∈ prev, ¬live bops g k (pcl B w).toFinset) (l : List (ℕ × List ℕ)) :
    ∀ a ∈ pcrefs B maps prev l, ¬live bops g k a.toFinset := by
  intro a ha
  obtain ⟨⟨j,t⟩,_,hh⟩ := List.mem_filterMap.mp ha
  cases he : prev[j]? with
  | none => simp [he] at hh
  | some w =>
    simp [he] at hh
    subst a
    exact pcacts_ok hm k t w (hp _ (List.mem_of_getElem? he))

def pccheck (P g : ℕ) (roots : List ℕ) (B : PBank) (bs : List (ℕ × ℕ))
    (maps : List PPage) (prev : List (List ℕ)) (k : ℕ) (c : CCell) : Bool :=
  let w := pcl B c.w
  let h := chist c.hist roots
  let rs := pcrefs B maps prev c.links
  decide w.Nodup && w.all (fun x => h.contains x) && !(PSearchAux.isOne g w) &&
    memSeq g k roots bs h rs c.hints (List.range rs.length) (nextKids P (2^P-1) k w)

theorem pccell_ok {P g roots B bs maps prev k} (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hm : ∀ p ∈ maps, pcg B g p) (hp : ∀ w ∈ prev, ¬live bops g k (pcl B w).toFinset)
    (c : CCell) (hh : pccheck P g roots B bs maps prev k c = true) :
    ¬live bops g (k+1) (pcl B c.w).toFinset := by
  simp only [pccheck,Bool.and_eq_true,decide_eq_true_eq,Bool.not_eq_true',List.all_eq_true] at hh
  obtain ⟨⟨⟨hn,hs⟩,ho⟩,hc⟩ := hh
  apply mem_state hg0 hg hv (chist_ok c.hist roots HistOK.root) hn _ ho (pcrefs_ok hm hp c.links) hc
  intro x hx
  exact List.mem_toFinset.mpr (List.contains_iff_mem.mp (hs x (List.mem_toFinset.mp hx)))

theorem pclayer {P g roots B bs maps prev k} (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hm : ∀ p ∈ maps, pcg B g p) (hp : ∀ w ∈ prev, ¬live bops g k (pcl B w).toFinset)
    (cells : List CCell) (hc : cells.all (pccheck P g roots B bs maps prev k) = true) :
    ∀ w ∈ cells.map CCell.w, ¬live bops g (k+1) (pcl B w).toFinset := by
  intro w hw
  obtain ⟨c,hm',rfl⟩ := List.mem_map.mp hw
  exact pccell_ok hg0 hg hv hm hp c (List.all_eq_true.mp hc _ hm')

theorem pcfrom {B : PBank} {p : PPage} {src : List ℕ} {g : ℕ}
    (hg : bmap src g = g)
    (hf : ∀ i < B.cap+1, bmap src (pcv B i) = pcv B (pci B p i))
    (hi : ∀ i : Fin (B.cap+1), pci B p (pci B p i.val) = i.val) : pcg B g p := by
  apply pcgood B p src g hg
  intro i
  refine ⟨hf i i.isLt,?_⟩
  have hx := hf ((pci B p i) % (B.cap+1)) (Nat.mod_lt _ (Nat.succ_pos _))
  have he : bmap src (pcv B (pci B p i)) = pcv B (pci B p (pci B p i)) := by
    simpa only [pcv,pci,Nat.mod_mod] using hx
  rwa [hi] at he
section Shortcut

theorem sidx_enc : ∀ l : List Bool, l.foldr (fun b z => b.toNat + 2 * z) 0 = enc id l
  | [] => rfl
  | b :: t => by
    rw [List.foldr_cons, sidx_enc t]
    cases b <;> simp [enc, Nat.bit_val] <;> omega

theorem sidx_lt {m : ℕ} (x : Fin m → Bool) : sampleIdx x < 2 ^ m := by
  unfold sampleIdx
  rw [sidx_enc]
  simpa using enc_lt id (List.ofFn x)

theorem sidx_bit {m : ℕ} (x : Fin m → Bool) (j : Fin m) : (sampleIdx x).testBit j.val = x j := by
  unfold sampleIdx
  rw [sidx_enc, enc_testBit]
  simp [List.getD_eq_getElem?_getD, List.getElem?_ofFn, j.isLt]

theorem Run_not {ι : Type} : ∀ (t : ℕ) (S : (ι → Bool) → Prop) (f : ι → Bool),
    Run t S (fun x => !f x) → Run t S f
  | 0, S, f, h => by
    have h' : K S (fun x => !(!f x)) := K_not h
    have e : (fun x => !(!f x)) = f := funext fun x => Bool.not_not (f x)
    rw [e] at h'
    exact h'
  | t + 1, S, f, h => by
    rcases h with h | ⟨a, b, ka, kb, hr⟩
    · exact Or.inl (Run_not t S f h)
    · exact Or.inr ⟨a, b, ka, kb, Run_not t _ f hr⟩

def scode (m code c : ℕ) : Bool :=
  if code < m then c.testBit code
  else if code < 2 * m then !(c.testBit (code - m))
  else Nat.beq code (2 * m + 1)

def scheck (ws : List ℕ) (g k m q b : ℕ) (idx ls : List ℕ) (phase : Bool) : Bool :=
  Nat.blt 0 b && decide ws.Nodup && Nat.beq ws.length ls.length &&
  Nat.blt k (b + ls.countP (fun c => Nat.ble (2 * m) c)) &&
  (List.range (2 ^ m)).all fun c =>
    fz (idx.getD c 0) fun r =>
      (g.testBit r == Bool.xor phase (q.testBit c)) &&
      (List.zip ws ls).all fun p => p.1.testBit r == scode m p.2 c

theorem cnt_zip (P1 P2 : ℕ → Bool) : ∀ (ws ls : List ℕ), ws.length = ls.length →
    (∀ p ∈ ws.zip ls, P2 p.2 = true → P1 p.1 = true) → ls.countP P2 ≤ ws.countP P1
  | [], [], _, _ => by simp
  | [], _ :: _, h, _ => by simp at h
  | _ :: _, [], h, _ => by simp at h
  | w :: ws, l :: ls, h, hp => by
    have ih := cnt_zip P1 P2 ws ls (by simpa using h)
      (fun p hm => hp p (by simp [List.zip_cons_cons, hm]))
    have h0 := hp (w, l) (by simp [List.zip_cons_cons])
    rw [List.countP_cons, List.countP_cons]
    by_cases h2 : P2 l = true
    · have h1 := h0 h2
      simp only [h1, h2, ite_true]; omega
    · have h2' : P2 l = false := by simpa using h2
      simp only [h2', Bool.false_eq_true, ite_false]
      omega

theorem sbops {ι : Type} (ρ : ι → ℕ) (a b z : ℕ) (hz : z ∈ bops a b) :
    ∃ pa pb pz : Bool, ∀ i, z.testBit (ρ i) =
      Bool.xor pz (Bool.xor pa (a.testBit (ρ i)) && Bool.xor pb (b.testBit (ρ i))) := by
  simp only [bops, ops, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl
  · exact ⟨false, false, false, fun i => by simp [Nat.testBit_and]⟩
  · refine ⟨true, true, true, fun i => ?_⟩
    simp only [Nat.testBit_or]
    cases a.testBit (ρ i) <;> cases b.testBit (ρ i) <;> rfl
  · refine ⟨false, true, false, fun i => ?_⟩
    simp only [Nat.testBit_xor, Nat.testBit_and]
    cases a.testBit (ρ i) <;> cases b.testBit (ρ i) <;> rfl
  · refine ⟨true, false, false, fun i => ?_⟩
    simp only [Nat.testBit_xor, Nat.testBit_and]
    cases a.testBit (ρ i) <;> cases b.testBit (ρ i) <;> rfl

theorem scut {ws : List ℕ} {g k m q b : ℕ} (hf : LB (tbl m q) b) (idx ls : List ℕ) (phase : Bool)
    (hc : scheck ws g k m q b idx ls phase = true) : ¬live bops g k ws.toFinset := by
  classical
  unfold scheck at hc
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range, fz_eq,
    beq_iff_eq] at hc
  obtain ⟨⟨⟨⟨hb0, hn⟩, hlen⟩, hk⟩, hrows⟩ := hc
  have hb0' : 0 < b := Nat.blt_eq.mp hb0
  have hlen' : ws.length = ls.length := Nat.eq_of_beq_eq_true hlen
  have hk' : k < b + ls.countP (fun c => Nat.ble (2 * m) c) := Nat.blt_eq.mp hk
  let ρ : (Fin m → Bool) → ℕ := fun x => idx.getD (sampleIdx x) 0
  let ev : ℕ → (Fin m → Bool) → Bool := fun w x => w.testBit (ρ x)
  have hgx : ∀ x, ev g x = Bool.xor phase (tbl m q x) := fun x => (hrows _ (sidx_lt x)).1
  have hwx : ∀ p ∈ ws.zip ls, ∀ x, ev p.1 x = scode m p.2 (sampleIdx x) :=
    fun p hp x => (hrows _ (sidx_lt x)).2 p hp
  have hK : ∀ p ∈ ws.zip ls, K (Vars m) (ev p.1) := by
    intro p hp
    have e : ev p.1 = fun x => scode m p.2 (sampleIdx x) := funext (hwx p hp)
    rw [e]
    unfold scode
    by_cases h1 : p.2 < m
    · simp only [h1, ite_true]
      exact Or.inr (Or.inl ⟨⟨p.2, h1⟩, funext fun x => sidx_bit x ⟨p.2, h1⟩⟩)
    · simp only [h1, ite_false]
      by_cases h2 : p.2 < 2 * m
      · simp only [h2, ite_true]
        have h3 : p.2 - m < m := by omega
        refine Or.inr (Or.inr ⟨⟨p.2 - m, h3⟩, funext fun x => ?_⟩)
        rw [Bool.not_not]
        exact sidx_bit x ⟨p.2 - m, h3⟩
      · simp only [h2, ite_false]
        exact Or.inl ⟨_, rfl⟩
  have hconst : ∀ p ∈ ws.zip ls, Nat.ble (2 * m) p.2 = true → ∃ c : Bool, ev p.1 = fun _ => c := by
    intro p hp h2
    have h2' : 2 * m ≤ p.2 := Nat.le_of_ble_eq_true h2
    refine ⟨Nat.beq p.2 (2 * m + 1), funext fun x => ?_⟩
    rw [hwx p hp x]
    unfold scode
    have h1 : ¬ p.2 < m := by omega
    have h3 : ¬ p.2 < 2 * m := by omega
    simp only [h1, h3, ite_false]
  intro hl
  have hgC : ¬ ∃ c : Bool, ev g = fun _ => c := by
    rintro ⟨c, hcst⟩
    have hk0 : K (Vars m) (tbl m q) := by
      refine Or.inl ⟨Bool.xor phase c, funext fun x => ?_⟩
      have h1 := hgx x
      rw [congrFun hcst x] at h1
      rw [h1]
      cases phase <;> cases tbl m q x <;> rfl
    have := hf 0 hk0
    omega
  have hmem : ∀ w ∈ ws.toFinset, ∃ p ∈ ws.zip ls, p.1 = w := by
    intro w hw
    obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp (List.mem_toFinset.mp hw)
    have hi' : i < ls.length := hlen' ▸ hi
    exact ⟨(ws[i], ls[i]), List.mem_iff_getElem.mpr ⟨i, by simp [hi, hi'], by simp⟩, rfl⟩
  obtain ⟨t, hr, hle⟩ := live_project_loss ev (fun w => ∃ c : Bool, ev w = fun _ => c)
    (fun _ => Iff.rfl) (fun a b z hz => sbops ρ a b z hz) hgC hl (Vars m)
    (fun w hw _ => by
      obtain ⟨p, hp, rfl⟩ := hmem w hw
      exact hK p hp)
  have hrun : Run t (Vars m) (tbl m q) := by
    have e : ev g = fun x => Bool.xor phase (tbl m q x) := funext hgx
    rw [e] at hr
    cases phase
    · simpa using hr
    · exact Run_not t _ _ (by simpa using hr)
  have hbt := hf t hrun
  have hcnt : ls.countP (fun c => Nat.ble (2 * m) c) ≤
      ws.countP (fun w => decide (∃ c : Bool, ev w = fun _ => c)) :=
    cnt_zip _ _ ws ls hlen' (fun p hp h2 => decide_eq_true (hconst p hp h2))
  rw [hn.card_eq_countP] at hle
  omega

end Shortcut
def clsh (g i j : ℕ) (ws : List ℕ) : Bool :=
  decide (g.testBit (j-i+i) ≠ g.testBit i) &&
    ws.all (fun w => !decide (w.testBit (j-i+i) ≠ w.testBit i))

theorem clsh_no {g i j ws} (k : ℕ) (hc : clsh g i j ws = true) :
    ¬live bops g k ws.toFinset := by
  intro h
  obtain ⟨hg,hw⟩ := Bool.and_eq_true_iff.mp hc
  have hg' : differs (j-i) i g := by unfold differs; exact of_decide_eq_true hg
  obtain ⟨w,hm,hd⟩ := live_separates (differs (j-i) i) hg' (ops_differs (j-i) i) h
  have ha := List.all_eq_true.mp hw w (List.mem_toFinset.mp hm)
  change w.testBit (j-i+i) ≠ w.testBit i at hd
  change (!decide (w.testBit (j-i+i) ≠ w.testBit i)) = true at ha
  simp [hd] at ha

structure SCRec where
  w : List ℕ
  num : ℕ
  phase : Bool
  idx : List ℕ
  ls : List ℕ

def scCheck (real : List ℕ → List ℕ) (g k : ℕ) (T : List (ℕ × ℕ × ℕ)) (c : SCRec) :=
  match c.num with
  | 0 => clsh g (c.idx.getD 0 0) (c.idx.getD 1 0) (real c.w)
  | j+1 => (T[j]?).any (fun (z : ℕ × ℕ × ℕ) => scheck (real c.w) g k z.1 z.2.1 z.2.2 c.idx c.ls c.phase)

theorem scLayer {real g k} {T : List (ℕ × ℕ × ℕ)}
    (hf : ∀ z ∈ T, LB (tbl z.1 z.2.1) z.2.2)
    (L : List SCRec) (hh : L.all (scCheck real g k T) = true) :
    ∀ w ∈ L.map SCRec.w, ¬live bops g k (real w).toFinset := by
  intro w hw
  obtain ⟨c,hc,rfl⟩ := List.mem_map.mp hw
  have ht := List.all_eq_true.mp hh c hc
  simp only [scCheck] at ht
  cases he : c.num with
  | zero => exact clsh_no k (by simpa only [he] using ht)
  | succ j =>
    cases hq : T[j]? with
    | none => simp [he,hq] at ht
    | some z =>
      exact scut (hf z (List.mem_of_getElem? hq)) c.idx c.ls c.phase (by simpa only [he,hq,Option.any_some] using ht)
theorem msame_refl (xs : List ℕ) : msame xs xs = true := by
  simp [msame]

def mok (maps : List (List ℕ)) : List ℕ → List ℕ → List ℕ → Bool
  | [], A, B => msame A B
  | t :: w, A, B =>
    match maps[t]? with
    | none => false
    | some src => decide ((A.map (bmap src)).map (bmap src) = A) && mok maps w (A.map (bmap src)) B

theorem mtw {maps : List (List ℕ)} {g k : ℕ} (hm : ∀ src ∈ maps, bmap src g = g) :
    ∀ (w : List ℕ) {A B : List ℕ}, mok maps w A B = true →
      ¬live bops g k B.toFinset → ¬live bops g k A.toFinset := by
  intro w
  induction w with
  | nil =>
    intro A B h hc
    rw [mok] at h
    rw [msame_eq h]
    exact hc
  | cons t w ih =>
    intro A B h hc
    rw [mok] at h
    cases hsrc : maps[t]? with
    | none => simp [hsrc] at h
    | some src =>
      simp only [hsrc, Bool.and_eq_true, decide_eq_true_eq] at h
      exact mtransport (src := src) (A := A) (M := A.map (bmap src)) (B := A.map (bmap src))
        (hm src (List.mem_of_getElem? hsrc)) rfl h.1 (msame_refl _) (ih h.2 hc)

def histB (roots : List ℕ) : List ℕ → Bool
  | [] => false
  | z :: t => (z :: t == roots) ||
      (histB roots t && t.any fun a => t.any fun b => (ops a b).contains z)

theorem histB_ok {roots : List ℕ} : ∀ {h : List ℕ}, histB roots h = true → HistOK roots h := by
  intro h
  induction h with
  | nil => intro hh; exact Bool.noConfusion hh
  | cons z t ih =>
    intro hh
    rw [histB] at hh
    rcases Bool.or_eq_true_iff.mp hh with he | hr
    · have e : z :: t = roots := by simpa using he
      rw [e]; exact HistOK.root
    · obtain ⟨h1, h2⟩ := Bool.and_eq_true_iff.mp hr
      obtain ⟨a, ha, h3⟩ := List.any_eq_true.mp h2
      obtain ⟨b, hb, h4⟩ := List.any_eq_true.mp h3
      exact HistOK.cons (ih h1) ha hb (List.mem_toFinset.mpr (List.contains_iff_mem.mp h4))

theorem rnil {g k : ℕ} : ∀ a ∈ ([] : List (List ℕ)), ¬live bops g k a.toFinset := by
  intro _ h; cases h

theorem rcons {g k : ℕ} {x : List ℕ} {t : List (List ℕ)} (h : ¬live bops g k x.toFinset)
    (ht : ∀ a ∈ t, ¬live bops g k a.toFinset) : ∀ a ∈ x :: t, ¬live bops g k a.toFinset := by
  intro a ha
  rcases List.mem_cons.mp ha with rfl | ha
  · exact h
  · exact ht a ha

def stB (g : ℕ) (roots hist ws : List ℕ) : Bool :=
  histB roots hist && decide ws.Nodup && ws.all (fun w => hist.contains w) && !(PSearchAux.isOne g ws)

theorem mst {P g k : ℕ} {roots : List ℕ} {bs : List (ℕ × ℕ)} (hist ws : List ℕ)
    (refs : List (List ℕ)) (h : ℕ) (r : List ℕ)
    (hg0 : g ≠ 0) (hg : ∀ i < P, differs P i g)
    (hv : ∀ q ∈ bs, pconst q.1 g = false ∧ PoolLB q.1 roots g q.2)
    (hb : stB g roots hist ws = true)
    (hr : ∀ a ∈ refs, ¬live bops g k a.toFinset)
    (hc : memSeq g k roots bs hist refs h r (nextKids P (2^P-1) k ws) = true) :
    ¬live bops g (k+1) ws.toFinset := by
  unfold stB at hb
  simp only [Bool.and_eq_true, decide_eq_true_eq, Bool.not_eq_true'] at hb
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := hb
  refine mem_state hg0 hg hv (histB_ok h1) h2 ?_ h4 hr hc
  intro x hx
  have hx' := List.mem_toFinset.mp hx
  exact List.mem_toFinset.mpr (List.contains_iff_mem.mp (List.all_eq_true.mp h3 x hx'))
