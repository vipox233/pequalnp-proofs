def morphRoot (a : ℕ) (B M : ℕ → ℕ) (src : List ℕ) : Bool :=
  (List.range a).all fun i => Nat.beq (bmap src (B i)) (B (M i))

def morphStep (B M H : ℕ → ℕ) (i : ℕ) : Bool :=
  Nat.blt ((H i / 4) % 2048) i && Nat.blt (H i / 8192) i &&
    Nat.beq (B i) (cgate (H i % 4) (B ((H i / 4) % 2048)) (B (H i / 8192))) &&
    Nat.beq (B (M i)) (cgate (H i % 4) (B (M ((H i / 4) % 2048))) (B (M (H i / 8192))))

def morphLocal (n a : ℕ) (B M H : ℕ → ℕ) : Bool :=
  (List.range n).all fun i => Nat.blt i a || morphStep B M H i

theorem windMorphP (n a : ℕ) (B M H : ℕ → ℕ) (src : List ℕ)
    (hroot : ∀ i < a, bmap src (B i) = B (M i))
    (hloc : ∀ i, a ≤ i → i < n →
      (H i / 4) % 2048 < i ∧ H i / 8192 < i ∧
      B i = cgate (H i % 4) (B ((H i / 4) % 2048)) (B (H i / 8192)) ∧
      B (M i) = cgate (H i % 4) (B (M ((H i / 4) % 2048))) (B (M (H i / 8192)))) :
    ∀ i < n, bmap src (B i) = B (M i) := by
  intro i
  induction i using Nat.strong_induction_on with
  | _ i ih =>
    intro hi
    by_cases ha : i < a
    · exact hroot i ha
    · obtain ⟨hu, hv, e1, e2⟩ := hloc i (Nat.le_of_not_lt ha) hi
      rw [e1, gate_map, ih _ hu (Nat.lt_trans hu hi), ih _ hv (Nat.lt_trans hv hi), ← e2]

theorem windMorph (n a : ℕ) (B M H : ℕ → ℕ) (src : List ℕ)
    (hroot : morphRoot a B M src = true) (hloc : morphLocal n a B M H = true) :
    ∀ i < n, bmap src (B i) = B (M i) := by
  apply windMorphP n a B M H src
  · intro i hi
    exact Nat.eq_of_beq_eq_true (List.all_eq_true.mp hroot i (List.mem_range.mpr hi))
  · intro i ha hi
    have h := List.all_eq_true.mp hloc i (List.mem_range.mpr hi)
    have hna : Nat.blt i a = false := by
      cases hb : Nat.blt i a
      · rfl
      · exact absurd (Nat.blt_eq.mp hb) (Nat.not_lt.mpr ha)
    rw [hna, Bool.false_or] at h
    unfold morphStep at h
    simp only [Bool.and_eq_true] at h
    obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
    exact ⟨Nat.blt_eq.mp h1, Nat.blt_eq.mp h2, Nat.eq_of_beq_eq_true h3, Nat.eq_of_beq_eq_true h4⟩
