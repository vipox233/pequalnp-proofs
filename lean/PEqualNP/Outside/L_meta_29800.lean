def runW (gs : List Gate) (w : List W) : List W :=
  gs.foldl (fun w g => w ++ [action w g]) w

theorem runW_length (gs : List Gate) (w : List W) :
    (runW gs w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp [runW]
  | cons g gs ih => simpa [runW, List.foldl_cons, Nat.add_assoc, Nat.add_comm] using ih (w ++ [action w g])

theorem runW_stable (gs : List Gate) (w : List W) (i : ℕ) (hi : i < w.length) :
    (runW gs w).getD i 0 = w.getD i 0 := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (runW gs (w ++ [action w g])).getD i 0 = _
    rw [ih _ (by simp; omega)]
    exact List.getD_append _ _ _ _ hi

theorem runW_bits (gs : List Gate) (w : List W) (hg : ∀ g ∈ gs, legal g) (k : Fin 182) :
    (runW gs w).map (bit k) = gs.foldl step (w.map (bit k)) := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (runW gs (w ++ [action w g])).map (bit k) = _
    rw [ih _ (fun a ha => hg a (by simp [ha]))]
    simp only [List.foldl_cons, action_spec w g (hg g (by simp)) k]

theorem holds_mono {av av' : Finset W} (hsub : av ⊆ av') {z : W} (h : holds av z) :
    holds av' z := by
  rcases h with h | h | ⟨a, ha, hz⟩
  · exact .inl h
  · exact .inr (.inl h)
  · exact .inr (.inr ⟨a, hsub ha, hz⟩)

theorem holds_append (w : List W) (av : Finset W) (z : W)
    (hw : ∀ i, i ≠ 0 → holds av (w.getD i 0)) (hz : holds av z) :
    ∀ i, i ≠ 0 → holds av ((w ++ [z]).getD i 0) := by
  intro i hi
  by_cases h : i < w.length
  · rw [List.getD_append _ _ _ _ h]
    exact hw i hi
  · by_cases he : i = w.length
    · subst i
      simpa [List.getD_append_right _ _ _ _ (Nat.le_refl _)] using hz
    · have hb : w.length + 1 ≤ i := by omega
      rw [List.getD_eq_default _ _ (by simpa using hb)]
      exact .inl rfl

set_option maxRecDepth 5000 in
theorem gate_reach_reads (w : List W) (av : Finset W) (g : Gate) (hg : legal g)
    (hw : ∀ i ∈ g.inputs, holds av (w.getD i 0)) : reachable av (action w g) := by
  obtain ⟨op,args⟩ := g
  obtain ⟨hop,cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _|⟨i,_|⟨j,_|⟨u,tail⟩⟩⟩ <;> simp at cap
  all_goals rcases hop with rfl|rfl|rfl <;>
    simp only [action,List.head?_nil,List.head?_cons,List.map_nil,List.map_cons,
      List.foldr_nil,List.foldr_cons,Option.map_none,Option.map_some,
      Option.getD_none,Option.getD_some,
      show ∀ x : W, x ||| (0 : W) = x from fun x => BitVec.or_zero,
      show ∀ x : W, x &&& ~~~0 = x from fun x => BitVec.and_allOnes]
  all_goals first
    | exact .inl (.inl rfl)
    | exact .inl (.inr (.inl rfl))
    | exact .inl (hw i (by simp))
    | exact .inl (holds_not (hw i (by simp)))
    | exact and_reach (hw i (by simp)) (hw j (by simp))
    | exact or_reach (hw i (by simp)) (hw j (by simp))


def freeAt (p : ℕ) : Prop := p = 0 ∨ p = 1

def price : ℕ → List Gate → ℕ
  | _, [] => 0
  | p, _ :: gs => price (p+1) gs + if p = 0 ∨ p = 1 then 0 else 1

def emptyGate : Gate := ⟨.or, []⟩

set_option maxRecDepth 5000 in
theorem compile_free (gs : List Gate) (p out : ℕ) (w : List W) (av : Finset W)
    (hg : ∀ g ∈ gs, legal g)
    (hout : out ≠ 0)
    (hw : ∀ i, i ≠ 0 → holds av (w.getD i 0))
    (hr : ∀ j < gs.length, p+j ≠ 1 → 0 ∉ (gs.getD j emptyGate).inputs)
    (hf : ∀ j < gs.length, freeAt (p+j) →
      holds av (action (runW (gs.take j) w) (gs.getD j emptyGate)))
    (he : (runW gs w).getD out 0 = ~~~goal) :
    ∃ t, (t = goal ∨ t = ~~~goal) ∧ build basicOps t (price p gs) av := by
  induction gs generalizing p w av with
  | nil =>
    have h := he ▸ hw out hout
    rcases h with zero|ones|⟨t,ht,eq|eq⟩
    · exact False.elim ((by decide : ~~~goal ≠ 0) zero)
    · exact False.elim ((by decide : ~~~goal ≠ ~~~0) ones)
    · exact ⟨t, .inr eq.symm, ht⟩
    · exact ⟨t, .inl (by simpa only [BitVec.not_not] using congrArg (fun w : W => ~~~w) eq.symm), ht⟩
  | cons g gs ih =>
    let z := action w g
    have tailLegal : ∀ a ∈ gs, legal a := fun a ha => hg a (by simp [ha])
    have tailRead : ∀ j < gs.length, p+1+j ≠ 1 → 0 ∉ (gs.getD j emptyGate).inputs := by
      intro j hj hp
      simpa [Nat.add_assoc] using hr (j+1) (by simp; omega) (by omega)
    have tailFree : ∀ j < gs.length, freeAt (p+1+j) →
        holds av (action (runW (gs.take j) (w ++ [z])) (gs.getD j emptyGate)) := by
      intro j hj hp
      simpa [List.take_succ_cons, runW, z, Nat.add_assoc] using
        hf (j+1) (by simp; omega) (by rcases hp with hp | hp <;> unfold freeAt <;> omega)
    have tailEval : (runW gs (w ++ [z])).getD out 0 = ~~~goal := he
    have cont (A : Finset W) (sub : av ⊆ A) (new : holds A z) :=
      ih (p+1) (w ++ [z]) A tailLegal
        (holds_append w A z (fun i hi => holds_mono sub (hw i hi)) new) tailRead
        (fun j hj hp => holds_mono sub (tailFree j hj hp)) tailEval
    by_cases hp : p = 0 ∨ p = 1
    · have hz : holds av z := by
        simpa [runW, freeAt] using hf 0 (by simp) (by simpa [freeAt] using hp)
      simpa [price, hp] using cont av (fun _ h => h) hz
    · have nr : 0 ∉ g.inputs := by
        simpa using hr 0 (by simp) (by simp; tauto)
      have reach := gate_reach_reads w av g (hg g (by simp)) (fun i hi =>
        hw i (fun eq => nr (eq ▸ hi)))
      rw [price, if_neg hp]
      rcases reach with old | ⟨a,ha,b,hb,ne,new,op,rep⟩
      · obtain ⟨t,ht,run⟩ := cont av (fun _ h => h) old
        exact ⟨t,ht,Or.inl run⟩
      · obtain ⟨t,ht,run⟩ := cont (insert new av) (Finset.subset_insert _ _) rep
        exact ⟨t,ht,Or.inr ⟨a,ha,b,hb,ne,new,op,run⟩⟩

abbrev Code := Fin 3 × Fin 3 × Fin 8 × Fin 8

def codeGate (c : Code) : Gate :=
  ⟨if c.1.val = 0 then .and else if c.1.val = 1 then .or else .not,
    if c.2.1.val = 0 then [] else if c.2.1.val = 1 then [c.2.2.1.val]
    else [c.2.2.1.val,c.2.2.2.val]⟩

def clamp (i : ℕ) : Fin 8 := ⟨min i 7, by omega⟩

def normalGate (g : Gate) : Gate := ⟨g.op, g.inputs.map (fun i => (clamp i).val)⟩

theorem read_clamp {α : Type} (w : List α) (d : α) (hw : w.length = 7) (i : ℕ) :
    w.getD (clamp i).val d = w.getD i d := by
  by_cases hi : i < 7
  · simp [clamp, Nat.min_eq_left (by omega : i ≤ 7)]
  · rw [show (clamp i).val = 7 by simp [clamp, Nat.min_eq_right (by omega : 7 ≤ i)]]
    rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega)]

theorem action_normal (w : List W) (hw : w.length = 7) (g : Gate) :
    action w (normalGate g) = action w g := by
  obtain ⟨op,is⟩ := g
  cases op <;> simp only [normalGate, action, List.map_map, List.head?_map,
    Option.map_map, Function.comp_def, read_clamp w 0 hw]

def evalGate (g : Gate) (x : Fin 7 → Bool) : Bool :=
  g.op.eval (g.inputs.map fun i => (List.ofFn x).getD i false)

theorem eval_normal (g : Gate) (x : Fin 7 → Bool) :
    evalGate (normalGate g) x = evalGate g x := by
  simp only [evalGate, normalGate, List.map_map, Function.comp_def,
    read_clamp _ false (show (List.ofFn x).length = 7 from List.length_ofFn)]

theorem normal_no_zero (g : Gate) (h : 0 ∉ g.inputs) : 0 ∉ (normalGate g).inputs := by
  intro hx
  obtain ⟨i, hi, he⟩ := List.mem_map.mp hx
  have iz : i = 0 := by change min i 7 = 0 at he; omega
  exact h (iz ▸ hi)

theorem code_exists (g : Gate) (hg : legal g) : ∃ c : Code, codeGate c = normalGate g := by
  obtain ⟨op,args⟩ := g
  obtain ⟨hop,cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _|⟨i,_|⟨j,_|⟨u,tail⟩⟩⟩ <;> simp at cap
  · rcases hop with rfl|rfl|rfl
    · exact ⟨(0,0,0,0),rfl⟩
    · exact ⟨(1,0,0,0),rfl⟩
    · exact ⟨(2,0,0,0),rfl⟩
  · rcases hop with rfl|rfl|rfl
    · exact ⟨(0,1,clamp i,0),rfl⟩
    · exact ⟨(1,1,clamp i,0),rfl⟩
    · exact ⟨(2,1,clamp i,0),rfl⟩
  · rcases hop with rfl|rfl|rfl
    · exact ⟨(0,2,clamp i,clamp j),rfl⟩
    · exact ⟨(1,2,clamp i,clamp j),rfl⟩
    · exact ⟨(2,2,clamp i,clamp j),rfl⟩

def witnessInput (r : Fin 16) (i : Fin 7) : Bool :=
  if 2 ≤ i.val ∧ i.val ≤ 5 then r.val.testBit (i.val - 2) else false

set_option maxRecDepth 32000 in
set_option maxHeartbeats 0 in
theorem witness_exhaustive : ∀ x : Fin 7 → Bool,
    x 0 = false → x 1 = false → x 6 = false → ∃ r : Fin 16, witnessInput r = x := by
  decide +kernel

def codeWitness (c : Code) : Bool :=
  (List.finRange 16).any (fun r => evalGate (codeGate c) (witnessInput r))

set_option maxRecDepth 32000 in
set_option maxHeartbeats 0 in
theorem finite_codes : ∀ c : Code, 0 ∉ (codeGate c).inputs →
    codeWitness c = true → action primary (codeGate c) ∈ candidates := by
  decide +kernel

theorem first_candidate (g : Gate) (hg : legal g) (hn : 0 ∉ g.inputs)
    (x : Fin 7 → Bool) (h0 : x 0 = false) (h1 : x 1 = false) (h6 : x 6 = false)
    (he : evalGate g x = true) : action primary g ∈ candidates := by
  obtain ⟨c, hc⟩ := code_exists g hg
  have hnc : 0 ∉ (codeGate c).inputs := hc ▸ normal_no_zero g hn
  obtain ⟨r, hr⟩ := witness_exhaustive x h0 h1 h6
  have hcW : codeWitness c = true := by
    apply List.any_eq_true.mpr
    refine ⟨r, by simp, ?_⟩
    rw [hc, hr, eval_normal]
    exact he
  have h := finite_codes c hnc hcW
  rw [hc, action_normal primary (by decide)] at h
  exact h

def target (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) ||
    (x 4 && x 5) || (x 5 && x 6) || (x 6 && x 0)

set_option maxRecDepth 32000 in
set_option maxHeartbeats 0 in
theorem sample_target : ∀ k : Fin 182,
    target (fun i => bit k (primary.getD i.val 0)) = bit k (~~~goal) := by
  decide +kernel

theorem bool_stable (gs : List Gate) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (gs.foldl step w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (gs.foldl step (w ++ [_])).getD i false = _
    rw [ih _ (by simp; omega)]
    exact List.getD_append _ _ _ _ hi

theorem first_bool (g : Gate) (gs : List Gate) (x : Fin 7 → Bool) :
    (Circuit.wires ⟨g :: gs, 0⟩ (List.ofFn x)).getD 7 false = evalGate g x := by
  change (gs.foldl step (List.ofFn x ++ [evalGate g x])).getD 7 false = _
  rw [bool_stable _ _ _ (by simp)]
  rw [List.getD_append_right _ _ _ _ (by simp)]
  simp

theorem first_vector (g : Gate) (gs : List Gate) (w : List W) (hw : w.length = 7) :
    (runW (g :: gs) w).getD 7 0 = action w g := by
  change (runW gs (w ++ [action w g])).getD 7 0 = _
  rw [runW_stable _ _ _ (by simp [hw])]
  rw [List.getD_append_right _ _ _ _ (by omega)]
  simp [hw]

theorem source_holds (u v : W) (hv : v ∈ sourceValues u) :
    holds (sources u).toFinset v := by
  refine .inr (.inr ⟨~~~v, ?_, .inr (BitVec.not_not.symm)⟩)
  simp only [sources, List.mem_toFinset, List.mem_dedup]
  exact List.mem_map.mpr ⟨v,hv,rfl⟩

theorem initial_holds (u : W) :
    ∀ i, i ≠ 0 → holds (sources u).toFinset (primary.getD i 0) := by
  intro i hi
  by_cases hb : i < 7
  · apply source_holds
    have mem : primary.getD i 0 ∈ primary.drop 1 := by
      interval_cases i <;> simp_all [primary]
    exact List.mem_append_left _ (List.mem_append_right _ mem)
  · rw [List.getD_eq_default _ _ (by simpa [primary] using Nat.le_of_not_gt hb)]
    exact .inl rfl

theorem two_inputs (g : Gate) (hg : legal g) (h0 : 0 ∈ g.inputs) (h7 : 7 ∈ g.inputs) :
    g.inputs = [0,7] ∨ g.inputs = [7,0] := by
  obtain ⟨op,args⟩ := g
  have cap : args.length ≤ 2 := hg.2
  rcases args with _|⟨a,_|⟨b,_|⟨c,tail⟩⟩⟩ <;> simp_all
  all_goals omega

def cost : ℕ → ℕ → ℕ
  | _, 0 => 0
  | p, n+1 => cost (p+1) n + if p = 0 ∨ p = 1 then 0 else 1

theorem price_cost (gs : List Gate) (p : ℕ) : price p gs = cost p gs.length := by
  induction gs generalizing p with
  | nil => rfl
  | cons g gs ih => simp [price, cost, ih]

theorem vectors_compute (gs : List Gate) (out : ℕ) (hg : ∀ g ∈ gs, legal g)
    (he : ∀ x : Fin 7 → Bool, Circuit.eval ⟨gs,out⟩ (List.ofFn x) = target x) :
    (runW gs primary).getD out 0 = ~~~goal := by
  apply BitVec.eq_of_getElem_eq
  intro j hj
  let k : Fin 182 := ⟨j,hj⟩
  change bit k ((runW gs primary).getD out 0) = bit k (~~~goal)
  rw [← read_bit, runW_bits gs primary hg k]
  let x (i : Fin 7) := bit k (primary.getD i.val 0)
  have same : List.ofFn x = primary.map (bit k) := by
    apply List.ext_getElem
    · simp [primary]
    · intro i hi hj
      have hlt : i < primary.length := by simpa using hj
      simp only [List.getElem_ofFn, List.getElem_map, x, List.getD_eq_getElem?_getD,
        List.getElem?_eq_getElem hlt, Option.getD_some]
  rw [← same]
  change Circuit.eval ⟨gs,out⟩ (List.ofFn x) = _
  rw [he]
  exact sample_target k

set_option maxRecDepth 5000 in
set_option maxHeartbeats 0 in
theorem impossible (g : Gate) (gs : List Gate) (out : ℕ)
    (hlen : (g :: gs).length = 10)
    (hg : ∀ a ∈ g :: gs, legal a)
    (he : ∀ x : Fin 7 → Bool, Circuit.eval ⟨g :: gs,out⟩ (List.ofFn x) = target x)
    (hr : ∀ j < (g :: gs).length, j ≠ 1 → 0 ∉ ((g :: gs).getD j emptyGate).inputs)
    (hop : ((g :: gs).getD 1 emptyGate).op = .or)
    (hargs : ((g :: gs).getD 1 emptyGate).inputs = [0,7] ∨
      ((g :: gs).getD 1 emptyGate).inputs = [7,0])
    (x : Fin 7 → Bool) (h0 : x 0 = false) (h1 : x 1 = false) (h6 : x 6 = false)
    (hx : evalGate g x = true) : False := by
  let u := action primary g
  have hu : u ∈ candidates := first_candidate g (hg g (by simp))
    (by simpa using hr 0 (by simp) (by decide)) x h0 h1 h6 hx
  have hev := vectors_compute (g :: gs) out hg he
  have hout : out ≠ 0 := by
    intro e
    subst out
    rw [runW_stable _ _ _ (by decide)] at hev
    exact (by decide : primary.getD 0 0 ≠ ~~~goal) hev
  have hf : ∀ j < (g :: gs).length, freeAt (0+j) →
      holds (sources u).toFinset
        (action (runW ((g :: gs).take j) primary) ((g :: gs).getD j emptyGate)) := by
    intro j hj hp
    rcases hp with hp | hp
    · have je : j = 0 := by omega
      subst j
      apply source_holds
      simp [sourceValues, u, runW]
    · have je : j = 1 := by omega
      subst j
      have read0 : (runW ((g :: gs).take 1) primary).getD 0 0 = primary.getD 0 0 :=
        runW_stable _ _ _ (by decide)
      have read7 : (runW ((g :: gs).take 1) primary).getD 7 0 = u := by
        change (runW (g :: gs.take 0) primary).getD 7 0 = _
        exact first_vector _ _ _ (by decide)
      have eq : action (runW ((g :: gs).take 1) primary) ((g :: gs).getD 1 emptyGate) =
          primary.getD 0 0 ||| u := by
        rcases hargs with ha | ha <;>
          simp only [action, hop, ha, List.map_cons, List.map_nil,
            List.foldr_cons, List.foldr_nil, read0, read7,
            show ∀ a : W, a ||| (0 : W) = a from fun a => BitVec.or_zero]
        all_goals first | rfl | exact BitVec.or_comm _ _
      rw [eq]
      apply source_holds
      simp [sourceValues]
  obtain ⟨t, ht, hb⟩ := compile_free (g :: gs) 0 out primary (sources u).toFinset hg hout
    (initial_holds u) (by simpa using hr) hf hev
  rw [price_cost, hlen] at hb
  exact no_eight u hu t ht hb


end PEqualNP.Outside.L_meta_29800_aux

theorem PEqualNP.Outside.L_meta_29800 : (¬ (∃ (C : PEqualNP.CircuitLowerBounds.Circuit) (i k : Fin C.gates.length), i.val = 1 ∧ PEqualNP.MetaComplexity.FanInTwo C ∧ C.size = 10 ∧ (∀ x : Fin 7 → Bool, C.eval (List.ofFn x) = ((x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) || (x 4 && x 5) || (x 5 && x 6) || (x 6 && x 0))) ∧ 0 ∈ (C.gates.get i).inputs ∧ (∀ j : Fin C.gates.length, 0 ∈ (C.gates.get j).inputs → j = i) ∧ (C.gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ (C.gates.get k).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ i.val < k.val ∧ 7 + i.val ∈ (C.gates.get k).inputs ∧ 7 ∈ (C.gates.get i).inputs ∧ 7 ≠ 0 ∧ 7 < 7 + i.val ∧ ∃ x : Fin 7 → Bool, x 0 = false ∧ x 1 = false ∧ x 6 = false ∧ (C.wires (List.ofFn x)).getD 7 false = true))  := by
  rintro ⟨⟨gates, out⟩, i, k, hi, hfan, hsize, he, h0, honly, hop, hkop, hik, hki, h7, h70, h7i, x, hx0, hx1, hx6, hx⟩
  have hlen : gates.length = 10 := hsize
  have hg : ∀ a ∈ gates, PEqualNP.Outside.L_meta_29800_aux.legal a := by
    intro a ha
    obtain ⟨ops, len⟩ := hfan a ha
    exact ⟨by simpa using ops, len⟩
  have hget (j : Fin gates.length) :
      gates.get j = gates.getD j.val PEqualNP.Outside.L_meta_29800_aux.emptyGate := by
    simp only [List.get_eq_getElem, List.getD_eq_getElem?_getD,
      List.getElem?_eq_getElem j.isLt, Option.getD_some]
  have hgi : gates.get i = gates.getD 1 PEqualNP.Outside.L_meta_29800_aux.emptyGate := by
    rw [hget, hi]
  have hr : ∀ j < gates.length, j ≠ 1 →
      0 ∉ (gates.getD j PEqualNP.Outside.L_meta_29800_aux.emptyGate).inputs := by
    intro j hj hne hm
    have hmem : 0 ∈ (gates.get ⟨j, hj⟩).inputs := by
      rw [hget]
      exact hm
    have heq := honly ⟨j, hj⟩ hmem
    have hv := congrArg Fin.val heq
    simp only [hi] at hv
    exact hne hv
  change (gates.get i).op = _ at hop
  change 0 ∈ (gates.get i).inputs at h0
  change 7 ∈ (gates.get i).inputs at h7
  rw [hgi] at hop h0 h7
  have hlegali : PEqualNP.Outside.L_meta_29800_aux.legal (gates.getD 1 PEqualNP.Outside.L_meta_29800_aux.emptyGate) := by
    rw [← hgi]
    exact hg _ (List.get_mem ..)
  have hargs := PEqualNP.Outside.L_meta_29800_aux.two_inputs _ hlegali h0 h7
  have het : ∀ x : Fin 7 → Bool,
      PEqualNP.CircuitLowerBounds.Circuit.eval ⟨gates, out⟩ (List.ofFn x) =
        PEqualNP.Outside.L_meta_29800_aux.target x := he
  cases gates with
  | nil => simp at hlen
  | cons g gs =>
    have hw : PEqualNP.Outside.L_meta_29800_aux.evalGate g x = true := by
      change (PEqualNP.CircuitLowerBounds.Circuit.wires ⟨g :: gs, 0⟩ (List.ofFn x)).getD 7 false = true at hx
      rwa [PEqualNP.Outside.L_meta_29800_aux.first_bool] at hx
    exact PEqualNP.Outside.L_meta_29800_aux.impossible g gs out hlen hg het hr hop hargs x hx0 hx1 hx6 hw
