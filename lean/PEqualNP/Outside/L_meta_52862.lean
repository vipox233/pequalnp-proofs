    exact (a1.sublist hsub).imp fun h => Nat.ne_of_gt h
  have hrep : Rep v S := by
    refine ⟨hnd, Finset.ext fun x => ?_⟩
    rw [List.mem_toFinset, List.mem_map]
    constructor
    · rintro ⟨w, hw, rfl⟩
      rw [hv, List.mem_filter] at hw; simpa using hw.2
    · intro hx
      obtain ⟨w, hw, rfl⟩ := hSW hx
      obtain ⟨w', hw', e⟩ := a3 w hw (fun e => h0 (e ▸ hx)) (fun e => h1 (e ▸ hx))
      exact ⟨w', by rw [hv, List.mem_filter]; exact ⟨hw', by simpa [e] using hx⟩, e⟩
  have hwok : ∀ w ∈ v, WOk (PZ Q) w := by
    intro w hw
    obtain ⟨x, _, rfl⟩ := a2 w (hsub.subset hw); exact mkW_ok _ _
  have hcod : ∀ w ∈ v, w.r = RZ E Z w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw)
    have : x &&& mz Z ∈ WZ E Z := ⟨x, hx, rfl⟩
    change 3 = RZ E Z (x &&& mz Z)
    rw [RZ, if_pos this]
  have hgood : ∀ w ∈ v, Good (lz Z) w.s := by
    intro w hw
    obtain ⟨x, hx, rfl⟩ := a2 w (hsub.subset hw); exact wire_good (rawL_sub hE6 hx) Z
  have hPlen : (PZ Q).length = Q.length := by simp [PZ]
  have hPget : ∀ j < (PZ Q).length, (PZ Q).getD j 0 = mz (Q.getD j (0, L - 1)).1 ∧ Q.getD j (0, L - 1) ∈ Q := by
    intro j hj
    rw [hPlen] at hj
    simp [PZ, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]
  have X : Ctx (PZ Q) (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (tz Z) := by
    refine ⟨fun i hi => lz_lg Z i hi, fun j hj => ?_, ?_⟩
    · obtain ⟨e1, e2⟩ := hPget j hj
      have h3 := hproj _ e2
      rw [e1, tz_sub h3.1]; exact h3
    · rw [pL_pk, List.length_map, hPlen]
      refine pk_congr fun j hj => ?_
      rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hj]; rfl
  have hcl : Cl (PZ Q) (tz Z) (L - 1) (fun j => L - 1 - (Q.getD j (0, L - 1)).2) S := by
    intro j hj q hq
    obtain ⟨e1, e2⟩ := hPget j hj
    have hq' : q + (L - 1 - (Q.getD j (0, L - 1)).2) < L - 1 := hq
    rw [e1]; exact hno _ e2 q (by omega)
  have hle := cnt_le X hrep hwok hcl hm (by omega)
  have hst : StOk (PZ Q) (tz Z) (lz Z) (L - 1) (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v S := by
    refine ⟨hrep, hwok, hgood, _, fun j _ => by omega, hcl, ?_⟩
    rw [sumc_eq hwok, pk16, pk_sub]
    intro j hj; have := hle j hj; omega
  have hcov : ∀ i, (lz Z).testBit i = true → (0 : ℕ).testBit i = true ∨ (cov (pos t) (lz Z) v).testBit i = true := by
    intro i hli
    right
    rw [cov_bit]
    obtain ⟨⟨m1, m2, t1, t2⟩, _⟩ := lz_lg Z i hli
    obtain ⟨w, hw, hs⟩ := hl.cov m1 m2 t1 t2
    obtain ⟨w', hw', rfl⟩ := hrep.mem.1 hw
    exact ⟨w', hw', by rw [sp_bit, hli, pos_eq, hs]; rfl⟩
  have hsz := hm.size.1
  have hcard := hrep.card
  have hble : Nat.ble v.length (Nat.sub (Nat.succ (L - 1)) t) = true := Nat.ble_eq_true_of_le (by
    change v.length ≤ L - 1 + 1 - t; omega)
  have hhas : hasP (pwr E Z) v = true := hasP_ok (hpw.imp id fun h => hrep.mem.1 h)
  have all : ∀ p ∈ M, topC (lz Z) (mz Z) (pL (Q.map fun _ => 16)) (L - 1) p.1 p.2 (L - 1) t (pL (Q.map fun e => 16 + (L - 1 - e.2)) - sumc v) v = false := by
    intro p hpM
    have h2 := hchk p hpM
    simp only [chk, frc_eq, st_eq] at h2
    have h3 := anySub_false (by simp) h2 v hsub hcov
    simp only [startv, bR, hhas, hble, Bool.cond_true] at h3
    exact child_sound X (f := fun z r => topC (lz Z) (mz Z) _ (L - 1) p.1 p.2 (L - 1) t z r) (fun h => rfl) hst hm (by omega) h3
  refine topC_selected X (RZ_R E Z) (RZ_R2 E Z) hMf all hst hcod (by omega) hl hsel ?_
  intro q hq hs
  rw [RZ_set] at hs
  refine hmin q hq (hs.mono le_rfl ?_)
  rintro x ((hx | hx) | hx)
  · exact Or.inl hx
  · exact Or.inl (hSW hx)
  · exact Or.inr hx

lemma Live.neg_le {m T k t : ℕ} {S : Finset ℕ} (run : Live Z0 m T k t S) : t ≤ k := by
  induction run <;> omega

lemma routed.op {ps m a b x y} (d : Bool) (hx : routed ps m a x) (hy : routed ps m b y) :
    routed ps m (op d a b) (op d x y) := by
  refine ⟨by rw [and_op, hx.1, hy.1], ?_⟩
  intro p hp
  rw [op_bit, op_bit, hx.2 p hp, hy.2 p hp]

lemma Live.routeBudget {ps : List (ℕ × ℕ)} {m T k t : ℕ} {S : Finset ℕ}
    (cover : routeMask ps = m) (hm : routed ps m m m) (ht : routed ps m T T)
    (run : Live Z0 m T k t S) {D : Set ℕ} (supply : ∀ a ∈ S, ∃ b ∈ D, routed ps m a b) :
    GateBudget m T (k-t) t D := by
  induction run generalizing D with
  | stop =>
    obtain ⟨b,hb,hr⟩ := supply T (by simp)
    refine ⟨0,0,by omega,by omega,{T},?_,.stop⟩
    simpa only [Finset.coe_singleton, Set.singleton_subset_iff, hr.unique cover ht] using hb
  | @un k t a U tail ih =>
    obtain ⟨b,hb,hr⟩ := supply a (by simp)
    have hn : routed ps m (a ^^^ m) (b ^^^ m) := by
      refine ⟨by rw [and_neg (Nat.and_self m),hr.1], ?_⟩
      intro p hp
      rw [Nat.testBit_xor,Nat.testBit_xor,hr.2 p hp,hm.2 p hp]
    have next : GateBudget m T (k-t) t (insert (b ^^^ m) D) := by
      apply ih
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hu
      · exact ⟨_,Or.inl rfl,hn⟩
      obtain ⟨y,hy,hxy⟩ := supply x (Finset.mem_insert_of_mem hu)
      exact ⟨y,Or.inr hy,hxy⟩
    exact (next.un hb).mono (by omega) le_rfl (fun _ h => h)
  | @bi k t d a b U _ _ tail ih =>
    obtain ⟨a',ha,ra⟩ := supply a (by simp)
    obtain ⟨b',hb,rb⟩ := supply b (by simp)
    have next : GateBudget m T (k-t) t (insert (op d a' b') D) := by
      apply ih
      intro x hx
      rcases Finset.mem_insert.mp hx with rfl | hu
      · exact ⟨_,Or.inl rfl,ra.op d rb⟩
      obtain ⟨y,hy,hxy⟩ := supply x (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hu))
      exact ⟨y,Or.inr hy,hxy⟩
    have htk := tail.neg_le
    exact (next.bi ha hb).mono (by omega) le_rfl (fun _ h => h)

def stock (z i : ℕ) := rawP.getD i 0 &&& mz z

lemma mem_stock {x z} (hx : x ∈ WZ [] z) : ∃ i : Fin 8, x = stock z i.val := by
  obtain ⟨w,hw,rfl⟩ := hx
  have hw' : w ∈ rawP := by simpa [rawL] using hw
  obtain ⟨i,hi,h⟩ := List.mem_iff_getElem.mp hw'
  refine ⟨⟨i, by simpa [rawP] using hi⟩, ?_⟩
  simp [stock, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi,h]

lemma stock_mem {z i} (hi : i < 8) : stock z i ∈ WZ [] z := by
  refine ⟨rawP.getD i 0,?_,rfl⟩
  have h : i < rawP.length := by simpa [rawP] using hi
  simp only [rawL, List.map_nil, List.append_nil]
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h, Option.getD_some]
  exact List.getElem_mem h

def Rotates (z : ℕ) (p : List ℕ) : Prop :=
  ∃ rs : List (ℕ × ℕ), routeMask rs = mz z ∧ routed rs (mz z) (mz z) (mz z) ∧
    routed rs (mz z) (tz z) (tz z) ∧ ∀ i : Fin 8, p.getD i.val 0 < 8 ∧ routed rs (mz z) (stock z i.val) (stock z (p.getD i.val 0))

def representatives (z : ℕ) (M : List (ℕ × ℕ)) (ps : List (List ℕ)) : Bool :=
  (List.range 8).all fun i => (List.range 8).all fun j => stock z i == stock z j || ps.any fun p =>
    let x := stock z (p.getD i 0)
    let y := stock z (p.getD j 0)
    !(x == y) && M.any fun u => hb u.1 (x + y)

lemma chooseFront {z k t} {S : Finset ℕ} {M : List (ℕ × ℕ)} {ps : List (List ℕ)}
    (rots : ∀ p ∈ ps, Rotates z p) (reps : representatives z M ps = true)
    (small : Imp [] z k) (supply : (S : Set ℕ) ⊆ C (mz z) (WZ [] z))
    (run : Live Z0 (mz z) (tz z) k t S) :
    ∃ A : Finset ℕ, (A : Set ℕ) ⊆ C (mz z) (WZ [] z) ∧ Live Z0 (mz z) (tz z) k t A ∧ Selected (RZ [] z) M (mz z) (tz z) k t A := by
  let D := C (mz z) (WZ [] z)
  have min : ∀ q < k, ¬ Sol Z0 (mz z) (tz z) q (C (mz z) ({x | RZ [] z x ≠ 0} ∪ (S : Set ℕ))) := by
    intro q hq h
    apply small q hq
    apply h.mono le_rfl
    rw [RZ_set]
    rintro x ((hx | hx) | hx)
    · exact Or.inl hx
    · exact supply hx
    · exact Or.inr hx
  rcases front (RZ_R2 [] z) run min with h | ⟨k0,d,a,b,B,rfl,am,bm,gate,tail⟩
  · exact ⟨S,supply,run,Or.inl h⟩
  have memR (x : ℕ) : RZ [] z x ≠ 0 ↔ x ∈ WZ [] z := by
    change x ∈ {y | RZ [] z y ≠ 0} ↔ _
    rw [RZ_set]
  obtain ⟨i,rfl⟩ := mem_stock ((memR _).mp am)
  obtain ⟨j,rfl⟩ := mem_stock ((memR _).mp bm)
  simp only [representatives,List.all_eq_true,List.mem_range,Bool.or_eq_true,List.any_eq_true,Bool.and_eq_true,Bool.not_eq_true',beq_iff_eq] at reps
  rcases reps i i.isLt j j.isLt with h | ⟨p,hp,hxy,hm⟩
  · exact False.elim (gate.1 h)
  have ne : stock z (p.getD i.val 0) ≠ stock z (p.getD j.val 0) := fun h => by
    have bad : (stock z (p.getD i.val 0) == stock z (p.getD j.val 0)) = true := beq_iff_eq.mpr h
    exact Bool.noConfusion (bad.symm.trans hxy)
  obtain ⟨rs,cover,mr,tr,perm⟩ := rots p hp
  let x := stock z (p.getD i.val 0)
  let y := stock z (p.getD j.val 0)
  have xm := stock_mem (z := z) (perm i).1
  have ym := stock_mem (z := z) (perm j).1
  have transported : GateBudget (mz z) (tz z) (k0-t) t (insert (op d x y) D) := by
    apply tail.routeBudget cover mr tr
    intro w hw
    rcases Finset.mem_insert.mp (gate.sub.2.2 hw) with rfl | old
    · exact ⟨_,Or.inl rfl,((perm i).2).op d ((perm j).2)⟩
    rcases supply old with raw | cn
    · obtain ⟨a,rfl⟩ := mem_stock raw
      exact ⟨_,Or.inr (Or.inl (stock_mem (perm a).1)),(perm a).2⟩
    rcases cn with zero | full
    · change w = 0 at zero
      subst w
      exact ⟨0,Or.inr (Or.inr (Or.inl rfl)),by simp [routed]⟩
    · change w = mz z at full
      subst w
      exact ⟨mz z,Or.inr (Or.inr (Or.inr rfl)),mr⟩
  obtain ⟨q,n,hq,hn,V,hV,hv⟩ := transported
  have htk := tail.neg_le
  have vs : ∀ w ∈ V.erase (op d x y), w ∈ D := by
    intro w hw
    exact (hV (Finset.mem_erase.mp hw).2).resolve_left (Finset.mem_erase.mp hw).1
  have used : op d x y ∈ V := by
    by_contra h
    exact small q (by omega) (hv.sol.mono le_rfl (fun w hw => (hV hw).resolve_left (fun e => h (e ▸ hw))))
  let U := V.erase (op d x y)
  let A := insert x (insert y U)
  have hA : (A : Set ℕ) ⊆ D := by
    intro w hw
    rcases Finset.mem_insert.mp hw with rfl | hy
    · exact Or.inl xm
    rcases Finset.mem_insert.mp hy with rfl | hu
    · exact Or.inl ym
    exact vs w hu
  have bi : Bi Z0 d x y A V := ⟨ne,U,rfl,(Finset.insert_erase used).symm,al0 d x y⟩
  have step := bi.live hv
  have lower : k0 ≤ q := by
    by_contra h
    exact small (q+1) (by omega) (step.sol.mono le_rfl hA)
  have eq1 : q = k0 := by omega
  have eq2 : n = t := by omega
  subst q n
  exact ⟨A,hA,step,Or.inr ⟨_,d,x,y,V,rfl,(memR _).mpr xm,(memR _).mpr ym,bi,hv,hm⟩⟩

lemma rotateChecked {z p rs}
    (cover : routeMask rs = mz z) (ms : maskRows rs (mz z) (mz z) = true)
    (gt : agreeRows rs (tz z) (tz z) = true)
    (hs : ∀ i : Fin 8, p.getD i.val 0 < 8 ∧ agreeRows rs (stock z i.val) (stock z (p.getD i.val 0)) = true) : Rotates z p := by
  refine ⟨rs,cover,⟨Nat.and_self _,?_⟩,⟨by simp [tz,Nat.and_assoc],agreeRows_ok gt⟩,?_⟩
  · intro x hx
    have h := List.all_eq_true.mp ms x hx
    simp only [Bool.and_eq_true] at h
    exact h.1.trans h.2.symm
  · intro i
    exact ⟨(hs i).1,⟨by simp [stock,Nat.and_assoc],agreeRows_ok (hs i).2⟩⟩

lemma imp_rotations {z L} {Q M : List (ℕ × ℕ)} {ps : List (List ℕ)}
    (hp : pOk z Q = true) (hL : L ≤ 15) (sound : ∀ e ∈ Q, Imp [] e.1 e.2)
    (phase : ∃ p ∈ M, Nat.beq p.2 1 = true)
    (rotations : ∀ p ∈ ps, Rotates z p) (rep : representatives z M ps = true)
    (cases : ∀ t < L, (∀ u ∈ M, chk [] Q z (L-1) t u.1 u.2 = false) ∨ chk [] Q z (L-1) t FF 1 = false) : Imp [] z L := by
  intro q hq h
  classical
  let F := fun a => Sol Z0 (mz z) (tz z) a (C (mz z) (WZ [] z))
  have any : ∃ a, F a := ⟨q,h⟩
  let k := Nat.find any
  have good : F k := Nat.find_spec any
  have low : Imp [] z k := fun a ha => Nat.find_min any ha
  have bound : k < L := lt_of_le_of_lt (Nat.find_min' any h) hq
  obtain ⟨w,hw,t,V,hV,hv⟩ := good.live
  have eqw : w = k := le_antisymm hw (Nat.find_min' any (hv.sol.mono le_rfl hV))
  subst w
  have ht := hv.neg_le
  rcases cases t (by omega) with selected | all
  · obtain ⟨A,hA,ha,fits⟩ := chooseFront rotations rep low hV hv
    exact imp_selected (L:=L) (Or.inl rfl) hp hL sound bound hA ha low (Or.inr ⟨M,phase,fits,selected⟩)
  · apply imp_of_live (L:=L) (Or.inl rfl) hp hL sound bound hV hv low
    exact Or.inr ⟨[(FF,1)],ffull,fun p hp => by simp only [List.mem_singleton] at hp; subst p; exact all⟩

