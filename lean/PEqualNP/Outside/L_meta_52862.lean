    have h3 := anySub_false (by simp) h2 v hsub hcov
    simp only [startv, bR, hhas, hble, Bool.cond_true] at h3
    exact child_sound X (f := fun z r => topC (lz Z) (mz Z) _ (L - 1) p.1 p.2 (L - 1) t z r) (fun h => rfl) hst hm (by omega) h3
  refine topC_sound X (RZ_R E Z) (RZ_R2 E Z) hMf all hst hcod (by omega) hl ?_
  intro q hq hs
  rw [RZ_set] at hs
  refine Nat.find_min hex (show q < Nat.find hex by omega) (hs.mono le_rfl ?_)
  rintro x ((hx | hx) | hx)
  · exact Or.inl hx
  · exact Or.inl (hSW hx)
  · exact Or.inr hx
def FF : ℕ := 2 ^ MM - 1
lemma ffull : mFull [(FF, 1)] = true := by decide +kernel
noncomputable def okT (E Q : List (ℕ × ℕ)) (Z L : ℕ) (ts : List ℕ) : Bool := ts.all (fun t => !chk E Q Z (L - 1) t FF 1)
noncomputable def okE (E Q : List (ℕ × ℕ)) (e : ℕ × ℕ) : Bool := pOk e.1 Q && Nat.ble e.2 15 && (Q.any (fun x => Nat.ble e.2 x.2) || okT E Q e.1 e.2 (List.range e.2))
lemma imp_okE {E Q : List (ℕ × ℕ)} {e : ℕ × ℕ} (hE : E = [] ∨ ∃ e' ∈ six, E = [e'] ∧ Imp [] e.1 e.2) (h : okE E Q e = true) (hI : ∀ e' ∈ Q, Imp E e'.1 e'.2) : Imp E e.1 e.2 := by
  simp only [okE, okT, Bool.and_eq_true, Bool.or_eq_true, List.any_eq_true, List.all_eq_true, List.mem_range, Bool.not_eq_true'] at h
  refine imp_of hE h.1.1 (Nat.le_of_ble_eq_true h.1.2) hI (h.2.imp (fun ⟨x, hx, hx2⟩ => ⟨x, hx, Nat.le_of_ble_eq_true hx2⟩) fun h t ht =>
    ⟨[(FF, 1)], ffull, fun p hp => ?_⟩)
  simp only [List.mem_singleton] at hp; subst hp; exact h t ht
def pr (T : List (ℕ × ℕ)) (Z : ℕ) : List (ℕ × ℕ) := T.filter (fun e => Nat.beq (Nat.land Z e.1) Z && !Nat.beq Z e.1)
lemma okAll {T U : List (ℕ × ℕ)} (h : U.all (fun e => okE [] (pr T e.1) e) = true)
    (hT : ∀ e ∈ T, Imp [] e.1 e.2) : ∀ e ∈ U, Imp [] e.1 e.2 := fun e he => imp_okE
  (Or.inl rfl) (List.all_eq_true.1 h e he) (fun e' h' => hT e' (List.mem_of_mem_filter h'))
lemma apI {E A B : List (ℕ × ℕ)} (ha : ∀ e ∈ A, Imp E e.1 e.2) (hb : ∀ e ∈ B, Imp E e.1 e.2) : ∀ e ∈ A ++ B, Imp E e.1 e.2 := fun e he =>
  (List.mem_append.1 he).elim (ha e) (hb e)
lemma imp_ts {E Q : List (ℕ × ℕ)} {L : ℕ} (hE : E = [] ∨ ∃ p ∈ six, E = [p] ∧ Imp [] 0 L) (hp : pOk 0 Q = true) (hL : L ≤ 15) (hI : ∀ e ∈ Q, Imp E e.1 e.2)
    (h : ∀ t < L, ∃ M : List (ℕ × ℕ), mFull M = true ∧ ∀ p ∈ M, chk E Q 0 (L - 1) t p.1 p.2 = false) : Imp E 0 L :=
  imp_of hE hp hL hI (Or.inr h)
lemma one {E Q : List (ℕ × ℕ)} {K t : ℕ} (h : chk E Q 0 K t FF 1 = false) : ∃ M : List (ℕ × ℕ), mFull M = true ∧ ∀ p ∈ M, chk E Q 0 K t p.1 p.2 = false :=
  ⟨[(FF, 1)], ffull, fun q hq => by simp only [List.mem_singleton] at hq; subst hq; exact h⟩
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
section circuit
variable (m : ℕ)
def gv (w : List ℕ) (g : Gate) : ℕ := match g.op, g.inputs with
  | .and, [] => m
  | .and, [i] => w.getD i 0
  | .and, i :: j :: _ => w.getD i 0 &&& w.getD j 0
  | .or, [] => 0
  | .or, [i] => w.getD i 0
  | .or, i :: j :: _ => w.getD i 0 ||| w.getD j 0
  | .not, [] => m
  | .not, i :: _ => w.getD i 0 ^^^ m
  | _, _ => 0
def ex (gs : List Gate) (w : List ℕ) : List ℕ := gs.foldl (fun w g => w ++ [gv m w g]) w
lemma getD_mem {S : Set ℕ} {w : List ℕ} (hw : ∀ x ∈ w, x ∈ S) (h0 : 0 ∈ S) (i : ℕ) : w.getD i 0 ∈ S := by
  rw [List.getD_eq_getElem?_getD]
  by_cases h : i < w.length
  · rw [List.getElem?_eq_getElem h]; exact hw _ (List.getElem_mem h)
  · rw [List.getElem?_eq_none (by omega)]; exact h0
lemma ex_sol {T : ℕ} (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ), (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (∃ i, (ex m gs w).getD i 0 = T) → Sol Z0 m T gs.length S := by
  induction gs with
  | nil =>
    rintro w S hw h0 _ _ ⟨i, rfl⟩
    exact .done (getD_mem hw h0 i)
  | cons g gs ih =>
    intro w S hw h0 hm hg hT
    have hgs := fun x hx => hg x (List.mem_cons_of_mem _ hx)
    have rd := fun i => getD_mem hw h0 i
    have stay : gv m w g ∈ S → Sol Z0 m T (g :: gs).length S := fun h =>
      (ih (w ++ [gv m w g]) S (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact hw x hx
        · exact h) h0 hm hgs hT).mono (by simp) subset_rfl
    have go : Sol Z0 m T gs.length (insert (gv m w g) S) := ih (w ++ [gv m w g]) _ (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact Or.inr (hw x hx)
        · exact Or.inl rfl) (Or.inr h0) (Or.inr hm) hgs hT
    obtain ⟨hop, hlen⟩ := hg g List.mem_cons_self
    obtain ⟨o, l⟩ := g
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
    rcases hop with rfl | rfl | rfl
    · match l with
      | [] => exact stay hm
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact .bi (d := false) (rd i) (rd j) (al0 _ _ _) go
    · match l with
      | [] => exact stay h0
      | [i] => exact stay (rd i)
      | i :: j :: _ => exact .bi (d := true) (rd i) (rd j) (al0 _ _ _) go
    · match l with
      | [] => exact stay hm
      | i :: _ => exact .un (rd i) go
lemma gv_sub {w : List ℕ} (hw : ∀ x ∈ w, x &&& m = x) (g : Gate) : gv m w g &&& m = gv m w g := by
  have rd : ∀ i, w.getD i 0 &&& m = w.getD i 0 := fun i => getD_mem (S := {x | x &&& m = x}) hw (by simp) i
  unfold gv
  split
  · simp
  · exact rd _
  · rw [Nat.and_assoc, rd]
  · simp
  · exact rd _
  · rw [Nat.and_or_distrib_right, rd, rd]
  · simp
  · rw [and_neg (Nat.and_self m), rd]
  · simp
lemma ex_sub {gs : List Gate} : ∀ {w : List ℕ}, (∀ x ∈ w, x &&& m = x) → ∀ x ∈ ex m gs w, x &&& m = x := by
  induction gs with
  | nil => intro w hw; exact hw
  | cons g gs ih =>
    intro w hw
    refine ih (w := w ++ [gv m w g]) fun x hx => ?_
    simp only [List.mem_append, List.mem_singleton] at hx
    rcases hx with hx | rfl
    · exact hw x hx
    · exact gv_sub m hw g
lemma getD_map (w : List ℕ) (b i : ℕ) : (w.map (fun x => x.testBit b)).getD i false = (w.getD i 0).testBit b := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases w[i]? <;> simp
lemma gv_bit {b : ℕ} (hb : m.testBit b = true) (w : List ℕ) (g : Gate)
    (hg : g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) :
    (gv m w g).testBit b = g.op.eval (g.inputs.map fun i => (w.map (fun x => x.testBit b)).getD i false) := by
  have e1 : ∀ l, GateOp.and.eval l = l.all id := fun _ => rfl
  have e2 : ∀ l, GateOp.or.eval l = l.any id := fun _ => rfl
  have e3 : ∀ l, GateOp.not.eval l = !(l.headD false) := fun _ => rfl
  obtain ⟨o, l⟩ := g
  obtain ⟨hop, hlen⟩ := hg
  simp only [getD_map]
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
  simp only at hlen
  rcases hop with rfl | rfl | rfl
  · match l, hlen with
    | [], _ => simp [gv, e1, hb]
    | [i], _ => simp [gv, e1]
    | [i, j], _ => simp [gv, e1]
  · match l, hlen with
    | [], _ => simp [gv, e2]
    | [i], _ => simp [gv, e2]
    | [i, j], _ => simp [gv, e2]
  · match l, hlen with
    | [], _ => simp [gv, e3, hb]
    | [i], _ => simp [gv, e3, hb]
    | [i, j], _ => simp [gv, e3, hb]
lemma ex_bit {b : ℕ} (hb : m.testBit b = true) (gs : List Gate) : ∀ (w : List ℕ),
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (ex m gs w).map (fun x => x.testBit b) =
      gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (w.map (fun x => x.testBit b)) := by
  induction gs with
  | nil => intro w _; rfl
  | cons g gs ih =>
    intro w hg
    rw [List.foldl_cons, ← gv_bit m hb w g (hg g List.mem_cons_self)]
    have := ih (w ++ [gv m w g]) (fun x hx => hg x (List.mem_cons_of_mem _ hx))
    rw [List.map_append] at this
    exact this
end circuit
def f (x : Fin 8 → Bool) : Bool := (x 0 && x 3) || (x 1 && x 3) || (x 0 && x 4) || (x 1 && x 4) || (x 2 && x 4) || (x 0 && x 5) || (x 2 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 5 && x 6) || (x 0 && x 7) || (x 1 && x 7) || (x 2 && x 7) || (x 3 && x 7) || (x 5 && x 7) || (x 6 && x 7)
def EF : ℕ := (rawP.getD 0 0 &&& rawP.getD 3 0) ||| (rawP.getD 1 0 &&& rawP.getD 3 0) ||| (rawP.getD 0 0 &&& rawP.getD 4 0) ||| (rawP.getD 1 0 &&& rawP.getD 4 0) ||| (rawP.getD 2 0 &&& rawP.getD 4 0) ||| (rawP.getD 0 0 &&& rawP.getD 5 0) ||| (rawP.getD 2 0 &&& rawP.getD 5 0) ||| (rawP.getD 3 0 &&& rawP.getD 5 0) ||| (rawP.getD 0 0 &&& rawP.getD 6 0) ||| (rawP.getD 1 0 &&& rawP.getD 6 0) ||| (rawP.getD 2 0 &&& rawP.getD 6 0) ||| (rawP.getD 3 0 &&& rawP.getD 6 0) ||| (rawP.getD 5 0 &&& rawP.getD 6 0) ||| (rawP.getD 0 0 &&& rawP.getD 7 0) ||| (rawP.getD 1 0 &&& rawP.getD 7 0) ||| (rawP.getD 2 0 &&& rawP.getD 7 0) ||| (rawP.getD 3 0 &&& rawP.getD 7 0) ||| (rawP.getD 5 0 &&& rawP.getD 7 0) ||| (rawP.getD 6 0 &&& rawP.getD 7 0)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma EF_ok : EF &&& mz 0 = tz 0 := by decide +kernel
lemma rawP_len : rawP.length = 8 := rfl
lemma row_list (b : ℕ) : List.ofFn (fun v : Fin 8 => (rawP.getD v.val 0).testBit b) = rawP.map (fun x => x.testBit b) := by
  apply List.ext_getElem
  · simp [rawP_len]
  · intro i h1 h2
    have : i < rawP.length := by simpa using h2
    rw [List.getElem_ofFn, List.getElem_map, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem this]; rfl
lemma f_bit (k : ℕ) : EF.testBit k = f (fun v : Fin 8 => (rawP.getD v.val 0).testBit k) := by
  simp only [f, EF, Nat.testBit_or, Nat.testBit_and]
  rfl
theorem bridge (D : PEqualNP.CircuitLowerBounds.Circuit) (hD : PEqualNP.MetaComplexity.FanInTwo D)
    (hf : ∀ y : Fin 8 → Bool, D.eval (List.ofFn y) = f y) :
    Sol Z0 (mz 0) (tz 0) D.size (C (mz 0) (WZ [] 0)) := by
  obtain ⟨gates, out⟩ := D
  let row : ℕ → Fin 8 → Bool := fun k v => (rawP.getD v.val 0).testBit k
  let init : List ℕ := rawP.map (· &&& mz 0)
  have hinit_sub : ∀ x ∈ init, x &&& mz 0 = x := by
    intro x hx
    simp only [init, List.mem_map] at hx
    obtain ⟨w, _, rfl⟩ := hx
    rw [Nat.and_assoc, Nat.and_self]
  have hinit_mem : ∀ x ∈ init, x ∈ C (mz 0) (WZ [] 0) := by
    intro x hx
    simp only [init, List.mem_map] at hx
    obtain ⟨w, hw, rfl⟩ := hx
    exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
  have hinit_bits : ∀ k, (mz 0).testBit k = true → init.map (fun x => x.testBit k) = List.ofFn (row k) := by
    intro k hk
    simp only [init, List.map_map, Function.comp_def, Nat.testBit_and, hk, Bool.and_true]
    rw [row_list]
  have hout : (ex (mz 0) gates init).getD out 0 = tz 0 := by
    rw [← EF_ok]
    have hsub : ∀ x ∈ ex (mz 0) gates init, x &&& mz 0 = x := ex_sub (mz 0) hinit_sub
    have hsub' := getD_mem (S := {x | x &&& mz 0 = x}) hsub (by simp) out
    apply Nat.eq_of_testBit_eq; intro k
    have e1 := congrArg (fun x => x.testBit k) hsub'
    simp only [Nat.testBit_and] at e1
    rw [← e1, Nat.testBit_and]
    cases hk : (mz 0).testBit k with
    | false => simp
    | true =>
      simp only [Bool.and_true]
      rw [← getD_map, ex_bit (mz 0) hk gates init hD, hinit_bits k hk]
      have h := hf (row k)
      change (gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
        (List.ofFn (row k))).getD out false = f (row k) at h
      rw [h]
      exact (f_bit k).symm
  exact ex_sol (mz 0) gates init (C (mz 0) (WZ [] 0))
    hinit_mem (Or.inr (Set.mem_insert _ _)) (Or.inr (Set.mem_insert_of_mem _ rfl))
    hD ⟨out, hout⟩
theorem fanInTwo_of {gates : List Gate} {o : ℕ}
    (h : ∀ g ∈ gates, (g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧ g.inputs.length ≤ 2) :
    FanInTwo ⟨gates, o⟩ := by
  intro g hg; obtain ⟨ho, hl⟩ := h g hg
  exact ⟨by simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using ho, hl⟩

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
def GateBudget (m T b n : ℕ) (S : Set ℕ) : Prop :=
  ∃ k t : ℕ, k ≤ b + t ∧ t ≤ n ∧ ∃ V : Finset ℕ, (V : Set ℕ) ⊆ S ∧ Live Z0 m T k t V

lemma GateBudget.mono {m T b n S S'} {b' n' : ℕ} (h : GateBudget m T b n S)
    (hb : b ≤ b') (hn : n ≤ n') (hs : S ⊆ S') : GateBudget m T b' n' S' := by
  obtain ⟨k,t,hk,ht,V,hV,hl⟩ := h
  exact ⟨k,t,by omega,by omega,V,hV.trans hs,hl⟩

lemma GateBudget.bi {m T b n S x y d} (hx : x ∈ S) (hy : y ∈ S)
    (h : GateBudget m T b n (insert (op d x y) S)) : GateBudget m T (b+1) n S := by
  obtain ⟨k,t,hk,ht,V,hV,hl⟩ := h
  by_cases hxy : x = y
  · subst y
    rw [op_self] at hV
    exact ⟨k,t,by omega,ht,V,fun v hv => (hV hv).elim (fun e => e ▸ hx) id,hl⟩
  by_cases used : op d x y ∈ V
  · refine ⟨k+1,t,by omega,ht,insert x (insert y (V.erase (op d x y))), ?_, .bi hxy (al0 _ _ _) (by rwa [Finset.insert_erase used])⟩
    intro v hv
    simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe, Finset.mem_erase] at hv
    rcases hv with rfl | rfl | ⟨hne,hu⟩
    · exact hx
    · exact hy
    · exact (hV hu).resolve_left hne
  · exact ⟨k,t,by omega,ht,V,fun v hv => (hV hv).resolve_left (fun e => used (e ▸ hv)),hl⟩

lemma GateBudget.un {m T b n S x} (hx : x ∈ S)
    (h : GateBudget m T b n (insert (x ^^^ m) S)) : GateBudget m T b (n+1) S := by
  obtain ⟨k,t,hk,ht,V,hV,hl⟩ := h
  by_cases used : x ^^^ m ∈ V
  · refine ⟨k+1,t+1,by omega,by omega,insert x (V.erase (x ^^^ m)), ?_, .un (by rwa [Finset.insert_erase used])⟩
    intro v hv
    simp only [Finset.coe_insert, Set.mem_insert_iff, Finset.mem_coe, Finset.mem_erase] at hv
    rcases hv with rfl | ⟨hne,hu⟩
    · exact hx
    · exact (hV hu).resolve_left hne
  · exact ⟨k,t,hk,by omega,V,fun v hv => (hV hv).resolve_left (fun e => used (e ▸ hv)),hl⟩

def isNeg (g : Gate) : Bool := match g.op with
  | .not => true
  | _ => false

lemma isNeg_true (g : Gate) : isNeg g = true ↔ g.op = GateOp.not := by
  rcases g with ⟨op,ins⟩
  cases op <;> simp [isNeg]

def binCount (gs : List Gate) := gs.countP fun g => !isNeg g
def negCount (gs : List Gate) := gs.countP isNeg

lemma gate_total (gs : List Gate) : binCount gs + negCount gs = gs.length := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    cases hh : isNeg g <;> simp [binCount, negCount, List.countP_cons, hh] at * <;> omega

def UniqueNeg (gs : List Gate) : Prop :=
  ∀ i j : Fin gs.length, (gs.get i).op = GateOp.not → (gs.get j).op = GateOp.not → i = j

lemma neg_unique {gs : List Gate} (hu : UniqueNeg gs) : negCount gs ≤ 1 := by
  induction gs with
  | nil => decide
  | cons g gs ih =>
    have tail : UniqueNeg gs := fun i j hi hj => Fin.succ_inj.mp (hu i.succ j.succ hi hj)
    by_cases hg : isNeg g = true
    · have none (a : Gate) (ha : a ∈ gs) : ¬ isNeg a = true := by
        obtain ⟨i,hi,rfl⟩ := List.getElem_of_mem ha
        intro h
        have ha : gs[i].op = GateOp.not := (isNeg_true _).mp h
        have he := hu 0 (⟨i,hi⟩ : Fin gs.length).succ ((isNeg_true _).mp hg) ha
        have := congrArg Fin.val he
        simp at this
      have hz := List.countP_eq_zero.mpr none
      simp [negCount, List.countP_cons, hg, hz]
    · have := ih tail
      simpa [negCount, List.countP_cons, hg] using this

lemma neg_present {gs : List Gate} (h : ∃ g ∈ gs, g.op = GateOp.not) : 1 ≤ negCount gs := by
  obtain ⟨g,hg,hn⟩ := h
  by_contra! h0
  have hz : gs.countP isNeg = 0 := by change negCount gs = 0; omega
  exact List.countP_eq_zero.mp hz g hg ((isNeg_true _).mpr hn)
lemma ex_budget (m : ℕ) {T : ℕ} (gs : List Gate) : ∀ (w : List ℕ) (S : Set ℕ), (∀ x ∈ w, x ∈ S) → 0 ∈ S → m ∈ S →
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2) →
    (∃ i, (ex m gs w).getD i 0 = T) → GateBudget m T (binCount gs) (negCount gs) S := by
  induction gs with
  | nil =>
    rintro w S hw h0 _ _ ⟨i, rfl⟩
    exact ⟨0,0,by simp [binCount],by simp, {w.getD i 0}, by simpa using getD_mem hw h0 i, .stop⟩
  | cons g gs ih =>
    intro w S hw h0 hm hg hT
    have hgs := fun x hx => hg x (List.mem_cons_of_mem _ hx)
    have rd := fun i => getD_mem hw h0 i
    have stay : gv m w g ∈ S → GateBudget m T (binCount gs) (negCount gs) S := fun h =>
      (ih (w ++ [gv m w g]) S (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact hw x hx
        · exact h) h0 hm hgs hT)
    have go : GateBudget m T (binCount gs) (negCount gs) (insert (gv m w g) S) := ih (w ++ [gv m w g]) _ (fun x hx => by
        simp only [List.mem_append, List.mem_singleton] at hx
        rcases hx with hx | rfl
        · exact Or.inr (hw x hx)
        · exact Or.inl rfl) (Or.inr h0) (Or.inr hm) hgs hT
    obtain ⟨hop, hlen⟩ := hg g List.mem_cons_self
    obtain ⟨o, l⟩ := g
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
    rcases hop with rfl | rfl | rfl
    · simp [binCount, negCount, List.countP_cons, isNeg]
      match l with
      | [] => exact (stay hm).mono (by simpa [binCount, isNeg] using Nat.le_succ (binCount gs)) le_rfl subset_rfl
      | [i] => exact (stay (rd i)).mono (by simpa [binCount, isNeg] using Nat.le_succ (binCount gs)) le_rfl subset_rfl
      | i :: j :: _ => exact GateBudget.bi (d := false) (rd i) (rd j) go
    · simp [binCount, negCount, List.countP_cons, isNeg]
      match l with
      | [] => exact (stay h0).mono (by simpa [binCount, isNeg] using Nat.le_succ (binCount gs)) le_rfl subset_rfl
      | [i] => exact (stay (rd i)).mono (by simpa [binCount, isNeg] using Nat.le_succ (binCount gs)) le_rfl subset_rfl
      | i :: j :: _ => exact GateBudget.bi (d := true) (rd i) (rd j) go
    · simp only [binCount, negCount, List.countP_cons, isNeg, beq_self_eq_true, Bool.not_true, Bool.false_eq_true, if_false, if_true]
      match l with
      | [] => exact (stay hm).mono le_rfl (by simp [negCount]) subset_rfl
      | i :: _ => exact GateBudget.un (rd i) go
theorem bridge_budget (gates : List Gate) (o : ℕ) (hD : FanInTwo ⟨gates, o⟩)
    (hf : ∀ y : Fin 8 → Bool, Circuit.eval ⟨gates, o⟩ (List.ofFn y) = f y) :
    GateBudget (mz 0) (tz 0) (binCount gates) (negCount gates) (C (mz 0) (WZ [] 0)) := by
  let row : ℕ → Fin 8 → Bool := fun k v => (rawP.getD v.val 0).testBit k
  let init : List ℕ := rawP.map (· &&& mz 0)
  have hinit_sub : ∀ x ∈ init, x &&& mz 0 = x := by intro x hx; simp only [init, List.mem_map] at hx; obtain ⟨w, _, rfl⟩ := hx; rw [Nat.and_assoc, Nat.and_self]
  have hinit_mem : ∀ x ∈ init, x ∈ C (mz 0) (WZ [] 0) := by intro x hx; simp only [init, List.mem_map] at hx; obtain ⟨w, hw, rfl⟩ := hx; exact Or.inl ⟨w, by simp [rawL, hw], rfl⟩
  have hinit_bits : ∀ k, (mz 0).testBit k = true → init.map (fun x => x.testBit k) = List.ofFn (row k) := by intro k hk; simp only [init, List.map_map, Function.comp_def, Nat.testBit_and, hk, Bool.and_true]; rw [row_list]
  have hout : (ex (mz 0) gates init).getD o 0 = tz 0 := by
    rw [← EF_ok]
    have hsub : ∀ x ∈ ex (mz 0) gates init, x &&& mz 0 = x := ex_sub (mz 0) hinit_sub
    have hsub' := getD_mem (S := {x | x &&& mz 0 = x}) hsub (by simp) o
    apply Nat.eq_of_testBit_eq; intro k
    have e1 := congrArg (fun x => x.testBit k) hsub'
    simp only [Nat.testBit_and] at e1; rw [← e1, Nat.testBit_and]
    cases hk : (mz 0).testBit k with
    | false => simp
    | true =>
      simp only [Bool.and_true]; rw [← getD_map, ex_bit (mz 0) hk gates init hD, hinit_bits k hk]
      have h := hf (row k)
      change (gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (List.ofFn (row k))).getD o false = f (row k) at h
      rw [h]; exact (f_bit k).symm
  exact ex_budget (mz 0) gates init (C (mz 0) (WZ [] 0)) hinit_mem (Or.inr (Set.mem_insert _ _)) (Or.inr (Set.mem_insert_of_mem _ rfl)) hD ⟨o, hout⟩

def remainder (rs : List ℕ) : ℕ := FF ^^^ rs.foldr (fun i mask => (2 ^ i) ||| mask) 0
def bucketList (rs : List ℕ) : List (ℕ × ℕ) := (remainder rs, 1) :: rs.map (fun r => (2 ^ r,0))
lemma oneBucket {E Q : List (ℕ × ℕ)} {Z K t : ℕ} (h : chk E Q Z K t FF 1 = false) : ∃ M : List (ℕ × ℕ), mFull M = true ∧ ∀ p ∈ M, chk E Q Z K t p.1 p.2 = false :=
  ⟨[(FF, 1)], ffull, fun q hq => by simp only [List.mem_singleton] at hq; subst hq; exact h⟩

def routed (ps : List (ℕ × ℕ)) (mask a b : ℕ) : Prop :=
  b &&& mask = b ∧ ∀ p ∈ ps, a.testBit p.2 = b.testBit p.1

def routeMask (ps : List (ℕ × ℕ)) : ℕ :=
  ps.foldr (fun p b => (1 <<< p.1) ||| b) 0

lemma routeMask_mem (ps : List (ℕ × ℕ)) (i : ℕ)
    (hi : (routeMask ps).testBit i = true) : ∃ p ∈ ps, p.1 = i := by
  induction ps with
  | nil => simp [routeMask] at hi
  | cons p ps ih =>
    change (((1 <<< p.1) ||| routeMask ps : ℕ).testBit i = true) at hi
    rw [Nat.testBit_or, Bool.or_eq_true] at hi
    rcases hi with hp | hs
    · have e : p.1 = i := by simpa [Nat.one_shiftLeft, Nat.testBit_two_pow] using hp
      exact ⟨p, by simp, e⟩
    · obtain ⟨q,hq,e⟩ := ih hs
      exact ⟨q, List.mem_cons_of_mem _ hq,e⟩

lemma routed.unique {ps : List (ℕ × ℕ)} {m a b c : ℕ} (cover : routeMask ps = m)
    (hb : routed ps m a b) (hc : routed ps m a c) : b = c := by
  apply Nat.eq_of_testBit_eq
  intro i
  cases h : m.testBit i with
  | true =>
    obtain ⟨p,hp,e⟩ := routeMask_mem ps i (cover ▸ h)
    exact e ▸ ((hb.2 p hp).symm.trans (hc.2 p hp))
  | false =>
    have f (x : ℕ) (he : x &&& m = x) : x.testBit i = false := by
      have := congrArg (fun v : ℕ => v.testBit i) he
      simpa [Nat.testBit_and, h] using this.symm
    exact (f b hb.1).trans (f c hc.1).symm

lemma Sol.routed {ps : List (ℕ × ℕ)} {m n T V q : ℕ} {S : Set ℕ}
    (cover : routeMask ps = n) (hm : routed ps n m n) (hV : routed ps n T V)
    (run : Sol Z0 m T q S) {D : Set ℕ} (hD : ∀ a ∈ S, ∃ b ∈ D, routed ps n a b) :
    Sol Z0 n V q D := by
  induction run generalizing D with
  | done h =>
    obtain ⟨b,hb,hr⟩ := hD _ h
    exact .done ((hr.unique cover hV) ▸ hb)
  | @un q S a ha _ ih =>
    obtain ⟨b,hb,hr⟩ := hD _ ha
    apply Sol.un hb
    apply ih
    intro x hx
    rcases hx with rfl | hx
    · refine ⟨b ^^^ n, Or.inl rfl, ?_, ?_⟩
      · rw [and_neg (Nat.and_self n), hr.1]
      · intro p hp
        rw [Nat.testBit_xor, Nat.testBit_xor, hr.2 p hp, hm.2 p hp]
    · obtain ⟨y,hy,hr⟩ := hD x hx
      exact ⟨y,Or.inr hy,hr⟩
  | @bi q S d a a' ha ha' _ _ ih =>
    obtain ⟨b,hb,hr⟩ := hD _ ha
    obtain ⟨b',hb',hr'⟩ := hD _ ha'
    apply Sol.bi (d := d) hb hb' (al0 _ _ _)
    apply ih
    intro x hx
    rcases hx with rfl | hx
    · refine ⟨op d b b', Or.inl rfl, ?_, ?_⟩
      · rw [and_op, hr.1, hr'.1]
      · intro p hp
        rw [op_bit, op_bit, hr.2 p hp, hr'.2 p hp]
    · obtain ⟨y,hy,hr⟩ := hD x hx
      exact ⟨y,Or.inr hy,hr⟩

def maskRows (ps : List (ℕ × ℕ)) (m n : ℕ) : Bool :=
  ps.all fun p => m.testBit p.2 && n.testBit p.1

def agreeRows (ps : List (ℕ × ℕ)) (a b : ℕ) : Bool :=
  ps.all fun p => a.testBit p.2 == b.testBit p.1

lemma agreeRows_ok {ps a b} (h : agreeRows ps a b = true) : ∀ p ∈ ps, a.testBit p.2 = b.testBit p.1 :=
  fun p hp => beq_iff_eq.mp (List.all_eq_true.mp h p hp)

def inputRows (ps : List (ℕ × ℕ)) : Bool :=
  rawP.all fun a => rawP.any fun b => agreeRows ps a b

lemma transferBound {z d L : ℕ} (ps : List (ℕ × ℕ))
    (cover : routeMask ps = mz d) (hm : maskRows ps (mz z) (mz d) = true)
    (ht : agreeRows ps (tz z) (tz d) = true) (hw : inputRows ps = true)
    (low : Imp [] d L) : Imp [] z L := by
  intro q hq run
  have masks (p : ℕ × ℕ) (hp : p ∈ ps) : (mz z).testBit p.2 = true ∧ (mz d).testBit p.1 = true := by
    simpa only [Bool.and_eq_true] using (List.all_eq_true.mp hm p hp)
  have mr : routed ps (mz d) (mz z) (mz d) :=
    ⟨Nat.and_self _, fun p hp => (masks p hp).1.trans (masks p hp).2.symm⟩
  have tr : routed ps (mz d) (tz z) (tz d) := ⟨by simp [tz, Nat.and_assoc], agreeRows_ok ht⟩
  apply low q hq
  apply run.routed cover mr tr
  intro a ha
  rcases ha with ⟨w,hw',rfl⟩ | ha
  · have hwp : w ∈ rawP := by simpa [rawL] using hw'
    obtain ⟨v,hv,hagree⟩ := List.any_eq_true.mp (List.all_eq_true.mp hw w hwp)
    refine ⟨v &&& mz d, Or.inl ⟨v,by simpa [rawL] using hv,rfl⟩, by simp [Nat.and_assoc], ?_⟩
    intro p hp
    simp only [Nat.testBit_and, (masks p hp).1, (masks p hp).2, Bool.and_true]
    exact agreeRows_ok hagree p hp
  · rcases ha with ha | ha
    · change a = 0 at ha
      subst a
      exact ⟨0, Or.inr (Or.inl rfl), Nat.zero_and _, fun _ _ => by simp⟩
    · change a = mz z at ha
      subst a
      exact ⟨mz d, Or.inr (Or.inr rfl), mr⟩

def Chosen (M : List (ℕ × ℕ)) (a b : ℕ) : Prop := ∃ p ∈ M, hb p.1 (a + b) = true

def Selected (R : ℕ → ℕ) (M : List (ℕ × ℕ)) (m T k t : ℕ) (S : Finset ℕ) : Prop :=
  Live R m T k t S ∨ ∃ k0 d a b S1, k = k0 + 1 ∧ R a ≠ 0 ∧ R b ≠ 0 ∧ Bi Z0 d a b S S1 ∧ Live Z0 m T k0 t S1 ∧ Chosen M a b

section symSound
