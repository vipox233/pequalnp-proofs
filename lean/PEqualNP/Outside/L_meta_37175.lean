theorem grow {s t : ℕ} {f : (Fin 6 → Bool) → Bool} (hst : s ≤ t)
    (h : HasCircuitSize 6 f s) : HasCircuitSize 6 f t := by
  obtain ⟨C, hOK, hSize, hEval⟩ := h
  exact ⟨C, hOK, hSize.trans hst, hEval⟩

def table (t : ℕ) (x : Fin 6 → Bool) : Bool :=
  t.testBit (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)

def majority (x : Fin 3 → Bool) : Bool :=
  (x 0 && x 1) || (x 1 && x 2) || (x 0 && x 2)

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
theorem majoritySearch :
    TableSearch.reach 255 (fun t => t % 256 == 232) 3 [170, 204, 240] = false := by
  decide +kernel

theorem majorityLower : ¬HasCircuitSize 3 majority 3 := by
  refine TableSearch.lower_of_search 3 8 majority [170, 204, 240] 232 3 (by decide) ?_ majoritySearch
  have points : ∀ p, p < 8 →
      List.ofFn (fun i : Fin 3 => p.testBit i.val) = ([170, 204, 240] : List ℕ).map (fun t => t.testBit p) ∧
        majority (fun i => p.testBit i.val) = (232 : ℕ).testBit p := by decide +kernel
  exact fun p hp => ⟨(fun i => p.testBit i.val), points p hp⟩

