  have hv:2*M - 2=2*q:=by{omega};have h8:∑ v:Var,(a v:Q)*((n v:Q)/2)=(q:Q):=by{have:∑ v:Var,(a v:Q)*((n v:Q)/2)=((∑ v:Var,a v*n v:ℤ):Q)/2:=by{simp_rw[<-mul_div_assoc,div_eq_mul_inv,<-sum_mul];push_cast;rfl};rw[this,y,hv];push_cast;ring};linarith
lemma E8 (u:Line) (hu:inPLP u) (d:ℕ) (w:0<d) (o:∀ v,(d:ℤ) ∣ u.1 v) : 0<=Phi (fun v=>u.1 v/(d:ℤ),-((-u.2)/(d:ℤ))):=by{let a:Var->ℤ:=fun v=>u.1 v/(d:ℤ);obtain⟨x,h,k,h4⟩:=Fl a;have b:0<=evalQ x u:=hu x h k;have h5:(0:Q)<(d:Q):=by{exact_mod_cast w};have c:∑ v:Var,(u.1 v:Q)*x v=(d:Q)*∑ v:Var,(a v:Q)*x v:=by{rw[mul_sum];refine jy rfl fun v _=>?_;have q:(d:ℤ)*a v=u.1 v:=Int.mul_ediv_cancel' (o v);have l:(d:Q)*(a v:Q)=(u.1 v:Q):=by{exact_mod_cast q};rw[<-mul_assoc,l]};have e:(u.2:Q)<=(d:Q)*(((∑ v:Var,a v)/3:ℤ):Q):=by{unfold evalQ at b;rw[c]at b;nlinarith};have h3:u.2<=(d:ℤ)*((∑ v:Var,a v)/3):=by{exact_mod_cast e};have h0:-((-u.2)/(d:ℤ))<=(∑ v:Var,a v)/3:=by{have r:(0:ℤ)<d:=by{exact_mod_cast w};have n:(-((∑ v:Var,a v)/3))*(d:ℤ)<=-u.2:=by{linarith};have hq:=(Int.le_ediv_iff_mul_le r).mpr n;linarith};have y:=Int.emod_add_mul_ediv (∑ v:Var,a v) 3;have h1:0<=(∑ v:Var,a v) % 3:=Int.emod_nonneg _ (by omega);unfold Phi;change 0<=(∑ v:Var,a v) - 3*(-((-u.2)/(d:ℤ)));omega}
namespace CPGraph
section Weights
open scoped Classical
variable {I : Type} [Fintype I] [DecidableEq I] (G : CPGraph I)
def wk (y:I):ℕ:=
 match G.tag y,G.V y with
 | .div d,[u]=>((d:ℤ)*(G.qg y).2 - (G.qg u).2).toNat
 | _,_=>0
lemma Dl {y u:I} {d:ℕ} (n:G.tag y=.div d) (h:G.V y=[u]) : ((G.wk y:ℕ):ℤ)=(d:ℤ)*(G.qg y).2 - (G.qg u).2/\G.wk y<d:=by{have b:=G.sem y;rw[n,h]at b;simp only[Y,List.map_cons,List.map_nil]at b;have l:(G.qg y).2=-((-(G.qg u).2)/(d:ℤ)):=by{rw[b.2.2]};have o:(0:ℤ)<d:=by{omega};have q:=Int.emod_add_mul_ediv (-(G.qg u).2) (d:ℤ);have c:0<=(-(G.qg u).2) % (d:ℤ):=Int.emod_nonneg _ (by omega);have k:(-(G.qg u).2) % (d:ℤ)<(d:ℤ):=Int.emod_lt_of_pos _ o;have e:(d:ℤ)*(G.qg y).2 - (G.qg u).2=(-(G.qg u).2) % (d:ℤ):=by{rw[l];linarith};unfold wk;rw[n,h];simp only;rw[e];constructor;{exact Int.toNat_of_nonneg c};{omega}}
def By (y:I):Prop:=
 ∃ d u,G.tag y=.div d/\G.V y=[u]/\0<G.wk y
def qj (i:I):Prop:=
 ∃ y:I,G.By y/\G.Anc y i
lemma Dg {i j:I} (h:G.Anc i j) (c:G.qj i):G.qj j:=by{obtain⟨y,d,b⟩:=c;exact⟨y,d,h.trans b⟩}
lemma Eq {i:I} (r:¬G.qj i):inPLP (G.qg i):=by{let l:=univ.sup G.O;have n (p:I):G.O p<=l:=Finset.le_sup (y5 p);induction i using (measure (fun j=>l - G.O j)).wf.induction with|h i ih =>{have c (p:I) (hp:p∈G.V i):inPLP (G.qg p):=by{apply ih p;{change l - G.O p<l - G.O i;have lt:=G.earlier i p hp;have le:=n p;omega};{intro w;exact r (G.Dg (Relation.ReflTransGen.single hp) w)}};have b:=G.sem i;cases ht:G.tag i with|source =>{cases e:G.V i with|nil =>{rw[ht,e]at b;exact Gr (G.qg i) b}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}|add =>{cases e:G.V i with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons q rest =>{cases rest with|nil =>{rw[ht,e]at b;simp only[Y,List.map_cons,List.map_nil]at b;rw[b];exact G3 (c p (by simp[e])) (c q (by simp[e]))}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}}|mul k =>{cases e:G.V i with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil =>{rw[ht,e]at b;simp only[Y,List.map_cons,List.map_nil]at b;rw[b.2];exact G2 (c p (by simp[e])) k}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}|div d =>{cases e:G.V i with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil =>{rw[ht,e]at b;simp only[Y,List.map_cons,List.map_nil]at b;have o:G.wk i=0:=by{by_contra v;exact r ⟨i,⟨d,p,ht,e,jk v⟩,Relation.ReflTransGen.refl⟩};have⟨hspec,_⟩:=G.Dl ht e;rw[o]at hspec;simp only[Nat.cast_zero]at hspec;have u:(d:ℤ) ∣ (G.qg p).2:=⟨(G.qg i).2,by linarith⟩;rw[b.2.2];exact F9 (c p (by simp[e])) d (by omega) b.2.1 u}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}}}
def qt (j i:I):Q:=
 match G.tag j,G.V j with
 | .add,[p,q]=>(if i=p then (1:Q) else 0)+(if i=q then (1:Q) else 0)
 | .mul k,[p]=>if i=p then (k:Q) else 0
 | .div d,[p]=>if i=p then (1:Q)/(d:Q) else 0
 | _,_=>0
lemma w3 (j i:I):0<=G.qt j i:=by
 unfold qt
 cases G.tag j<;>rcases G.V j with _|⟨p,_|⟨q,_|_⟩⟩<;>simp only
 all_goals try positivity
 all_goals split_ifs<;>positivity
lemma A9 {j i:I} (h:i∈G.V j):0<G.qt j i:=by{have b:=G.sem j;unfold qt;cases ht:G.tag j with|source =>{cases e:G.V j with|nil=>{rw[e]at h;simp at h}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}|add =>{cases e:G.V j with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons q rest =>{cases rest with|nil =>{rw[e]at h;simp only[List.mem_cons,List.not_mem_nil,or_false]at h;rcases h with rfl|rfl;{simp only[ite_true];split_ifs<;>norm_num};{simp only[ite_true];split_ifs<;>norm_num}}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}}|mul k =>{cases e:G.V j with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil =>{rw[ht,e]at b;simp only[Y,List.map_cons,List.map_nil]at b;rw[e]at h;have c:i=p:=List.mem_singleton.mp h;subst c;simp only[ite_true];have l:(0:Q)<k:=by{exact_mod_cast (show 0<k by omega)};exact l}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}|div d =>{cases e:G.V j with|nil=>{rw[ht,e]at b;simp[Y]at b}|cons p tail =>{cases tail with|nil =>{rw[ht,e]at b;simp only[Y,List.map_cons,List.map_nil]at b;rw[e]at h;have c:i=p:=List.mem_singleton.mp h;subst c;simp only[ite_true];have n:(0:Q)<d:=by{exact_mod_cast (show 0<d by omega)};positivity}|cons _ _=>{rw[ht,e]at b;simp[Y]at b}}}}
lemma v9 {j i:I} (h:i∉G.V j) : G.qt j i=0:=by{unfold qt;cases G.tag j<;>cases e:G.V j with|nil=>{rfl}|cons p tail =>{cases tail with|nil =>{have b:i≠p:=fun heq=>h (by simp[e,heq]);simp[b]}|cons q rest =>{cases rest with|nil =>{have b:i≠p:=fun heq=>h (by simp[e,heq]);have c:i≠q:=fun heq=>h (by simp[e,heq]);simp[b,c]}|cons _ _=>{rfl}}}}
noncomputable def W:I->Q:=
 WellFounded.fix (measure G.O).wf fun i rec =>
  (if i=G.J then (1:Q) else 0) +
   ∑ j:I,if h:i∈G.V j then G.qt j i*rec j (G.earlier j i h) else 0
lemma F5 (i:I) : G.W i=(if i=G.J then (1:Q) else 0)+∑ j:I,G.qt j i*G.W j:=by
 conv_lhs=>unfold W;rw[WellFounded.fix_eq]
 congr 1;refine jy rfl fun j _=>?_;by_cases h:i∈G.V j;{simp[h,W]};{simp[h,G.v9 h]}
lemma G7:G.W G.J=1:=by{rw[G.F5];simp only[ite_true];have c:∑ j:I,G.qt j G.J*G.W j=0:=by{apply jv;intro j _;have b:G.J∉G.V j:=fun hm=>by{have:=G.vc hm;rw[G.qy]at this;omega};rw[G.v9 b,zero_mul]};linarith}
lemma vs (i:I):0<G.W i:=by{induction i using (measure G.O).wf.induction with|h i ih =>{by_cases c:i=G.J;{subst c;rw[G.G7];norm_num};{rcases (G.connected i).cases_tail with eq|⟨j,_,b⟩;{exact (c eq).elim};{have d:0<G.W j:=ih j (G.earlier j i b);have n:0<G.qt j i*G.W j := mul_pos (G.A9 b) d;have e:∀ k∈(univ:Finset I),0<=G.qt k i*G.W k:=by{intro k _;by_cases l:i∈G.V k;{exact jm (mul_pos (G.A9 l) (ih k (G.earlier k i l)))};{rw[G.v9 l,zero_mul]}};have o:=jx e (y5 j);rw[G.F5,jt c,zero_add];linarith}}}}
lemma G6 {a b:I} (h:G.Smooth a b):G.W a=G.W b:=by{have o:a≠G.J:=by{rintro rfl;have:=h.1;rw[G.qy]at this;omega};rw[G.F5,jt o,zero_add];rw[j1 b];{obtain⟨p,q,d⟩:=List.length_eq_two.mp h.2.1;have c:=G.sem b;cases ht:G.tag b with|source=>{rw[ht,d]at c;simp[Y]at c}|mul _=>{rw[ht,d]at c;simp[Y]at c}|div _=>{rw[ht,d]at c;simp[Y]at c}|add =>{have e:=h.2.2;rw[d]at e;simp only[List.mem_cons,List.not_mem_nil,or_false]at e;have k:p≠q:=by{rintro rfl;have l:=G.Bt b p;rcases e with rfl|rfl<;>simp[d,h.1]at l};unfold qt;rw[ht,d];rcases e with rfl|rfl;{simp[k]};{simp[Ne.symm k]}}};{intro j _ r;have n:a∉G.V j:=fun hm=>r (G.wh h.1 hm h.2.2);rw[G.v9 n,zero_mul]};{simp}}
lemma Bj (i:I):G.W i=G.W (G.R i):=by{have c:∀ a b:I,G.Path a b->G.W a=G.W b:=by{intro a b d;induction d with|refl=>{rfl}|tail _ edge ih=>{exact ih.trans (G.G6 edge)}};exact c i (G.R i) (G.kv i)}
lemma Fv (f:Line->Q)
 (o:∀ e₁ e₂,f (e₁.1+e₂.1,e₁.2+e₂.2)=f e₁+f e₂)
 (n:∀(k:ℕ) e,f ((k:ℤ) • e.1,(k:ℤ)*e.2)=(k:Q)*f e) :
 f (G.qg G.J) =
  (∑ i∈G.qi 0,G.W i*f (G.qg i)) +
  (∑ j:I,match G.tag j,G.V j with
   | .div d,[u]=>G.W j*(f (G.qg j) - (1/(d:Q))*f (G.qg u))
   | _,_=>0):=by
 have v:∑ i:I,G.W i*f (G.qg i) = f (G.qg G.J)+∑ j:I,G.W j*(∑ i:I,G.qt j i*f (G.qg i)):=by
  conv_lhs =>
   arg 2;ext i
   rw[G.F5 i,add_mul,sum_mul]
  rw[yj];congr 1;{simp};{rw[sum_comm];refine jy rfl fun j _=>?_;rw[mul_sum];refine jy rfl fun i _=>by{ring}}
 have l (j:I) :
  G.W j*f (G.qg j) - G.W j*(∑ i:I,G.qt j i*f (G.qg i)) =
   (if (G.V j).length=0 then G.W j*f (G.qg j) else 0) +
   (match G.tag j,G.V j with
    | .div d,[u]=>G.W j*(f (G.qg j) - (1/(d:Q))*f (G.qg u))
    | _,_=>0):=by
  have b:=G.sem j
  cases ht:G.tag j with
  | source =>
   cases e:G.V j with
   | nil =>
    have r:∑ i:I,G.qt j i*f (G.qg i)=0:=
     jv fun i _=>by simp[qt,ht,e]
    simp[e,r,ht]
   | cons _ _=>rw[ht,e]at b;simp[Y]at b
  | add =>
   cases e:G.V j with
   | nil=>rw[ht,e]at b;simp[Y]at b
   | cons p tail =>
    cases tail with
    | nil=>rw[ht,e]at b;simp[Y]at b
    | cons q rest =>
     cases rest with
     | nil =>
      rw[ht,e]at b
      simp only[Y,List.map_cons,List.map_nil]at b
      have c:∑ i:I,G.qt j i*f (G.qg i)=f (G.qg p)+f (G.qg q):=by
       unfold qt
       simp only[ht,e,add_mul,yj,ite_mul,one_mul,zero_mul,
        sum_ite_eq',mem_univ,ite_true]
      rw[c,b,o]
      simp[e,ht]
     | cons _ _=>rw[ht,e]at b;simp[Y]at b
  | mul k =>
   cases e:G.V j with
   | nil=>rw[ht,e]at b;simp[Y]at b
   | cons p tail =>
    cases tail with
    | nil =>
     rw[ht,e]at b
     simp only[Y,List.map_cons,List.map_nil]at b
     have c:∑ i:I,G.qt j i*f (G.qg i)=(k:Q)*f (G.qg p):=by
      unfold qt
      simp only[ht,e,ite_mul,zero_mul,sum_ite_eq',mem_univ,ite_true]
     rw[c,b.2,n]
     simp[e,ht]
    | cons _ _=>rw[ht,e]at b;simp[Y]at b
  | div d =>
   cases e:G.V j with
   | nil=>rw[ht,e]at b;simp[Y]at b
   | cons p tail =>
    cases tail with
    | nil =>
     have c:∑ i:I,G.qt j i*f (G.qg i)=(1/(d:Q))*f (G.qg p):=by
      unfold qt
      simp only[ht,e,ite_mul,zero_mul,sum_ite_eq',mem_univ,ite_true]
     rw[c]
     simp[e,ht,mul_sub]
    | cons _ _=>rw[ht,e]at b;simp[Y]at b
