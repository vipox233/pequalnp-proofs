lemma Fd (v:Var) : ∑ i∈G.qi 0,G.W i*((G.qg i).1 v:Q)=0:=by
 have q:=G.Fv (fun e=>(e.1 v:Q)) (fun e₁ e₂=>by simp) (fun k e=>by simp);have c:((G.qg G.J).1 v:Q)=0:=by{rw[G.line_root];simp}
 have h:∑ j:I,(match G.tag j,G.V j with
  | .div d,[u]=>G.W j*(((G.qg j).1 v:Q) - (1/(d:Q))*((G.qg u).1 v:Q))
  | _,_=>0)=0:=by
  apply jv
  intro j _
  cases ht':G.tag j with
  | source=>rfl
  | add=>rfl
  | mul _=>rfl
  | div d =>
   cases e:G.V j with
   | nil=>rfl
   | cons u tail =>
    cases tail with
    | nil =>
     have b:=G.sem j
     rw[ht',e]at b
     simp only[Y,List.map_cons,List.map_nil]at b
     have o:(d:Q)≠0:=by exact_mod_cast (show d≠0 by omega)
     have n:(d:ℤ)*((G.qg u).1 v/(d:ℤ))=(G.qg u).1 v:=
      Int.mul_ediv_cancel' (b.2.1 v)
     have r:(d:Q)*(((G.qg j).1 v:ℤ):Q)=((G.qg u).1 v:Q):=by
      rw[b.2.2];exact_mod_cast n
     have l:((G.qg j).1 v:Q) - 1/(d:Q)*((G.qg u).1 v:Q)=0:=by
      field_simp[o];linarith
     dsimp only
     rw[l,mul_zero]
    | cons _ _=>rfl
 rw[c,h,add_zero]at q;exact q.symm
noncomputable def edgeWeight2 (j i:I):Q:=
 match G.tag j,G.V j with
 | .div d,[u]=>if G.qj u then G.qt j i else 0
 | _,_=>G.qt j i
lemma Bw (j i:I):0<=G.edgeWeight2 j i:=by{unfold edgeWeight2;cases G.tag j with|div d =>{rcases G.V j with _|⟨u,_|_⟩;{exact G.w3 j i};{dsimp only;split_ifs;{exact G.w3 j i};{exact le_rfl}};{exact G.w3 j i}}|_=>{exact G.w3 j i}}
lemma Gf (j i:I):G.edgeWeight2 j i<=G.qt j i:=by{unfold edgeWeight2;cases G.tag j with|div d =>{rcases G.V j with _|⟨u,_|_⟩;{exact le_rfl};{dsimp only;split_ifs;{exact le_rfl};{exact G.w3 j i}};{exact le_rfl}}|_=>{exact le_rfl}}
lemma kf {j i:I} (h:i∉G.V j) : G.edgeWeight2 j i=0:=by{have c:=G.Bw j i;have b:=G.Gf j i;rw[G.v9 h]at b;linarith}
noncomputable def W2:I->Q:=
 WellFounded.fix (measure G.O).wf fun i rec =>
  (if i=G.J then (1:Q) else 0) +
   ∑ j:I,if h:i∈G.V j then G.edgeWeight2 j i*rec j (G.earlier j i h) else 0
lemma Ga (i:I) : G.W2 i=(if i=G.J then (1:Q) else 0)+∑ j:I,G.edgeWeight2 j i*G.W2 j:=by
 conv_lhs=>unfold W2;rw[WellFounded.fix_eq]
 congr 1;refine jy rfl fun j _=>?_;by_cases h:i∈G.V j;{simp[h,W2]};{simp[h,G.kf h]}
lemma kq (i:I):0<=G.W2 i:=by{induction i using (measure G.O).wf.induction with|h i ih =>{rw[G.Ga];have c:0<=(if i=G.J then (1:Q) else 0):=by{split_ifs<;>norm_num};have b:0<=∑ j:I,G.edgeWeight2 j i*G.W2 j:=by{refine ju fun j _=>?_;by_cases h:i∈G.V j;{exact mul_nonneg (G.Bw j i) (ih j (G.earlier j i h))};{rw[G.kf h,zero_mul]}};linarith}}
lemma Bk {i:I} (h:G.qj i):G.W2 i=G.W i:=by{induction i using (measure G.O).wf.induction with|h i ih =>{rw[G.Ga,G.F5];congr 1;refine jy rfl fun j _=>?_;by_cases b:i∈G.V j;{have n:G.qj j:=G.Dg (Relation.ReflTransGen.single b) h;have l:G.W2 j=G.W j:=ih j (G.earlier j i b) n;have k:G.edgeWeight2 j i=G.qt j i:=by{unfold edgeWeight2;cases ht:G.tag j with|div d =>{cases e:G.V j with|nil=>{rfl}|cons u tail =>{cases tail with|nil =>{rw[e]at b;have c:i=u:=List.mem_singleton.mp b;subst c;simp[h]}|cons _ _=>{rfl}}}|_=>{rfl}};rw[k,l]};{rw[G.kf b,G.v9 b,zero_mul,zero_mul]}}}
