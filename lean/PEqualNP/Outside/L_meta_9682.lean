def cntMod3 (f:Var->ℤ) (h:Hole) (r:ℤ):ℕ:=
 (List.finRange 4).countP fun p:qe=>f (p,h) == r
def inRecoverMod3 (f:Var->ℤ) (e:qf):Bool:=
 let h:=e.1
 let a:=qv e
 let b:=qs e
 let n1:=cntMod3 f h 1
 let n2:=cntMod3 f h 2
 if n1 == 3 then f (a,h) == 1 && f (b,h) == 1
 else if n2 == 3 then f (a,h) == 0 || f (b,h) == 0
 else if n1 == 1 then (f (a,h) == 1 && f (b,h) == 2) || (f (b,h) == 1 && f (a,h) == 2)
 else f (a,h) == 2 && f (b,h) == 2
