lemma Fj : ∀ e1 e2:qf,e1≠e2->vk e1 e2=false -> ∀ e:qf, inRecoverMod3 (fun v=>q7 {e1,e2} v % 3) e=decide (e=e1\/e=e2):=by{decide}
