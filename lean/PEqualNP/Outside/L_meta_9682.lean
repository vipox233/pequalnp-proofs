open scoped BigOperators
open PEqualNP.ProofComplexity PEqualNP.Search
abbrev qe:=Fin 4
abbrev Hole:=Fin 3
abbrev Var:=qe × Hole
abbrev Line:=CPLine Var
abbrev F43:Set (Clause Var):=PHP (3+1) 3
abbrev qr:=Fin 6
abbrev qf:=Hole × qr
abbrev Label:=qe ⊕ qf
def Gq (i:qe):Clause Var:=
 univ.image fun h:Hole=>((i,h),true)
def E9 (i j:qe) (h:Hole):Clause Var:=
 {((i,h),false),((j,h),false)}
def qo:qr->qe × qe:=
 ![(0,1),(0,2),(0,3),(1,2),(1,3),(2,3)]
def qv (e:qf):qe:=(qo e.2).1
def qs (e:qf):qe:=(qo e.2).2
def Ch:Label->Clause Var
 | .inl p=>Gq p
 | .inr e=>E9 (qv e) (qs e) e.1
def v6 (i:Label):Line:=clauseCP (Ch i)
def slack (a:Var->ℤ) (c:Line):ℤ:=(∑ v,c.1 v*a v) - c.2
def wm (a b:qr):Bool:=
 (qo a).1 == (qo b).1 || (qo a).1 == (qo b).2 ||
 (qo a).2 == (qo b).1 || (qo a).2 == (qo b).2
def vk (e f:qf):Bool:=
 if e.1 == f.1 then !(wm e.2 f.2) else wm e.2 f.2
def kt:Label->Label->Bool
 | .inl _,.inl _=>false
 | .inl _,.inr _=>true
 | .inr _,.inl _=>false
 | .inr e,.inr f=>vk e f
def kw (a:Var->ℤ) (i:Label):Prop:=
 (∀ v,a v=0\/a v=1)/\slack a (v6 i)=-1 /\
  ∀ j,j≠i->0<=slack a (v6 j)
lemma Cg:∀ e:qf,qv e≠qs e:=by{decide}
lemma Gd:∀ e f:qf, ((qv e=qv f/\qs e=qs f) \/ (qv e=qs f/\qs e=qv f))->e.2=f.2:=by{decide}
lemma Gi:∀ p q:qe,p≠q -> ∃ k:qr,qo k=(p,q)\/qo k=(q,p):=by{decide}
lemma k7 (C:Clause Var) (c:C∈F43) : ∃ i:Label,Ch i=C:=by
 rcases c with ⟨p,rfl⟩|⟨p,q,h,ne,rfl⟩;{exact⟨.inl p,rfl⟩}
 . obtain⟨k,b|b⟩:=Gi p q ne;{exact⟨.inr (h,k),by simp[Ch,qv,qs,b,E9]⟩}
   . exact⟨.inr (h,k),by
      simp[Ch,qv,qs,b,E9,pair_comm]⟩
lemma Ai:∀(i:qe) (v:Var), (v6 (.inl i)).1 v=(if v.1=i then 1 else 0) /\ (v6 (.inl i)).2=1:=by{decide}
lemma k9:∀(e:qf) (v:Var), (v6 (.inr e)).1 v = -((if v=(qv e,e.1) then 1 else 0) + (if v=(qs e,e.1) then 1 else 0)) /\ (v6 (.inr e)).2=-1:=by{decide}
def vz (skip:Option qe) (home:qe->Hole) (v:Var):ℤ:=
 if skip=some v.1 then 0 else if home v.1=v.2 then 1 else 0
lemma ky (skip:Option qe) (b:qe->Hole) (v:Var) : vz skip b v=0\/vz skip b v=1:=by
 unfold vz
 split<;>(try split)<;>simp
lemma Ep (skip:Option qe) (b:qe->Hole) (p:qe) : slack (vz skip b) (v6 (.inl p)) = if skip=some p then -1 else 0:=by{unfold slack;simp only[fun v=>(Ai p v).1,(Ai p (0,0)).2];rw[Fintype.sum_prod_type,j1 p];{simp only[js rfl,one_mul];by_cases h:skip=some p;{simp[vz,h]};{simp[vz,h,sum_ite_eq,eq_comm]}};{intro q _ c;simp[c]};{simp}}
lemma Ap (a:Var->ℤ) (e:qf) : slack a (v6 (.inr e))=1 - a (qv e,e.1) - a (qs e,e.1):=by{unfold slack;simp only[fun v=>(k9 e v).1,(k9 e (0,0)).2, neg_mul,add_mul,sum_neg_distrib,yj];simp only[ite_mul,one_mul,zero_mul,sum_ite_eq',mem_univ,if_true];ring}
def Bp (i:qe) (p:qe):Hole:=
 Fin.ofNat 3 (p.val - (if i.val<p.val then 1 else 0))
def collidingHome (e:qf) (p:qe):Hole:=
 if p=qv e\/p=qs e then e.1 else
  let t:=p.val - (if (qv e).val<p.val then 1 else 0) -
   (if (qs e).val<p.val then 1 else 0)
  Fin.ofNat 3 (t+(if e.1.val<=t then 1 else 0))
lemma Dr:∀ i p q:qe,p≠i->q≠i -> Bp i p=Bp i q->p=q:=by{decide}
lemma Au:∀ e:qf,∀ p:qe, collidingHome e p=e.1↔p=qv e\/p=qs e:=by{decide}
lemma Cz:∀ e:qf,∀ p q:qe,p≠q -> collidingHome e p=collidingHome e q -> (p=qv e/\q=qs e)\/(p=qs e/\q=qv e):=by{decide}
lemma missingSlack (i:qe) (r:Hole ≃ Hole) : kw (vz (some i) (r ∘ Bp i)) (.inl i):=by
 refine⟨ky _ _,by simp[Ep],?_⟩;rintro (p|e) different;{have u:p≠i:=fun eq=>different (congrArg Sum.inl eq);simp[Ep,Ne.symm u]}
 . rw[Ap];let b:=r ∘ Bp i;have v:=ky (some i) b (qv e,e.1);have q:=ky (some i) b (qs e,e.1);change 0<=1 - vz (some i) b (qv e,e.1) - vz (some i) b (qs e,e.1)
   rcases v with l|l<;>rcases q with n|n<;>rw[l,n]<;>try omega
   exfalso;have d:qv e≠i/\b (qv e)=e.1:=by{by_cases h:i=qv e;{simp[vz,h]at l};{refine⟨Ne.symm h,?_⟩;by_contra o;simp[vz,h,o]at l}};have c:qs e≠i/\b (qs e)=e.1:=by{by_cases k:i=qs e;{simp[vz,k]at n};{refine⟨Ne.symm k,?_⟩;by_contra o;simp[vz,k,o]at n}};exact Cg e (Dr i _ _ d.1 c.1 (r.injective (d.2.trans c.2.symm)))
lemma collidingSlack (e:qf) (r:Hole ≃ Hole) (fix:r e.1=e.1) : kw (vz none (r ∘ collidingHome e)) (.inr e):=by
 let b:=r ∘ collidingHome e;have d:b (qv e)=e.1:=by{simp[b,(Au e _).2 (Or.inl rfl),fix]};have l:b (qs e)=e.1:=by{simp[b,(Au e _).2 (Or.inr rfl),fix]};refine⟨ky _ _,?_,?_⟩;{rw[Ap];have o:r (collidingHome e (qv e))=e.1:=d;have n:r (collidingHome e (qs e))=e.1:=l;simp[vz,o,n]}
 . rintro (i|f) different;{simp[Ep]}
   . rw[Ap];change 0<=1 - vz none b (qv f,f.1) - vz none b (qs f,f.1);have b1:=ky none b (qv f,f.1);have b2:=ky none b (qs f,f.1)
     rcases b1 with w|w<;>rcases b2 with h2|h2<;>rw[w,h2]<;>try omega
     exfalso;have c:b (qv f)=f.1:=by{by_contra y;simp[vz,y]at w};have v:b (qs f)=f.1:=by{by_contra y;simp[vz,y]at h2};have k:=Cz e _ _ (Cg f) (r.injective (c.trans v.symm));have u:f.2=e.2:=Gd f e k;have q:f.1=e.1:=by{rcases k with ⟨h,_⟩|⟨h,_⟩;{rw[h,d]at c;exact c.symm};{rw[h,l]at c;exact c.symm}};exact different (congrArg Sum.inr (Prod.ext q u))
lemma D1 (i:Label):∃ a:Var->ℤ,kw a i:=by{cases i with|inl p=>{exact⟨_,missingSlack p (Equiv.refl Hole)⟩}|inr e=>{exact⟨_,collidingSlack e (Equiv.refl Hole) rfl⟩}}
lemma Gp:∀(i:qe) (e:qf),∃ p:qe, p≠i/\p≠qv e/\p≠qs e:=by{decide}
lemma Ct (i:qe) (e:qf) : ∃ a:Var->ℤ,kw a (.inl i)/\1<=slack a (v6 (.inr e)):=by{obtain⟨p,k,n,l⟩:=Gp i e;let r:=Equiv.swap (Bp i p) e.1;let b:=r ∘ Bp i;refine⟨vz (some i) b,missingSlack i r,?_⟩;have d:b p=e.1:=by{simp[b,r]};have c (q:qe) (hne:p≠q):vz (some i) b (q,e.1)=0:=by{by_cases h:q=i;{simp[vz,h]};{have hq':b q≠e.1:=fun eq => hne (Dr i _ _ k h (r.injective (d.trans eq.symm)));simp[vz,hq']}};rw[Ap,c _ n,c _ l];omega}
lemma E7:∀ e f:qf, e.1≠f.1->wm e.2 f.2=true -> ∃ p:qe,p≠qv e/\p≠qs e/\p≠qv f/\p≠qs f:=by{decide}
lemma Fn:∀ e f:qf, e.1=f.1->wm e.2 f.2=false -> qv f≠qv e/\qv f≠qs e /\ qs f≠qv e/\qs f≠qs e:=by{decide}
lemma D6 (e f:qf) (h:vk e f=true) : ∃ a:Var->ℤ,kw a (.inr e)/\1<=slack a (v6 (.inr f)):=by{by_cases b:e.1=f.1;{have n:wm e.2 f.2=false:=by{simp[vk,b]at h;exact h};obtain⟨w,lr,rl,rr⟩:=Fn e f b n;have y:collidingHome e (qv f)≠f.1:=by{rw[<-b];exact fun he=>((Au e _).1 he).elim w lr};have hR:collidingHome e (qs f)≠f.1:=by{rw[<-b];exact fun he=>((Au e _).1 he).elim rl rr};refine⟨vz none (collidingHome e),collidingSlack e (Equiv.refl Hole) rfl,?_⟩;simp[Ap,vz,y,hR]};{have k:wm e.2 f.2=true:=by{simp[vk,b]at h;exact h};obtain⟨p,le,v,lf,rf⟩:=E7 e f b k;let r:=Equiv.swap (collidingHome e p) f.1;let c:=r ∘ collidingHome e;have o:collidingHome e p≠e.1:=fun eq => ((Au e p).1 eq).elim le v;have u:r e.1=e.1:=Equiv.swap_apply_of_ne_of_ne (Ne.symm o) b;have l:c p=f.1:=by{simp[c,r]};refine⟨vz none c,collidingSlack e r u,?_⟩;have d (q:qe) (neq:p≠q):vz none c (q,f.1)=0:=by{have hq':c q≠f.1:=by{intro eq;exact (Cz e _ _ neq (r.injective (l.trans eq.symm))).elim (fun h=>le h.1) (fun h=>v h.1)};simp[vz,hq']};rw[Ap,d _ lf,d _ rf];omega}}
lemma Aw (i j:Label) (h:kt i j=true) : ∃ a:Var->ℤ,kw a i/\1<=slack a (v6 j):=by{cases i with|inl p =>{cases j with|inl q=>{simp[kt]at h}|inr e=>{exact Ct p e}}|inr e =>{cases j with|inl q=>{simp[kt]at h}|inr f=>{exact D6 e f h}}}
lemma A3:∀ e f:qf,vk e f=vk f e:=by{decide}
lemma Ex:Function.Injective v6:=by{intro i j eq;by_contra d;obtain⟨a,_,c,b⟩:=D1 i;have h:=b j (Ne.symm d);rw[<-eq,c]at h;omega}
def asBoolean (a:Var->ℤ) (v:Var):Bool:=decide (a v=1)
def IsCollClique (S:Finset qf):Prop:=
 ∀ e∈S,∀ f∈S,vk e f=false
def IsMaxCollClique (S:Finset qf):Prop:=
 IsCollClique S/\∀ f:qf,f∉S->∃ e∈S,vk e f=true
def qu (h:Hole) (miss:qe):Finset qf:=
 univ.filter fun e:qf=>e.1=h/\qv e≠miss/\qs e≠miss
def vm (h:Hole) (center:qe):Finset qf:=
 univ.filter fun e:qf=>e.1=h/\(qv e=center\/qs e=center)
lemma Ed:∀ e f:qf,e≠f->vk e f=false ->
 let common:=univ.filter fun g:qf =>
  vk g e=false/\vk g f=false
 (common.card<=2) \/
  (common.card=4/\∃ g∈common,∃ k∈common,vk g k=true):=by{decide}
lemma Bf (S:Finset qf) (b:IsCollClique S):S.card<=3:=by{by_contra! u;obtain⟨e,o,f,q,n⟩:=one_lt_card.1 (show 1<S.card by omega);have d:S⊆univ.filter (fun g:qf => vk g e=false/\vk g f=false):=by{intro g c;exact z7.2 ⟨y5 _,b g c e o,b g c f q⟩};rcases Ed e f n (b e o f q) with v|⟨w,g,c,k,r,l⟩;{have:=y6 d;omega};{have h:S=univ.filter (fun g:qf => vk g e=false/\vk g f=false) := jd d (by omega);have:=b g (h.symm ▸ c) k (h.symm ▸ r);rw[l]at this;exact Bool.noConfusion this}}
lemma De : ∀ e f g:qf,e≠f->e≠g->f≠g -> vk e f=false->vk e g=false->vk f g=false -> e.1=f.1/\e.1=g.1 /\ ((∃ m:qe,{e,f,g}=qu e.1 m) \/ (∃ c:qe,{e,f,g}=vm e.1 c)):=by{decide}
lemma kg (S:Finset qf) (l:IsCollClique S) (b:S.card=3) : ∃ h:Hole,∃ p:qe,S=qu h p\/S=vm h p:=by{rw[Finset.card_eq_three]at b;rcases b with ⟨e,f,g,q,n,o,rfl⟩;have w:=l e (by simp) f (by simp);have y:=l e (by simp) g (by simp);have u:=l f (by simp) g (by simp);obtain⟨_,_,k|d⟩:=De e f g q n o w y u;{obtain⟨m,r⟩:=k;exact⟨e.1,m,Or.inl r⟩};{obtain⟨c,v⟩:=d;exact⟨e.1,c,Or.inr v⟩}}
lemma Fw:∀ h:Hole,∀ m:qe,IsMaxCollClique (qu h m):=by{intro h m;have c:∀ e∈qu h m,∀ f∈qu h m,vk e f=false:=by{revert h m;decide};have b:∀ f:qf,f∉qu h m->∃ e∈qu h m,vk e f=true:=by{revert h m;decide};exact⟨c,b⟩}
lemma Gn:∀ h:Hole,∀ c:qe,IsMaxCollClique (vm h c):=by{intro h c;have d:∀ e∈vm h c,∀ f∈vm h c,vk e f=false:=by{revert h c;decide};have b:∀ f:qf,f∉vm h c->∃ e∈vm h c,vk e f=true:=by{revert h c;decide};exact⟨d,b⟩}
lemma Al (S:Finset qf) (c:IsCollClique S) (b:S.card=3) : IsMaxCollClique S:=by{obtain⟨h,p,rfl|rfl⟩:=kg S c b;{exact Fw h p};{exact Gn h p}}
def q7 (S:Finset qf) (v:Var):ℤ:=
 ∑ e∈S,(v6 (.inr e)).1 v
lemma Cb : ∀ e:qf,∃ v:Var,q7 {e} v=-1:=by{decide}
lemma Ca : ∀ e f:qf,e≠f->vk e f=false -> ∃ v:Var,q7 {e,f} v=-1:=by{decide}
lemma kj (S:Finset qf) (y:IsCollClique S) (h2:S.Nonempty) (d:ℕ) (hd:2<=d) (o:∀ v,(d:ℤ) ∣ q7 S v) : d=2/\∃ h:Hole,∃ m:qe,S=qu h m:=by{have h7:=Bf S y;have h5:1<=S.card:=zp h2;have b:¬∃ v,q7 S v=-1:=by{rintro ⟨v,w⟩;have r:=o v;rw[w]at r;rcases r with ⟨k,hk⟩;have:(d:ℤ)>=2:=by{exact_mod_cast hd};rcases le_or_gt k 0 with c|c;{rcases eq_or_lt_of_le c with rfl|q;{omega};{nlinarith}};{nlinarith}};interval_cases hc:S.card;{rw[card_eq_one]at hc;rcases hc with ⟨e,rfl⟩;exact (b (Cb e)).elim};{rw[card_eq_two]at hc;rcases hc with ⟨e,f,h3,rfl⟩;exact (b (Ca e f h3 (y e (by simp) f (by simp)))).elim};{obtain⟨h,p,rfl|rfl⟩:=kg S y hc;{have n:∀(h0:Hole) (p0:qe),∃ v:Var,q7 (qu h0 p0) v=-2:=by{decide};obtain⟨v,w⟩:=n h p;have u:=o v;rw[w]at u;rcases u with ⟨k,hk⟩;have h8:(2:ℤ)<=d:=by{exact_mod_cast hd};have h4:(d:ℤ)<=2:=by{rcases le_or_gt k 0 with c|c;{rcases eq_or_lt_of_le c with rfl|q;{omega};{nlinarith}};{nlinarith}};exact⟨by omega,h,p,rfl⟩};{exfalso;have l:∀(h0:Hole) (p0:qe),∃ v:Var,q7 (vm h0 p0) v=-1:=by{decide};exact b (l h p)}}}
def Ag (v:Var):Line:=(fun u=>if u=v then 1 else 0,0)
def Ah (v:Var):Line:=(fun u=>if u=v then -1 else 0,-1)
def wg:Line:=(0,0)
lemma F3 (C:Clause Var) (c:C∈F43):clauseCP C≠wg:=by{obtain⟨l,rfl⟩:=k7 C c;intro h;have b:=congrArg Prod.snd h;cases l with|inl p =>{have d:=(Ai p (0,0)).2;change (v6 (.inl p)).2=0 at b;omega}|inr e =>{have k:=(k9 e (0,0)).2;change (v6 (.inr e)).2=0 at b;omega}}
lemma Fx (v:Var):Ag v≠wg:=by{intro h;have b:=congrArg (fun x:Line=>x.1 v) h;simp[Ag,wg]at b}
lemma Fy (v:Var):Ah v≠wg:=by{intro h;have b:=congrArg Prod.snd h;simp[Ah,wg]at b}
lemma En {π:List Line} (h:IsCPDerivation F43 π) : ∃ n:List Line,IsCPDerivation F43 n /\ (∀ e∈π,e≠wg->e∈n)/\wg∉n/\n.length<=π.length:=by
 induction h with
 | nil=>exact⟨[],.nil,by simp,by simp,le_rfl⟩
 | @ax π C _ hC ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;refine⟨clauseCP C :: n,.ax C l hC,?_,?_,by simp;omega⟩;{intro e y c;rcases List.mem_cons.mp y with rfl|he';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b e he' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact F3 C hC o.symm};{exact q o}}
 | @boolLo π v _ ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;refine⟨Ag v :: n,.boolLo v l,?_,?_,by simp;omega⟩;{intro e y c;rcases List.mem_cons.mp y with rfl|he';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b e he' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact Fx v o.symm};{exact q o}}
 | @boolHi π v _ ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;refine⟨Ah v :: n,.boolHi v l,?_,?_,by simp;omega⟩;{intro e y c;rcases List.mem_cons.mp y with rfl|he';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b e he' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact Fy v o.symm};{exact q o}}
 | @add π e f _ y hf ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;by_cases h5:((e.1+f.1,e.2+f.2):Line)=wg;{refine⟨n,l,?_,q,by simp;omega⟩;intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact (c h5).elim};{exact b x hx' c}}
  . by_cases w:e=wg;{have h6:((e.1+f.1,e.2+f.2):Line)=f:=by{rcases e with ⟨e1,e2⟩;rcases f with ⟨f1,f2⟩;simp[wg]at w;rcases w with ⟨rfl,rfl⟩;simp};have h4:f≠wg:=h6 ▸ h5;refine⟨n,l,?_,q,by simp;omega⟩;intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact h6.symm ▸ b f hf h4};{exact b x hx' c}}
    . by_cases h4:f=wg;{have h6:((e.1+f.1,e.2+f.2):Line)=e:=by{rcases e with ⟨e1,e2⟩;rcases f with ⟨f1,f2⟩;simp[wg]at h4;rcases h4 with ⟨rfl,rfl⟩;simp};refine⟨n,l,?_,q,by simp;omega⟩;intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact h6.symm ▸ b e y w};{exact b x hx' c}}
      . refine⟨(e.1+f.1,e.2+f.2) :: n,
         .add l (b e y w) (b f hf h4),?_,?_,by simp;omega⟩
        {intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b x hx' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact h5 o.symm};{exact q o}}
 | @mul π e k _ y ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;by_cases r:(((k:ℤ) • e.1,(k:ℤ)*e.2):Line)=wg;{refine⟨n,l,?_,q,by simp;omega⟩;intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact (c r).elim};{exact b x hx' c}}
  . have w:e≠wg:=by{intro o;apply r;rcases e with ⟨e1,e2⟩;simp[wg]at o;rcases o with ⟨rfl,rfl⟩;simp[wg]}
    refine⟨((k:ℤ) • e.1,(k:ℤ)*e.2) :: n,
     .mul k l (b e y w),?_,?_,by simp;omega⟩
    {intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b x hx' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact r o.symm};{exact q o}}
 | @div π e d _ y hd hdiv ih =>
  obtain⟨n,l,b,q,h2⟩:=ih;by_cases r:((fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ))):Line)=wg;{refine⟨n,l,?_,q,by simp;omega⟩;intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact (c r).elim};{exact b x hx' c}}
  . have w:e≠wg:=by{intro o;apply r;rcases e with ⟨e1,e2⟩;simp[wg]at o;rcases o with ⟨rfl,rfl⟩;ext v<;>simp[wg]}
    refine⟨(fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ))) :: n,
     .div d l (b e y w) hd hdiv,?_,?_,by simp;omega⟩
    {intro x u c;rcases List.mem_cons.mp u with rfl|hx';{exact List.mem_cons_self ..};{exact List.mem_cons_of_mem _ (b x hx' c)}};{intro hz;rcases List.mem_cons.mp hz with o|o;{exact r o.symm};{exact q o}}
lemma F1 {w:List Line} (h:IsCPDerivation F43 w) : ∃ c:List Line,IsCPDerivation F43 c /\ (∀ e,e∈c↔e∈w)/\c.Nodup/\c.length<=w.length:=by
 induction h with
 | nil=>exact⟨[],.nil,by simp,List.nodup_nil,le_rfl⟩
 | @ax w C _ hC ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:clauseCP C∈c
  . exact⟨c,l,fun e=>⟨fun q=>List.mem_cons_of_mem _ ((b e).mp q),
     fun q=>by rcases List.mem_cons.mp q with rfl|he';exact o;exact (b e).mpr he'⟩,
     n,by simp;omega⟩
  . exact⟨clauseCP C :: c,.ax C l hC,
     fun e=>by simp[b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
 | @boolLo w v _ ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:Ag v∈c
  . exact⟨c,l,fun e=>⟨fun q=>List.mem_cons_of_mem _ ((b e).mp q),
     fun q=>by rcases List.mem_cons.mp q with rfl|he';exact o;exact (b e).mpr he'⟩,
     n,by simp;omega⟩
  . exact⟨Ag v :: c,.boolLo v l,
     fun e=>by simp[Ag,b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
 | @boolHi w v _ ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:Ah v∈c
  . exact⟨c,l,fun e=>⟨fun q=>List.mem_cons_of_mem _ ((b e).mp q),
     fun q=>by rcases List.mem_cons.mp q with rfl|he';exact o;exact (b e).mpr he'⟩,
     n,by simp;omega⟩
  . exact⟨Ah v :: c,.boolHi v l,
     fun e=>by simp[Ah,b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
 | @add w e f _ q hf ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:((e.1+f.1,e.2+f.2):Line)∈c
  . exact⟨c,l,fun x=>⟨fun r=>List.mem_cons_of_mem _ ((b x).mp r),
     fun r=>by rcases List.mem_cons.mp r with rfl|hx';exact o;exact (b x).mpr hx'⟩,
     n,by simp;omega⟩
  . exact⟨(e.1+f.1,e.2+f.2) :: c,.add l ((b e).mpr q) ((b f).mpr hf),
     fun x=>by simp[b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
 | @mul w e k _ q ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:(((k:ℤ) • e.1,(k:ℤ)*e.2):Line)∈c
  . exact⟨c,l,fun x=>⟨fun r=>List.mem_cons_of_mem _ ((b x).mp r),
     fun r=>by rcases List.mem_cons.mp r with rfl|hx';exact o;exact (b x).mpr hx'⟩,
     n,by simp;omega⟩
  . exact⟨((k:ℤ) • e.1,(k:ℤ)*e.2) :: c,.mul k l ((b e).mpr q),
     fun x=>by simp[b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
 | @div w e d _ q hd hdiv ih =>
  obtain⟨c,l,b,n,u⟩:=ih;by_cases o:((fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ))):Line)∈c
  . exact⟨c,l,fun x=>⟨fun r=>List.mem_cons_of_mem _ ((b x).mp r),
     fun r=>by rcases List.mem_cons.mp r with rfl|hx';exact o;exact (b x).mpr hx'⟩,
     n,by simp;omega⟩
  . exact⟨(fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ))) :: c,
     .div d l ((b e).mpr q) hd hdiv,
     fun x=>by simp[b],List.nodup_cons.mpr ⟨o,n⟩,by simp;omega⟩
lemma F2 {v:List Line} (c:IsCPRefutation F43 v) : ∃ π':List Line,IsCPRefutation F43 π'/\π'.Nodup/\wg∉π'/\π'.length<=v.length:=by{obtain⟨y,n,l,q,k⟩:=En c.1;obtain⟨u,d,b,o,e⟩:=F1 n;have r:((0:Var->ℤ),(1:ℤ))≠wg:=by{intro h;have:=congrArg Prod.snd h;simp[wg]at this};refine⟨u,⟨d,(b _).mpr (l _ c.2 r)⟩,o,?_,le_trans e k⟩;intro w;exact q ((b _).mp w)}
def Bm (π:List Line) (i:Fin π.length):Line:=π.get i
def Source (e:Line):Prop:=
 (∃ C∈F43,e=clauseCP C)\/(∃ v,e=Ag v)\/(∃ v,e=Ah v)
inductive E1
 | source
 | add
 | mul (k:ℕ)
 | div (d:ℕ)
 deriving DecidableEq
def Y (tag:E1) (e:Line) (parents:List Line):Prop:=
 match tag,parents with
 | .source,[]=>Source e
 | .add,[a,b]=>e=(a.1+b.1,a.2+b.2)
 | .mul k,[a]=>2<=k/\e=((k:ℤ) • a.1,(k:ℤ)*a.2)
 | .div d,[a]=>2<=d/\(∀ v,(d:ℤ) ∣ a.1 v) /\
  e=(fun v=>a.1 v/(d:ℤ),-((-a.2)/(d:ℤ)))
 | _,_=>False
structure Ac (π:List Line) where
 uses:Fin π.length->List (Fin π.length)
 tag:Fin π.length->E1
 later:∀ i j,j∈uses i->i.val<j.val
 sem:∀ i,Y (tag i) (Bm π i) ((uses i).map (Bm π))
def Ac.push {b:List Line} (r:Ac b) (e:Line) (t:E1)
 (parents:List (Fin b.length)) (d:Y t e (parents.map (Bm b))) :
 Ac (e :: b) where
 uses:=Fin.cases (parents.map Fin.succ) (fun i=>(r.uses i).map Fin.succ)
 tag:=Fin.cases t r.tag
 later:=by
  intro i
  refine Fin.cases ?_ ?_ i
  . intro j c
    change j∈parents.map Fin.succ at c
    obtain⟨k,_,rfl⟩:=y3.mp c
    exact Nat.zero_lt_succ k.val
  . intro i j c
    change j∈(r.uses i).map Fin.succ at c
    obtain⟨k,h,rfl⟩:=y3.mp c
    exact Nat.succ_lt_succ (r.later i k h)
 sem:=by
  intro i
  refine Fin.cases ?_ ?_ i
  . change Y t e ((parents.map Fin.succ).map (Bm (e :: b)))
    rw[List.map_map]
    exact d
  . intro i
    change Y (r.tag i) (Bm b i) (((r.uses i).map Fin.succ).map (Bm (e :: b)))
    rw[List.map_map]
    exact r.sem i
lemma Dx {b:List Line} (h:IsCPDerivation F43 b) (l:b.Nodup) (c:wg∉b):Nonempty (Ac b):=by{induction h with|nil =>{exact⟨⟨fun i=>Fin.elim0 i,fun i=>Fin.elim0 i, fun i=>Fin.elim0 i,fun i=>Fin.elim0 i⟩⟩}|@ax b C _ hC ih =>{have⟨hnot,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';exact⟨r.push (clauseCP C) .source [] (Or.inl ⟨C,hC,rfl⟩)⟩}|@boolLo b v _ ih =>{have⟨_,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';exact⟨r.push (Ag v) .source [] (Or.inr (Or.inl ⟨v,rfl⟩))⟩}|@boolHi b v _ ih =>{have⟨_,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';exact⟨r.push (Ah v) .source [] (Or.inr (Or.inr ⟨v,rfl⟩))⟩}|@add b e f _ he hf ih =>{have⟨_,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';obtain⟨i,n⟩:=List.mem_iff_get.mp he;obtain⟨j,hj⟩:=List.mem_iff_get.mp hf;refine⟨r.push (e.1+f.1,e.2+f.2) .add [i,j] ?_⟩;change (e.1+f.1,e.2+f.2)=((b.get i).1+(b.get j).1,(b.get i).2+(b.get j).2);rw[n,hj]}|@mul b e k _ he ih =>{have⟨hnot,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';obtain⟨i,n⟩:=List.mem_iff_get.mp he;have u:2<=k:=by{by_contra h3;have o:k=0\/k=1:=by{omega};rcases o with rfl|rfl;{apply c;have h0:(((0:ℕ):ℤ) • e.1,((0:ℕ):ℤ)*e.2)=wg:=by{ext v<;>simp[wg]};rw[<-h0];exact List.mem_cons_self ..};{apply hnot;have q:(((1:ℕ):ℤ) • e.1,((1:ℕ):ℤ)*e.2)=e:=by{rcases e with ⟨e1,e2⟩;simp};rw[q];exact he}};refine⟨r.push (((k:ℤ) • e.1),(k:ℤ)*e.2) (.mul k) [i] ?_⟩;change 2<=k/\(((k:ℤ) • e.1),(k:ℤ)*e.2)=((k:ℤ) • (b.get i).1,(k:ℤ)*(b.get i).2);rw[n];exact⟨u,rfl⟩}|@div b e d _ he hd hdiv ih =>{have⟨hnot,hnd'⟩:=List.nodup_cons.mp l;have hnz':wg∉b:=fun hm=>c (List.mem_cons_of_mem _ hm);obtain⟨r⟩:=ih hnd' hnz';obtain⟨i,n⟩:=List.mem_iff_get.mp he;have w:2<=d:=by{by_contra h5;have h2:d=1:=by{omega};subst h2;apply hnot;have q:((fun v=>e.1 v/((1:ℕ):ℤ),-((-e.2)/((1:ℕ):ℤ))):Line)=e:=by{rcases e with ⟨e1,e2⟩;simp};rw[q];exact he};refine⟨r.push ((fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ)))) (.div d) [i] ?_⟩;change 2<=d/\(∀ v,(d:ℤ) ∣ (b.get i).1 v) /\ ((fun v=>e.1 v/(d:ℤ),-((-e.2)/(d:ℤ))):Line) = (fun v=>(b.get i).1 v/(d:ℤ),-((-(b.get i).2)/(d:ℤ)));rw[n];exact⟨w,hdiv,rfl⟩}}
structure CPGraph (I:Type) [Fintype I] where
 O:I->ℕ
 J:I
 V:I->List I
 qg:I->Line
 tag:I->E1
 earlier:∀ i j,j∈V i->O i<O j
 Ci:∀ i,(V i).length<=2
 connected:∀ i,Relation.ReflTransGen (fun x y=>y∈V x) J i
 sem:∀ i,Y (tag i) (qg i) ((V i).map qg)
 line_inj:Function.Injective qg
 rank_inj:Function.Injective O
 line_root:qg J=(0,1)
namespace CPGraph
variable {I : Type} [Fintype I] [DecidableEq I] (G : CPGraph I)
def wa (i:I):ℕ:=∑ j:I,(G.V j).count i
def qi (n:ℕ):Finset I:=univ.filter fun i=>(G.V i).length=n
def Smooth (a b:I):Prop:=
 G.wa a=1/\(G.V b).length=2/\a∈G.V b
noncomputable def L:Finset I:=by
 classical
 exact univ.filter fun a=>¬∃ b,G.Smooth a b
lemma ka (a:I):a∈G.L↔¬∃ b,G.Smooth a b:=by
 classical
 simp[L]
lemma v7 {a b:I} (h:Relation.ReflTransGen (fun x y=>y∈G.V x) a b) : G.O a<=G.O b:=by{induction h with|refl=>{exact le_rfl}|tail _ edge ih=>{exact ih.trans (Nat.le_of_lt (G.earlier _ _ edge))}}
lemma qy:G.wa G.J=0:=by{apply jv;intro i _;apply List.count_eq_zero_of_not_mem;intro h;exact (Nat.not_lt_of_ge (G.v7 (G.connected i))) (G.earlier _ _ h)}
lemma vc {i j:I} (h:j∈G.V i):1<=G.wa j:=by{have b:=List.count_pos_iff.mpr h;exact (show 1<=(G.V i).count j by omega).trans (jx (f:=fun k=>(G.V k).count j) (fun _ _=>jl _) (y5 i))}
lemma Ao (i:I) (h:i≠G.J):1<=G.wa i:=by{rcases (G.connected i).cases_tail with eq|⟨j,_,edge⟩;{exact (h eq).elim};{exact G.vc edge}}
lemma Bt (i j:I):(G.V i).count j<=G.wa j:=
 jx (f:=fun k=>(G.V k).count j) (fun _ _=>jl _)
  (y5 i)
lemma wh {a b c:I} (one:G.wa a=1) (l:a∈G.V b) (n:a∈G.V c):b=c:=by{by_contra e;have h:=List.count_pos_iff.mpr l;have k:=List.count_pos_iff.mpr n;have d:(∑ i∈({b,c}:Finset I),(G.V i).count a)<=G.wa a := jw (subset_univ _);rw[sum_pair e,one]at d;omega}
lemma Ff {a b c:I} (hb:G.Smooth a b) (hc:G.Smooth a c):b=c:=
 G.wh hb.1 hb.2.2 hc.2.2
lemma Ck {a b:I} (h:G.Smooth a b):G.O b<G.O a:=
 G.earlier _ _ h.2.2
lemma sumCounts (s:List I):(∑ i:I,s.count i)=s.length:=by{induction s with|nil=>{simp}|cons a as ih =>{simp only[List.count_cons,List.length_cons];rw[yj,ih];simp[beq_iff_eq]}}
lemma Gz:(∑ i:I,G.wa i)=∑ i:I,(G.V i).length:=by{unfold wa;rw[sum_comm];simp only[sumCounts]}
def surplus:ℕ:=∑ i:I,(G.wa i - 1)
lemma Fi : (∑ i:I,G.wa i)+1=G.surplus+Fintype.card I:=by
 classical
 have d (i:I):G.wa i=(G.wa i - 1)+(if i=G.J then 0 else 1):=by{by_cases e:i=G.J;{subst i;simp[G.qy]};{simp only[jt e];have h:=G.Ao i e;omega}};have b:=sum_congr (s₁:=(univ:Finset I)) rfl (fun i _=>d i);rw[yj]at b;have c:(∑ i:I,if i=G.J then (0:ℕ) else 1)+1=Fintype.card I:=by{have k:(∑ i:I,if i=G.J then (0:ℕ) else 1) + (∑ i:I,if i=G.J then (1:ℕ) else 0)=Fintype.card I:=by{rw[<-yj];have l:∀ i:I,(if i=G.J then (0:ℕ) else 1) + (if i=G.J then (1:ℕ) else 0)=1:=fun i=>by{split_ifs<;>rfl};simp_rw[l];simp};have n:(∑ i:I,if i=G.J then (1:ℕ) else 0)=1:=by{simp};omega};unfold surplus;rw[b,Nat.add_assoc,c]
lemma G0 : (∑ i:I,(G.V i).length)=(G.qi 1).card+2*(G.qi 2).card:=by
 classical
 have c (i:I):(G.V i).length = (if (G.V i).length=1 then 1 else 0) + 2*(if (G.V i).length=2 then 1 else 0):=by{have h:=G.Ci i;interval_cases (G.V i).length<;>decide};have b:=sum_congr (s₁:=(univ:Finset I)) rfl (fun i _=>c i);rw[yj,<-mul_sum]at b;simpa only [qi,card_filter] using b
lemma Ee : Fintype.card I=(G.qi 0).card+(G.qi 1).card+(G.qi 2).card:=by
 classical
 have c (i:I):(1:ℕ) = (if (G.V i).length=0 then 1 else 0) + (if (G.V i).length=1 then 1 else 0) + (if (G.V i).length=2 then 1 else 0):=by{have h:=G.Ci i;interval_cases (G.V i).length<;>decide};have b:=sum_congr (s₁:=(univ:Finset I)) rfl (fun i _=>c i);rw[yj,yj]at b;have card:(∑ _:I,(1:ℕ))=Fintype.card I:=by{simp};rw[card]at b;simpa only [qi,card_filter] using b
def q9 (b:I):ℕ:=(univ.filter fun i=>G.V i=[b]).card
lemma Gc:(∑ b:I,G.q9 b)=(G.qi 1).card:=by
 classical
 unfold q9;simp_rw[card_filter];rw[sum_comm]
 rw[show (G.qi 1).card=∑ i:I,if (G.V i).length=1 then 1 else 0 by
  unfold qi;rw[card_filter]]
 refine jy rfl fun i _=>?_;by_cases c:(G.V i).length=1;{obtain⟨p,e⟩:=yz.mp c;simp[e]};{rw[jt c];apply jv;intro b _;have d:G.V i≠[b]:=fun heq=>c (by simp[heq]);simp[d]}
lemma Df {i:I} (h:i∉G.L) : G.wa i=1/\G.q9 i=0:=by
 classical
 have o:∃ b,G.Smooth i b:=by{by_contra e;exact h ((G.ka i).mpr e)};obtain⟨b,d,c,l⟩:=o;refine⟨d,?_⟩;unfold q9;rw[yo,filter_eq_empty_iff];intro j _ n;have k:i∈G.V j:=by{rw[n];simp};have q:=G.wh d k l;subst q;rw[n]at c;simp at c
lemma wd:G.J∈G.L:=by{apply (G.ka G.J).mpr;rintro ⟨i,b⟩;have h:=b.1;rw[G.qy]at h;omega}
lemma F8:G.q9 G.J=0:=by
 classical
 unfold q9;rw[yo,filter_eq_empty_iff];intro j _ c;have b:=G.vc (i:=j) (j:=G.J) (by simp[c]);rw[G.qy]at b;omega
lemma Aa {b:I} (q:b∈G.L) (d:b≠G.J) : 1<=G.q9 b+(G.wa b - 1):=by
 classical
 have u:=G.Ao b d;by_cases y:2<=G.wa b;{omega};{have r:G.wa b=1:=by{omega};rcases (G.connected b).cases_tail with eq|⟨j,_,used⟩;{exact (d eq).elim};{have n:(G.V j).length≠2:=fun two => (G.ka b).mp q ⟨j,r,two,used⟩;have h:G.V j≠[]:=List.ne_nil_of_mem used;have c:(G.V j).length=1:=by{have o:=G.Ci j;have v:=List.length_pos_iff.mpr h;omega};obtain⟨p,l⟩:=yz.mp c;have k:p=b:=by{rw[l]at used;exact (List.mem_singleton.mp used).symm};subst k;have e:j∈univ.filter fun i=>G.V i=[p] := za l;have w:1<=G.q9 p:=zp ⟨j,e⟩;omega}}
def vp (b:I):ℕ:=G.q9 b+(G.wa b - 1) - 1
noncomputable def vf:ℕ:=∑ b∈G.L.erase G.J,G.vp b
lemma v4 {u:I} (h:u∈G.L.erase G.J):G.vp u<=G.vf:=
 jx (fun _ _=>jl _) h
lemma Ez : 2*(G.qi 0).card+G.L.card+G.vf=Fintype.card I+2:=by
 classical
 have d:=G.Fi;rw[G.Gz,G.G0,G.Ee]at d;have k:G.surplus+(G.qi 1).card = ∑ i:I,(G.q9 i+(G.wa i - 1)):=by{unfold surplus;rw[<-G.Gc,Nat.add_comm,<-yj]}
 have n:∑ i:I,(G.q9 i+(G.wa i - 1)) = ∑ b∈G.L.erase G.J,(G.q9 b+(G.wa b - 1)):=by
  symm;refine jz (subset_univ _) fun i _ hi=>?_;by_cases h:i=G.J;{subst h;simp[G.qy,G.F8]};{have r:i∉G.L:=fun hb=>hi (ze ⟨h,hb⟩);obtain⟨w,y⟩:=G.Df r;omega}
 have e:∑ b∈G.L.erase G.J,(G.q9 b+(G.wa b - 1)) = (G.L.erase G.J).card+G.vf:=by{unfold vf vp;rw[show (G.L.erase G.J).card=∑ _∈G.L.erase G.J,(1:ℕ) by simp];rw[<-yj];refine jy rfl fun b hb=>?_;have o:=(zd hb).1;have q:=(zd hb).2;have v:=G.Aa q o;omega};have c:(G.L.erase G.J).card+1=G.L.card:=by{rw[jb G.wd];have u:1<=G.L.card:=zp ⟨G.J,G.wd⟩;omega};have l:=G.Ee;omega
end CPGraph
section Trim
open Relation
variable {π : List Line}
abbrev Reach (r:Ac π) (J:Fin π.length):=
 { i:Fin π.length // ReflTransGen (fun x y=>y∈r.uses x) J i }
noncomputable local instance reachFintype (r:Ac π) (J:Fin π.length) :
 Fintype (Reach r J):=Fintype.ofFinite _
def ku (r:Ac π) (J:Fin π.length) (i:Reach r J) :
 List (Reach r J):=
 (r.uses i.val).attach.map fun parent=>⟨parent.val,i.property.tail parent.property⟩
lemma Bc (r:Ac π) (J:Fin π.length) (i:Reach r J) : (ku r J i).map Subtype.val=r.uses i.val:=by{simp[ku,List.map_map,Function.comp_def]}
lemma D2 (r:Ac π) (J:Fin π.length) (i j:Reach r J) : j∈ku r J i↔j.val∈r.uses i.val:=by{constructor;{intro c;have b:=List.mem_map_of_mem (f:=Subtype.val) c;simpa only [Bc] using b};{intro c;refine y3.mpr ⟨⟨j.val,c⟩,by simp,Subtype.ext rfl⟩}}
lemma E2 (r:Ac π) (J:Fin π.length) (i:Reach r J) : (ku r J i).length=(r.uses i.val).length:=by{simpa only [List.length_map] using congrArg List.length (Bc r J i)}
lemma Fh {t:E1} {e:Line} {ps:List Line} (h:Y t e ps):ps.length<=2:=by
 cases t<;>rcases ps with _|⟨a,_|⟨b,_|⟨c,cs⟩⟩⟩<;>simp[Y]at h ⊢
lemma Gb (r:Ac π) (J:Fin π.length) {i:Fin π.length} (h:ReflTransGen (fun x y=>y∈r.uses x) J i) : ReflTransGen (fun x y=>y∈ku r J x) (⟨J,ReflTransGen.refl⟩:Reach r J) ⟨i,h⟩:=by{induction h with|refl=>{exact ReflTransGen.refl}|tail prior edge ih=>{exact ih.tail ((D2 _ _ _ _).mpr edge)}}
def Gv (r:Ac π) (J:Fin π.length)
 (d:π.Nodup) (b:Bm π J=(0,1)):CPGraph (Reach r J) where
 O i:=i.val.val
 J:=⟨J,ReflTransGen.refl⟩
 V:=ku r J
 qg i:=Bm π i.val
 tag i:=r.tag i.val
 earlier:=fun i j hj=>r.later i.val j.val ((D2 _ _ _ _).mp hj)
 Ci:=by
  intro i
  rw[E2]
  simpa only [List.length_map] using Fh (r.sem i.val)
 connected:=fun i=>Gb r J i.property
 sem:=by
  intro i
  have c:((ku r J i).map fun j=>Bm π j.val) =
   (r.uses i.val).map (Bm π):=by
   rw[show (ku r J i).map (fun j=>Bm π j.val) =
    ((ku r J i).map Subtype.val).map (Bm π) by rw[List.map_map];rfl,
    Bc]
  rw[c]
  exact r.sem i.val
 line_inj:=by
  intro i j e
  apply Subtype.ext
  exact (List.nodup_iff_injective_get.mp d) e
 rank_inj:=fun _ _ h=>Subtype.ext (Fin.ext h)
 line_root:=b
lemma Gm (r:Ac π) (J:Fin π.length) : Fintype.card (Reach r J)<=π.length:=by{simpa only [y4] using Fintype.card_le_of_injective (fun i:Reach r J=>i.val) Subtype.val_injective}
end Trim
namespace CPGraph
section Nuclear
open scoped Classical
variable {I : Type} [Fintype I] [DecidableEq I] (G : CPGraph I)
abbrev Path (a b:I):=Relation.ReflTransGen G.Smooth a b
abbrev Anc (a b:I):=Relation.ReflTransGen (fun x y=>y∈G.V x) b a
lemma F4 {a b:I} (h:G.Anc a b):G.O b<=G.O a:=
 G.v7 h
lemma Bb {a b:I} (h:G.Path a b):G.O b<=G.O a:=by{induction h with|refl=>{exact le_rfl}|tail _ edge ih=>{exact (Nat.le_of_lt (G.Ck edge)).trans ih}}
lemma Dy {a b c:I} (hb:G.Path a b) (hc:G.Path a c) :
 G.Path b c\/G.Path c b:=
 Relation.ReflTransGen.total_of_right_unique (fun _ _ _ hb hc=>G.Ff hb hc) hb hc
lemma B6 {a b:I} (d:a∈G.L) (p:G.Path a b):a=b:=by{rcases p.cases_head with h|⟨c,e,_⟩;{exact h};{exact ((G.ka a).mp d ⟨c,e⟩).elim}}
lemma Cy (a:I):∃ b∈G.L,G.Path a b:=by{induction a using (measure G.O).wf.induction with|h a ih =>{by_cases d:a∈G.L;{exact⟨a,d,.refl⟩};{obtain⟨b,k⟩:∃ b,G.Smooth a b:=by{by_contra! l;exact d ((G.ka a).mpr (fun ⟨b,k⟩=>l b k))};obtain⟨c,e,n⟩:=ih b (G.Ck k);exact⟨c,e,n.head k⟩}}}
noncomputable def R (a:I):I:=Classical.choose (G.Cy a)
lemma q5 (a:I):G.R a∈G.L:=
 (Classical.choose_spec (G.Cy a)).1
lemma kv (a:I):G.Path a (G.R a):=
 (Classical.choose_spec (G.Cy a)).2
lemma wo (a:I):G.O (G.R a)<=G.O a:=
 G.Bb (G.kv a)
lemma vt {a b:I} (e:b∈G.L) : G.Path a b↔G.R a=b:=by{constructor;{intro h;rcases G.Dy (G.kv a) h with c|d;{exact G.B6 (G.q5 a) c};{exact (G.B6 e d).symm}};{rintro rfl;exact G.kv a}}
lemma D5 {b:I} (hb:b∈G.L):G.R b=b:=
 (G.vt hb).mp .refl
lemma Cl {a b:I} (h:G.Path a b):G.R a=G.R b:=
 (G.vt (G.q5 b)).mp (h.trans (G.kv b))
lemma C3 {a u:I} (h:G.Anc a u) : G.Path a u\/G.Anc (G.R a) u:=by{induction h using Relation.ReflTransGen.head_induction_on with|refl=>{exact Or.inl .refl}|@head d c hedge hca ih =>{rcases ih with b|o;{by_cases l:c=G.R a;{subst l;exact Or.inr (Relation.ReflTransGen.single hedge)};{have v:c∉G.L:=by{intro q;exact l ((G.vt q).mp b).symm};obtain⟨e,k⟩:∃ e,G.Smooth c e:=by{by_contra! n;exact v ((G.ka c).mpr fun ⟨e,k⟩=>n e k)};have r:d=e:=G.wh k.1 hedge k.2.2;subst r;exact Or.inl (b.tail k)}};{exact Or.inr (Relation.ReflTransGen.head hedge o)}}}
lemma Bu {a b:I} (k:b∈G.L) (e:G.O (G.R a)<G.O b):¬G.Anc a b:=by{intro d;rcases G.C3 d with c|hanc';{have h:=(G.vt k).mp c;rw[h]at e;omega};{have l:=G.F4 hanc';omega}}
noncomputable def chip (a i:I):ℤ:=if G.Path a i then 1 else 0
lemma C9 {a i p q:I} (e:a≠i) (shape:G.V i=[p,q]) : G.Path a i↔(G.Path a p/\G.Smooth p i)\/(G.Path a q/\G.Smooth q i):=by{constructor;{intro reach;rcases reach.cases_tail with eq|⟨b,d,step⟩;{exact (e eq.symm).elim};{have c:=step.2.2;rw[shape]at c;simp only[List.mem_cons,List.not_mem_nil,or_false]at c;rcases c with rfl|rfl;{exact Or.inl ⟨d,step⟩};{exact Or.inr ⟨d,step⟩}}};{rintro (⟨reach,step⟩|⟨reach,step⟩)<;>exact reach.tail step}}
lemma Ae {a i p q:I} (shape:G.V i=[p,q]) (e:G.Path a p/\G.Smooth p i) (h:G.Path a q/\G.Smooth q i):False:=by
 have d:p≠q:=by{rintro rfl;have count:=G.Bt i p;simp[shape,e.2.1]at count}
 have b {x y:I} (xy:x≠y) (hx:G.Smooth x i) (hy:G.Smooth y i) (path:G.Path x y):False:=by
  rcases path.cases_head with k|⟨c,xToC,cToY⟩;{exact xy k};have k:=G.Ff hx xToC;subst c;exact (Nat.not_lt_of_ge (G.Bb cToY)) (G.Ck hy)
 rcases G.Dy e.1 h.1 with order|order;{exact b d e.2 h.2 order};{exact b (Ne.symm d) h.2 e.2 order}
lemma Aq {a i p q:I} (c:a≠i) (shape:G.V i=[p,q]) : G.chip a i=(if G.Smooth p i then G.chip a p else 0) + (if G.Smooth q i then G.chip a q else 0):=by
 have b:=G.C9 c shape
 by_cases d:G.Path a p<;>by_cases k:G.Path a q <;>
  by_cases h:G.Smooth p i<;>by_cases e:G.Smooth q i
 all_goals try exact (G.Ae shape ⟨d,h⟩ ⟨k,e⟩).elim
 all_goals simp[chip,b,d,k,h,e]
lemma vl {p i:I} (c:p∈G.V i) (bad:¬G.Smooth p i) : p∈G.L:=by{apply (G.ka p).mpr;rintro ⟨j,b⟩;have d:=G.wh b.1 c b.2.2;exact bad (d.symm ▸ b)}
lemma kh {u y:I} (h:G.V y=[u]):u∈G.L:=
 G.vl (by rw[h];simp) (fun hm=>by have:=hm.2.1;rw[h]at this;simp at this)
