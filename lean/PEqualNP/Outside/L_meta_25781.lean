namespace PEqualNP.Outside.L_meta_25781_aux.OneHotLow
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

private theorem masks_bounded : ∀ (D ws : List ℕ), (∀ x ∈ ws, x < 512) →
    Der 511 ws D → ∀ x ∈ D, x < 512 := by
  intro D
  induction D with
  | nil => intro ws _ _ x hx; simp at hx
  | cons d D ih =>
    intro ws hws hD x hx
    have hd : d < 512 := by
      rcases hD.1 with hd | rfl | ⟨a, ha, rfl⟩ | ⟨a, ha, b, hb, rfl | rfl⟩
      · rcases List.mem_cons.1 hd with rfl | hd
        · norm_num
        · exact hws d hd
      · norm_num
      · exact Nat.xor_lt_two_pow (n := 9) (hws a ha) (by norm_num)
      · exact Nat.and_lt_two_pow (n := 9) a (hws b hb)
      · exact Nat.or_lt_two_pow (n := 9) (hws a ha) (hws b hb)
    rcases List.mem_cons.1 hx with rfl | hx
    · exact hd
    · exact ih (d :: ws) (fun y hy => by
        rcases List.mem_cons.1 hy with rfl | hy
        · exact hd
        · exact hws y hy) hD.2 x hx

theorem canonical_derivation (m : Fin 512) (C : Circuit) (hfan : FanInTwo C)
    (hrep : Represents (matrix m) C) :
    ∃ D, Der 511 W0 D ∧ D.length = C.size ∧ (canon m ∈ 0 :: W0 ∨ canon m ∈ D) := by
  let l := layout m
  let w := rowInput l
  have wlen : ∀ r, (w r).length = 6 := by
    intro r
    simp [w, rowInput, oneEach]
  have hcov : Cov 9 W0 w := by
    intro i
    by_cases hi : i < 6
    · refine ⟨rootAt l ⟨i, hi⟩, (layout_pins l ⟨i, hi⟩).1, fun j hj => ?_⟩
      exact (layout_pins l ⟨i, hi⟩).2 ⟨j, hj⟩
    · refine ⟨0, List.mem_cons_self, fun j _ => ?_⟩
      rw [List.getD_eq_default _ _ (by rw [wlen]; omega)]
      simp
  have hM : ∀ j < 9, (511 : ℕ).testBit j = true := by decide +kernel
  obtain ⟨D, hD, hDl, t, ht, htv⟩ :=
    to_der 9 511 hM C.output C.gates W0 w 6 hfan (fun j _ => wlen j) hcov
  have equal_bits : ∀ j < 9, t.testBit j = (canon m).testBit j := by
    intro j hj
    rw [← htv j hj]
    exact (hrep (site l j).1 (site l j).2).trans (layout_target m ⟨j, hj⟩)
  have raw_bound : ∀ x ∈ 0 :: W0, x < 512 := by decide
  have ht512 : t < 2 ^ 9 := by
    rcases ht with h | h
    · exact raw_bound t h
    · exact masks_bounded D W0 (fun x hx => raw_bound x (List.mem_cons_of_mem _ hx)) hD t h
  have heq : t = canon m := by
    apply Nat.eq_of_testBit_eq
    intro j
    by_cases hj : j < 9
    · exact equal_bits j hj
    · have hp : 2 ^ 9 ≤ 2 ^ j := Nat.pow_le_pow_right (by norm_num) (by omega)
      rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le ht512 hp),
        Nat.testBit_lt_two_pow (lt_of_lt_of_le (canon_lt m) hp)]
  exact ⟨D, hD, hDl, by simpa only [heq] using ht⟩

end PEqualNP.Outside.L_meta_25781_aux.OneHotLow

