set_option maxHeartbeats 0 in
def rootAt (l : Fin 72) (i : Fin 6) : ℕ := (masks.getD l.val #[]).getD i.val 0
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
def rowInput (l : Fin 72) (j : ℕ) : List Bool := oneEach (site l j).1 (site l j).2

