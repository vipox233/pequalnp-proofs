theorem cases_checked : ∀ (m : Fin 512) (k : Fin 6),
    budget m ≤ k.val + 1 ∨
    bans.any (fun p => decide (p.1 = canon m ∧ k.val ≤ p.2)) = true := by
  decide +kernel

