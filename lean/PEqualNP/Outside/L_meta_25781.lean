def bans : List (ℕ × ℕ) := [(3, 0), (15, 0), (127, 0), (10, 1), (27, 1), (31, 1), (95, 1), (255, 1), (11, 2), (14, 2), (87, 2), (29, 3), (78, 3), (84, 3), (118, 3), (119, 3), (239, 3), (85, 4), (94, 5), (238, 5)]

