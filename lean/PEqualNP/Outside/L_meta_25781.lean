theorem certified_bans : ∀ b ∈ bans, Forbidden b.1 b.2 := by
  intro b hb
  simp only [bans, List.mem_cons, List.not_mem_nil, or_false] at hb
  rcases hb with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact forbid_3
  · exact forbid_15
  · exact forbid_127
  · exact forbid_10
  · exact forbid_27
  · exact forbid_31
  · exact forbid_95
  · exact forbid_255
  · exact forbid_11
  · exact forbid_14
  · exact forbid_87
