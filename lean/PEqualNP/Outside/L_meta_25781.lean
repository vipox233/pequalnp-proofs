set_option maxHeartbeats 0 in
theorem layout_target : ∀ (m : Fin 512) (j : Fin 9),
    matrix m (site (layout m) j.val).1 (site (layout m) j.val).2 = (canon m).testBit j.val := by
  decide +kernel

