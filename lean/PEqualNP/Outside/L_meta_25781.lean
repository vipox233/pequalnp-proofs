def canon (m : Fin 512) : ℕ := (orbitBank.getD m.val (0, 0, 0)).2.1
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
def budget (m : Fin 512) : ℕ := (orbitBank.getD m.val (0, 0, 0)).2.2
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
def site (l : Fin 72) (j : ℕ) : Fin 3 × Fin 3 := (sites.getD l.val #[]).getD j (0, 0)
