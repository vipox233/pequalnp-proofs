set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private def pick (m : Fin 512) : Circuit := bank.getD m.val ⟨[], 20⟩
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private def matrix (m : Fin 512) (u v : Fin 3) : Bool := m.val.testBit (3*u.val + v.val)
set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private def gateOK (g : Gate) : Bool :=
  match g.op with
  | .and | .or => decide (g.inputs.length ≤ 2)
  | _ => false

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private theorem gate_sound (g : Gate) (h : gateOK g = true) :
    g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2 := by
  rcases g with ⟨op, ins⟩
  cases op <;> simp_all [gateOK]

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private theorem bankChecked : ∀ m : Fin 512,
    (pick m).gates.all gateOK = true ∧ (pick m).size ≤ 7 ∧ Represents (matrix m) (pick m) := by
  decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private def encode (a b c d e f g h i : Bool) : Fin 512 :=
  Fin.ofNat 512 ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) + (if e then 16 else 0) + (if f then 32 else 0) + (if g then 64 else 0) + (if h then 128 else 0) + (if i then 256 else 0))

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
private theorem recover : ∀ a b c d e f g h i : Bool,
    let m := encode a b c d e f g h i
    matrix m 0 0 = a ∧
    matrix m 0 1 = b ∧
    matrix m 0 2 = c ∧
    matrix m 1 0 = d ∧
    matrix m 1 1 = e ∧
    matrix m 1 2 = f ∧
    matrix m 2 0 = g ∧
    matrix m 2 1 = h ∧
    matrix m 2 2 = i := by
  decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem three_mono_ceiling (A : Fin 3 → Fin 3 → Bool) : RepSizeAtMost A 7 := by
  let m := encode (A 0 0) (A 0 1) (A 0 2) (A 1 0) (A 1 1) (A 1 2) (A 2 0) (A 2 1) (A 2 2)
  obtain ⟨h00, h01, h02, h10, h11, h12, h20, h21, h22⟩ := recover (A 0 0) (A 0 1) (A 0 2) (A 1 0) (A 1 1) (A 1 2) (A 2 0) (A 2 1) (A 2 2)
  have agrees : matrix m = A := by
    funext u v
    fin_cases u <;> fin_cases v <;> first
      | exact h00
      | exact h01
      | exact h02
      | exact h10
      | exact h11
      | exact h12
      | exact h20
      | exact h21
      | exact h22
  rcases bankChecked m with ⟨operators, size, spec⟩
  refine ⟨pick m, ?_, size, ?_⟩
  · intro g hg
    exact gate_sound g (List.all_eq_true.mp operators g hg)
  · simpa only [agrees] using spec

set_option maxHeartbeats 0 in
set_option maxRecDepth 20000 in
theorem three_conversion_from_six (s : ℕ) (A : Fin 3 → Fin 3 → Bool) (hs : 6 ≤ s) :
    RepSizeAtMost A (s + (2*3-5)) := by
  rcases three_mono_ceiling A with ⟨C, hm, hsize, hrep⟩
  exact ⟨C, hm, by omega, hrep⟩

