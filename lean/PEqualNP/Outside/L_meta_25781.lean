theorem layout_pins : ∀ (l : Fin 72) (i : Fin 6),
    rootAt l i ∈ [0, 7, 56, 448, 73, 146, 292] ∧
    ∀ j : Fin 9, (rowInput l j.val).getD i.val false = (rootAt l i).testBit j.val := by
  decide +kernel

