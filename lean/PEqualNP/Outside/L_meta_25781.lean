  · exact forbid_238

theorem three_conversion_low (s : ℕ) (A : Fin 3 → Fin 3 → Bool) (C : Circuit)
    (hfan : FanInTwo C) (hsize : C.size ≤ s) (hsmall : s ≤ 5) (hrep : Represents A C) :
    RepSizeAtMost A (s + (2 * 3 - 5)) := by
  obtain ⟨m, hm⟩ := represented_by_mask A
  subst A
  rcases cases_checked m ⟨s, by omega⟩ with good | bad
  · rcases explicit_upper m with ⟨M, hm, hc, hr⟩
    exact ⟨M, hm, by change budget m ≤ s + 1 at good; omega, hr⟩
  · rcases List.any_eq_true.mp bad with ⟨b, hb, test⟩
    have hx : b.1 = canon m ∧ s ≤ b.2 := of_decide_eq_true test
    obtain ⟨D, hD, hlen, hv⟩ := canonical_derivation m C hfan hrep
    have no := certified_bans b hb D hD (hlen.le.trans (hsize.trans hx.2))
    rw [← hx.1] at hv
    exact False.elim (hv.elim no.1 no.2)

theorem three_conversion (s : ℕ) (A : Fin 3 → Fin 3 → Bool) (C : Circuit)
    (hfan : FanInTwo C) (hsize : C.size ≤ s) (hrep : Represents A C) :
    RepSizeAtMost A (s + (2 * 3 - 5)) := by
  by_cases h : s ≤ 5
  · exact three_conversion_low s A C hfan hsize h hrep
  · exact PEqualNP.Outside.L_meta_25781_aux.OneHotThree.three_conversion_from_six s A (by omega)

end PEqualNP.Outside.L_meta_25781_aux.OneHotLow
