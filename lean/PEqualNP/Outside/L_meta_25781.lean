private theorem bank_cost : ∀ m : Fin 512,
    (tableCircuit m).gates.all gateOK = true ∧ (tableCircuit m).size ≤ budget m ∧ Represents (matrix m) (tableCircuit m) := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem explicit_upper (m : Fin 512) : RepSizeAtMost (matrix m) (budget m) := by
  rcases bank_cost m with ⟨ops, cost, spec⟩
  exact ⟨tableCircuit m, fun g hg => gate_sound g (List.all_eq_true.mp ops g hg), cost, spec⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private def encode (a b c d e f g h i : Bool) : Fin 512 :=
  Fin.ofNat 512 ((if a then 1 else 0) + (if b then 2 else 0) + (if c then 4 else 0) + (if d then 8 else 0) + (if e then 16 else 0) + (if f then 32 else 0) + (if g then 64 else 0) + (if h then 128 else 0) + (if i then 256 else 0))

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
private theorem recover : ∀ a b c d e f g h i : Bool,
    let m := encode a b c d e f g h i
    matrix m 0 0 = a ∧
    matrix m 0 1 = b ∧
    matrix m 0 2 = c ∧
    matrix m 1 0 = d ∧
    matrix m 1 1 = e ∧
    matrix m 1 2 = f ∧
    matrix m 2 0 = g ∧
    matrix m 2 1 = h ∧
    matrix m 2 2 = i := by
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem represented_by_mask (A : Fin 3 → Fin 3 → Bool) : ∃ m : Fin 512, matrix m = A := by
  let m := encode (A 0 0) (A 0 1) (A 0 2) (A 1 0) (A 1 1) (A 1 2) (A 2 0) (A 2 1) (A 2 2)
  obtain ⟨h00, h01, h02, h10, h11, h12, h20, h21, h22⟩ := recover (A 0 0) (A 0 1) (A 0 2) (A 1 0) (A 1 1) (A 1 2) (A 2 0) (A 2 1) (A 2 2)
  have agrees : matrix m = A := by
    funext u v
    fin_cases u <;> fin_cases v <;> first
      | exact h00
      | exact h01
      | exact h02
      | exact h10
      | exact h11
      | exact h12
      | exact h20
      | exact h21
      | exact h22
  exact ⟨m, agrees⟩

