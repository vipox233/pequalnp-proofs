noncomputable def ex (T : List Nat) (nt fuel : Nat) : Nat → List Nat → List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat → List Nat) (fun _ rest => rest)
    (fun _ ih s rest =>
