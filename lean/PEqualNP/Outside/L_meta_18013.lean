lemma qV {x j:Nat}(hx:x<10)(hj:j<5):kB x j 0+10<=1940:=by unfold kB;omega
lemma qL {s e:Nat}(hs:s<2)(he:e<14):kQ s e 0+10<=1940:=by unfold kQ;omega
lemma CR {t:Nat}(ht:t<3):kV t 0+10<=1940:=by unfold kV;omega
