lemma vW (x j:Nat):kB x j 0 %10=0:=by unfold kB;omega
lemma uX (s e:Nat):kQ s e 0 %10=0:=by unfold kQ;omega
lemma yO {v a b x p}(hb:qE v a b)(h:gB a b x p=true):v x=p:=by unfold gB at h;simp only[bR,qU,BL] at h;split at h<;>rename_i c<;>[exact hb.1 x p (kd.mp c) (by simpa using h);exact hb.2 x p (by rw[kd,nL] at c;exact c) (by simpa using h)]
lemma uz {v a b x}(hb:qE v a b)(hx:x<1940)(hv:v x=true)(ht:a.testBit (Nat.mul 2 x)=true):False:=by have:=hb.1 x false hx (by simpa using ht);rw[hv] at this;cases this
lemma Ar {v a b x}(hb:qE v a b)(hx:x<1940)(hv:v x=false)(ht:a.testBit ((Nat.mul 2 x).add 1)=true):False:=by have:=hb.1 x true hx (by simpa using ht);rw[hv] at this;cases this
lemma xC {v a b x p}(hb:qE v a b)(hv:v x=p)(hg:gB a b x (!p)=true):False:=by have:=yO hb hg;rw[hv] at this;cases p<;>cases this
lemma Ch {v a b x p}(hb:qE v a b)(hv:v x=p):qE v (AP a b x p).1 (AP a b x p).2:=by unfold AP;simp only[bR,BL];split<;>rename_i c;{refine⟨fun y q hy h=>?_,hb.2⟩;simp only[wX,vH,xE,xD,tO,sL,oM,t2,sO,sD] at h;rcases h with h1|h2;{exact hb.1 y q hy h1};{have ex:x=y:=(by cases p<;>cases q<;>simp[Bool.toNat] at h2<;>omega);have ep:p=q:=(by cases p<;>cases q<;>simp[Bool.toNat] at h2 ⊢<;>omega);subst ex;subst ep;exact hv}};{refine⟨hb.1,fun y q hy h=>?_⟩;rw[kd,nL] at c;simp only[wX,vH,xE,xD,kP,tO,sL,oM,t2,sO,sD] at h;rcases h with h1|h2;{exact hb.2 y q hy h1};{have ex:x=y:=(by cases p<;>cases q<;>simp[Bool.toNat] at h2<;>omega);have ep:p=q:=(by cases p<;>cases q<;>simp[Bool.toNat] at h2 ⊢<;>omega);subst ex;subst ep;exact hv}}
lemma uV' {x:Nat}(h:x≠0):∃k,x.testBit k=true:=by by_contra hn;push Not at hn;apply h;apply Nat.eq_of_testBit_eq;intro k;simp[B5 (hn k)]
lemma uV {x:Nat}(h:!(x.beq 0)=true):∃k,x.testBit k=true:=by cases hx:x.beq 0;{exact uV' (qQ.mp hx)};{rw[hx] at h;cases h}
lemma wE {n k:Nat}(hl:n<2^20)(o0:¬k<20):n.testBit k=false:=Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hl (Nat.pow_le_pow_right (by omega) (by omega:20<=k)))
lemma Bq (k:Nat):zH.testBit k=decide (k<20):=by by_cases o0:k<20;{exact ((by decide +kernel:∀u:Fin 20,zH.testBit u.1=true) ⟨k,o0⟩).trans (by simp[o0])};{simp[o0,wE (by decide +kernel:zH<2^20) o0]}
lemma uq (k:Nat):ut.testBit k=decide (k<20/\k %2=0):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀u:Fin 20,ut.testBit u.1=decide (u.1 %2=0)) ⟨k,o0⟩};{simp[o0,wE (by decide +kernel:ut<2^20) o0]}
lemma uK (k:Nat):us.testBit k=decide (k<20/\k %2=1):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀u:Fin 20,us.testBit u.1=decide (u.1 %2=1)) ⟨k,o0⟩};{simp[o0,wE (by decide +kernel:us<2^20) o0]}
lemma BP (gi:Fin 4){c:Nat}(hc:c<16)(k:Nat):(B8 gi c).testBit k=(decide (k<20/\k %2=0)&&(yN gi c).testBit (k/2)):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀g:Fin 4,∀a:Fin 16,∀u:Fin 20,(B8 g a.1).testBit u.1=(decide (u.1 %2=0)&&(yN g a.1).testBit (u.1/2))) gi ⟨c,hc⟩ ⟨k,o0⟩};{simp[o0,wE ((by decide +kernel:∀g:Fin 4,∀a:Fin 16,B8 g a.1<2^20) gi ⟨c,hc⟩) o0]}
lemma CZ (gi:Fin 4){c:Nat}(hc:c<16)(k:Nat):(B7 gi c).testBit k=(decide (k<20/\k %2=1)&&(yN gi c).testBit (k/2)):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀g:Fin 4,∀a:Fin 16,∀u:Fin 20,(B7 g a.1).testBit u.1=(decide (u.1 %2=1)&&(yN g a.1).testBit (u.1/2))) gi ⟨c,hc⟩ ⟨k,o0⟩};{simp[o0,wE ((by decide +kernel:∀g:Fin 4,∀a:Fin 16,B7 g a.1<2^20) gi ⟨c,hc⟩) o0]}
lemma Cy (gi:Fin 4){i:Nat}(hi:i<10)(k:Nat):(BZ gi i).testBit k=(decide (k<20/\k %2=0)&&qR gi i (k/2)):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀g:Fin 4,∀a:Fin 10,∀u:Fin 20,(BZ g a.1).testBit u.1=(decide (u.1 %2=0)&&qR g a.1 (u.1/2))) gi ⟨i,hi⟩ ⟨k,o0⟩};{simp[o0,wE ((by decide +kernel:∀g:Fin 4,∀a:Fin 10,BZ g a.1<2^20) gi ⟨i,hi⟩) o0]}
lemma Bj (gi:Fin 4){i:Nat}(hi:i<10)(k:Nat):(BY gi i).testBit k=(decide (k<20/\k %2=1)&&qR gi i (k/2)):=by by_cases o0:k<20;{simpa[o0] using (by decide +kernel:∀g:Fin 4,∀a:Fin 10,∀u:Fin 20,(BY g a.1).testBit u.1=(decide (u.1 %2=1)&&qR g a.1 (u.1/2))) gi ⟨i,hi⟩ ⟨k,o0⟩};{simp[o0,wE ((by decide +kernel:∀g:Fin 4,∀a:Fin 10,BY g a.1<2^20) gi ⟨i,hi⟩) o0]}
lemma zM (a v k:Nat):(kY a v).testBit k=(decide (k<20)&&a.testBit (2*v+k)):=by unfold kY;simp only[vo,BX,xD,tA,tR,Bq,Bool.and_comm]
lemma qJ {a v k:Nat}(h:(kY a v).testBit k=true):k<20/\a.testBit (2*v+k)=true:=by simpa[zM,sA,sD] using h
lemma xR (b k:Nat):(xS b).testBit k=if k<20 then b.testBit (if k %2=0 then k+1 else k-1) else false:=by unfold xS;simp only[wX,vH,vo,BX,tO,tL,tA,tR,uq];by_cases o0:k<20;{simp only[o0,iT];by_cases hp:k %2=0;{simp[hp,Nat.add_comm 1 k];intro h1 _ h2 h3;omega};{have h1:k>=1:=(by omega);have h2:k-1<20/\(k-1) %2=0:=(by omega);simp[hp,h1,h2]}};{simp[o0];intro h1 _ h2;omega}
lemma qP {v a b u w}(hb:qE v a b)(hu:u+10<=1940)(hw:w+10<=1940)(he:∀y<10,v (u+y)=v (w+y))(hc:un a u w=true):False:=by unfold un at hc;simp only[bN] at hc;obtain⟨k,o0⟩:=uV hc;simp only[vo,tA,sA] at o0;obtain⟨yj,h1⟩:=qJ o0.1;simp only[xR,yj,iT] at o0;obtain⟨_,h2⟩:=qJ o0.2;let y:=k/2;have hy:y<10:=(by omega);by_cases hp:k %2=0;{simp only[hp,iT] at h2;have w1:=hb.1 (u+y) false (by omega) ((by simp[Bool.toNat,y];omega:2*u+k=2*(u+y)+false.toNat)▸h1);have w2:=hb.1 (w+y) true (by omega) ((by simp[Bool.toNat,y];omega:2*w+(k+1)=2*(w+y)+true.toNat)▸h2);have:=he y hy;rw[w1,w2] at this;cases this};{simp only[hp,iF] at h2;have w1:=hb.1 (u+y) true (by omega) ((by simp[Bool.toNat,y];omega:2*u+k=2*(u+y)+true.toNat)▸h1);have w2:=hb.1 (w+y) false (by omega) ((by simp[Bool.toNat,y];omega:2*w+(k-1)=2*(w+y)+false.toNat)▸h2);have:=he y hy;rw[w1,w2] at this;cases this}
lemma kD {c:Bool}{α}{Q:α->Prop}{e t:Option α}(h1:c=true->uk Q t)(h2:c=false->uk Q e):uk Q (c.rec e t):=by cases c<;>[exact h2 rfl;exact h1 rfl]
lemma kX {c:Bool}{α}{Q:α->Prop}{e t:Option α}(ht:c=true->uk Q t)(he:uk Q e):uk Q (if c=true then t else e):=Co ht λ _=>he
lemma uy {α β}{Q:α->Prop}{R:β->Prop}{o:Option α}{f:α->Option β}(ho:uk Q o)(hf:∀x,Q x->uk R (f x)):uk R (o.rec none f):=by cases o with|none=>exact⟨(λ _=>ho.1 rfl),fun _ e=>nomatch e⟩|some x=>exact hf x (ho.2 x rfl)
