lemma qW (x j y:Nat):kB x j 0+y=kB x j y:=by unfold kB;omega
lemma qN (s e y:Nat):kQ s e 0+y=kQ s e y:=by unfold kQ;omega
lemma CS (t y:Nat):kV t 0+y=kV t y:=by unfold kV;omega
