lemma vP {v a b u m}(hb:qE v a b)(hu:u+10<=1940)(hm20:∀k,20<=k->m.testBit k=false)(hmok:∀y<10,∀q:Bool,m.testBit (2*y+q.toNat)=true->v (u+y)=q):uk (λ a'=>qE v a' b) (xB a u m):=by refine kD (λ _=>uu ⟨fun x p hx ht=>?_,hb.2⟩) λ hc=>⟨fun _=>?_,fun _ e=>nomatch e⟩;{simp only[wX,vH,xD,tO,tL,sO,sA,sD] at ht;rcases ht with h1|⟨hge,h2⟩;{exact hb.1 x p hx h1};have hlt:2*x+p.toNat-2*u<20:=(by by_contra hg;rw[hm20 _ (by omega)] at h2;cases h2);have hxu:u<=x:=(by cases p<;>simp[Bool.toNat] at hge<;>omega);let y:=x-u;have hy:y<10:=(by cases p<;>simp[Bool.toNat] at hlt<;>omega);exact (by omega:u+y=x)▸hmok y hy p ((by cases p<;>simp[Bool.toNat,y]<;>omega:2*x+p.toNat-2*u=2*y+p.toNat)▸h2)};{obtain⟨k,o0⟩:=Bh hc;simp only[vo,tA,sA] at o0;obtain⟨yj,h1⟩:=qJ o0.1;simp only[xR,yj,iT] at o0;let y:=k/2;have hy:y<10:=(by omega);by_cases hp:k %2=0;{simp only[hp,iT] at o0;have w1:=hb.1 (u+y) false (by omega) ((by simp[Bool.toNat,y];omega:2*u+k=2*(u+y)+false.toNat)▸h1);have w2:=hmok y hy true ((by simp[Bool.toNat,y];omega:k+1=2*y+true.toNat)▸o0.2);rw[w1] at w2;cases w2};{simp only[hp,iF] at o0;have w1:=hb.1 (u+y) true (by omega) ((by simp[Bool.toNat,y];omega:2*u+k=2*(u+y)+true.toNat)▸h1);have w2:=hmok y hy false ((by simp[Bool.toNat,y];omega:k-1=2*y+false.toNat)▸o0.2);rw[w1] at w2;cases w2}}
lemma BO (m n a k:Nat):(xc m n a).testBit k=(a.testBit k||(decide (k<2*n/\k %2=0)&&m.testBit (k/2))):=by induction n generalizing a with| zero=>simp[xc]| succ n ih=>{unfold xc at ih ⊢;dsimp only;rw[ih];simp only[bR,qU];by_cases hm:m.testBit n=true;{simp only[hm,iT,wX,vH,xD,tO,sL,oM,t2];by_cases o0:k=2*n;{subst o0;simp[hm]};have he:decide (k<2*(n+1)/\k %2=0)=decide (k<2*n/\k %2=0):=(by simp only[decide_eq_decide];omega);have yd:decide (2*n=k)=false:=decide_eq_false (λ h=>o0 h.symm);simp[yd,he]};{simp only[hm];by_cases o0:k=2*n;{subst o0;simp[hm]};have he:decide (k<2*(n+1)/\k %2=0)=decide (k<2*n/\k %2=0):=(by simp only[decide_eq_decide];omega);simp[he]}}
