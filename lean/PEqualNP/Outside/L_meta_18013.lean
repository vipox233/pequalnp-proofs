lemma A7 {v b cs a d n}(hb:qE v a b)(y2:vK v cs):uk (λ p=>qE v p.1 b) (Ah cs a d n):=by induction cs generalizing a d n with|nil=>exact uu (Q:=λ p:Nat×Nat=>qE v p.1 b) hb|cons c r ih=>{rcases c with ⟨cm,bs⟩;have hc:=y2 (cm,bs) wK;have hr:vK v r:=λ q hq=>y2 q (vA _ hq);unfold Ah at ih ⊢;dsimp only;refine kD (λ _=>ih hb hr) λ _=>?_;have hu:∀k,(Am a bs 0).testBit k=true->k<20/\∀u∈bs,v (u+k/2)=decide (k %2=1):=(by intro k o0;rcases zP o0 with h0|⟨w,hw,hs⟩;{simp at h0};obtain⟨yj,ha⟩:=qJ hs;have hwc:=hc.1 w hw;refine⟨yj,fun u hu=>?_⟩;have hvw:=hb.1 (w+k/2) (decide (k %2=1)) (by omega) ((by by_cases hp:k %2=1<;>simp[hp,Bool.toNat]<;>omega:2*w+k=2*(w+k/2)+(decide (k %2=1)).toNat)▸ha);rw[hc.1 u hu |>.2.2 w hw (k/2) (by omega),hvw]);refine kD (λ _=>kD (λ _=>ih hb hr) λ _=>ih ⟨fun x q hx ht=>?_,hb.2⟩ hr) λ hcf=>⟨fun _=>?_,fun _ e=>nomatch e⟩;{simp only[wX,tO,sO] at ht;rcases ht with h0|hd;{exact hb.1 x q hx h0};rcases A4 hd with h0|⟨u,hu0,hge,hu1⟩;{simp at h0};obtain⟨yj,hv1⟩:=hu _ hu1;have huc:=hc.1 u hu0;have hxu:u<=x:=(by cases q<;>simp[Bool.toNat] at hge<;>omega);have h1:=hv1 u hu0;rwa[(by cases q<;>simp[Bool.toNat] at hge yj ⊢<;>omega:u+(2*x+q.toNat-2*u)/2=x),(by cases q<;>simp[Bool.toNat] at hge ⊢<;>omega:decide ((2*x+q.toNat-2*u) %2=1)=q)] at h1};{obtain⟨k,o0⟩:=Bh hcf;simp only[vo,tA,sA] at o0;rcases zP o0.1 with h0|⟨u0,hu0,_⟩;{simp at h0};obtain⟨yj,h1⟩:=hu k o0.1;simp only[xR,yj,iT] at o0;obtain⟨_,h2⟩:=hu _ o0.2;have v1:=h1 u0 hu0;have v2:=h2 u0 hu0;by_cases hp:k %2=0;{simp only[hp,iT] at v2;rw[(by omega:(k+1)/2=k/2),v1] at v2;have:(k+1) %2=1:=(by omega);simp[hp,this] at v2};{simp only[hp,iF] at v2;rw[(by omega:(k-1)/2=k/2),v1] at v2;have:k %2=1:=(by omega);have h0:(k-1) %2=0:=(by omega);simp[this,h0] at v2}}}
lemma Ca {v b ps a d n}(hb:qE v a b)(y0:wN v ps):uk (λ p=>qE v p.1 b) (Ag ps a d n):=by induction ps generalizing a d n with|nil=>exact uu (Q:=λ p:Nat×Nat=>qE v p.1 b) hb|cons p r ih=>{rcases p with ⟨u,w,m⟩;have hp:=y0 (u,w,m) wK;dsimp only at hp;have hr:wN v r:=λ q hq=>y0 q (vA _ hq);unfold Ag at ih ⊢;dsimp only;refine kD (λ _=>ih hb hr) λ _=>kD (λ _=>?_) λ hc=>⟨fun _=>?_,fun _ e=>nomatch e⟩;{have s1:qE v (a.lor (((kY a u).land us).shiftLeft (Nat.mul 2 w))) b:=⟨(λ x q hx ht=>by simp only[wX,vH,vo,xD,tO,tL,tA,uK,sO,sA,sD] at ht;rcases ht with h0|⟨hge,hs,h20,ho⟩;{exact hb.1 x q hx h0};have hq:q=true:=(by cases q;{simp[Bool.toNat] at hge ho;omega};rfl);subst hq;have hxw:w<=x:=(by simp[Bool.toNat] at hge;omega);let y:=x-w;have hy:y<10:=(by simp[Bool.toNat] at h20;omega);exact (by omega:w+y=x)▸hp.2.2 y hy (hb.1 (u+y) true (by omega) ((by simp[Bool.toNat,y];omega:2*u+(2*x+true.toNat-2*w)=2*(u+y)+true.toNat)▸(qJ hs).2))),hb.2⟩;have s2:∀a0,qE v a0 b->qE v (a0.lor (((kY a w).land ut).shiftLeft (Nat.mul 2 u))) b:=λ a0 ha0=>⟨(λ x q hx ht=>by simp only[wX,vH,vo,xD,tO,tL,tA,uq,sO,sA,sD] at ht;rcases ht with h0|⟨hge,hs,h20,he⟩;{exact ha0.1 x q hx h0};have hq:q=false:=(by cases q;rfl;{simp[Bool.toNat] at hge he;omega});subst hq;have hxu:u<=x:=(by simp[Bool.toNat] at hge;omega);let y:=x-u;have hy:y<10:=(by simp[Bool.toNat] at h20;omega);have w2:=hb.1 (w+y) false (by omega) ((by simp[Bool.toNat,y];omega:2*w+(2*x+false.toNat-2*u)=2*(w+y)+false.toNat)▸(qJ hs).2);cases hvx:v x;rfl;{have:=hp.2.2 y hy ((by omega:u+y=x).symm▸hvx);rw[w2] at this;cases this}),ha0.2⟩;have s12:qE v (a.lor ((((kY a u).land us).shiftLeft (Nat.mul 2 w)).lor (((kY a w).land ut).shiftLeft (Nat.mul 2 u)))) b:=(by have h':=s2 _ s1;rwa[show (a.lor (((kY a u).land us).shiftLeft (Nat.mul 2 w))).lor (((kY a w).land ut).shiftLeft (Nat.mul 2 u))=a.lor ((((kY a u).land us).shiftLeft (Nat.mul 2 w)).lor (((kY a w).land ut).shiftLeft (Nat.mul 2 u))) by simp only[wX,Nat.lor_assoc]] at h');exact kD (λ _=>kD (λ _=>ih s12 hr) λ _=>ih (s2 a hb) hr) λ _=>kD (λ _=>ih s1 hr) λ _=>ih hb hr};{obtain⟨k,o0⟩:=Bh hc;simp only[vo,vH,tA,tL,uK,uq,zM,sA,sD] at o0;obtain⟨⟨⟨yj,h1⟩,_,_⟩,hge1,⟨_,h2⟩,_,_⟩:=o0;let y:=k/2;have hy:y<10:=(by omega);have:=hp.2.2 y hy (hb.1 (u+y) true (by omega) ((by simp[Bool.toNat,y];omega:2*u+k=2*(u+y)+true.toNat)▸h1));rw[hb.1 (w+y) false (by omega) ((by simp[Bool.toNat,y];omega:2*w+(k-1)=2*(w+y)+false.toNat)▸h2)] at this;cases this}}
lemma Cb {v b cs em ps im f a d}(hb:qE v a b)(y2:vK v cs)(y0:wN v ps):uk (λ a'=>qE v a' b) (Ai cs em ps im f a d):=by induction f generalizing a d with|zero=>exact uu (Q:=λ a'=>qE v a' b) hb|succ f ih=>{unfold Ai at ih ⊢;dsimp only;exact uy (kD (λ _=>uu (Q:=λ p:Nat×Nat=>qE v p.1 b) hb) λ _=>A7 hb y2) λ p1 hp1=>kD (λ _=>uu (Q:=λ a'=>qE v a' b) hp1) λ _=>uy (Ca hp1 y0) λ p2 hp2=>kD (λ _=>uu (Q:=λ a'=>qE v a' b) hp2) λ _=>ih hp2}
