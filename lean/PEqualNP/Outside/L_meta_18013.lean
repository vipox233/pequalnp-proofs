lemma sA {a b:Bool}:((a&&b)=true)=(a=true/\b=true):=Bool.and_eq_true a b
lemma sO {a b:Bool}:((a||b)=true)=(a=true\/b=true):=Bool.or_eq_true a b
lemma sN {a:Bool}:((!a)=true)=(a=false):=Bool.not_eq_true' a
lemma sD {p:Prop}[Decidable p]:(decide p=true)=p:=decide_eq_true_eq
lemma tA {a b i:Nat}:(a&&&b).testBit i=(a.testBit i&&b.testBit i):=Nat.testBit_land a b i
lemma tO {a b i:Nat}:(a|||b).testBit i=(a.testBit i||b.testBit i):=Nat.testBit_lor a b i
lemma tX {a b i:Nat}:(a^^^b).testBit i=(a.testBit i^^b.testBit i):=Nat.testBit_xor a b i
lemma t2 {n i:Nat}:(2^n).testBit i=decide (n=i):=Nat.testBit_two_pow
lemma sL {a b:Nat}:a<<<b=a*2^b:=Nat.shiftLeft_eq a b
lemma oM {a:Nat}:1*a=a:=Nat.one_mul a
lemma nL {a b:Nat}:(¬a<b)↔b<=a:=Nat.not_lt
lemma mC {α}{a b:α}{l:List α}:(a∈b::l)↔(a=b\/a∈l):=List.mem_cons
lemma wK {α}{a:α}{l:List α}:a∈a::l:=List.mem_cons_self
lemma vA {α}{a:α}(b:α){l:List α}(h:a∈l):a∈b::l:=List.mem_cons_of_mem b h
lemma bF:(false=true)=False:=Bool.false_eq_true
lemma nF:(!false)=true:=Bool.not_false
lemma nT:(!true)=false:=Bool.not_true
lemma iT {α}(a b:α):(if True then a else b)=a:=ite_true a b
lemma iF {α}(a b:α):(if False then a else b)=b:=ite_false a b
lemma tL {a b i:Nat}:(a<<<b).testBit i=(decide (i>=b)&&a.testBit (i-b)):=Nat.testBit_shiftLeft a
lemma tR {a b i:Nat}:(a>>>b).testBit i=a.testBit (b+i):=Nat.testBit_shiftRight a
lemma lR {a n:Nat}:a∈List.range n↔a<n:=List.mem_range
lemma lM {α β}{f:α->β}{l:List α}{b:β}:b∈l.map f↔∃a∈l,f a=b:=List.mem_map
lemma vM {α β}{f:α->List β}{l:List α}{b:β}:b∈l.flatMap f↔∃a∈l,b∈f a:=List.mem_flatMap
lemma CE {α}{a:α}{s:List α}(t:List α)(h:a∈s):a∈s++t:=List.mem_append_left t h
lemma CB {α}{a:α}(s:List α){t:List α}(h:a∈t):a∈s++t:=List.mem_append_right s h
lemma Bt {α}{a:α}{s t:List α}:a∈s++t↔a∈s\/a∈t:=List.mem_append
lemma Dm {α}{p:α->Bool}{a:α}{l:List α}:a∈l.filter p↔a∈l/\p a=true:=List.mem_filter
lemma Bs {α}{a b:α}:a∈[b]↔a=b:=List.mem_singleton
lemma Dt {α}(l:List α)(d:α){i}(h:i<l.length):l.getD i d=l[i]:=List.getD_eq_getElem l d h
lemma Ds {α}{l:List α}{i}(h:i<l.length):l[i]∈l:=List.getElem_mem h
lemma B5 {a:Bool}(h:a≠true):a=false:=Bool.eq_false_iff.mpr h
@[local simp] lemma xE (a b:Nat):a.add b=a+b:=rfl
@[local simp] lemma kP (a b:Nat):a.sub b=a-b:=rfl
@[local simp] lemma xD (a b:Nat):a.mul b=a*b:=rfl
@[local simp] lemma kM (a b:Nat):a.div b=a/b:=rfl
@[local simp] lemma kO (a b:Nat):a.mod b=a %b:=rfl
@[local simp] lemma wX (a b:Nat):a.lor b=a|||b:=rfl
@[local simp] lemma vo (a b:Nat):a.land b=a&&&b:=rfl
@[local simp] lemma AS (a b:Nat):a.xor b=a^^^b:=rfl
@[local simp] lemma vH (a b:Nat):a.shiftLeft b=a<<<b:=rfl
@[local simp] lemma BX (a b:Nat):a.shiftRight b=a>>>b:=rfl
lemma yJ {a b:Nat}:a.beq b=true↔a=b:=Iff.of_eq Nat.beq_eq
lemma qQ {a b:Nat}:a.beq b=false↔a≠b:=by rw[<-Bool.not_eq_true,Nat.beq_eq]
lemma kd {a b:Nat}:a.blt b=true↔a<b:=Iff.of_eq Nat.blt_eq
lemma kz {a b:Nat}:a.blt b=false↔b<=a:=by rw[<-Bool.not_eq_true,Nat.blt_eq,nL]
lemma bR {α}(c:Bool)(t e:α):c.rec e t=(if c=true then t else e):=by cases c<;>rfl
lemma bA (a b:Bool):a.rec false b=(a&&b):=by cases a<;>rfl
lemma bO (a b:Bool):a.rec b true=(a||b):=by cases a<;>rfl
lemma bN (a:Bool):a.rec true false=!a:=by cases a<;>rfl
lemma kI {c e t:Bool}(h:c.rec e t=true):(c=true/\t=true)\/(c=false/\e=true):=by cases c<;>simp at h ⊢<;>exact h
lemma qU (x i:Nat):tB x i=x.testBit i:=by unfold tB;simp only[Nat.testBit,vo,BX,Nat.land_comm 1,Nat.and_one_is_mod];cases h:(x>>>i)%2 with|zero=>rfl|succ n=>cases n with|zero=>rfl|succ _=>omega
lemma BL (p:Bool):BM p=p.toNat:=by cases p<;>rfl
lemma ki (k I x:Nat):kk k I x=kF k I x:=by unfold kk kF kJ;simp[bR,qU]
lemma oR {α β}(o:Option α)(n:β)(s:α->β):o.rec n s=(match o with|none=>n|some x=>s x):=by cases o<;>rfl
lemma pR {α β γ}(p:α×β)(f:α->β->γ):p.rec f=f p.1 p.2:=by cases p;rfl
lemma wq {e}(he:e<14):wS e=qG e:=(by decide +kernel:∀u:Fin 14,wS u.1=qG u.1) ⟨e,he⟩
lemma wj {gi:Fin 4}{e}(he:e<14):wR gi e=kZ gi e:=(by decide +kernel:∀g:Fin 4,∀u:Fin 14,wR g u.1=kZ g u.1) gi ⟨e,he⟩
lemma Bp {gi:Fin 4}{x}(hx:x<10):vG gi x=xX gi x:=(by decide +kernel:∀g:Fin 4,∀u:Fin 10,vG g u.1=xX g u.1) gi ⟨x,hx⟩
lemma Ad {gi:Fin 4}{x y}(hx:x<10)(hy:y<10)(ha:qR gi x y=true):zG gi x y=(w4 gi x y).1:=(by decide +kernel:∀g:Fin 4,∀u v:Fin 10,qR g u.1 v.1=true->zG g u.1 v.1=(w4 g u.1 v.1).1) gi ⟨x,hx⟩ ⟨y,hy⟩ ha
def qE (v:Nat->Bool)(a b:Nat):Prop:=(∀x (p:Bool),x<1940->a.testBit (2*x+p.toNat)=true->v x=p)/\(∀x (p:Bool),1940<=x->b.testBit (2*(x-1940)+p.toNat)=true->v x=p)
def EH (v:Nat->Bool)(c:Nat×List Nat):Prop:=(∀u∈c.2,u+10<=1940/\u %10=0/\∀w∈c.2,∀y<10,v (u+y)=v (w+y))/\∀k,c.1.testBit k=true->∃w∈c.2,w/10=k
def vK (v:Nat->Bool)(cs:CC):Prop:=∀c∈cs,EH v c
def wN (v:Nat->Bool)(ym:List (Nat×Nat×Nat)):Prop:=∀p∈ym,p.1+10<=1940/\p.2.1+10<=1940/\∀y<10,v (p.1+y)=true->v (p.2.1+y)=true
def uo (v:Nat->Bool)(st:St):Prop:=qE v st.a st.b/\vK v st.e/\wN v st.i
abbrev uk {α}(Q:α->Prop)(o:Option α):Prop:=(o=none->False)/\∀x,o=some x->Q x
lemma uu {α}{Q:α->Prop}{x}(h:Q x):uk Q (some x):=⟨(λ e=>nomatch e),fun _ e=>(by cases e;exact h)⟩
lemma Co {P:Prop}[Decidable P]{α}{Q:α->Prop}{a b:Option α}(h1:P->uk Q a)(h2:¬P->uk Q b):uk Q (if P then a else b):=by by_cases h:P<;>simp[h];{exact h1 h};{exact h2 h}
lemma qC {v l q}(hl:w2 v l)(hq:∀x∈q,w2 v x):∀x∈l::q,w2 v x:=λ _ hx=>(mC.mp hx).elim (λ e=>e▸hl) (hq _)
lemma yI {k I x:Nat}(o0:k<=3):kF k I x<=5:=by unfold kF;split<;>omega
lemma BH {e:Nat}(he:e<14):qG e<10:=(by decide +kernel:∀u:Fin 14,qG u.1<10) ⟨e,he⟩
lemma BG {gi:Fin 4}{e:Nat}(he:e<14):kZ gi e<10:=(by decide +kernel:∀g:Fin 4,∀u:Fin 14,kZ g u.1<10) gi ⟨e,he⟩
lemma Bo {gi:Fin 4}{i n:Nat}(hi:i<10)(hn:n<(kG gi i).length):(kG gi i).getD n 0<10:=by have h:∀g:Fin 4,∀u:Fin 10,∀j:Fin 5,j.1<(kG g u.1).length->(kG g u.1).getD j.1 0<10:=(by decide +kernel);have hl:∀g:Fin 4,∀u:Fin 10,(kG g u.1).length<5:=(by decide +kernel);exact h gi ⟨i,hi⟩ ⟨n,Nat.lt_trans hn (hl gi ⟨i,hi⟩)⟩ hn
lemma yX {gi:Fin 4}{i y:Nat}(hi:i<10)(hy:y∈kG gi i):y<10/\qR gi i y=true:=by have h:∀g:Fin 4,∀u:Fin 10,(kG g u.1).all (λ z=>decide (z<10)&&qR g u.1 z)=true:=(by decide +kernel);simpa[sA,sD] using List.all_eq_true.mp (h gi ⟨i,hi⟩) y hy
lemma CW {gi:Fin 4}{a b:Nat}(ha:a<10)(hb:b<10):(w4 gi a b).1<14:=(by decide +kernel:∀g:Fin 4,∀u v:Fin 10,(w4 g u.1 v.1).1<14) gi ⟨a,ha⟩ ⟨b,hb⟩
