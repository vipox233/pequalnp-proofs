namespace PEqualNP.Outside.L_meta_18013_aux.Compose

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.TopForm

private def wire (k : Fin 10) (i : Nat) : Nat :=
  if hi : i < 9 then (k.succAbove ⟨i,hi⟩).val else i+1

private def rename (k : Fin 10) (g : Gate) : Gate := ⟨g.op,g.inputs.map (wire k)⟩

private def step (w : List Bool) (g : Gate) :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

private def connector (k : Fin 10) (A : Circuit) : Gate :=
  ⟨GateOp.and,[k.val,wire k A.output]⟩

private def joined (k : Fin 10) (A B : Circuit) : Circuit :=
  ⟨A.gates.map (rename k) ++ [connector k A] ++ B.gates.map (rename k),wire k B.output⟩

private theorem read_input {n : Nat} (x : Fin n → Bool) (w : List Bool) (i : Fin n) :
    (List.ofFn x ++ w).getD i.val false = x i := by
  rw [List.getD_append _ _ _ _ (by simp), List.getD_eq_getElem?_getD]
  simp

private theorem read_wire (k : Fin 10) (x : Fin 10 → Bool) (u : List Bool) (i : Nat) :
    (List.ofFn x ++ u).getD (wire k i) false =
      (List.ofFn (k.removeNth x) ++ u).getD i false := by
  by_cases hi : i < 9
  · let a : Fin 9 := ⟨i,hi⟩
    have hiW : wire k i = (k.succAbove a).val := by unfold wire; rw [dite_eq_left hi]
    rw [hiW,read_input x u (k.succAbove a)]
    exact (read_input (k.removeNth x) u a).symm
  · have hiW : wire k i = i+1 := by unfold wire; rw [dite_eq_right hi]
    rw [hiW]
    rw [List.getD_append_right _ _ _ _ (by simp only [List.length_ofFn]; omega)]
    rw [List.getD_append_right _ _ _ _ (by simp only [List.length_ofFn]; omega)]
    simp only [List.length_ofFn]
    rw [show i+1-10 = i-9 by omega]

private theorem shared_suffix (k : Fin 10) (x : Fin 10 → Bool) (gs : List Gate) (u : List Bool) :
    ∃ v : List Bool,
      ((gs.map (rename k)).foldl step (List.ofFn x ++ u)) = List.ofFn x ++ v ∧
      (gs.foldl step (List.ofFn (k.removeNth x) ++ u)) = List.ofFn (k.removeNth x) ++ v := by
  induction gs generalizing u with
  | nil => exact ⟨u,rfl,rfl⟩
  | cons g tail ih =>
    let t := g.op.eval (g.inputs.map fun i => (List.ofFn (k.removeNth x) ++ u).getD i false)
    have eqRead : g.inputs.map (fun i => (List.ofFn x ++ u).getD (wire k i) false) =
        g.inputs.map (fun i => (List.ofFn (k.removeNth x) ++ u).getD i false) := by
      apply List.map_congr_left
      intro i _
      exact read_wire k x u i
    have real : step (List.ofFn x ++ u) (rename k g) = List.ofFn x ++ (u ++ [t]) := by
      simp only [step,rename,List.map_map,Function.comp_def,eqRead,List.append_assoc,t]
    have virt : step (List.ofFn (k.removeNth x) ++ u) g =
        List.ofFn (k.removeNth x) ++ (u ++ [t]) := by
      simp only [step,List.append_assoc,t]
    simpa only [List.map_cons,List.foldl_cons,real,virt] using ih (u ++ [t])

private theorem compose_eval (k : Fin 10) (A B : Circuit) (x : Fin 10 → Bool) :
    (joined k A B).eval (List.ofFn x) =
      B.eval (A.wires (List.ofFn (k.removeNth x)) ++
        [x k && A.eval (List.ofFn (k.removeNth x))]) := by
  let y := k.removeNth x
  obtain ⟨u,real,virt⟩ := shared_suffix k x A.gates []
  simp only [List.append_nil] at real virt
  have aw : A.wires (List.ofFn y) = List.ofFn y ++ u := virt
  let t := x k && A.eval (List.ofFn y)
  have valA : (List.ofFn x ++ u).getD (wire k A.output) false = A.eval (List.ofFn y) := by
    rw [read_wire]
    change _ = (A.wires (List.ofFn y)).getD A.output false
    rw [aw]
  have gate : step (List.ofFn x ++ u) (connector k A) = List.ofFn x ++ (u ++ [t]) := by
    simp only [step,connector,List.map_cons,List.map_nil,read_input,valA,GateOp.eval,
      List.all_cons,List.all_nil,id_eq,Bool.and_true,List.append_assoc,t]
  obtain ⟨v,rb,vb⟩ := shared_suffix k x B.gates (u ++ [t])
  change (((A.gates.map (rename k) ++ [connector k A] ++ B.gates.map (rename k)).foldl step
    (List.ofFn x)).getD (wire k B.output) false) =
    (B.gates.foldl step (A.wires (List.ofFn y) ++ [t])).getD B.output false
  rw [List.foldl_append,List.foldl_append,real,List.foldl_cons,List.foldl_nil,gate,rb,aw,
    List.append_assoc,vb]
  exact read_wire k x v B.output

private theorem renamed_mono {n : Nat} (k : Fin 10) {A : Circuit} (h : IsAO2 n A)
    {g : Gate} (hg : g ∈ A.gates.map (rename k)) :
    g.op ∈ ({GateOp.and,GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2 := by
  obtain ⟨a,ha,rfl⟩ := List.mem_map.mp hg
  refine ⟨?_,?_⟩
  · simpa [rename] using h.1 a ha
  · simp [rename,h.2.2 a ha]

private theorem joined_mono {k : Fin 10} {A B : Circuit} (ha : IsAO2 9 A)
    (hb : IsAO2 (10+A.size) B) : Monotone2 (joined k A B) := by
  intro g hg
  change g ∈ A.gates.map (rename k) ++ [connector k A] ++ B.gates.map (rename k) at hg
  simp only [List.mem_append,List.mem_singleton] at hg
  rcases hg with (hg|rfl)|hg
  · exact renamed_mono k ha hg
  · simp [connector]
  · exact renamed_mono k hb hg

theorem exclusion (F : (Fin 10 → Bool) → Bool)
    (low : ∀ D : Circuit, Monotone2 D → D.size ≤ 18 →
      (∀ x, D.eval (List.ofFn x) = F x) → False)
    (k : Fin 10) (A B : Circuit) (ha : IsAO2 9 A) (hb : IsAO2 (10+A.size) B)
    (size : A.size+B.size ≤ 17) :
    ∃ (y : Fin 9 → Bool) (b : Bool),
      B.eval (A.wires (List.ofFn y) ++ [b && A.eval (List.ofFn y)]) ≠ F (k.insertNth b y) := by
  by_contra! correct
  apply low (joined k A B) (joined_mono ha hb)
  · simp only [joined,Circuit.size,List.length_append,List.length_map,List.length_cons,
      List.length_nil] at *
    omega
  · intro x
    rw [compose_eval,correct]
    rw [Fin.insertNth_self_removeNth]

end PEqualNP.Outside.L_meta_18013_aux.Compose

theorem PEqualNP.Outside.L_meta_18013 : (∀ (x1 : Fin (11 : ℕ)) (x2 : Fin (10 : ℕ)) (x3 x4 : PEqualNP.CircuitLowerBounds.Circuit),   ↑x1 < (4 : ℕ) →     PEqualNP.TopForm.IsAO2 (9 : ℕ) x3 →       PEqualNP.TopForm.IsAO2 ((10 : ℕ) + x3.size) x4 →         x3.size + x4.size ≤ (17 : ℕ) →           (9 : ℕ) ≤ x3.output →             x3.output < (9 : ℕ) + x3.size →               have x11 : (Fin (10 : ℕ) → Bool) → Bool := fun (x11 : Fin (10 : ℕ) → Bool) =>                 have x12 : Fin (11 : ℕ) → Bool := x1.insertNth Bool.false x11;                 [(9 : ℕ), (10 : ℕ), (15 : ℕ), (19 : ℕ), (27 : ℕ), (32 : ℕ), (39 : ℕ), (40 : ℕ), (52 : ℕ), (54 : ℕ), (63 : ℕ), (64 : ℕ), (73 : ℕ), (76 : ℕ), (86 : ℕ), (97 : ℕ)].any fun (x13 : ℕ) => x12 (Fin.ofNat (11 : ℕ) (x13 / (11 : ℕ))) && x12 (Fin.ofNat (11 : ℕ) (x13 % (11 : ℕ)));               (∀ (x12 : Fin (9 : ℕ) → Bool), x11 (x2.insertNth Bool.false x12) ≠ x11 (x2.insertNth Bool.true x12) → x3.eval (List.ofFn x12) = Bool.true) → ∃ (x13 : Fin (9 : ℕ) → Bool) (x14 : Bool), x4.eval (x3.wires (List.ofFn x13) ++ [x14 && x3.eval (List.ofFn x13)]) ≠ x11 (x2.insertNth x14 x13)) := by
  intro v k A B hv ha hb hsize _ _
  dsimp only
  intro _
  refine PEqualNP.Outside.L_meta_18013_aux.Compose.exclusion
    (fun x => PEqualNP.Outside.L_meta_18013_aux.W.wV (v.insertNth false x)) ?_ k A B ha hb hsize
  intro C mono small evaluates
  obtain ⟨x, different⟩ := PEqualNP.Outside.L_meta_18013_aux.all4_lb v C hv mono small
  exact different ((evaluates x).trans (PEqualNP.Outside.L_meta_18013_aux.W.wF _).symm)
