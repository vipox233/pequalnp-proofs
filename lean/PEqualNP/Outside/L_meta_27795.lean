theorem finish8 (D8 : Circuit) (fan8 : FanInTwo D8) (s8 : D8.size ≤ 9)
    (e8 : ∀ x, D8.eval (List.ofFn x) = mid8 x) :
    ∃ D : Circuit, FanInTwo D ∧ D.size ≤ 7 ∧ ∀ x, D.eval (List.ofFn x) = c6 x := by
  have ch8 := necessary8 D8 fan8 e8
  have part7 (y) : D8.eval (restrict b7 y) = mid7 y := e8 (lift7 y)
  obtain ⟨D7, fan7, cost7, val7⟩ := eliminate_pin b7 0 D8 fan8 (by decide) ⟨fun _ => false, (part7 _).trans (by decide)⟩
  have e7 (y) : D7.eval (List.ofFn y) = mid7 y := (val7 y).trans (part7 y)
  have ch7 := necessary7 D7 fan7 e7
  have part6 (y) : D7.eval (restrict b6 y) = c6 y := e7 (lift6 y)
  obtain ⟨D6, fan6, cost6, val6⟩ := eliminate_pin b6 0 D7 fan7 (by decide) ⟨fun _ => false, (part6 _).trans (by decide)⟩
  have e6 (y) : D6.eval (List.ofFn y) = c6 y := (val6 y).trans (part6 y)
  exact ⟨D6,fan6,by omega,e6⟩
private def probe9 (b : Bool) : Fin 9 → Bool :=
  ![b,false,false,false,true,false,false,false,true]

theorem necessary9 (C : Circuit) (fan : FanInTwo C)
    (ev : ∀ x, C.eval (List.ofFn x) = pm x)
    (fst : C.gates.head? = some ⟨GateOp.or, [0,4]⟩) :
    2 ≤ C.gates.countP (reads 0) := by
  have raw : C.output ≠ 0 := by
    intro eq
    let x : Fin 9 → Bool := fun i => decide (i = 0)
    obtain ⟨t, ht, _⟩ := wiresFrom_prefix C.gates (List.ofFn x)
    have v := ev x
    change (wiresFrom C.gates (List.ofFn x)).getD C.output false = pm x at v
    rw [eq, ht, List.getD_append _ _ _ _ (by decide : 0 < (List.ofFn x).length)] at v
    exact (by decide : (List.ofFn x).getD 0 false ≠ pm x) v
  cases h : C.gates with
  | nil => simp [h] at fst
  | cons g tail =>
    simp [h] at fst
    subst g
    let G : Gate := ⟨GateOp.or, [0,4]⟩
    have near : AgreeAway (List.ofFn (probe9 false)) (List.ofFn (probe9 true)) := by
      refine ⟨rfl, by decide, ?_⟩
      intro j diff
      cases j with
      | zero => contradiction
      | succ j => rfl
    have pos : 0 < tail.countP (reads 0) := by
      by_contra! no
      have silent : ∀ g ∈ tail, reads 0 g = false := by
        intro g hg
        cases val : reads 0 g with
        | false => rfl
        | true =>
          have yes := List.countP_pos_iff.mpr ⟨g, hg, val⟩
          omega
      have first := step_agree _ _ G near (by decide)
      have fan' : FanInTwo ⟨tail,0⟩ := fun k hk => fan k (by simp [h,hk])
      have same := (fold_agree tail _ _ first fan' silent).2.2 C.output raw
      have ev' (b : Bool) :
          (tail.foldl step (step (List.ofFn (probe9 b)) G)).getD C.output false = pm (probe9 b) := by
        have e := ev (probe9 b)
        change (wiresFrom C.gates (List.ofFn (probe9 b))).getD C.output false = _ at e
        rw [h] at e
        exact e
      rw [ev',ev'] at same
      contradiction
    simpa [List.countP_cons, reads, normGate] using Nat.succ_le_succ pos


theorem chooseUses (C : Circuit) (fan : FanInTwo C) (ev : ∀ x, C.eval (List.ofFn x) = pm x)
    (fst : C.gates.head? = some ⟨GateOp.or, [0,4]⟩)
    (useLater : ∀ j : Fin C.gates.length, j.val + 1 < C.gates.length →
       ∃ k : Fin C.gates.length, j.val < k.val ∧ 9+j.val ∈ (C.gates.get k).inputs)
    (notArity : ∀ i : Fin C.gates.length, (C.gates.get i).op = GateOp.not → (C.gates.get i).inputs.length ≤ 1)
    (sep : ∀ k : Fin C.gates.length, 0 ∈ (C.gates.get k).inputs → 9 ∉ (C.gates.get k).inputs) :
    ∃ a b : Fin C.gates.length, 0 < a.val ∧ 0 < b.val ∧ a ≠ b ∧
      0 ∈ (normGate (C.gates.get a)).inputs ∧ 9 ∈ (normGate (C.gates.get b)).inputs := by
  have count := necessary9 C fan ev fst
  obtain ⟨g,gs,shape⟩ : ∃ g gs, C.gates = g :: gs := by
    cases h : C.gates with
    | nil => simp [h] at fst
    | cons g gs => exact ⟨_,_,rfl⟩
  have pos : 0 < gs.countP (reads 0) := by
    rw [shape, List.countP_cons] at count
    split at count <;> omega
  obtain ⟨v,hv,vr⟩ := List.countP_pos_iff.mp pos
  obtain ⟨i,hi⟩ := List.mem_iff_get.mp hv
  let a : Fin C.gates.length := ⟨i.val + 1, by rw [shape]; simp⟩
  have ga : C.gates.get a = v := by
    calc C.gates.get a = gs.get i := by simp [a, shape, List.get_eq_getElem]
         _ = v := hi
  have ar : 0 ∈ (normGate (C.gates.get a)).inputs := by rw [ga]; exact List.contains_iff_mem.mp vr
  have len : 1 < C.gates.length := by have := a.isLt; dsimp [a] at this; omega
  obtain ⟨b,hb,readB⟩ := useLater ⟨0,by omega⟩ len
  have norm (j : Fin C.gates.length) : (normGate (C.gates.get j)).inputs = (C.gates.get j).inputs := by
    by_cases h : (C.gates.get j).op = GateOp.not
    · simp only [normGate,h,List.take_of_length_le (notArity j h)]
    · cases he : (C.gates.get j).op <;> simp_all [normGate]
  have n9 : 9 ∈ (C.gates.get b).inputs := readB
  refine ⟨a,b,by simp [a],hb,?_,ar,by rwa [norm]⟩
  rintro rfl
  rw [norm] at ar
  exact sep a ar n9

