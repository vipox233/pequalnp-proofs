theorem PEqualNP.Outside.L_meta_27795 : (¬ (∃ C : PEqualNP.CircuitLowerBounds.Circuit,
    PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 12 ∧
    (∀ x : Fin 9 → Bool, C.eval (List.ofFn x) = ((x 0 && x 4 && x 8) || (x 0 && x 5 && x 7) || (x 1 && x 3 && x 8) || (x 1 && x 5 && x 6) || (x 2 && x 3 && x 7) || (x 2 && x 4 && x 6))) ∧
    C.output + 1 = 9 + C.size ∧
    (∀ j : Fin C.gates.length,
      ((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.not ∧
          ∃ a, a < 9 + j.val ∧ (C.gates.get j).inputs = [a]) ∨
      (((C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.and ∨
          (C.gates.get j).op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧
          ∃ a b, a < b ∧ b < 9 + j.val ∧ (C.gates.get j).inputs = [a, b])) ∧
    (∀ j : Fin C.gates.length,
      (∃ x y : Fin 9 → Bool,
        (C.wires (List.ofFn x)).getD (9 + j.val) false ≠ (C.wires (List.ofFn y)).getD (9 + j.val) false) ∧
      ∀ k, k < 9 + j.val → ∃ x : Fin 9 → Bool,
        (C.wires (List.ofFn x)).getD (9 + j.val) false ≠ (C.wires (List.ofFn x)).getD k false) ∧
    (∀ j : Fin C.gates.length, j.val + 1 < C.gates.length →
      ∃ k : Fin C.gates.length, j.val < k.val ∧ 9 + j.val ∈ (C.gates.get k).inputs) ∧
    C.gates.head? = some ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [0, 4]⟩ ∧
    C.gates.tail.head? = some ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [2, 8]⟩)) := by
  rintro ⟨C,fan,sz,ev,_,form,distinct,used,fst,_⟩
  have arity (i : Fin C.gates.length) (hn : (C.gates.get i).op = GateOp.not) : (C.gates.get i).inputs.length ≤ 1 := by
    rcases form i with ⟨_,a,_,ha⟩ | ⟨ho,_⟩
    · rw [ha]; exact Nat.le_refl 1
    · rcases ho with ha|ha <;> rw [ha] at hn <;> contradiction
  have sep := no_zero_nine C form distinct fst
  obtain ⟨a,b,ha,hb,hab,ar,br⟩ := chooseUses C fan ev fst used arity sep
  obtain ⟨D8,fan8,cost8,e8⟩ := pinThree C fan ev fst a b ha hb hab ar br
  obtain ⟨D,hD,hs,he⟩ := finish8 D8 fan8 (by omega) e8
  have hsmall : PEqualNP.MetaComplexity.HasCircuitSize 6 PEqualNP.Outside.L_meta_27795_aux.Cycle.rowCycle 7 := ⟨D,hD,hs,he⟩
  have hb := PEqualNP.Outside.L_meta_27795_aux.Cycle.rowCycleLower 7 hsmall
  omega
