theorem pinThree (C : Circuit) (fan : FanInTwo C) (ev : ∀ x, C.eval (List.ofFn x) = pm x)
    (fst : C.gates.head? = some ⟨GateOp.or,[0,4]⟩)
    (a b : Fin C.gates.length) (ha : 0 < a.val) (hb : 0 < b.val) (hne : a ≠ b)
    (ar : 0 ∈ (normGate (C.gates.get a)).inputs) (br : 9 ∈ (normGate (C.gates.get b)).inputs) :
    ∃ D : Circuit, FanInTwo D ∧ D.size + 3 ≤ C.size ∧ ∀ x, D.eval (List.ofFn x) = mid8 x := by
  obtain ⟨tail, htail⟩ : ∃ tail, C.gates = ⟨GateOp.or,[0,4]⟩ :: tail := by
    cases h : C.gates with
    | nil => simp [h] at fst
    | cons g gs => simp [h] at fst; exact ⟨gs,by rw [fst]⟩
  let initial := layout b8
  let gs := C.gates.map normGate
  let acc := elim 8 gs (initial, [])
  have shape : gs = ⟨GateOp.or,[0,4]⟩ :: tail.map normGate := by
    simp only [gs,htail,List.map_cons]; rfl
  have p0 : acc.1.getD 0 (.inl false) = .inl true := by
    dsimp only [acc]; rw [elim_getD 8 0 _ gs _ (by decide)]; rfl
  have p9 : acc.1.getD 9 (.inl false) = .inl true := by
    dsimp only [acc]; rw [shape,elim_cons,elim_getD 8 9 _ _ _ (by decide)]; rfl
  have normOk : ∀ g ∈ gs, NOk g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok _ (fan _ hg0)
  have penalty := elim_count 8 (initial,[]) gs normOk {0,a.val,b.val} (by
    intro p hp
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp
    rcases hp with rfl | rfl | rfl
    · exact ⟨⟨GateOp.or,[0,4]⟩,by simp [shape],0,by decide,by decide,true,p0⟩
    · refine ⟨normGate (C.gates.get a),by simp [gs,a.isLt],0,ar,?_,true,p0⟩
      change 0 < 9 + a.val
      omega
