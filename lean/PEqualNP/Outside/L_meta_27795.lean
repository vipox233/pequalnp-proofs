theorem no_zero_nine (C : Circuit)
    (form : ∀ j : Fin C.gates.length,
      ((C.gates.get j).op = GateOp.not ∧
          ∃ a, a < 9 + j.val ∧ (C.gates.get j).inputs = [a]) ∨
      (((C.gates.get j).op = GateOp.and ∨ (C.gates.get j).op = GateOp.or) ∧
          ∃ a b, a < b ∧ b < 9 + j.val ∧ (C.gates.get j).inputs = [a, b]))
    (distinct : ∀ j : Fin C.gates.length,
      (∃ x y : Fin 9 → Bool,
        (C.wires (List.ofFn x)).getD (9 + j.val) false ≠ (C.wires (List.ofFn y)).getD (9 + j.val) false) ∧
      ∀ k, k < 9 + j.val → ∃ x : Fin 9 → Bool,
        (C.wires (List.ofFn x)).getD (9 + j.val) false ≠ (C.wires (List.ofFn x)).getD k false)
    (head : C.gates.head? = some ⟨GateOp.or, [0, 4]⟩) :
    ∀ k : Fin C.gates.length, 0 ∈ (C.gates.get k).inputs → 9 ∉ (C.gates.get k).inputs := by
  have hget : C.gates[0]? = some ⟨GateOp.or, [0,4]⟩ := by
    cases e : C.gates <;> simpa [e] using head
  have hwire (x : Fin 9 → Bool) : val C.gates 9 9 x = (val C.gates 9 0 x || val C.gates 9 4 x) := by
    simpa [GateOp.eval] using val_gate 9 C.gates 0 _ hget (by decide) x
  intro k h0 h9
  rcases form k with ⟨_, a, _, ha⟩ | ⟨hop, a, b, hab, hb, hin⟩
  · rw [ha] at h0 h9; simp at h0 h9; omega
  · rw [hin] at h0 h9
    simp at h0 h9
    have ea : a = 0 := by omega
    have eb : b = 9 := by omega
    subst a; subst b
    have heval (x : Fin 9 → Bool) := val_gate 9 C.gates k.val (C.gates.get k)
      (List.getElem?_eq_some_iff.mpr ⟨k.isLt,rfl⟩)
      (by intro i hi; rw [hin] at hi; simp at hi; omega) x
    rcases hop with hop | hop
    · obtain ⟨x, hx⟩ := (distinct k).2 0 (by omega)
      apply hx
      change val C.gates 9 (9+k.val) x = val C.gates 9 0 x
      rw [heval, hop, hin]
      simp [GateOp.eval, hwire]
      exact Or.inl
    · obtain ⟨x, hx⟩ := (distinct k).2 9 hb
      apply hx
      change val C.gates 9 (9+k.val) x = val C.gates 9 9 x
      rw [heval, hop, hin]
      simp [GateOp.eval, hwire]

end PEqualNP.Outside.L_meta_27795.Physical

