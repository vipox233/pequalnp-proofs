theorem symsG_ok:symsG.all (fun ms=>ms.all moveOK256 && (applyMoves ms dom_22==dom_22) && (applyMoves ms goalM==goalM))=true:=by decide +kernel
def ori (zs:List Nat):List Nat:=pickMin 0 zs symsG zs (hk 0 zs)
theorem ori_ok {v ys} (h:RunD true dom_22 goalM v ys):RunD true dom_22 goalM v (ori ys):=pickMin_runD 0 ys h symsG ys (hk 0 ys) symsG_ok h
def Z (s:Nat):=barP true dom_22 goalM mpG SD SS NN htAt idxH ori 0 pool6G mkPools s
