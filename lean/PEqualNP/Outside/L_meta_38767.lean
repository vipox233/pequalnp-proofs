def pairsG:List (Nat × Nat):=[(2,6),(2,18),(4,6),(4,20),(16,18),(16,20)]
def r1sG:List Nat:=pairsG.map Prod.fst
def r2sG:List Nat:=pairsG.map Prod.snd
def mpG:Nat:=0x3f
def pool6G:List Nat:=[]
