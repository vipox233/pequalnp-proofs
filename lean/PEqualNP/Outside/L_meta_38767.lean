def NN:Nat → Nat
|2=>1
|3=>1
|_=>0
def HT:Nat → Nat → Nat
|2,0=>0x1ebf1bc1
|3,0=>0x1ebf1bc1
|_,_=>0
def dictB:Nat → Nat → Nat
|0,0=>0x154000280028440044
