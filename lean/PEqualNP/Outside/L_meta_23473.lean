theorem PEqualNP.Outside.L_meta_23473 : ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.FanInTwo C ∧ C.size ≤ 8 ∧ ∀ i j : Fin 6, C.eval (List.ofFn fun k : Fin 6 => decide (k = i ∨ k = j)) = (397 : ℕ).testBit (6 * min i.val j.val + max i.val j.val) := by
  exact ⟨PEqualNP.Outside.L_meta_23473_aux.circ, PEqualNP.Outside.L_meta_23473_aux.h_ok, PEqualNP.Outside.L_meta_23473_aux.h_sz, by decide +kernel⟩
