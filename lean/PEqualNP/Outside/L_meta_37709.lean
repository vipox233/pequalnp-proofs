      rcases hc with h0 | h1
      · exact Or.inl (houtm.symm.trans h0)
      · exact Or.inr (houtm.symm.trans h1))
    have hnc_256 : ¬ IsConst mask256 out := fun hc => hnc_m (by
      rcases hc with h0 | h1
      · exact Or.inl (by rw [h0]; simp)
