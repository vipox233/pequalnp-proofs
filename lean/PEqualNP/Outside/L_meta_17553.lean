lemma step_good{gs:List Gate}{ws:Finset W32}(hg:GSt gs ws){a b z:W32}(ha:a∈ws)(hb:b∈ws)(hz:z=a&&&b\/z=a|||b):∃gs',gs'.length<=gs.length+1/\GSt gs' (insert z ws):=by obtain⟨hM,hrep⟩:=hg;obtain⟨ra,hba,hea⟩:=hrep a ha;obtain⟨rb,hbb,heb⟩:=hrep b hb;have ext:∀(g:Gate),(g.op=.and\/g.op=.or)/\g.inputs.length<=2->(∀r:Fin 32,g.op.eval (g.inputs.map λ i=>(Circuit.wires ⟨gs,0⟩ (List.ofFn (rowB r))).getD i false)=z.getLsbD r.1)->∃gs',gs'.length<=gs.length+1/\GSt gs' (insert z ws):=λ g hgM hge=>⟨gs++[g],by simp,⟨λ g' hm=>by{simp only[List.mem_append,List.mem_singleton] at hm;rcases hm with h1|rfl;{exact hM g' h1};{exact hgM}},λ w hw=>by{rcases Finset.mem_insert.mp hw with rfl|hw;{refine⟨some (10+gs.length),by simp,λ r=>by{simp only[refE];have:=wNew gs g (List.ofFn (rowB r));simp only[List.length_ofFn] at this;rw[this];exact hge r}⟩};{obtain⟨ref,hbr,her⟩:=hrep w hw;refine⟨ref,λ k hk=>by{have:=hbr k hk;simp;omega},λ r=>by{cases ref with|none=>{exact her r}|some k=>{simp only[refE] at her ⊢;have hk:=hbr k rfl;have:=wLt gs g (List.ofFn (rowB r)) k (by simp;omega);rw[this];exact her r}}⟩}}⟩⟩;have reu:∀(ref:Option ℕ),(∀k,ref=some k->k < 10+gs.length)->(∀r:Fin 32,refE gs (rowB r) ref=z.getLsbD r.1)->∃gs',gs'.length<=gs.length+1/\GSt gs' (insert z ws):=λ ref hbr her=>⟨gs,by omega,hM,λ w hw=>by{rcases Finset.mem_insert.mp hw with rfl|hw;{exact⟨ref,hbr,her⟩};{exact hrep w hw}}⟩;rcases hz with rfl|rfl;{cases ra with|none=>{exact reu none (by simp) (λ r=>by{have h1:=hea r;simp only[refE] at h1 ⊢;rw[BitVec.getLsbD_and,<-h1];rfl})}|some u=>{cases rb with|none=>{exact reu none (by simp) (λ r=>by{have h2:=heb r;simp only[refE] at h2 ⊢;rw[BitVec.getLsbD_and,<-h2];simp})}|some v=>{exact ext ⟨.and,[u,v]⟩ ⟨Or.inl rfl,by simp⟩ (λ r=>by{simp only[GateOp.eval,List.map_cons,List.map_nil,List.all_cons,List.all_nil,Bool.and_true];have h1:=hea r;have h2:=heb r;simp only[refE] at h1 h2;rw[h1,h2,BitVec.getLsbD_and];rfl})}}};{cases ra with|none=>{exact reu rb hbb (λ r=>by{have h1:=hea r;have h2:=heb r;simp only[refE] at h1;rw[h2,BitVec.getLsbD_or,<-h1];rfl})}|some u=>{cases rb with|none=>{exact reu (some u) hba (λ r=>by{have h1:=hea r;have h2:=heb r;simp only[refE] at h2;rw[h1,BitVec.getLsbD_or,<-h2];simp})}|some v=>{exact ext ⟨.or,[u,v]⟩ ⟨Or.inr rfl,by simp⟩ (λ r=>by{simp only[GateOp.eval,List.map_cons,List.map_nil,List.any_cons,List.any_nil,Bool.or_false];have h1:=hea r;have h2:=heb r;simp only[refE] at h1 h2;rw[h1,h2,BitVec.getLsbD_or];rfl})}}}
lemma good_to_circuit{gs:List Gate}{ws:Finset W32}(hg:GSt gs ws)(hlen:gs.length<=18)(hhit:(16383:W32)∈ws):∃C:Circuit,Monotone2 C/\C.size<=18/\∀x:Fin 10->Bool,C.eval (List.ofFn x)=true<->∃u v:Fin 10,(u.1,v.1)∈k7/\x u=true/\x v=true:=by obtain⟨hM,hrep⟩:=hg;obtain⟨ref,_,href⟩:=hrep 16383 hhit;cases ref with|none=>{have h0:=href 0;simp[refE] at h0}|some out=>{let C:Circuit:=⟨gs,out⟩;have hMC:Monotone2 C:=hM;refine⟨C,hMC,hlen,λ x=>?_⟩;rw[<-gBool_iff];constructor;{intro ht;by_contra hne;have hf:gBool x=false:=Bool.eq_false_of_not_eq_true hne;obtain⟨r,hr,hsub⟩:=(bounds x).2 hf;have hup:=eMono C hMC x (rowB r) hsub out ht;have hrow:=href r;simp only[refE] at hrow;change (C.wires (List.ofFn (rowB r))).getD out false=(16383:W32).getLsbD r.1 at hrow;rw[hrow,goal_bits,decide_eq_false (by omega)] at hup;cases hup};{intro ht;obtain⟨r,hr,hsub⟩:=(bounds x).1 ht;apply eMono C hMC (rowB r) x hsub out;have hrow:=href r;simp only[refE] at hrow;change (C.wires (List.ofFn (rowB r))).getD out false=(16383:W32).getLsbD r.1 at hrow;rw[hrow,goal_bits,decide_eq_true hr]}}
lemma list_good (xs : List W32)
    (hstep : ∀ i : Fin xs.length,
      ∃ a ∈ initW ++ xs.take i.val, ∃ b ∈ initW ++ xs.take i.val,
        xs.get i = a &&& b ∨ xs.get i = a ||| b) :
    ∀ k (hk : k ≤ xs.length),
      ∃ gs : List Gate, gs.length ≤ k ∧ GSt gs (initW ++ xs.take k).toFinset := by
  intro k
  induction k with
  | zero =>
    intro _
    exact ⟨[], by simp, by simpa using init_good⟩
  | succ k ih =>
    intro hk
    obtain ⟨gs, hlen, hg⟩ := ih (Nat.le_of_succ_le hk)
    have hlt : k < xs.length := Nat.lt_of_succ_le hk
    obtain ⟨a, ha, b, hb, hval⟩ := hstep ⟨k, hlt⟩
    obtain ⟨gs', hlen', hg'⟩ := step_good hg (List.mem_toFinset.mpr ha) (List.mem_toFinset.mpr hb) hval
    refine ⟨gs', by omega, ?_⟩
    have htake : xs.take (k + 1) = xs.take k ++ [xs.get ⟨k, hlt⟩] := by
      rw [List.take_add_one, List.getElem?_eq_getElem hlt]
      simp [List.get_eq_getElem]
    have hset : (initW ++ xs.take (k + 1)).toFinset =
        insert (xs.get ⟨k, hlt⟩) (initW ++ xs.take k).toFinset := by
      ext w
      simp only [List.mem_toFinset, Finset.mem_insert, List.mem_append]
      rw [htake]
      simp only [List.mem_append, List.mem_singleton]
      tauto
    rw [hset]
    exact hg'
end Br

