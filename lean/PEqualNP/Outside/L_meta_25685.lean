theorem PEqualNP.Outside.L_meta_25685 : (
¬ (let nonlinear := fun (g : PEqualNP.CircuitLowerBounds.Gate) =>
  (g.inputs.length == 2) &&
  xor (xor (g.op.eval [false, false]) (g.op.eval [false, true]))
      (xor (g.op.eval [true, false]) (g.op.eval [true, true]))
let depth := fun (w : ℕ) (C : PEqualNP.CircuitLowerBounds.Circuit) =>
  (C.gates.foldl (fun (ds : List ℕ) g =>
    ds ++ [(g.inputs.map (fun a => ds.getD a 0)).foldr max 0 + (nonlinear g).toNat])
    (List.replicate w 0)).getD C.output 0
∃ C : PEqualNP.CircuitLowerBounds.Circuit,
  (∀ g ∈ C.gates, g.inputs.length ≤ 2) ∧
  PEqualNP.MetaComplexity.NestedCover.ReadsBack 16 C ∧
  PEqualNP.Represents.Represents (fun u v : Fin 8 => decide (u = v)) C ∧
  depth 16 C ≤ 1 ∧ C.gates.countP nonlinear ≤ 2)
) := by
  rintro ⟨C, hlen, hrb, hrep, hd1, hcnt⟩
  have hle := PEqualNP.Outside.L_meta_25685_aux.dir_le (fun u v : Fin 8 => decide (u = v)) 0 0 2 C hlen hrb hrep hd1 hcnt
  have hge := PEqualNP.Outside.L_meta_25685_aux.rank_ge_six
  omega
