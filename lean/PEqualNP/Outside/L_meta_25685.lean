    _ ≤ 2 * t := by omega


theorem rank_ge_six :
    6 ≤ (anchor (0 : Fin 8) (0 : Fin 8) (fun i j => b2z (decide (i = j)))).rank := by
  let A := anchor (0 : Fin 8) (0 : Fin 8) (fun i j => b2z (decide (i = j)))
  let S : Matrix (Fin 6) (Fin 8) (ZMod 2) := fun a i => if i.val = a.val + 1 then 1 else 0
  have hinv : (S * A * S.transpose) * (S * A * S.transpose) = 1 := by
    ext a c
    fin_cases a <;> fin_cases c <;> decide
  have h1 : (1 : Matrix (Fin 6) (Fin 6) (ZMod 2)).rank = 6 := by
    rw [Matrix.rank_one, Fintype.card_fin]
  calc 6 = (1 : Matrix (Fin 6) (Fin 6) (ZMod 2)).rank := h1.symm
    _ = ((S * A * S.transpose) * (S * A * S.transpose)).rank := by rw [hinv]
    _ ≤ (S * A * S.transpose).rank := Matrix.rank_mul_le_left _ _
    _ ≤ (S * A).rank := Matrix.rank_mul_le_left _ _
    _ ≤ A.rank := Matrix.rank_mul_le_right _ _

