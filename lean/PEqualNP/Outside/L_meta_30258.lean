theorem graphTable : ∀ r : Row, bit r graphTarget = f (graphSample r) := by decide +kernel
theorem graphProper : proper graphTarget := by unfold proper; decide +kernel
theorem graphOldProper : proper graph10900 := by unfold proper; decide +kernel
def graphWitnesses : List (Sig × Row × Row) := [(graphInputs.getD 0 zero,4,20), (graphInputs.getD 1 zero,32,40), (graphInputs.getD 2 zero,1,129), (graphInputs.getD 3 zero,16,20), (graphInputs.getD 4 zero,8,40), (graphInputs.getD 5 zero,16,80), (graphInputs.getD 6 zero,16,17), (graphInputs.getD 7 zero,8,10)]

theorem allEssential : ∀ v ∈ graphInputs, Essential graphTarget graphInputs v := by
  have h := essential_ok (T := graphTarget) (raw := graphInputs) (xs := graphWitnesses) (by decide +kernel)
  intro v hv
  exact h v (List.mem_toFinset.mpr hv)
theorem physicalNew (C : Circuit) (legal : PEqualNP.MetaComplexity.FanInTwo C)
    (computes : ∀ x : Fin 8 → Bool, C.eval (List.ofFn x) = f x) :
    ∃ k, k ≤ C.gates.countP (fun g => !isNot g) ∧ Live true graphTarget k graphInputs.toFinset := by
  have goalEq : (execute C.gates graphInputs).getD C.output zero = graphTarget := by
    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    let r : Row := ⟨j,hj⟩
    exact (graphEval C legal C.output r).trans ((computes (graphSample r)).trans (graphTable r).symm)
  have out := get_rep (u:=true) (execute C.gates graphInputs) C.output
  rw [goalEq] at out
  unfold Base.Repr at out
  have pg : bit 0 graphTarget = false := by decide +kernel
  rw [nrm_id pg] at out
  obtain ⟨k,S,hk,run,sub⟩ := extract (u:=true) C.gates graphInputs legal (by simp) graphProper
    (out.resolve_right (fun h => h graphProper))
  have plain : graphInputs.all plainWord = true := by decide +kernel
  rw [nrm_map plain] at sub
  have eq : graphInputs.toFinset = S := by
    ext a
    rw [List.mem_toFinset]
    refine ⟨fun ha => ?_,sub _⟩
    obtain ⟨r,s,hd,iso⟩ := allEssential a ha
    exact raw_required run graphInputs a sub r s hd iso
  exact ⟨k,hk,eq.symm ▸ run⟩

theorem boundNew (prior : Lower true sevenInputs graph10900 12) {k : Nat}
    (run : Live true graphTarget k graphInputs.toFinset) : 13 ≤ k := by
  have sl : Slice true graphInputs graphTarget dropDomain 12 :=
    slice_correct (ms := dropMoves) (by decide +kernel) (by decide +kernel) graphOldProper prior
  obtain ⟨rows, roots, dom, available, nonconstant, lower⟩ := sl
  have covered : supply true (roots.map observe) ((graphInputs.map observe).map (restrictRows rows)) := by
    intro v hv
    obtain ⟨_, hm, rfl⟩ := List.mem_map.mp hv
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hm
    exact available a ha
  have projected := projected_bound rows (list_run run graphInputs (by decide +kernel) rfl)
    nonconstant (Reach.start (roots := roots.map observe)) covered lower
  have paid := count_constants dom graphInputs
  have cnt : graphInputs.countP (isMaskedConstant dropDomain) = 1 := by decide +kernel
  omega

