def graphInputs : List Sig := [inputs.getD 4 zero, inputs.getD 3 zero, inputs.getD 7 zero, inputs.getD 2 zero, inputs.getD 5 zero, inputs.getD 6 zero, inputs.getD 0 zero, inputs.getD 1 zero]
