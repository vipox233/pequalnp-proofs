      simp [basicOps,ops,bin,BitVec.and_comm]

theorem packedLower {raw : List Sig} {k} (xs : List (Sig × Row × Row))
    (all : xs.map Prod.fst = raw) (check : checkEssential goal raw xs = true)
    (nd : raw.Nodup) (room : raw.length ≤ k+1)
    (ok : optimized k (k+1-raw.length) raw = false) : Lower true raw goal (k+1) := by
  apply lower_impossible (proper_of _ (by decide)) (essential_plain check).1 (essential_plain check).2
  · intro a ha
    exact essential_ok check a (List.mem_toFinset.mpr (all ▸ ha))
  · intro t ht run
    have smaller := transfer run
    have lift : live basicOps goal k raw.toFinset := by
      clear room ok
      induction ht with
      | refl => exact smaller
      | step _ ih => exact Or.inl ih
    have hit := optimized_complete (g := goal) (Or.inl rfl) k raw (k+1-raw.length) nd (by omega) lift
    exact Bool.noConfusion (ok.symm.trans hit)

