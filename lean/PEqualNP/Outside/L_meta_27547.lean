private theorem lb_root0 (s : ℕ) (h : HasCircuitSize 9 root0 s) : 8 ≤ s := by
  obtain ⟨b, t, ht, hsub⟩ := gate_elim_at 8 root0 3 s ⟨point 140, by decide +kernel⟩ (by intro b; cases b <;> exact ⟨point 0, point 511, by decide +kernel⟩) h
