  have hc := dep_lower_set 9 root001 T (fun i hi => ⟨W i, hd i hi⟩) s h
  have : T.card = 5 := by decide
  omega
private theorem lb_root00 (s : ℕ) (h : HasCircuitSize 9 root00 s) : 6 ≤ s := by
  obtain ⟨b, t, ht, hsub⟩ := gate_elim_at 8 root00 1 s ⟨point 98, by decide +kernel⟩ (by intro b; cases b <;> exact ⟨point 0, point 511, by decide +kernel⟩) h
  cases b
  · have := lb_root000 t hsub; omega
  · have := lb_root001 t hsub; omega
