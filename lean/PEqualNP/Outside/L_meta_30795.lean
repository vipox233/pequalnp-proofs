    (code &&& 3, wireSAt ((code >>> 2) &&& 15), wireSAt ((code >>> 6) &&& 15)) :: readOps n (p + 1)
def PO (s j : Nat) : List (Nat × Nat × Nat) :=
  let v := fld (opOffB s (j / 64)) 5 (j % 64)
  readOps (v &&& 15) (v >>> 4)

def pmPalB : Nat → Nat
|0=>0x7c20
|_=>0
def pmB : Nat → Nat → Nat
|5,0=>0x11
|6,0=>2
|_,_=>0
def PM (s j : Nat) : Nat := let k := fld (pmB s (j / 128)) 2 (j % 128); fld (pmPalB (k / 32)) 5 (k % 32)
def mkPools (s i : Nat) : List (Nat × Nat × (Nat × List Nat)) :=
  let pm := PM s i
  if pm == 0 then [] else
    let ops := PO s i
    (if pm.testBit 0 then [(dom_212,4,runOps true dom_212 (0,roots_212) ops)] else [])++(if pm.testBit 1 then [(dom_149,4,runOps true dom_149 (0,roots_149) ops)] else [])++(if pm.testBit 2 then [(dom_85,4,runOps true dom_85 (0,roots_85) ops)] else [])++(if pm.testBit 3 then [(dom_209,4,runOps true dom_209 (0,roots_209) ops)] else [])++(if pm.testBit 4 then [(dom_197,4,runOps true dom_197 (0,roots_197) ops)] else [])
