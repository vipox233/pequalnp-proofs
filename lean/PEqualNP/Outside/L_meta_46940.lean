lemma replacement_from_binary_cofactor_bound {n m b : ℕ}
    (f : (Fin n → Bool) → Bool) (π : Fin n → Option (Fin m))
    (a c : Fin n → Bool)
    (changed : ∀ i, a i ≠ c i → π i = none)
    (different : f a ≠ f c)
