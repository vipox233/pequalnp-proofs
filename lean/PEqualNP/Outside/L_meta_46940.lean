    (length : roots.length = m)
    (properT : proper T) (normal : nrm true U = T) (low : Lower true certifiedRoots T L)
    (f : (Fin m → Bool) → Bool)
    (tab : ∀ r : Row, bit r U = f (fun i => bit r (roots.getD i.val zero)))
    (C : Circuit) (legal : PEqualNP.MetaComplexity.FanInTwo C)
    (computes : ∀ x, C.eval (List.ofFn x) = f x) :
    L ≤ C.gates.countP (fun g => !isNot g) := by
  classical
  have sampled (r : Row) : List.ofFn (fun i : Fin m => bit r (roots.getD i.val zero)) = roots.map (bit r) := by
    have q : List.ofFn (fun i : Fin m => roots.getD i.val zero) = roots := by
      apply List.ext_getElem
      · simp [length]
      · intro i hi hj
        simp only [List.getElem_ofFn]
        simp [List.getD_eq_getElem?_getD,hj]
    calc
      _ = (List.ofFn (fun i : Fin m => roots.getD i.val zero)).map (bit r) := by rw [List.map_ofFn];rfl
      _ = roots.map (bit r) := congrArg (List.map (bit r)) q
  have goalEq : (execute C.gates roots).getD C.output zero = U := by
    apply bit_ext
    intro r
    rw [←b_read,execute_bits _ _ _ (fun g hg => (legal g hg).1),←sampled]
    exact (computes _).trans (tab r).symm
  have out := get_rep (u:=true) (execute C.gates roots) C.output
  rw [goalEq] at out
  unfold Source46940.Repr at out
  rw [normal] at out
  obtain ⟨k,S,hk,run,sub⟩ := extract (u:=true) C.gates roots legal (by simp) properT
    (out.resolve_right (fun h => h properT))
  have listRun := list_run run S.toList (Finset.nodup_toList _) (by simp)
  have supplied : supply true (certifiedRoots.map observe) (S.toList.map observe) := by
    intro a ha
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp ha
    exact Or.inl (List.mem_map_of_mem (subset v (sub v (Finset.mem_toList.mp hv))))
  obtain ⟨q,bank,reach,hit,bound⟩ := contraction (observe_proper properT) listRun
    (certifiedRoots.map observe) Reach.start supplied
  have hq := low q bank reach hit
  omega
