def routeB {n m : ℕ} (fixed : Bool) (π : Fin n → Option (Fin m))
    (y : Fin m → Bool) (i : Fin n) : Bool := (π i).elim fixed y

lemma essential_routed_fixed_restriction {n m : ℕ} (C : Circuit)
    (hops : ∀ g ∈ C.gates, (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2)
    (fixed : Bool) (π : Fin n → Option (Fin m)) (a b : Fin n → Bool)
    (changed : ∀ i, a i ≠ b i → π i = none)
    (different : C.eval (List.ofFn a) ≠ C.eval (List.ofFn b))
    (nonconstant : ¬∃ c, ∀ y, C.eval (List.ofFn (routeB fixed π y)) = c) :
    ∃ D : Circuit,
      (∀ g ∈ D.gates, (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2) ∧
      (∀ y, D.eval (List.ofFn y) = C.eval (List.ofFn (routeB fixed π y))) ∧
      binaryCost D.gates + 1 ≤ binaryCost C.gates := by
  classical
  let X := fun y => List.ofFn (routeB fixed π y)
  let A := fun w => (C.wires (List.ofFn a)).getD w false
  let B := fun w => (C.wires (List.ofFn b)).getD w false
  have wire : ∀ xs, C.wires xs = run C.gates xs := fun _ => rfl
  have wi : ∀ (x : Fin n → Bool) (i : Fin n),
      (C.wires (List.ofFn x)).getD i.val false = x i := by
    intro x i
    rw [wire,run_input _ _ _ (by simpa using i.isLt),
      List.getD_eq_getElem _ _ (by simpa using i.isLt),List.getElem_ofFn]
  have xget : ∀ i (hi : i < n) y, (X y).getD i false = routeB fixed π y ⟨i,hi⟩ := by
    intro i hi y
    rw [List.getD_eq_getElem _ _ (by simpa [X] using hi)]
    simp [X]
  have hin : ∀ i < n, (∃ c, ∀ y, (X y).getD i false = c) ∨
      ∃ k < m, ∀ y, (X y).getD i false = (List.ofFn y).getD k false := by
    intro i hi
    cases h : π ⟨i,hi⟩ with
    | none => exact Or.inl ⟨fixed,fun y => by rw [xget i hi]; simp [routeB,h]⟩
    | some k =>
      refine Or.inr ⟨k.val,k.isLt,fun y => ?_⟩
      rw [xget i hi,List.getD_eq_getElem _ _ (by simpa using k.isLt),List.getElem_ofFn]
      simp [routeB,h]
  have varies : ∀ i < n, A i ≠ B i →
      Const (fun y => (C.wires (X y)).getD i false) := by
    intro i hi hd
    have hab : a ⟨i,hi⟩ ≠ b ⟨i,hi⟩ := by
      change (C.wires (List.ofFn a)).getD (⟨i,hi⟩ : Fin n).val false ≠
        (C.wires (List.ofFn b)).getD (⟨i,hi⟩ : Fin n).val false at hd
      rw [wi,wi] at hd
      exact hd
    have hπ := changed ⟨i,hi⟩ hab
    exact ⟨fixed,fun y => by
      change (C.wires (List.ofFn (routeB fixed π y))).getD (⟨i,hi⟩ : Fin n).val false = fixed
      rw [wi]
      simp [routeB,hπ]⟩
  have out : C.output < n + C.gates.length := by
    by_contra! h
    apply different
    simp [Circuit.eval,wire,List.getD_eq_default,run_length,h]
  apply restrict_with_binary_drop n m C X A B hops (by simp [X]) hin
    (fun j hj y => by simpa [X,wire] using run_gate C.gates (X y) j hj)
    (fun i hi y => by simpa [X,wire] using run_input C.gates (X y) i (by simpa [X] using hi))
    (fun j hj => by simpa [A,wire] using run_gate C.gates (List.ofFn a) j hj)
    (fun j hj => by simpa [B,wire] using run_gate C.gates (List.ofFn b) j hj)
    varies out different nonconstant

end LeafLiftPreparation

