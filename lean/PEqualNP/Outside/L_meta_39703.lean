theorem solve (low : Lower true fullRoots fullWord 11) : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4008372904 * 2 ^ 32 + 3972581512) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4008372904 * 2 ^ 32 + 3972581512) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) := by
  intro s hs
  obtain ⟨⟨gs, o⟩, legal, hsize, correct⟩ := hs
  by_cases clean : ∀ g ∈ gs, g.op ≠ GateOp.not
  · refine ⟨⟨gs, o⟩, ?_, hsize, correct⟩
    intro g hg
    obtain ⟨op, len⟩ := legal g hg
    refine ⟨?_, len⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at op ⊢
    exact op.elim Or.inl (fun h => Or.inr (h.resolve_right (clean g hg)))
  · push Not at clean
    obtain ⟨a, ha, hop⟩ := clean
    have lo := binaryLower low gs o legal (fun x => correct x)
    have less : gs.countP (fun g => !isNot g) < gs.length := by
      by_contra! bad
      have e := List.countP_eq_length.mp (Nat.le_antisymm List.countP_le_length bad) a ha
      simp [isNot, hop] at e
    refine ⟨⟨mono, 17⟩, monoShape, ?_, fun x => monoEval x⟩
    change mono.length ≤ s
    have hm : mono.length = 12 := rfl
    change gs.length ≤ s at hsize
    omega


private def rows : Bool → Row → Row
  | true, r => ⟨r.val % 32 + 32, by omega⟩
  | false, r => ⟨31 - ((r.val % 32 / 4) * 4 + r.val % 2 * 2 + r.val / 2 % 2), by omega⟩

private def goals (b : Bool) : Sig := if b then cofGoal else neg cofGoal

private theorem mapTarget (b : Bool) : rename (rows b) fullWord = goals b := by
  cases b <;> decide +kernel

private theorem mapRoots (b : Bool) (a : Sig) (ha : a ∈ fullRoots) :
    Available true (cofRoots.map observe) (observe (rename (rows b) a)) := by
  let ok (r : Sig) := freeWord cofRoots (rename (rows b) r) ||
    freeWord cofRoots (neg (rename (rows b) r))
  have allOK : fullRoots.all ok = true := by cases b <;> decide +kernel
  have h := List.all_eq_true.1 allOK a ha
  simp only [ok, Bool.or_eq_true] at h
  rcases h with h | h
  · exact freeWord_ok h
  · have free := freeWord_ok (u := true) h
    rw [obs_neg] at free
    simpa only [inv_inv'] using avail_inv rfl free

private theorem pivotEssential :
    Essential fullWord fullRoots (inputs.getD 5 zero) := by
  apply essential_ok (xs := [(inputs.getD 5 zero, 5, 37)])
  · decide +kernel
  · simp

theorem fullBound (known : KnownCofactor) : Lower true fullRoots fullWord 11 := by
  apply lower_two_slices (pivot := inputs.getD 5 zero) (L := 9)
    (proper_of _ (by decide +kernel)) (by decide +kernel) (by decide +kernel)
    pivotEssential rows (fun _ => cofRoots) goals mapTarget mapRoots
  · intro b
    rw [← observe_rename]
    cases b
    · rw [show rename (rows false) (inputs.getD 5 zero) = zero by decide +kernel]
      exact funext bit_zero
    · rw [show rename (rows true) (inputs.getD 5 zero) = one by decide +kernel]
      exact funext bit_one
  · intro b
    cases b <;> exact proper_of _ (by decide +kernel)
  · intro b
    cases b
    · exact cofDualBound known
    · exact cofBound known

