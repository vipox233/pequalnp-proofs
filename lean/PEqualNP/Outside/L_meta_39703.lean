  apply Numeric.avail_of_eq _ (bridgeAvail supplies ht)
  simp only [code, table_observe]
  decide +kernel

private theorem cofDualBound (known : KnownCofactor) : Lower true cofRoots (neg cofGoal) 9 := by
  intro k bank hr ht
  apply cofBound known k bank hr
  rw [obs_neg] at ht
  simpa only [inv_inv'] using avail_inv rfl ht

