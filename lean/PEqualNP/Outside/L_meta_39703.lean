private theorem dom_bit (k : Nat) : Numeric.dom_31.testBit k = decide (k < 32) := by
  change (2 ^ 32 - 1 : Nat).testBit k = _
  rw [Nat.testBit_two_pow_sub_one]

private theorem code_bit (f : Wire Row) (k : Nat) (hk : k < 32) :
    (code f).testBit k = f ⟨k, by omega⟩ := by
  unfold code
  rw [Nat.testBit_and, dom_bit]
  simpa only [hk, decide_true, Bool.and_true, bit, BitVec.testBit_toNat] using bit_table f ⟨k, by omega⟩

private theorem code_outside (f : Wire Row) (k : Nat) (hk : 32 ≤ k) :
    (code f).testBit k = false := by
  simp [code, Nat.testBit_and, dom_bit, show ¬ k < 32 by omega]

private theorem code_const (b : Bool) :
    code (fun _ => b) = (if b then Numeric.dom_31 else 0) := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk : k < 32
  · rw [code_bit _ _ hk]
    cases b <;> simp [dom_bit, hk]
  · rw [code_outside _ _ (by omega)]
    cases b <;> simp [dom_bit, hk]

private theorem code_inv (f : Wire Row) :
    code (inv f) = Numeric.negD Numeric.dom_31 (code f) := by
  apply Nat.eq_of_testBit_eq
  intro k
  simp only [Numeric.negD, Nat.testBit_and, Nat.testBit_xor, Numeric.mask256_bit, dom_bit]
  by_cases hk : k < 32
  · simp [code_bit _ k hk, inv, hk, show k < 256 by omega]
  · simp [code_outside _ k (by omega : 32 ≤ k), hk]

private theorem code_op (b : Bool) (f g : Wire Row) :
    Numeric.opD Numeric.dom_31 (if b then 1 else 0) (code f) (code g) =
      code (combine b f g) := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk : k < 32
  · cases b <;>
      simp [Numeric.opD, Numeric.andD, Numeric.orD, Nat.testBit_and, Nat.testBit_or,
        dom_bit, code_bit _ k hk, combine, hk]
  · cases b <;>
      simp [Numeric.opD, Numeric.andD, Numeric.orD, Nat.testBit_and, Nat.testBit_or,
        dom_bit, code_outside _ k (by omega : 32 ≤ k), hk]

private theorem bridgeAvail {bank : List (Wire Row)} {pool : List Nat}
    (supplied : ∀ f ∈ bank, Numeric.Avail true Numeric.dom_31 pool (code f))
    {f : Wire Row} (haveF : Available true bank f) :
    Numeric.Avail true Numeric.dom_31 pool (code f) := by
  rcases haveF with h | ⟨b,rfl⟩ | ⟨_,h⟩
  · exact supplied f h
  · rw [code_const]
    cases b
    · exact Or.inl (Or.inl (by simp))
    · exact Or.inl (Or.inr (by simp))
  · have v := Numeric.avail_neg (by decide : Numeric.dom_31 &&& Numeric.mask256 = Numeric.dom_31)
      (supplied _ h)
    rw [← code_inv, inv_inv'] at v
    exact v

private theorem initial (f : Wire Row) (h : f ∈ cofRoots.map observe) :
    Numeric.Avail true Numeric.dom_31 Numeric.roots_31 (code f) := by
  obtain ⟨r, hr, rfl⟩ := List.mem_map.1 h
  simp only [code, table_observe]
  have ok : cofRoots.all (fun w => Numeric.availB true Numeric.dom_31 Numeric.roots_31
      (w.toNat &&& Numeric.dom_31)) = true := by decide +kernel
  exact (Numeric.availB_iff _ _ _ _).1 (List.all_eq_true.1 ok _ hr)

private theorem simulate {k : Nat} {bank : List (Wire Row)}
    (h : Reach true (cofRoots.map observe) k bank) :
    ∃ pool, Numeric.NatReach true Numeric.dom_31 Numeric.roots_31 k pool ∧
      ∀ f ∈ bank, Numeric.Avail true Numeric.dom_31 pool (code f) := by
  induction h using Reach.ind with
  | start => exact ⟨Numeric.roots_31, rfl, initial⟩
  | @two p bank a b op h ha hb ih =>
    obtain ⟨pool, reach, supplied⟩ := ih
    let z := Numeric.opD Numeric.dom_31 (if op then 1 else 0) (code a) (code b)
    refine ⟨z :: pool, ⟨pool, code a, code b, (if op then 1 else 0), ?_, rfl,
      reach, bridgeAvail supplied ha, bridgeAvail supplied hb⟩, ?_⟩
    · cases op <;> decide
    · intro f hf
      rcases List.mem_cons.1 hf with rfl | hm
      · rw [← code_op]
        exact Or.inr (.inl ⟨z, List.mem_cons_self, rfl⟩)
      · exact Numeric.avail_cons z _ (supplied f hm)

