    (old : List Nat) (allSafe : ∀ w ∈ old, w ∈ safe)
    (tailWords : List Nat) (before after : Nat)
    (prepared : ∀ m ∈ cuts, ∃ pre, pre.length ≤ before ∧ BuildsBin m (coreBank m) pre ∧
      ∀ w ∈ a :: b :: old, Avail (pre ++ coreBank m) (canon m (canon fullMask w)))
