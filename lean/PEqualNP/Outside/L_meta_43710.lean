      obtain ⟨pre,g',tail,eqn,safe',neg⟩ := ih _ bigger escaped
      exact ⟨g::pre,g',tail,by simp [eqn],safe',neg⟩
    · exact ⟨[],g,gs,rfl,hs,h⟩
