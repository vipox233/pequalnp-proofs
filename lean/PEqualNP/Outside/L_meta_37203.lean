theorem PEqualNP.Outside.L_meta_37203 : (∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4277071584 * 2 ^ 32 + 4276678368) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4277071584 * 2 ^ 32 + 4276678368) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) := by
  rintro s ⟨C,hC,hs,he⟩
  by_cases clean : ∀ g ∈ C.gates, g.op ≠ GateOp.not
  · refine ⟨C,?_,hs,he⟩
    intro g hg
    obtain ⟨ho,hl⟩ := hC g hg
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at ho ⊢
    exact ⟨ho.imp_right (fun v => v.resolve_right (clean g hg)),hl⟩
  · push Not at clean
    obtain ⟨g,hg,hop⟩ := clean
    have bound := freshBound C hC he
    have fewer : C.gates.countP (fun a => !isNot a) < C.gates.length := by
      by_contra! h
      have e := List.countP_eq_length.mp (Nat.le_antisymm List.countP_le_length h) g hg
      simp [isNot,hop] at e
    change C.gates.length ≤ s at hs
    exact ⟨⟨freshWitness,15⟩,freshMono,by rw [freshSize]; omega,freshCorrect⟩
