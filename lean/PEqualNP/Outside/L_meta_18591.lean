lemma kIG:GSt [] initW.toFinset:=by refine⟨by simp,λ w hw=>?_⟩;simp only[initW,List.toFinset_cons,List.toFinset_nil,Finset.mem_insert,Finset.notMem_empty,or_false] at hw;have hget:∀(v:Fin 10)(r:Fin 32),refE [] (rowB r) (some v.1)=(activeW.getD v.1 0).getLsbD r.1:=λ v r=>by{simp only[refE,Circuit.wires,List.foldl_nil];rw[List.getD_eq_getElem _ _ (by simp[v.isLt]),List.getElem_ofFn];rfl};rcases hw with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl;{exact⟨some 0,by simp,hget ⟨0,by decide⟩⟩};{exact⟨some 1,by simp,hget ⟨1,by decide⟩⟩};{exact⟨some 2,by simp,hget ⟨2,by decide⟩⟩};{exact⟨none,by simp,by intro r;simp[refE]⟩};{exact⟨some 3,by simp,hget ⟨3,by decide⟩⟩};{exact⟨some 4,by simp,hget ⟨4,by decide⟩⟩};{exact⟨some 5,by simp,hget ⟨5,by decide⟩⟩};{exact⟨some 6,by simp,hget ⟨6,by decide⟩⟩};{exact⟨some 7,by simp,hget ⟨7,by decide⟩⟩};{exact⟨some 8,by simp,hget ⟨8,by decide⟩⟩};{exact⟨some 9,by simp,hget ⟨9,by decide⟩⟩}
