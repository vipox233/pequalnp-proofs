nly[refE] at h1;rw[h2,BitVec.getLsbD_or,<-h1];rfl})}|some u=>{cases rb with|none=>{exact reu (some u) hba (λ r=>by{have h1:=hea r;have h2:=heb r;simp only[refE] at h2;rw[h1,BitVec.getLsbD_or,<-h2];simp})}|some v=>{exact ext ⟨.or,[u,v]⟩ ⟨Or.inr rfl,by simp⟩ (λ r=>by{simp only[GateOp.eval,List.map_cons,List.map_nil,List.any_cons,List.any_nil,Bool.or_false];have h1:=hea r;have h2:=heb r;simp only[refE] at h1 h2;rw[h1,h2,BitVec.getLsbD_or];rfl})}}}
lemma kGC{gs:List Gate}{ws:Finset W32}(hg:GSt gs ws)(hlen:gs.length<=18)(hhit:(16383:W32)∈ws):∃C:Circuit,Monotone2 C/\C.size<=18/\∀x:Fin 10->Bool,C.eval (List.ofFn x)=true<->∃u v:Fin 10,(u.1,v.1)∈k7/\x u=true/\x v=true:=by obtain⟨hM,hrep⟩:=hg;obtain⟨ref,_,href⟩:=hrep 16383 hhit;cases ref with|none=>{have h0:=href 0;simp[refE] at h0}|some out=>{let C:Circuit:=⟨gs,out⟩;have hMC:Monotone2 C:=hM;refine⟨C,hMC,hlen,λ x=>?_⟩;rw[<-gBool_iff];constructor;{intro ht;by_contra hne;have hf:gBool x=false:=Bool.eq_false_of_not_eq_true hne;obtain⟨r,hr,hsub⟩:=(bounds x).2 hf;have hup:=eMono C hMC x (rowB r) hsub out ht;have hrow:=href r;simp only[refE] at hrow;change (C.wires (List.ofFn (rowB r))).getD out false=(16383:W32).getLsbD r.1 at hrow;rw[hrow,goal_bits,decide_eq_false (by omega)] at hup;cases hup};{intro ht;obtain⟨r,hr,hsub⟩:=(bounds x).1 ht;apply eMono C hMC (rowB r) x hsub out;have hrow:=href r;simp only[refE] at hrow;change (C.wires (List.ofFn (rowB r))).getD out false=(16383:W32).getLsbD r.1 at hrow;rw[hrow,goal_bits,decide_eq_true hr]}}
lemma kSQ2(S:Finset W32)(L:List W32)(hseq:∀pre x suf,L=pre++x::suf->∃a∈S∪pre.toFinset,∃b∈S∪pre.toFinset,x=a&&&b\/x=a|||b)(gs:List Gate)(hg:GSt gs S):∃gs',gs'.length<=gs.length+L.length/\GSt gs' (S∪L.toFinset):=by induction L using List.reverseRecOn generalizing gs with|nil=>exact⟨gs,by simp,by simpa using hg⟩|append_singleton pre x ih=>{have hpre:∀p y s,pre=p++y::s->∃a∈S∪p.toFinset,∃b∈S∪p.toFinset,y=a&&&b\/y=a|||b:=λ p y s hp=>hseq p y (s++[x]) (by rw[hp];simp);obtain⟨gs1,hl1,hg1⟩:=ih hpre gs hg;obtain⟨a,ha,b,hb,hz⟩:=hseq pre x [] (by simp);obtain⟨gs2,hl2,hg2⟩:=step_good hg1 ha hb hz;have hset:insert x (S∪pre.toFinset)=S∪(pre++[x]).toFinset:=(by ext w;simp);rw[hset] at hg2;exact⟨gs2,by simp;omega,hg2⟩}
