lemma xa{D:qD}(d:q0 n D)(c:D≠[])(x:tX n):fO (relabel a D) x (qb n (relabel a D))=fO D (λ i=>x (a i)) (qb n D):=by have g:=lP c;have e:qb n (relabel a D)=gL a (qb n D):=by{rw[qt a (by unfold qb;omega)];simp[qb,kRL]};rw[e,fH a d]
