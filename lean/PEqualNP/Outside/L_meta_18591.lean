def gL{n:Nat}(a:EP (Fin n))(w:Nat):Nat:=if h:w<n then (a ⟨w,h⟩).1 else w
def relabel {n:Nat}(a:EP (Fin n))(D:qD):qD:=D.map (λ g=>(g.1,gL a g.2.1,gL a g.2.2))
section
variable {n:Nat}(a:EP (Fin n))
include n a
lemma yh{w:Nat}(h:w<n):gL a w=(a ⟨w,h⟩).1:=by simp[gL,h]
lemma qt{w:Nat}(h:n<=w):gL a w=w:=by simp[gL,p25.2 h]
lemma qy{m:Nat}(c:n<=m)(w:Nat):gL a w<m↔w<m:=by by_cases h:w<n;{rw[yh a h];have:=(a ⟨w,h⟩).2;constructor<;>intro<;>omega};{rw[qt a (p25.1 h)]}
lemma yz(w:Nat):gL a⁻¹ (gL a w)=w:=by by_cases h:w<n;{rw[yh a h,yh a⁻¹ (a ⟨w,h⟩).2];simp};{rw[qt a (p25.1 h),qt a⁻¹ (p25.1 h)]}
lemma tr_liftP_inv'(w:Nat):gL a (gL a⁻¹ w)=w:=by simpa using yz a⁻¹ w
end
lemma tr_liftP_inj{n:Nat}(c:EP (Fin n)){a b:Nat}:gL c a=gL c b↔a=b:=by refine⟨λ h=>?_,congrArg _⟩;have:=congrArg (gL c⁻¹) h;rwa [yz,yz] at this
lemma kRL{n:Nat}(a:EP (Fin n))(D:qD):(relabel a D).length=(tD D):=by simp[relabel]
lemma ba{n:Nat}(c:EP (Fin n))(D:qD)(j:Nat)(a:j<(tD D)):gZ (relabel c D) j=gZ D j:=by rw[xd _ j (by rw[kRL];exact a),xd D j a];simp[relabel]
section
variable {n:Nat}(a:EP (Fin n))
include n a
lemma kt(D:qD)(j:Nat)(c:j<(tD D)):yx (relabel a D) j=gL a (yx D j):=by rw[xe _ j (by rw[kRL];exact c),xe D j c];simp[relabel]
lemma ku(D:qD)(j:Nat)(c:j<(tD D)):yf (relabel a D) j=gL a (yf D j):=by rw[xf _ j (by rw[kRL];exact c),xf D j c];simp[relabel]
lemma j3{D:qD}(c:q0 n D):q0 n (relabel a D):=by intro j d;rw[kRL] at d;obtain⟨l,i,g⟩:=c j d;rw[kt a D j d,ku a D j d];exact⟨(qy a (nL n j) _).2 l,(qy a (nL n j) _).2 i,λ h=>g ((tr_liftP_inj a).1 h)⟩
lemma fH{D:qD}(c:q0 n D)(x:tX n)(w:Nat):fO (relabel a D) x (gL a w)=fO D (λ i=>x (a i)) w:=by by_cases h:w<n+(tD D);{refine (jy (j3 a c) x (λ l=>fO D (λ i=>x (a i)) (gL a⁻¹ l)) (λ i g=>by{show fO D (λ i=>x (a i)) (gL a⁻¹ i)=x ⟨i,g⟩;rw[yh a⁻¹ g,qa D _ _ (a⁻¹ ⟨i,g⟩).2];simp}) (λ j d=>by{rw[kRL] at d;show fO D (λ i=>x (a i)) (gL a⁻¹ (n+j))=_;rw[qt a⁻¹ (nL n j),ba a D j d,kt a D j d,ku a D j d,yz,yz,qu c _ j d]}) (gL a w) (by{rw[kRL];exact (qy a (nL _ _) w).2 h})).trans (by{show fO D (λ i=>x (a i)) (gL a⁻¹ (gL a w))=_;rw[yz]})};{have hw':=p25.1 h;rw[qt a (le_trans (nL _ _) hw'),z0 _ _ _ (by{rw[kRL];exact hw'}),z0 _ _ _ hw']}
lemma wa(D:qD)(w:Nat):fanout (relabel a D) (gL a w)=fanout D w:=by unfold fanout qg;rw[kRL];congr 1;apply filter_congr;intro j c;have hj':=mR.1 c;rw[kt a D j hj',ku a D j hj',tr_liftP_inj,tr_liftP_inj]
lemma kv{D:qD}(c:b5 n D):b5 n (relabel a D):=by rcases eq_or_ne D [] with rfl|g;{exact c};{intro d j;rw[kRL] at j;have i:=lP g;rw[<-tr_liftP_inv' a d,wa];apply c;by_cases h:d<n;{have:=(qy a⁻¹ le_rfl d).2 h;omega};{rw[qt a⁻¹ (p25.1 h)];exact j}}
